<section class="quasar-panel quasar-section">
    <header class="quasar-card-heading">
            <div class="quasar-row quasar-between">
                <div class="quasar-row">
                    <h2>@Cluster.DisplayName</h2>
                    <span class="quasar-status quasar-tone-primary">
                        Cluster
                    </span>
                </div>
                <div class="quasar-row">
                    <ClusterConsoleButton Cluster="Cluster" />
                    <ClusterDeleteButton Cluster="Cluster" />
                    <span class="quasar-tooltip" title="Cluster details"><a aria-label="Cluster details" class="quasar-icon-button" href="@($"/clusters/{Uri.EscapeDataString(Cluster.UniqueName)}")"><QuasarIcon Icon="@QuasarIcons.OpenInNew" /></a></span>
                    <ClusterAdminPanel Cluster="Cluster" Compact="true" />
                </div>
            </div>
            <p class="mono quasar-muted quasar-caption">@Cluster.UniqueName · @Cluster.GatewayUrl</p>
    </header>
    <div class="quasar-card-content">
        <ClusterDetailPanel Cluster="Cluster" ShowConfigurationLinks="false" />
    </div>
</section>

@code
{
    [Parameter, EditorRequired]
    public ClusterDefinition Cluster { get; set; } = new();
}
