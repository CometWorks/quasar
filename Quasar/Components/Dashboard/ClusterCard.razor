@inject NavigationManager Navigation

<MudCard Class="server-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween" Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h6">@Cluster.DisplayName</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                        Cluster
                    </MudChip>
                </MudStack>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="OpenDetails">
                    Details
                </MudButton>
            </MudStack>
            <MudText Typo="Typo.caption" Class="mono">@Cluster.UniqueName · @Cluster.GatewayUrl</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <ClusterDetailPanel Cluster="Cluster" />
    </MudCardContent>
</MudCard>

@code
{
    [Parameter, EditorRequired]
    public ClusterDefinition Cluster { get; set; } = new();

    private void OpenDetails() => Navigation.NavigateTo(
        $"/clusters/{Uri.EscapeDataString(Cluster.UniqueName)}");
}
