@implements IAsyncDisposable
@using Admin = CometWorks.ClusterGateway.AdminContract.V1
@using HostContract = Quasar.Host.Contract.V1
@inject ClusterGatewayClient GatewayClient
@inject ClusterHostClient HostClient
@inject ClusterReconciler Reconciler
@inject QuasarConfigProfileCatalog Profiles
@inject QuasarWorldTemplateCatalog Worlds
@inject ClusterFleetService Fleet
@inject ClusterHostCatalog Hosts

<section class="@(CollapseDetails ? "quasar-cluster-summary" : "quasar-panel quasar-section")">
<div class="quasar-card-content">
<div class="quasar-stack">
    @if (!CollapseDetails) { <h2>Cluster overview</h2> }
    @if (ShowConfigurationLinks) { <ClusterConfigurationLinks /> }
    @if (_loading && _status is null)
    {
        <QuasarProgress Label="Refreshing cluster status" Indeterminate="true" />
    }
    @if (_error is not null)
    {
        <div class="quasar-notice quasar-notice-error" role="status">@_error</div>
    }
    @if (RecoveryRequired)
    {
        <div class="quasar-notice quasar-notice-error" role="status">@Reconciler.GetStatus(Cluster.UniqueName).Message</div>
    }

    @if (Cluster.GoalState == DedicatedServerGoalState.On && _observedAt is { } observed)
    {
        <p class="quasar-muted quasar-caption">@(_stale ? "Stale observation" : "Observed") · @observed.ToString("u") · Health: @(_stale ? "Unknown" : _status?.Health.ToString())</p>
    }
    @if (_capabilities?.Scope == Admin.AdminScope.Query)
    {
        <div class="quasar-notice quasar-notice-info" role="status">Cluster Registry access is query-only.</div>
    }

    <div class="quasar-detail-metrics">
        <div class="quasar-detail-metric">
            <div>
                <p class="quasar-eyebrow">Status</p>
                <h2 class="quasar-tone-@(PhaseColor.ToString().ToLowerInvariant())">@PhaseText</h2>
                <p class="d-block quasar-muted quasar-caption">Cluster Registry · @GatewayText</p>
                <p class="d-block quasar-muted quasar-caption">World Authority · @WorldAuthorityText</p>
            </div>
        </div>
        @if (Cluster.GoalState == DedicatedServerGoalState.On)
        {
        @if (!ShowTopology)
        {
        <div class="quasar-detail-metric">
            <div>
                <p class="quasar-eyebrow">Players</p>
                <h2>@PlayerText</h2>
                <p class="quasar-muted quasar-caption">@JoinText</p>
            </div>
        </div>
        }
        <div class="quasar-detail-metric">
            <div>
                <p class="quasar-eyebrow">Capacity</p>
                <h2>@CapacityText</h2>
                <p class="quasar-muted quasar-caption">@CapacityDetail</p>
            </div>
        </div>
        <div class="quasar-detail-metric">
            <div>
                <p class="quasar-eyebrow">Crash recovery readiness</p>
                <h2 class="quasar-tone-@(RecoveryColor.ToString().ToLowerInvariant())">@RecoveryText</h2>
                <p class="quasar-muted quasar-caption">@RecoveryDetail</p>
            </div>
        </div>
        }
    </div>

    @if (Cluster.GoalState == DedicatedServerGoalState.On && !_stale && _status?.ReasonCodes.Length > 0)
    {
        <div class="quasar-notice quasar-notice-warning" role="status">
            @string.Join(" · ", _status.ReasonCodes)
        </div>
    }

    @if (ShowTopology)
    {
        <ClusterHealthOverview Cluster="Cluster" Status="@(_stale ? null : _status)" Plan="_plan"
                               Fleet="_fleet" Clients="_clients" Partitions="_partitions" Host="_host"
                               Hosts="Hosts.GetAll()" />
    }

    @if (CollapseDetails)
    {
        <details class="quasar-card-disclosure"><summary>Cluster details <span class="quasar-muted">World, configuration &amp; runtime</span></summary>@RuntimeDetails</details>
    }
    else { @RuntimeDetails }

</div>
</div>
</section>

@code
{
    [Parameter] public bool CollapseDetails { get; set; }
    [Parameter] public bool ShowTopology { get; set; }
    [Parameter] public EventCallback<bool> GatewayAvailabilityChanged { get; set; }
    private RenderFragment RuntimeDetails => @<div class="quasar-live-details">
    <div>
        <h2>World and configuration</h2>
        <p>Active world: @(_status?.WorldId ?? "Unknown")</p>
        <p>Configuration profile: @(Profiles.GetProfile(Cluster.ConfigProfileId)?.Name ?? ValueOrDash(Cluster.ConfigProfileId))</p>
        <p>World template: @(Worlds.GetTemplate(Cluster.WorldTemplateId)?.Name ?? ValueOrDash(Cluster.WorldTemplateId))</p>
    </div>

    <hr class="quasar-divider">
    <h3>Runtime details</h3>
    <table class="cluster-details-table quasar-server-table quasar-runtime-table">
        <tbody>
            <tr><th>Desired state</th><td>@Cluster.GoalState</td></tr>
            <tr><th><MudTooltip Text="Quasar checks whether the cluster is running or stopped as requested and starts or stops its services when needed."><span tabindex="0">Automatic cluster control</span></MudTooltip></th><td>@ReconcileText</td></tr>
            @if (GatewayOutput is { Length: > 0 } output)
            {
                <tr><th>Last Cluster Registry process output</th><td><pre class="cluster-gateway-output">@string.Join('\n', output)</pre></td></tr>
            }
            <tr><th><MudTooltip Text="Quasar.Host is the management service on the host machine. It starts, stops and monitors the cluster's processes."><span tabindex="0">Host management service</span></MudTooltip></th><td>@HostText</td></tr>
            <tr><th>Cluster Registry process</th><td>@GatewayExecutorText</td></tr>
            <tr><th><MudTooltip Text="The Cluster Registry saves its coordination data as a snapshot and a log of later updates. This is separate from a world backup."><span tabindex="0">Saved coordination state</span></MudTooltip></th><td>@RegistryText</td></tr>
        </tbody>
    </table>    </div>;

    [Parameter] public bool ShowConfigurationLinks { get; set; } = true;
    private readonly CancellationTokenSource _shutdown = new();
    private Admin.ClusterStatus? _status;
    private Admin.NodePlan[] _plan = [];
    private Admin.RecoveryReadiness? _recovery;
    private HostContract.HostStatus? _host;
    private Task? _refreshLoop;
    private string? _error;
    private bool _loading;
    private bool _stale;
    private DateTimeOffset? _observedAt;
    private Admin.AdminCapabilities? _capabilities;
    private bool? _reportedGatewayAvailability;
    private ClusterFleet? _fleet;
    private Admin.ClientSummary[]? _clients;
    private Admin.PartitionSummary[]? _partitions;

    [Parameter, EditorRequired]
    public ClusterDefinition Cluster { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync(_shutdown.Token);
        _refreshLoop = RefreshLoopAsync(_shutdown.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(async () =>
                {
                    await RefreshAsync(cancellationToken);
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync(CancellationToken cancellationToken)
    {
        _loading = true;
        _fleet = null;
        _clients = null;
        _partitions = null;
        _host = null;
        _plan = [];
        _recovery = null;
        try
        {
            var capabilities = GatewayClient.GetCapabilitiesAsync(Cluster, cancellationToken);
            Task<Admin.AdminEnvelope<Admin.ClusterStatus>> status =
                GatewayClient.GetStatusAsync(Cluster, cancellationToken);
            Task<Admin.AdminEnvelope<Admin.NodePlan[]>> plan =
                GatewayClient.GetPlanAsync(Cluster, cancellationToken);
            Task<Admin.AdminEnvelope<Admin.RecoveryReadiness>> recovery =
                GatewayClient.GetRecoveryReadinessAsync(Cluster, cancellationToken);
            Task<HostContract.HostEnvelope<HostContract.HostStatus>>? host =
                string.IsNullOrWhiteSpace(Cluster.HostCommandUrl) ? null : HostClient.GetStatusAsync(Cluster, cancellationToken);
            var clients = ShowTopology ? GatewayClient.GetClientsAsync(Cluster, cancellationToken) : null;
            var partitions = ShowTopology ? GatewayClient.GetPartitionsAsync(Cluster, cancellationToken) : null;
            Admin.ClusterStatus? nextStatus = null;
            Admin.NodePlan[] nextPlan = [];
            Admin.RecoveryReadiness? nextRecovery = null;
            HostContract.HostStatus? nextHost = null;
            var errors = new List<string>();
            try { _capabilities = (await capabilities).Data; }
            catch (ClusterGatewayException exception)
            {
                _capabilities = null;
                if (!ExpectedOffline(exception)) errors.Add(exception.Message);
            }
            bool gatewayAvailable = _capabilities is not null;
            if (_reportedGatewayAvailability != gatewayAvailable)
            {
                _reportedGatewayAvailability = gatewayAvailable;
                await GatewayAvailabilityChanged.InvokeAsync(gatewayAvailable);
            }
            try
            {
                var response = await status;
                nextStatus = response.Data;
                _observedAt = response.CapturedAt;
            }
            catch (ClusterGatewayException exception)
            {
                if (!ExpectedOffline(exception)) errors.Add(exception.Message);
            }
            try
            {
                nextPlan = (await plan).Data;
            }
            catch (ClusterGatewayException exception)
            {
                if (!ExpectedOffline(exception)) errors.Add(exception.Message);
            }
            try
            {
                nextRecovery = (await recovery).Data;
            }
            catch (ClusterGatewayException exception)
            {
                if (!ExpectedOffline(exception)) errors.Add(exception.Message);
            }
            try
            {
                nextHost = host is null ? null : (await host).Data;
            }
            catch (ClusterHostException exception)
            {
                errors.Add(exception.Message);
            }
            if (clients is not null)
            {
                try { _clients = (await clients).Data; }
                catch (ClusterGatewayException exception) { if (!ExpectedOffline(exception)) errors.Add(exception.Message); }
            }
            if (partitions is not null)
            {
                try { _partitions = (await partitions).Data; }
                catch (ClusterGatewayException exception) { if (!ExpectedOffline(exception)) errors.Add(exception.Message); }
            }
            if (ShowTopology && nextStatus is not null) _fleet = Fleet.Observe(nextStatus);
            _stale = nextStatus is null;
            _status = nextStatus ?? _status;
            _plan = nextPlan;
            _recovery = nextRecovery;
            _host = nextHost;
            _error = errors.Count == 0 ? null : string.Join(" ", errors.Distinct());
        }
        finally
        {
            _loading = false;
        }
    }

    private bool IsCleanlyStopped => Cluster.GoalState == DedicatedServerGoalState.Off
        && Reconciler.GetStatus(Cluster.UniqueName) is { State: ClusterReconcileState.Converged, ClusterPhase: Admin.ClusterPhase.Down };
    private bool RecoveryRequired => Cluster.GoalState == DedicatedServerGoalState.Off
        && Reconciler.GetStatus(Cluster.UniqueName).State == ClusterReconcileState.ConfigurationRequired;
    private bool ExpectedOffline(ClusterGatewayException error) => Cluster.GoalState == DedicatedServerGoalState.Off
        && error.IsConnectivityFailure;
    private string PhaseText => RecoveryRequired ? "Recovery required" : IsCleanlyStopped ? "Stopped" : _stale ? "Unavailable" : _status?.Phase.ToString() ?? "Unavailable";
    private Color PhaseColor => RecoveryRequired ? Color.Error : _stale ? Color.Default : _status?.Health switch
    {
        Admin.AdminHealth.Healthy => Color.Success,
        Admin.AdminHealth.Warning => Color.Warning,
        Admin.AdminHealth.Unhealthy => Color.Error,
        _ => Color.Default,
    };
    private string GatewayText => IsCleanlyStopped ? "Stopped" : _stale || _status is null ? "Unavailable" : "Online";
    private string PlayerText => _stale || _status is null ? "-" : $"{_status.Counts.ConnectedClients} connected";
    private string JoinText => _status?.AcceptingPlayers == true && !_stale
        ? "Accepting players." : "Player entry point is not serving yet.";
    private int ReadyNodes => _plan.Count(item => item.Observed == Admin.NodeObservation.Ready);
    private int WantedNodes => _plan.Count(item => item.Goal == Admin.NodeGoal.Wanted);
    private string CapacityText => _stale || _status is null ? "-" : $"{ReadyNodes}/{WantedNodes} ready";
    private string CapacityDetail => _stale || _status is null ? "Capacity unavailable."
        : $"{_status.Counts.Nodes} registered; {_plan.Count(item => item.FailureAlert)} alerting; "
            + $"{ClusterConversionService.HotSpares(Cluster.Preparation?.SpecificationJson)} hot spare(s) configured.";
    private string WorldAuthorityText => IsCleanlyStopped ? "Stopped" : _stale ? "Unavailable" : _status?.WorldAuthority.Node ?? "Unavailable";
    private string RecoveryText => _recovery?.State switch
    {
        Admin.RecoveryReadinessState.Ready => "Ready to recover",
        Admin.RecoveryReadinessState.AtRisk => "Recovery at risk",
        Admin.RecoveryReadinessState.NotReconstructible => "Complete recovery unavailable",
        _ => "Recovery status unavailable",
    };
    private Color RecoveryColor => _recovery?.State switch
    {
        Admin.RecoveryReadinessState.Ready => Color.Success,
        Admin.RecoveryReadinessState.AtRisk => Color.Warning,
        Admin.RecoveryReadinessState.NotReconstructible => Color.Error,
        _ => Color.Default,
    };
    private string RecoveryDetail => _recovery switch
    {
        null => "Quasar could not check whether the saved world data can be restored after a crash.",
        { State: Admin.RecoveryReadinessState.NotReconstructible } =>
            "The reported saved data cannot currently restore the whole cluster after a crash.",
        { LatestPoint: null } =>
            "No complete recovery point has been reported. Recovery after a crash is not confirmed.",
        { State: Admin.RecoveryReadinessState.AtRisk } =>
            "A recovery point exists, but the Cluster Registry reports risks that could prevent a complete restore after a crash.",
        { State: Admin.RecoveryReadinessState.Ready } =>
            "The Cluster Registry reports a usable recovery point. Progress since the last save may be lost after a crash.",
        _ => "The Cluster Registry has not provided a recognized recovery status.",
    };
    private string HostText => _host is null ? (string.IsNullOrWhiteSpace(Cluster.HostCommandUrl) ? "Not configured (observation only)" : "Unavailable")
        : $"{_host.HostId} · {_host.Attachments.Length} configured {(_host.Attachments.Length == 1 ? "cluster" : "clusters")}";
    private string GatewayExecutorText => _host?.Gateways?.FirstOrDefault(gateway =>
            gateway.ClusterId.Equals(Cluster.UniqueName, StringComparison.OrdinalIgnoreCase)) is { } gateway
        ? $"{gateway.Observed} · PID {gateway.ProcessId?.ToString() ?? "-"} · {gateway.ConfigRevision}"
        : "Not assigned";
    private string ReconcileText
    {
        get
        {
            ClusterReconcileStatus status = Reconciler.GetStatus(Cluster.UniqueName);
            var state = status.State switch
            {
                ClusterReconcileState.Pending => "Waiting for first check",
                ClusterReconcileState.Observing => "Monitoring only",
                ClusterReconcileState.ConfigurationRequired => "Setup needed",
                ClusterReconcileState.Converging => "Applying requested state",
                ClusterReconcileState.Converged => "Requested state reached",
                ClusterReconcileState.Failed => "Needs attention",
                _ => "Unknown",
            };
            return status.ErrorCode is null
                ? $"{state} · {status.Message}"
                : $"{state} · {status.ErrorCode}: {status.Message}";
        }
    }
    private string[]? GatewayOutput => Reconciler.GetStatus(Cluster.UniqueName).GatewayOutput;
    private string RegistryText => _recovery is null ? "-"
        : $"{(_recovery.Registry.SnapshotPresent ? "Saved snapshot available" : "No saved snapshot")} · {_recovery.Registry.WalRecords} logged updates";

    private static string ValueOrDash(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    public async ValueTask DisposeAsync()
    {
        await _shutdown.CancelAsync();
        if (_refreshLoop is not null)
        {
            try
            {
                await _refreshLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }
        _shutdown.Dispose();
    }
}
