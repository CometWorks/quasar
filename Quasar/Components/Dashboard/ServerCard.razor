@inject ServerManagementActions ServerActions
@inject QuasarConfigProfileCatalog ConfigProfiles
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<section class="quasar-panel quasar-fleet-card">
    <header class="quasar-card-heading">
        <div class="quasar-card-title-row">
            <div class="quasar-card-identity">
                <h2 title="@GetDisplayName()">@GetDisplayName()</h2>
                <span class="mono quasar-muted quasar-caption" title="@Server.UniqueName">@Server.UniqueName</span>
            </div>
            <span class="quasar-state-badge quasar-tone-@(GetStatusColor().ToString().ToLowerInvariant())">@GetStatusLabel()</span>
            <button type="button" class="quasar-icon-button" aria-label="More actions for @GetDisplayName()" title="More server actions" popovertarget="@_actionsId"><QuasarIcon Icon="@QuasarIcons.MoreVert" /></button>
            <div id="@_actionsId" popover="auto" class="quasar-server-menu">
                <strong>@GetDisplayName()</strong>
                <AuthorizeView Policy="@QuasarPolicyNames.CanEditServers">
                    <Authorized>
                        <QuasarIconButton ShowLabel="true" ClosePopover="@_actionsId" Label="Clone server" Icon="@QuasarIcons.ContentCopy" OnClick="CloneAsync" />
                        <QuasarIconButton ShowLabel="true" ClosePopover="@_actionsId" Label="Edit server" Icon="@QuasarIcons.Edit" OnClick="EditAsync" />
                        <QuasarIconButton ShowLabel="true" ClosePopover="@_actionsId" Label="Delete server" Class="quasar-text-error" Icon="@QuasarIcons.Delete" Disabled="@IsProcessActive" OnClick="DeleteAsync" />
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@QuasarPolicyNames.CanEditConfigs">
                    <QuasarIconButton ShowLabel="true" ClosePopover="@_actionsId" Label="Create world template" Icon="@QuasarIcons.Public" Disabled="@(!CanCreateTemplate)" OnClick="CreateTemplateAsync" />
                </AuthorizeView>
            </div>
        </div>
        <dl class="quasar-card-facts">
            <div><dt>World</dt><dd title="@GetWorldLabel()">@GetWorldLabel()</dd></div>
            <div><dt>Host</dt><dd title="@GetHostLabel()">@GetHostLabel()</dd></div>
            <div><dt>Connect</dt><dd><button class="quasar-table-link mono" type="button" title="@GetDirectConnectTooltip()" @onclick="CopyDirectConnectAsync">Port @Server.ServerPort <QuasarIcon Icon="@QuasarIcons.ContentCopy" /></button></dd></div>
            <div><dt>Profile</dt><dd>
                @if (CanOpenConfigProfile)
                {
                    <button class="quasar-table-link" type="button" title="Open config profile: @GetConfigProfileName()" @onclick="OpenConfigProfileAsync">@GetConfigProfileName()</button>
                }
                else { <span title="@GetConfigProfileName()">@GetConfigProfileName()</span> }
            </dd></div>
        </dl>
    </header>
    @if (!string.IsNullOrWhiteSpace(Runtime?.LastMessage) || !string.IsNullOrWhiteSpace(Runtime?.HealthSummary) || Runtime?.LastRestart is not null || ShouldShowLatestErrorLine)
    {
        <div class="quasar-card-notices" role="status">
            @if (!string.IsNullOrWhiteSpace(Runtime?.LastMessage)) { <p>@Runtime.LastMessage</p> }
            @if (!string.IsNullOrWhiteSpace(Runtime?.HealthSummary)) { <p>@Runtime.HealthSummary</p> }
            @if (Runtime?.LastRestart is { } lastRestart)
            {
                <p class="quasar-tone-@(GetRestartColor(lastRestart).ToString().ToLowerInvariant())" title="@GetRestartTooltip(lastRestart)">@GetRestartSummary(lastRestart)</p>
            }
            @if (ShouldShowLatestErrorLine)
            {
                <button type="button" class="quasar-table-link quasar-text-error quasar-error-line" title="Open console at latest error lines" @onclick="OpenErrorConsoleAsync">@Runtime!.LatestErrorLogLine</button>
            }
        </div>
    }
    <div class="quasar-card-content">
        <ServerDetailPanel Server="@Server" Runtime="@Runtime" Agent="@Agent" CollapseDetails="true" />
    </div>
    <footer class="quasar-card-actions">
        <button class="quasar-button quasar-card-console" type="button" @onclick="OpenConsoleAsync" aria-label="Open console output"><QuasarIcon Icon="@QuasarIcons.Terminal" />Console</button>
        <div class="quasar-row">
            <AuthorizeView Policy="@QuasarPolicyNames.CanControlServers">
                <Authorized>
                    @if (CanStart)
                    {
                        <button class="quasar-button quasar-tone-success" type="button" disabled="@IsStartDisabled" @onclick="StartAsync"><QuasarIcon Icon="@QuasarIcons.PlayArrow" />Start</button>
                    }
                    @if (CanRestart)
                    {
                        <button class="quasar-button" type="button" @onclick="RestartAsync"><QuasarIcon Icon="@QuasarIcons.RestartAlt" />Restart</button>
                    }
                    @if (CanStop)
                    {
                        <button class="quasar-button quasar-tone-error" type="button" @onclick="StopAsync"><QuasarIcon Icon="@QuasarIcons.Stop" />Stop</button>
                    }
                    @if (CanKillStarting)
                    {
                        <button class="quasar-button quasar-tone-error" type="button" @onclick="KillStartingAsync"><QuasarIcon Icon="@QuasarIcons.StopCircle" />Kill</button>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
    </footer>
</section>

@code
{
    [Parameter, EditorRequired]
    public DedicatedServerDefinition Server { get; set; } = default!;

    [Parameter]
    public DedicatedServerRuntimeSnapshot? Runtime { get; set; }

    [Parameter]
    public AgentRuntimeState? Agent { get; set; }

    [Parameter]
    public bool LaunchBlocked { get; set; }

    [Parameter]
    public EventCallback<string> StartRequested { get; set; }

    [Parameter]
    public EventCallback<string> StopRequested { get; set; }

    [Parameter]
    public EventCallback<string> KillStartingRequested { get; set; }

    [Parameter]
    public EventCallback<string> RestartRequested { get; set; }

    [Parameter]
    public EventCallback<string> ConfigProfileSelected { get; set; }

    private readonly string _actionsId = "card-actions-" + Guid.NewGuid().ToString("N");

    private DedicatedServerProcessState ProcessState => Runtime?.State ?? DedicatedServerProcessState.Stopped;

    private bool IsProcessActive => ProcessState is DedicatedServerProcessState.Starting
        or DedicatedServerProcessState.Running
        or DedicatedServerProcessState.Restarting
        or DedicatedServerProcessState.Stopping;

    private bool CanStart => ProcessState is DedicatedServerProcessState.Stopped
        or DedicatedServerProcessState.Crashed
        or DedicatedServerProcessState.Faulted;

    private bool IsStartDisabled =>
        LaunchBlocked || string.IsNullOrWhiteSpace(Server.WorldSaveName);

    private bool CanStop => ProcessState == DedicatedServerProcessState.Running;

    private bool CanKillStarting => ProcessState is DedicatedServerProcessState.Starting
        or DedicatedServerProcessState.Restarting;

    private bool CanRestart => ProcessState == DedicatedServerProcessState.Running;

    private bool CanCreateTemplate => ServerActions.CanCreateWorldTemplate(Server);

    private bool CanOpenConfigProfile =>
        !string.IsNullOrWhiteSpace(Server.ConfigProfileId) &&
        ConfigProfiles.GetProfile(Server.ConfigProfileId) is not null;

    private bool ShouldShowLatestErrorLine =>
        ProcessState is DedicatedServerProcessState.Crashed or DedicatedServerProcessState.Faulted &&
        !string.IsNullOrWhiteSpace(Runtime?.LatestErrorLogLine);

    private Task StartAsync() => StartRequested.InvokeAsync(Server.UniqueName);

    private Task StopAsync() => StopRequested.InvokeAsync(Server.UniqueName);

    private Task KillStartingAsync() => KillStartingRequested.InvokeAsync(Server.UniqueName);

    private Task RestartAsync() => RestartRequested.InvokeAsync(Server.UniqueName);

    private Task OpenConsoleAsync() => ServerActions.OpenConsoleDialogAsync(Server.UniqueName);

    private Task OpenErrorConsoleAsync() =>
        ServerActions.OpenConsoleDialogAsync(Server.UniqueName, Runtime?.LatestErrorLogKind ?? string.Empty, "errors");

    private Task CloneAsync() => ServerActions.OpenCloneDialogAsync(Server);

    private Task CreateTemplateAsync() => ServerActions.CreateWorldTemplateAsync(Server);

    private Task EditAsync() => ServerActions.OpenEditDialogAsync(Server);

    private Task DeleteAsync() => ServerActions.DeleteAsync(Server.UniqueName);

    private async Task OpenConfigProfileAsync()
    {
        if (!CanOpenConfigProfile)
            return;

        await ConfigProfileSelected.InvokeAsync(Server.ConfigProfileId);
    }

    private async Task CopyDirectConnectAsync()
    {
        var address = GetDirectConnectAddress();
        var ok = await JS.InvokeAsync<bool>("quasarConfigs.copyText", address);
        Snackbar.Add(
            ok ? $"Copied {address} to clipboard." : "Copy failed - select and copy the port manually.",
            ok ? Severity.Info : Severity.Warning);
    }

    private string GetDisplayName()
    {
        if (!string.IsNullOrWhiteSpace(Server.DisplayName))
            return Server.DisplayName.Trim();

        return Agent?.ServerDisplayName ?? Server.UniqueName;
    }

    private string GetHostLabel()
    {
        if (!string.IsNullOrWhiteSpace(Agent?.HostDisplayName) &&
            !string.Equals(Agent.HostDisplayName, "Unknown host", StringComparison.OrdinalIgnoreCase))
        {
            return Agent.HostDisplayName;
        }

        return "Local host";
    }

    private string GetWorldLabel()
    {
        if (!string.IsNullOrWhiteSpace(Agent?.WorldDisplayName) &&
            !string.Equals(Agent.WorldDisplayName, "Unknown world", StringComparison.OrdinalIgnoreCase))
        {
            return Agent.WorldDisplayName;
        }

        if (!string.IsNullOrWhiteSpace(Server.WorldSaveName))
            return Server.WorldSaveName.Trim();

        return "World pending";
    }

    private string GetConfigProfileName()
    {
        if (string.IsNullOrWhiteSpace(Server.ConfigProfileId))
            return "-";

        return ConfigProfiles.GetProfile(Server.ConfigProfileId)?.Name ?? $"Missing: {Server.ConfigProfileId}";
    }

    private string GetDirectConnectTooltip() => $"Copy direct connect address {GetDirectConnectAddress()}";

    private string GetDirectConnectAddress()
    {
        var fallbackHost = Navigation.ToAbsoluteUri(Navigation.BaseUri).Host;
        var host = ResolveDirectConnectHost(Server.ServerIP, fallbackHost);
        if (host.Contains(':', StringComparison.Ordinal) &&
            !host.StartsWith("[", StringComparison.Ordinal) &&
            !host.EndsWith("]", StringComparison.Ordinal))
        {
            host = $"[{host}]";
        }

        return $"{host}:{Server.ServerPort}";
    }

    private static string ResolveDirectConnectHost(string? configuredHost, string fallbackHost)
    {
        var host = configuredHost?.Trim() ?? string.Empty;
        if (IsAnyAddress(host))
            host = fallbackHost?.Trim() ?? string.Empty;

        if (IsAnyAddress(host) || string.IsNullOrWhiteSpace(host))
            return "127.0.0.1";

        return host;
    }

    private static bool IsAnyAddress(string value)
    {
        var normalized = value.Trim().Trim('[', ']');
        return string.IsNullOrWhiteSpace(normalized) ||
               string.Equals(normalized, "0.0.0.0", StringComparison.Ordinal) ||
               string.Equals(normalized, "::", StringComparison.Ordinal) ||
               string.Equals(normalized, "*", StringComparison.Ordinal) ||
               string.Equals(normalized, "+", StringComparison.Ordinal);
    }

    private string GetStatusLabel()
    {
        if (ProcessState == DedicatedServerProcessState.Stopping)
            return "Stopping";

        if (ProcessState == DedicatedServerProcessState.Restarting)
            return "Restarting";

        if (ProcessState == DedicatedServerProcessState.Crashed)
            return "Crashed";

        if (ProcessState == DedicatedServerProcessState.Faulted)
            return "Faulted";

        if (!IsProcessActive)
            return "Stopped";

        if (ProcessState == DedicatedServerProcessState.Running && Agent?.IsConnected == true && Agent.Snapshot is not null)
            return "Running";

        // Process is up but the agent link isn't established yet — e.g. just after a
        // Quasar restart that adopted a running process, or a transient agent drop.
        if (ProcessState == DedicatedServerProcessState.Running)
            return "Connecting";

        return "Starting";
    }

    private Color GetStatusColor()
    {
        if (ProcessState is DedicatedServerProcessState.Crashed or DedicatedServerProcessState.Faulted)
            return Color.Error;

        return GetStatusLabel() switch
        {
            "Running" => Color.Success,
            "Connecting" => Color.Info,
            "Starting" => Color.Warning,
            "Restarting" => Color.Warning,
            "Stopping" => Color.Warning,
            "Stopped" => Color.Default,
            _ => Color.Default,
        };
    }

    private static string GetRestartSummary(DedicatedServerRestartInfo restart)
    {
        var prefix = restart.Outcome switch
        {
            DedicatedServerRestartOutcome.Pending => "Restart pending",
            DedicatedServerRestartOutcome.Failed => "Last restart failed",
            _ => "Last restart recovered",
        };
        return $"{prefix} · {GetRestartCauseLabel(restart.Cause)} · {restart.RequestedAtUtc:yyyy-MM-dd HH:mm:ss} UTC";
    }

    private static string GetRestartTooltip(DedicatedServerRestartInfo restart) =>
        $"{GetRestartSummary(restart)} · {restart.Reason}";

    private static Color GetRestartColor(DedicatedServerRestartInfo restart) => restart.Outcome switch
    {
        DedicatedServerRestartOutcome.Pending => Color.Warning,
        DedicatedServerRestartOutcome.Failed => Color.Error,
        _ => Color.Success,
    };

    private static string GetRestartCauseLabel(DedicatedServerRestartCause cause) => cause switch
    {
        DedicatedServerRestartCause.HealthPolicy => "Health policy",
        DedicatedServerRestartCause.AgentAttachRecovery => "Agent attach recovery",
        DedicatedServerRestartCause.Scheduled => "Scheduled",
        DedicatedServerRestartCause.MaximumUptime => "Maximum uptime",
        DedicatedServerRestartCause.Manual => "Manual",
        DedicatedServerRestartCause.InGame => "In-game",
        DedicatedServerRestartCause.CrashRecovery => "Crash recovery",
        _ => "Unknown",
    };
}
