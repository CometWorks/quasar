@implements IDisposable
@using System.Text.Json
@inject ClusterDeploymentService Deployments
@inject ClusterCatalog Catalog
@inject ClusterBackupService Backups
@inject ClusterUpdateService Updates
@inject ClusterUpdatePreparationService UpdatePreparation
@inject ClusterPackageService Packages
@inject ClusterDependencyService Dependencies
@inject ClusterReleaseMonitor Releases
@inject ManagedDedicatedServerRuntimeResolver Runtime
@inject QuasarPermissionService Permissions
@inject AuthenticationStateProvider AuthenticationState
@inject QuasarRoleMapper RoleMapper
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ILogger<ClusterDeploymentPanel> Logger

<AuthorizeView Policy="@QuasarPolicyNames.ClusterManage">
    <MudCard Class="server-card">
    <MudCardContent>
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">Maintenance</MudText>
        <MudText Class="cluster-long-value">Active revision: @(Current.ActiveDeployment?.Revision ?? "None")</MudText>
        @if (Current.ActiveDeployment is not null && !ClusterReleaseMonitor.IsOnLatestRelease(Current, Releases.GetSnapshot().Release))
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">Release update</MudText>
                <MudText>Latest release: @(Releases.GetSnapshot().Release?.Version ?? "Unknown")</MudText>
                <MudButton OnClick="PrepareLatestUpdateAsync" Disabled="@(_busy || UpdateLocked || Current.Preparation is null)"
                           Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SystemUpdateAlt">Stage latest release</MudButton>
                <MudText Typo="Typo.caption">Quasar selects the release, freezes matching dependencies and prepares every Host executor automatically. The cluster stays online until you apply the pending update.</MudText>
                @if (Current.Preparation is null)
                {
                    <MudText Typo="Typo.caption">Complete guided setup first. For externally provisioned clusters, import their preparation once using Advanced deployment tools.</MudText>
                }
            </MudStack>
        }
        @if (Current.HasPreparedUpdate || Current.QueuedContentUpdates is not null)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Pending update</MudText>
                    @if (Current.HasPreparedUpdate)
                    {
                        <MudText>Deployment prepared on all host machines. Configuration and release changes are ready to apply.</MudText>
                    }
                    @if (Current.QueuedContentUpdates is { } queued)
                    {
                        @foreach (var item in queued.Items)
                        {
                            <MudText Class="cluster-long-value">@item.Name · @item.Kind · @item.TargetVersion</MudText>
                        }
                        <MudAlert Severity="Severity.Warning">Content changes are queued, not downloaded or pinned. Applying this update is blocked until cluster and Magnetar support pinned content preparation.</MudAlert>
                        <MudButton OnClick="ClearQueuedContentAsync" Disabled="@(_busy || UpdateLocked)" Variant="Variant.Outlined" Color="Color.Primary">Remove queued content changes</MudButton>
                    }
                    @if (Current.GoalState == DedicatedServerGoalState.Off && Current.Gateway is not null && Current.ShutdownProof?.LifecycleId != Current.GetLifecycleId())
                    {
                        <MudAlert Severity="Severity.Warning">Recover the stopped cluster after its unclean shutdown before applying an update.</MudAlert>
                    }
                    <MudButton OnClick="StartPreparedUpdateAsync" Color="Color.Primary" Variant="Variant.Filled"
                               Disabled="@(_busy || UpdateLocked || !Current.HasPreparedUpdate || Current.QueuedContentUpdates is not null || Current.GoalState == DedicatedServerGoalState.Off && Current.Gateway is not null && Current.ShutdownProof?.LifecycleId != Current.GetLifecycleId())"
                               StartIcon="@Icons.Material.Filled.SystemUpdateAlt">Apply pending update</MudButton>
                    <MudText Typo="Typo.caption">Applying stops the entire cluster, captures a verified backup for profile changes, activates the staged deployment on every host machine, and restarts it. Plan for full downtime.</MudText>
                </MudStack>
            </MudPaper>
        }
        @if (Current.PendingDeploymentHash is not null || Current.PendingRestoreHash is not null)
        {
            <MudAlert Severity="Severity.Warning">Activation is incomplete. Resume the original activation request before starting the cluster.</MudAlert>
        }
        @if (Current.Update is { } update)
        {
            <MudText>Update @update.Id: @update.Phase</MudText>
            @if (update.BackupRequired)
            {
                <MudText Typo="Typo.caption">Pre-migration backup ID: @update.Id. Keep this backup until the updated cluster has been checked. Restoring it requires a newly prepared deployment with rotated runtime credentials.</MudText>
            }
            @if (update.LastError is not null) { <MudAlert Severity="Severity.Warning">@update.LastError</MudAlert> }
            @if (update.Phase != ClusterUpdatePhase.Complete)
            {
                <MudButton OnClick="AbandonUpdateAsync" Disabled="_busy" Color="Color.Warning" Variant="Variant.Outlined">Abandon update</MudButton>
                <MudText Typo="Typo.caption">Abandoning unlocks the cluster controls without rolling anything back: before activation the cluster stays stopped on its current deployment, afterwards it keeps the new one.</MudText>
            }
        }
        <MudExpansionPanels>
            <MudExpansionPanel Text="Backups">
                <MudStack Spacing="3" Class="py-2 cluster-form-section">
                <MudText Typo="Typo.body2">Backups require a clean stop. Running clusters can store a Cluster Registry world export.</MudText>
                @if (Current.GoalState == DedicatedServerGoalState.Off)
                {
                    <MudButton OnClick="BackupAsync" Disabled="@_busy" Variant="Variant.Outlined" Color="Color.Primary">Back up stopped cluster</MudButton>
                }
                <MudButton OnClick="ListBackups" Disabled="_busy" Variant="Variant.Outlined" Color="Color.Primary">List backups</MudButton>
                @if (_backups is not null) { <pre style="max-height:300px;overflow:auto">@_backups</pre> }
                @if (Current.GoalState == DedicatedServerGoalState.Off && Backups.List(Cluster.UniqueName).Length != 0)
                {
                    <MudSelect T="Guid" @bind-Value="RestoreSnapshotId" Label="Backup to restore" Variant="Variant.Outlined">
                        @foreach (var backup in Backups.List(Cluster.UniqueName))
                        {
                            <MudSelectItem T="Guid" Value="@backup.SnapshotId">@backup.CreatedAt.ToLocalTime() · @backup.SnapshotId</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton OnClick="PrepareRestoreAsync" Disabled="@(_busy || _restoreSnapshotId == Guid.Empty || UpdateLocked)"
                               Variant="Variant.Outlined" Color="Color.Warning">Prepare restore with fresh credentials</MudButton>
                }
                <MudExpansionPanels>
                <MudExpansionPanel Text="Archive Cluster Registry export">
                <MudTextField T="string" Label="Cluster Registry world export artifact ID" @bind-Value="_artifactId" Disabled="_busy" />
                <MudButton OnClick="ArchiveExportAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_artifactId))" Variant="Variant.Outlined" Color="Color.Primary">Verify and store world export</MudButton>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Restore prepared backup">
                <MudTextField T="string" Label="Restore request (JSON)" @bind-Value="_restore" Lines="8" Disabled="_busy" />
                <MudText Typo="Typo.body2">Select a backup above and prepare it to fill this request. Restoring replaces current world and plugin data. The Host executor keeps the previous runtime data for recovery.</MudText>
                <MudButton OnClick="RestoreAsync" Color="Color.Warning" Variant="Variant.Outlined" Disabled="@(_busy || Current.GoalState != DedicatedServerGoalState.Off || string.IsNullOrWhiteSpace(_restore))">Restore backup</MudButton>
                </MudExpansionPanel>
                </MudExpansionPanels>
                </MudStack>
            </MudExpansionPanel>
            @if (Current.GoalState == DedicatedServerGoalState.Off && Current.ActiveDeployment is not null)
            {
            <MudExpansionPanel Text="Recovery">
                <MudStack Spacing="3" Class="py-2 cluster-form-section">
        <MudButton OnClick="RecoverAsync" Disabled="@(_busy || Current.GoalState != DedicatedServerGoalState.Off || Current.ActiveDeployment is null)" Variant="Variant.Outlined" Color="Color.Primary">Recover missing cluster services</MudButton>
        <MudText Typo="Typo.caption">Recovery resumes the recorded cluster services and any pending shutdown. It does not erase world state or mark a dirty shutdown as clean.</MudText>
        <MudButton OnClick="RecoverStoppedAsync" Color="Color.Warning" Variant="Variant.Outlined" Disabled="@(_busy || Current.GoalState != DedicatedServerGoalState.Off || Current.ActiveDeployment is null)">Recover stopped cluster after an unclean shutdown</MudButton>
        <MudText Typo="Typo.caption">Requires every node to be stopped. Starts a new recovery generation from retained saves and plugin data; unsaved game changes may be lost.</MudText>
                </MudStack>
            </MudExpansionPanel>
            }
            <MudExpansionPanel Text="Convert to a standalone server">
                <MudStack Spacing="3" Class="py-2 cluster-form-section">
                    <MudText Typo="Typo.body2">Back up and convert a cleanly stopped cluster into a standalone server.</MudText>
                    <MudButton Href="@("/clusters/" + Uri.EscapeDataString(Cluster.UniqueName) + "/convert-to-server")"
                               Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Dns">Open conversion wizard</MudButton>
                </MudStack>
            </MudExpansionPanel>
            <MudExpansionPanel Text="Advanced deployment tools">
                <MudStack Spacing="3" Class="py-2 cluster-form-section">
                    <MudText Typo="Typo.body2">Normal updates generate these requests automatically. Use these overrides only for custom installation or topology inputs.</MudText>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                        <MudButton OnClick="StageLatestAsync" Disabled="@(_busy || UpdateLocked)" Variant="Variant.Outlined" Color="Color.Primary">Select latest release only</MudButton>
                        <MudButton OnClick="FreezeDependenciesAsync" Disabled="@(_busy || UpdateLocked || Current.PackageSelection is null)" Variant="Variant.Outlined" Color="Color.Primary">Freeze selected dependencies</MudButton>
                        <MudButton OnClick="PrepareSelectedAsync" Disabled="@(_busy || UpdateLocked || Current.DependencyManifestSha256 is null || Current.Preparation is null)" Variant="Variant.Outlined" Color="Color.Primary">Stage selected release</MudButton>
                    </MudStack>
                    <MudDivider />
                    <MudButton OnClick="DownloadPreparationAsync" Disabled="@(_busy || _preparationRequest is null)" Variant="Variant.Outlined" Color="Color.Primary">Download generated preparation</MudButton>
                    <MudText Typo="Typo.caption">Import an edited preparation to override installation or topology. Staging prepares all host machines and generates the activation request.</MudText>
                    <InputFile OnChange="ImportPreparationAsync" accept=".json,application/json" disabled="@(_busy || UpdateLocked)" />
                    <MudButton OnClick="PrepareAsync" Disabled="@(_busy || UpdateLocked || _preparationRequest is null)" Variant="Variant.Outlined" Color="Color.Primary">Stage imported preparation</MudButton>
                    <MudTextField T="string" Label="Generated activation request (JSON override)" @bind-Value="_activation" Lines="8" Disabled="@(_busy || UpdateLocked)" />
                    <MudButton OnClick="UpdateFromJsonAsync" Disabled="@(_busy || UpdateLocked || Current.QueuedContentUpdates is not null || string.IsNullOrWhiteSpace(_activation))" Variant="Variant.Outlined" Color="Color.Primary">Apply JSON override with downtime</MudButton>
                    <MudButton OnClick="ActivateAsync" Disabled="@(_busy || Current.QueuedContentUpdates is not null || Current.GoalState != DedicatedServerGoalState.Off || string.IsNullOrWhiteSpace(_activation))" Variant="Variant.Outlined" Color="Color.Primary">Activate on stopped host machines</MudButton>
                    <MudButton OnClick="RollbackAsync" Disabled="@(_busy || UpdateLocked || Current.QueuedContentUpdates is not null || !CanRollbackWithoutDataRestore)" Variant="Variant.Outlined" Color="Color.Warning">Roll back binaries and configuration</MudButton>
                    <MudText Typo="Typo.caption">Rollback preserves current world and plugin data. The Host executor refuses an older bundle that cannot preserve migrated profile content; restore the pre-migration backup with fresh credentials in that case.</MudText>
                </MudStack>
            </MudExpansionPanel>
        </MudExpansionPanels>
        @if (_message is not null) { <MudAlert Severity="Severity.Info">@_message</MudAlert> }
    </MudStack>
    </MudCardContent>
    </MudCard>
</AuthorizeView>

@code {
    [Parameter, EditorRequired] public ClusterDefinition Cluster { get; set; } = default!;
    private ClusterDefinition Current => Catalog.GetCluster(Cluster.UniqueName) ?? Cluster;
    private string _artifactId = "";
    private ClusterPreparationRequest? _preparationRequest, _savedPreparation;
    private string _activation = "", _restore = "";
    private Guid _restoreSnapshotId;
    private Guid RestoreSnapshotId
    {
        get => _restoreSnapshotId;
        set { if (_restoreSnapshotId != value) _restore = ""; _restoreSnapshotId = value; }
    }
    private string? _backups;
    private string? _message;
    private bool _busy;
    private bool UpdateLocked => Current.PendingDeploymentHash is not null || Current.PendingRestoreHash is not null
        || Current.Update is { Phase: not ClusterUpdatePhase.Complete };
    private bool CanRollbackWithoutDataRestore => Current.PreviousDeployment is not null;
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    protected override void OnInitialized()
    {
        Catalog.Changed += CatalogChanged;
        RefreshSavedPreparation();
    }
    private void CatalogChanged() => _ = InvokeAsync(() => { RefreshSavedPreparation(); StateHasChanged(); });
    private void RefreshSavedPreparation()
    {
        var current = Current;
        if (current.Preparation == _savedPreparation) return;
        _preparationRequest = _savedPreparation = current.Preparation;
        _activation = current.PreparedDeployment is { } prepared ? JsonSerializer.Serialize(prepared, Json) : "";
    }
    public void Dispose() => Catalog.Changed -= CatalogChanged;
    private Task DownloadPreparationAsync()
    {
        if (_preparationRequest is null) return Task.CompletedTask;
        string json = JsonSerializer.Serialize(_preparationRequest, Json);
        string url = "data:application/json;charset=utf-8," + Uri.EscapeDataString(json);
        return JS.InvokeVoidAsync("quasarConfigs.downloadFile", url, $"{Cluster.UniqueName}-preparation.json").AsTask();
    }
    private async Task ImportPreparationAsync(InputFileChangeEventArgs args)
    {
        if (_busy || !await Permissions.IsAuthorizedAsync(QuasarPolicyNames.ClusterManage)) return;
        var user = RoleMapper.RefreshRoles((await AuthenticationState.GetAuthenticationStateAsync()).User);
        if (!user.CanQueryCluster(Cluster.UniqueName)) return;
        _busy = true;
        try
        {
            await using var stream = args.File.OpenReadStream(24 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var request = JsonSerializer.Deserialize<ClusterPreparationRequest>(await reader.ReadToEndAsync(), Json)
                ?? throw new InvalidDataException("Preparation request is empty.");
            if (string.IsNullOrWhiteSpace(request.SpecificationJson) || request.Hosts is null or { Length: 0 })
                throw new InvalidDataException("Preparation request needs a specification and at least one Host.");
            using var specification = JsonDocument.Parse(request.SpecificationJson);
            if (specification.RootElement.ValueKind != JsonValueKind.Object
                || !specification.RootElement.TryGetProperty("clusterId", out var clusterId)
                || clusterId.ValueKind != JsonValueKind.String || clusterId.GetString() != Cluster.UniqueName)
                throw new InvalidDataException("Preparation request identifies a different cluster.");
            _preparationRequest = request;
            _message = "Preparation imported. Select Stage imported preparation to create the pending update.";
        }
        catch (Exception error) when (error is IOException or InvalidDataException or JsonException
            or InvalidOperationException or ArgumentException)
        { _message = error.Message; }
        finally { _busy = false; }
    }
    private void ListBackups() => _backups = JsonSerializer.Serialize(Backups.List(Cluster.UniqueName)
        .Select(b => new { b.SnapshotId, b.CreatedAt, b.Consistency }), Json);
    private Task ArchiveExportAsync() => ExecuteAsync(actor => Backups.ArchiveExportAsync(Cluster.UniqueName,
        _artifactId, Guid.NewGuid().ToString("N"), actor, default));
    private Task BackupAsync() => ExecuteAsync(actor => Backups.CaptureAsync(Cluster.UniqueName,
        new(Guid.NewGuid()), Guid.NewGuid().ToString("N"), actor, default));
    private async Task RestoreAsync()
    {
        if (string.IsNullOrWhiteSpace(_restore)) return;
        if (await DialogService.ShowMessageBoxAsync("Restore cluster backup?",
            "This replaces the stopped cluster's world, plugin data and deployment with the backup identified in the prepared request. Each Host retains its previous runtime data. Continue?",
            yesText: "Restore", cancelText: "Cancel") != true) return;
        await ExecuteAsync(actor => Backups.RestoreAsync(Cluster.UniqueName,
            JsonSerializer.Deserialize<ClusterRestoreRequest>(_restore, Json) ?? throw new InvalidDataException("Restore request is required."),
            Guid.NewGuid().ToString("N"), actor, default));
    }
    private Task PrepareRestoreAsync() => ExecuteAsync(async actor =>
    {
        var result = await Backups.PrepareRestoreAsync(Cluster.UniqueName, _restoreSnapshotId,
            Guid.NewGuid(), Guid.NewGuid().ToString("N"), actor, default);
        if (result.State == ClusterOperationState.Succeeded)
            _restore = JsonSerializer.Serialize(result.Result!.Value.Deserialize<ClusterRestoreRequest>(Json), Json);
        return result;
    });
    private Task PrepareAsync() => ExecuteAsync(async actor =>
    {
        var request = _preparationRequest ?? throw new InvalidDataException("Preparation request is required.");
        var result = await Deployments.PrepareAsync(Cluster.UniqueName, request, Guid.NewGuid().ToString("N"), actor, default);
        if (result.State == ClusterOperationState.Succeeded) _activation = JsonSerializer.Serialize(result.Result, Json);
        return result;
    });
    private Task PrepareLatestUpdateAsync() => ExecuteAsync(async actor =>
    {
        await ShowProgressAsync("Checking and staging the latest cluster release...");
        var release = await Packages.GetReleaseAsync(null, default);
        var prior = Current;
        var changingPackage = prior.PackageSelection?.Version != release.Version || prior.PackageSelection.Sha256 != release.Sha256;
        var reusable = changingPackage && prior.DependencyManifestSha256 is not null
            ? await Dependencies.ReusableSourcesAsync(prior, default) : null;
        if (!await StageLatestCoreAsync(release, reusable)) reusable = null;
        if (Current.DependencyManifestSha256 is null)
        {
            await ShowProgressAsync("Freezing the selected release's runtime dependencies...");
            await FreezeDependenciesCoreAsync(reusable);
        }
        await ShowProgressAsync("Transferring and preparing the selected release on all Hosts...");
        var result = await UpdatePreparation.PrepareAsync(Cluster.UniqueName, actor, default);
        if (result.State == ClusterOperationState.Succeeded) _preparationRequest = Current.Preparation;
        return result;
    });
    private async Task ShowProgressAsync(string message)
    {
        _message = message;
        await InvokeAsync(StateHasChanged);
    }
    private Task StageLatestAsync() => ExecuteAsync<ClusterOperation?>(async _ =>
    {
        await StageLatestCoreAsync();
        return null;
    });
    private async Task<bool> StageLatestCoreAsync(ClusterPackageRelease? latest = null, Dictionary<string, string>? reusable = null)
    {
        var release = latest ?? await Packages.GetReleaseAsync(null, default);
        if (Current.PackageSelection is { } selected && selected.Version == release.Version && selected.Sha256 == release.Sha256)
            return reusable is not null;
        var package = await Packages.StageAsync(new(release.Version, release.Sha256), default);
        string? pinnedSdk = Quasar.ClusterDeployment.ClusterDeploymentFiles.GetPinnedPluginSdkSha256(package.PackagePath);
        bool reuse = reusable is not null && pinnedSdk == Quasar.ClusterDeployment.ClusterDeploymentFiles.Hash(
            await System.IO.File.ReadAllBytesAsync(System.IO.Path.Combine(reusable["Magnetar"], "Libraries/MagnetarInterim/PluginSdk.dll")));
        if (!reuse)
        {
            string installedSdk = System.IO.Path.Combine(Runtime.ResolveInstalledMagnetarInstallDirectory(), "Libraries/MagnetarInterim/PluginSdk.dll");
            string actualSdk = Quasar.ClusterDeployment.ClusterDeploymentFiles.Hash(await System.IO.File.ReadAllBytesAsync(installedSdk));
            if (pinnedSdk != actualSdk)
                throw new InvalidOperationException($"Cluster release {release.Version} pins PluginSdk {pinnedSdk ?? "none"}, but installed Magnetar has {actualSdk}. A matching Magnetar installation or existing dependency snapshot is required.");
        }
        await Catalog.SelectPackageAsync(Cluster.UniqueName, Current.PackageSelection?.Revision ?? 0, package,
            "web-ui-" + Guid.NewGuid().ToString("N"), default);
        return reuse;
    }
    private Task FreezeDependenciesAsync() => ExecuteAsync<ClusterOperation?>(async _ =>
    {
        await FreezeDependenciesCoreAsync();
        return null;
    });
    private async Task FreezeDependenciesCoreAsync(Dictionary<string, string>? sources = null)
    {
        var cluster = Current;
        var candidate = await Dependencies.InspectAsync(cluster, sources, default);
        var request = new ClusterDependencyRequest(candidate.ManifestSha256, cluster.PackageSelection!.Revision, cluster.DependencyManifestSha256);
        await Dependencies.StageAsync(cluster, request, sources, default);
        await Catalog.SelectDependenciesAsync(Cluster.UniqueName, request, default);
    }
    private Task PrepareSelectedAsync() => ExecuteAsync(async actor =>
    {
        var result = await UpdatePreparation.PrepareAsync(Cluster.UniqueName, actor, default);
        if (result.State == ClusterOperationState.Succeeded) _preparationRequest = Current.Preparation;
        return result;
    });
    private Task ClearQueuedContentAsync() => ExecuteAsync(_ => Catalog.ClearQueuedContentUpdatesAsync(Cluster.UniqueName));
    private Task StartPreparedUpdateAsync() => ExecuteAsync(actor => Updates.BeginAsync(Cluster.UniqueName,
        new(Guid.NewGuid(), Current.PreparedDeployment ?? throw new InvalidDataException("Prepare a deployment first.")),
        Guid.NewGuid().ToString("N"), actor, default));
    private Task UpdateFromJsonAsync() => ExecuteAsync(actor => Updates.BeginAsync(Cluster.UniqueName,
        new(Guid.NewGuid(), JsonSerializer.Deserialize<ClusterDeploymentRequest>(_activation, Json)
            ?? throw new InvalidDataException("Activation request is required.")), Guid.NewGuid().ToString("N"), actor, default));
    private Task RollbackAsync() => ExecuteAsync(actor => Updates.BeginAsync(Cluster.UniqueName,
        new(Guid.NewGuid(), Rollback: true), Guid.NewGuid().ToString("N"), actor, default));
    private Task AbandonUpdateAsync() => ExecuteAsync(actor => Updates.AbandonAsync(Cluster.UniqueName, Guid.NewGuid().ToString("N"), actor, default));
    private Task ActivateAsync() => ExecuteAsync(actor => Deployments.ActivateAsync(Cluster.UniqueName,
        JsonSerializer.Deserialize<ClusterDeploymentRequest>(_activation, Json) ?? throw new InvalidDataException("Activation request is required."),
        Guid.NewGuid().ToString("N"), actor, default));
    private Task RecoverStoppedAsync() => ExecuteAsync(actor => Deployments.RecoverClusterAsync(Cluster.UniqueName,
        Guid.NewGuid(), Guid.NewGuid().ToString("N"), actor, default));
    private Task RecoverAsync() => ExecuteAsync(actor => Deployments.RecoverGatewayAsync(Cluster.UniqueName,
        Guid.NewGuid().ToString("N"), actor, default));
    private async Task ExecuteAsync<T>(Func<string, Task<T>> run)
    {
        if (_busy || !await Permissions.IsAuthorizedAsync(QuasarPolicyNames.ClusterManage)) return;
        var user = RoleMapper.RefreshRoles((await AuthenticationState.GetAuthenticationStateAsync()).User);
        if (!user.CanQueryCluster(Cluster.UniqueName)) return;
        _busy = true;
        try
        {
            var result = await run(user.Identity?.Name ?? "web-ui");
            _message = result is ClusterOperation operation
                ? operation.State == ClusterOperationState.Succeeded ? "Completed. Review the pending update or current operation above." : $"{operation.State}: {operation.Error?.Message ?? operation.OperationId}"
                : "Step completed. Continue with the next update step.";
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Cluster {Cluster} page action failed.", Cluster.UniqueName);
            _message = error.Message;
        }
        finally { _busy = false; }
    }
}
