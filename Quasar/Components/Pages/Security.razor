@page "/settings/security"
@attribute [Authorize(Policy = QuasarPolicyNames.CanManageSecurity)]
@implements IDisposable
@inject QuasarAuthOptions AuthOptions
@inject QuasarAuthSettingsService AuthSettingsService
@inject DataHandlingConsentCatalog DataHandlingConsent
@inject RbacConfigCatalog RbacConfigCatalog
@inject QuasarPermissionService Permissions
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Security</PageTitle>

<QuasarPageHeading Section="Access & security">
    <Title>Security</Title>
    <Description>Manage trusted-network access, reverse proxy settings, and SteamID-based RBAC mappings.</Description>
</QuasarPageHeading>

<section class="quasar-panel pa-4 mb-4">
    <h2 class="quasar-text quasar-type-h6">Public panel access</h2>
    <p>Use your own reverse proxy, or enroll with Nebula for a public dashboard address.</p>
    <MudButton OnClick="ManageAccessAsync" Variant="Variant.Outlined">Manage access setup</MudButton>
</section>

<MudGrid>
    <MudItem xs="12" lg="4">
        <section class="quasar-panel pa-4 summary-card">
            <div class="quasar-layout quasar-gap-2">
                <h2 class="quasar-text quasar-type-h6">Auth Provider</h2>
                <p class="quasar-text quasar-type-body2">Default provider: <strong>@AuthOptions.DefaultProvider</strong></p>
                <p class="quasar-text quasar-type-body2">Steam login: <strong>@(AuthOptions.Steam.Enabled ? "Enabled" : "Disabled")</strong></p>
                <p class="quasar-text quasar-type-body2">Access mode: <strong>@(_trustedNetworkSettings.RequireHttpsForPublicAccess ? "Public HTTPS" : "Private LAN HTTP")</strong></p>
                <p class="quasar-text quasar-type-body2">Trusted loopback: <strong>@(_trustedNetworkSettings.AllowLoopback ? "Enabled" : "Disabled")</strong></p>
                <p class="quasar-text quasar-type-body2">Trusted same subnet: <strong>@(_trustedNetworkSettings.AllowSameSubnet ? "Enabled" : "Disabled")</strong></p>
                <p class="quasar-text quasar-type-body2">Trusted proxies: <strong>@TrustedProxySummary</strong></p>
                <span class="quasar-text quasar-type-caption">
                    Settings are saved to <CopyablePath Value="@AuthSettingsService.SettingsPath" Inline="true" TextClass="" />
                </span>
            </div>
        </section>
    </MudItem>

    <MudItem xs="12" lg="8">
        <section class="quasar-panel pa-4">
            <div class="quasar-layout quasar-gap-3">
                <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-justify-spacebetween quasar-gap-3">
                    <h2 class="quasar-text quasar-type-h6">Private LAN and Reverse Proxy</h2>
                    <MudChip T="string"
                             Color="@(_trustedNetworkSettings.RequireHttpsForPublicAccess ? Color.Success : Color.Warning)"
                             Variant="Variant.Outlined">
                        @(_trustedNetworkSettings.RequireHttpsForPublicAccess ? "Public HTTPS mode" : "Private LAN HTTP mode")
                    </MudChip>
                </div>

                @if (!_trustedNetworkSettings.RequireHttpsForPublicAccess)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        Private LAN mode permits plain HTTP and non-Secure cookies. Keep the Quasar port behind your firewall and do not forward it from the router.
                    </MudAlert>
                }

                @if (_trustedNetworkSettings.AllowSameSubnet)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        Direct same-subnet clients bypass HTTPS and sign-in even in public HTTPS mode. Keep the Quasar backend port private when using a reverse proxy.
                    </MudAlert>
                }

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudCheckBox T="bool"
                                     @bind-Value="_trustedNetworkSettings.AllowLoopback"
                                     Label="Trust loopback access" />
                        <span class="quasar-text quasar-type-caption quasar-tone-@((Color.Secondary).ToString().ToLowerInvariant())">
                            Allows local tools and same-host reverse proxies to use trusted-network auth.
                        </span>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCheckBox T="bool"
                                     @bind-Value="_trustedNetworkSettings.AllowSameSubnet"
                                     Label="Trust same subnet access" />
                        <span class="quasar-text quasar-type-caption quasar-tone-@((Color.Secondary).ToString().ToLowerInvariant())">
                            Direct LAN clients remain trusted; correctly forwarded public clients still use HTTPS and sign in.
                        </span>
                    </MudItem>
                    <MudItem xs="12">
                        <MudCheckBox T="bool"
                                     @bind-Value="_trustedNetworkSettings.RequireHttpsForPublicAccess"
                                     Label="Require HTTPS for non-LAN access" />
                        <span class="quasar-text quasar-type-caption quasar-tone-@((Color.Secondary).ToString().ToLowerInvariant())">
                            Enable this for a public reverse proxy. It rejects remote HTTP and marks authentication cookies Secure after Quasar restarts.
                        </span>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_trustedProxiesText"
                                      Label="Trusted reverse proxies"
                                      Variant="Variant.Outlined"
                                      Lines="4"
                                      HelperText="One IP or CIDR per line, comma, or space. Example: 172.18.0.0/16 or 192.168.1.10." />
                    </MudItem>
                </MudGrid>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Restart Quasar after changing HTTPS mode or trusted proxies. Loopback and same-subnet toggles apply immediately.
                </MudAlert>

                <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-gap-2">
                    <MudButton StartIcon="@Icons.Material.Filled.Save"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@_savingAuthSettings"
                               OnClick="SaveTrustedNetworkSettingsAsync">
                        Save Security Settings
                    </MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Security"
                               Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               OnClick="ApplyPublicReverseProxyPreset">
                        Apply Public Proxy Preset
                    </MudButton>
                </div>

                <MudExpansionPanels MultiExpansion="false" Elevation="0" Outlined="true" Dense="true">
                    <MudExpansionPanel Text="Safely expose Quasar to the internet">
                        <ol>
                            <li>Put Quasar behind a reverse proxy with HTTPS enabled, such as NGINX Proxy Manager.</li>
                            <li>Keep the Quasar port private. Do not forward the Quasar port directly from the router.</li>
                            <li>Click <strong>Apply Public Proxy Preset</strong> so non-LAN HTTPS is required while direct LAN access stays trusted.</li>
                            <li>If the proxy is not on the same machine, add its IP address or Docker bridge CIDR to Trusted reverse proxies.</li>
                            <li>Make sure the proxy sends <code>X-Forwarded-For</code>, <code>X-Forwarded-Proto</code>, and <code>X-Forwarded-Host</code>.</li>
                            <li>Restart Quasar after changing trusted proxies, then test from a phone or other external network. You should see the Steam sign-in flow.</li>
                        </ol>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </div>
        </section>
    </MudItem>

    <MudItem xs="12">
        <section class="quasar-panel pa-4">
            <div class="quasar-layout quasar-gap-3">
                <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-justify-spacebetween quasar-gap-3">
                    <h2 class="quasar-text quasar-type-h6">Data Handling Consent</h2>
                    <MudChip T="string" Color="@DataHandlingConsentStatusColor" Variant="Variant.Outlined">
                        @DataHandlingConsentStatusText
                    </MudChip>
                </div>

                <p class="quasar-text quasar-type-body2">
                    YES automatically enrolls this Quasar instance with https://log.se-servers.net and allows anonymous plugin usage statistics and diagnostic reports to CometWorks, including error details, bounded recent logs, software versions and execution context. Logs may contain private player or server information. Memory dumps require separate consent and are not enabled by YES. While YES and diagnostic reports remain enabled, Quasar also checks CometWorks announcements for the notification bell and Notifications page, or service logs in headless mode.
                </p>
                <p class="quasar-text quasar-type-body2">
                    Server listings require consent and working log delivery. Explicitly enabled listings publish their name, join address and summary statistics; admin Steam identities are shared privately for description editing. NO cancels publishing and requests immediate withdrawal. If backoffice updates stop, its last signed publication lease expires within 60 seconds. Magnetar's statistics flag changes on the next server start.
                </p>
                <span class="quasar-text quasar-type-caption quasar-tone-@((Color.Secondary).ToString().ToLowerInvariant())">
                    Stored at <CopyablePath Value="@DataHandlingConsent.SettingsPath" Inline="true" TextClass="" />.
                </span>

                <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-gap-2">
                    <MudButton StartIcon="@Icons.Material.Filled.Check"
                               Variant="@(DataHandlingConsentChoice == true ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               OnClick="@(() => SaveDataHandlingConsentAsync(true))">
                        YES
                    </MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Close"
                               Variant="@(DataHandlingConsentChoice == false ? Variant.Filled : Variant.Outlined)"
                               Color="@(DataHandlingConsentChoice == false ? Color.Warning : Color.Default)"
                               OnClick="@(() => SaveDataHandlingConsentAsync(false))">
                        NO
                    </MudButton>
                </div>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Running servers keep their current Magnetar consent state until they are restarted.
                </MudAlert>
                <hr class="quasar-divider" />
                <h3 class="quasar-text quasar-type-subtitle1">Diagnostic reports</h3>
                <p class="quasar-text quasar-type-body2">
                    Allow encrypted diagnostic reports and batched application logs from Quasar and all its enrolled hosts to be sent to CometWorks?
                    Reports include ordinary log messages, error details, bounded recent logs, software versions and host, cluster and server identifiers.
                    Logs can contain player names, chat or other private data. Reports are retained locally for up to seven days while delivery is unavailable.
                    Only incidents captured after enabling this choice are eligible.
                </p>
                <MudSwitch T="bool" Value="@DataHandlingConsent.GetSettings().DiagnosticsGranted"
                           ValueChanged="@(value => SaveDiagnosticsConsentAsync(value, DataHandlingConsent.GetSettings().DumpsGranted))"
                           Color="Color.Primary" Label="Send diagnostic reports" />
                <p class="quasar-text quasar-type-body2">
                    Crash dumps may include process memory, credentials, player data and world content. Enable only if you agree to share that sensitive content.
                    Dumps require diagnostic reports and are encrypted for the backoffice before transfer.
                </p>
                <MudSwitch T="bool" Value="@DataHandlingConsent.GetSettings().DumpsGranted"
                           ValueChanged="@(value => SaveDiagnosticsConsentAsync(DataHandlingConsent.GetSettings().DiagnosticsGranted, value))"
                           Disabled="@(!DataHandlingConsent.GetSettings().DiagnosticsGranted)"
                           Color="Color.Warning" Label="Include crash dumps" />
                <hr class="quasar-divider" />
                <MudSwitch T="bool" Value="@DataHandlingConsent.GetSettings().ListingGranted"
                           ValueChanged="@SaveListingVisibilityAsync"
                           Color="Color.Primary" Label="Show configured servers on se-servers.net" />
                <p class="quasar-text quasar-type-body2">
                    Listing visibility is optional and separate from diagnostic reporting. Public listings require current
                    log delivery to CometWorks and a configured public join address. Turning this off withdraws the listings.
                </p>
                <MudLink Href="settings/server-list">Configure public server listings</MudLink>
                <span class="quasar-text quasar-type-caption quasar-tone-@((Color.Secondary).ToString().ToLowerInvariant())">
                    Turning either choice off cancels active transfers and discards queued reports. Already delivered reports cannot be recalled.
                    Offline hosts stop collecting when their two-minute consent lease expires.
                </span>
            </div>
        </section>
    </MudItem>

    <MudItem xs="12">
        <section class="quasar-panel pa-4">
            <div class="quasar-layout quasar-gap-3">
                <div class="quasar-layout quasar-layout-row quasar-align-center quasar-justify-spacebetween quasar-gap-3">
                    <h2 class="quasar-text quasar-type-h6">Runtime Subject Role Mappings</h2>
                    <MudChip T="string" Variant="Variant.Outlined">@_config.SubjectRoleMappings.Count mapping(s)</MudChip>
                </div>

                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" @bind-Value="_newProvider" Label="Provider" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@QuasarAuthSchemes.Steam">Steam</MudSelectItem>
                            <MudSelectItem T="string" Value="@OidcProviderName">Oidc</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudTextField @bind-Value="_newSubject"
                                      Label="@(_newProvider == QuasarAuthSchemes.Steam ? "SteamID" : "Subject")"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" @bind-Value="_newRole" Label="Role" Variant="Variant.Outlined">
                            @foreach (var role in QuasarRoles.All.OrderBy(role => role, StringComparer.OrdinalIgnoreCase))
                            {
                                <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="1" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Primary"
                                       Disabled="@(!CanAddMapping)"
                                       OnClick="AddMappingAsync" />
                    </MudItem>
                </MudGrid>

                @if (_config.SubjectRoleMappings.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Runtime RBAC has no subject mappings yet.
                    </MudAlert>
                }
                else
                {
                    <MudTable T="SubjectRoleMapping" Items="_config.SubjectRoleMappings" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Provider</MudTh>
                            <MudTh>Roles</MudTh>
                            <MudTh>Subject</MudTh>
                            <MudTh Class="quasar-actions-column"><span class="quasar-visually-hidden">Actions</span></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Provider">@context.Provider</MudTd>
                            <MudTd DataLabel="Roles">@string.Join(", ", context.Roles)</MudTd>
                            <MudTd DataLabel="Subject" Class="mono">@context.Subject</MudTd>
                            <MudTd DataLabel="" Class="quasar-actions-column">
                                <MudTooltip Text="Remove role mapping">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveMappingAsync(context))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </div>
        </section>
    </MudItem>
</MudGrid>

@code
{
    private Task<IDialogReference> ManageAccessAsync() => DialogService.ShowAsync<AccessSetupDialog>("Set up administrator access",
        new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, FullWidth = true, MaxWidth = MaxWidth.Small });

    private RbacConfig _config = new();
    private const string OidcProviderName = "Oidc";
    private QuasarTrustedNetworkSettings _trustedNetworkSettings = new();
    private string _trustedProxiesText = string.Empty;
    private bool _savingAuthSettings;
    private string _newProvider = QuasarAuthSchemes.Steam;
    private string _newSubject = string.Empty;
    private string _newRole = QuasarRoles.Viewer;

    private bool? DataHandlingConsentChoice
    {
        get
        {
            var settings = DataHandlingConsent.GetSettings();
            return settings.ConsentGranted == true && !settings.DiagnosticsGranted ? null : settings.ConsentGranted;
        }
    }

    private string DataHandlingConsentStatusText => DataHandlingConsentChoice switch
    {
        true => "YES",
        false => "NO",
        _ => DataHandlingConsent.GetSettings().ConsentGranted == true ? "Logging consent required" : "No choice stored",
    };

    private Color DataHandlingConsentStatusColor => DataHandlingConsentChoice switch
    {
        true => Color.Success,
        false => Color.Warning,
        _ => Color.Default,
    };

    private string TrustedProxySummary =>
        _trustedNetworkSettings.TrustedProxies.Count == 0
            ? "Loopback only"
            : string.Join(", ", _trustedNetworkSettings.TrustedProxies);

    private bool CanAddMapping =>
        !string.IsNullOrWhiteSpace(_newSubject) &&
        QuasarRoles.All.Contains(_newRole);

    protected override void OnInitialized()
    {
        Reload();
        ReloadTrustedNetworkSettings();
        RbacConfigCatalog.Changed += HandleRbacChanged;
        DataHandlingConsent.Changed += HandleDataHandlingConsentChanged;
    }

    public void Dispose()
    {
        RbacConfigCatalog.Changed -= HandleRbacChanged;
        DataHandlingConsent.Changed -= HandleDataHandlingConsentChanged;
    }

    private void HandleRbacChanged()
    {
        _ = InvokeAsync(() =>
        {
            Reload();
            StateHasChanged();
        });
    }

    private void HandleDataHandlingConsentChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void Reload()
    {
        _config = RbacConfigCatalog.GetConfig();
    }

    private void ReloadTrustedNetworkSettings()
    {
        _trustedNetworkSettings = AuthSettingsService.GetTrustedNetworkSettings();
        _trustedProxiesText = FormatTrustedProxies(_trustedNetworkSettings.TrustedProxies);
    }

    private void ApplyPublicReverseProxyPreset()
    {
        _trustedNetworkSettings.AllowLoopback = true;
        _trustedNetworkSettings.AllowSameSubnet = true;
        _trustedNetworkSettings.RequireHttpsForPublicAccess = true;
        Snackbar.Add("Public reverse proxy preset applied. Save to persist it.", Severity.Info);
    }

    private async Task SaveTrustedNetworkSettingsAsync()
    {
        if (!await EnsureAuthorizedAsync())
            return;

        _savingAuthSettings = true;
        try
        {
            _trustedNetworkSettings.TrustedProxies = QuasarAuthSettingsService.ParseTrustedProxiesText(_trustedProxiesText);
            await AuthSettingsService.SaveTrustedNetworkSettingsAsync(_trustedNetworkSettings);
            ReloadTrustedNetworkSettings();
            Snackbar.Add("Security settings saved.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed saving security settings: {exception.Message}", Severity.Error);
        }
        finally
        {
            _savingAuthSettings = false;
        }
    }

    private async Task SaveDiagnosticsConsentAsync(bool diagnostics, bool dumps)
    {
        if (!await EnsureAuthorizedAsync()) return;
        try
        {
            await DataHandlingConsent.SaveAsync(DataHandlingConsent.GetSettings().ConsentGranted, diagnostics, dumps);
            Snackbar.Add("Diagnostic consent saved.", Severity.Success);
        }
        catch (Exception exception) { Snackbar.Add($"Failed saving diagnostic consent: {exception.Message}", Severity.Error); }
    }

    private async Task SaveListingVisibilityAsync(bool visible)
    {
        if (!await EnsureAuthorizedAsync()) return;
        try
        {
            await DataHandlingConsent.SaveListingVisibilityAsync(visible);
            Snackbar.Add("Listing visibility saved.", Severity.Success);
        }
        catch (Exception exception) { Snackbar.Add($"Failed saving listing visibility: {exception.Message}", Severity.Error); }
    }

    private async Task SaveDataHandlingConsentAsync(bool consentGranted)
    {
        if (!await EnsureAuthorizedAsync())
            return;

        try
        {
            await DataHandlingConsent.SaveAsync(consentGranted, consentGranted, false);
            Snackbar.Add(consentGranted ? "Data handling consent saved: YES." : "Data handling consent saved: NO.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed saving data handling consent: {exception.Message}", Severity.Error);
        }
    }

    private async Task AddMappingAsync()
    {
        _config.SubjectRoleMappings.Add(new SubjectRoleMapping
        {
            Provider = _newProvider,
            Subject = _newSubject.Trim(),
            Roles = [_newRole],
        });

        await SaveAsync("Added RBAC mapping.");
        _newSubject = string.Empty;
        _newRole = QuasarRoles.Viewer;
    }

    private async Task RemoveMappingAsync(SubjectRoleMapping mapping)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove RBAC mapping?",
            $"Mapping for '{mapping.Subject}' will be removed. The subject loses any roles granted by it.",
            yesText: "Remove",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        _config.SubjectRoleMappings.Remove(mapping);
        await SaveAsync("Removed RBAC mapping.");
    }

    private async Task SaveAsync(string message)
    {
        if (!await EnsureAuthorizedAsync())
        {
            Reload();
            return;
        }

        try
        {
            await RbacConfigCatalog.SaveAsync(_config);
            _config = RbacConfigCatalog.GetConfig();
            Snackbar.Add(message, Severity.Success);
        }
        catch (Exception exception)
        {
            Reload();
            Snackbar.Add($"Failed saving RBAC settings: {exception.Message}", Severity.Error);
        }
    }

    private async Task<bool> EnsureAuthorizedAsync()
    {
        if (await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanManageSecurity))
            return true;

        Snackbar.Add("Access denied: administrator permission is required.", Severity.Error);
        return false;
    }

    private static string FormatTrustedProxies(IEnumerable<string> proxies) =>
        string.Join(Environment.NewLine, proxies);
}
