@implements IDisposable
@using Admin = CometWorks.ClusterGateway.AdminContract.V1
@inject DedicatedServerCatalog ServerCatalog
@inject DedicatedServerSupervisor Supervisor
@inject ClusterCatalog ClusterCatalog
@inject ClusterCommandService ClusterCommands
@inject ClusterGatewayClient ClusterGatewayClient
@inject AgentRegistry Registry
@inject QuasarConfigProfileCatalog ConfigProfiles
@inject QuasarWorldTemplateCatalog WorldTemplates
@inject IDialogService DialogService
@inject ServerManagementActions ServerActions
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (!Embedded)
{
    <PageTitle>Servers</PageTitle>
}

@if (!HideHeader)
{
    <MudText Typo="Typo.h5" Class="mb-2">Servers</MudText>
    <MudText Typo="Typo.body2">Persistent standalone servers and clusters. Ordinary server controls stay here; cluster rows expose the Gateway, World Authority, node capacity, and recovery state as one managed server.</MudText>
}

<MudPaper Class="pa-4 server-card mt-2">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="mb-4">
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
            <MudChip T="string" Variant="Variant.Outlined">@($"{ManagedServers.Count} server(s)")</MudChip>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">
                Create Server
            </MudButton>
        </MudStack>
    </MudStack>

    @if (ManagedServers.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            No servers defined yet.
        </MudAlert>
    }
    else
    {
        <MudTable T="ManagedServerRow" Dense="true" Hover="true" Breakpoint="@ServerTableBreakpoint" Items="ManagedServers" Class="servers-list-table">
            <HeaderContent>
                <MudTh></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ManagedServerRow, object>(x => x.Kind)">Type</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ManagedServerRow, object>(GetManagedStateText)">Status</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ManagedServerRow, object>(x => x.UniqueName)">Unique name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ManagedServerRow, object>(GetEndpointSortValue)">Endpoint</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ManagedServerRow, object>(x => GetConfigProfileName(x.ConfigProfileId))">Config</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ManagedServerRow, object>(GetManagedPlayerSortValue)">Players</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ManagedServerRow, object>(GetManagedProcessSortValue)">Process</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ManagedServerRow, object>(GetManagedAttachmentStatus)">Agent / WA</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ManagedServerRow, object>(x => x.DisplayName)">Name</MudTableSortLabel></MudTh>
                <MudTh Class="quasar-actions-column"><span class="quasar-visually-hidden">Actions</span></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudTooltip Text="Show live data">
                        <MudIconButton Size="Size.Small"
                                       Icon="@(IsExpanded(context.UniqueName) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       OnClick="@(() => ToggleExpanded(context.UniqueName))" />
                    </MudTooltip>
                </MudTd>
                @if (context.Server is { } server)
                {
                    <MudTd DataLabel="Type">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Standalone</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@GetStateColor(server.UniqueName)" Variant="Variant.Outlined">
                            @GetStateText(server.UniqueName)
                        </MudChip>
                        @if (GetRuntime(server.UniqueName)?.LastRestart is { } lastRestart)
                        {
                            <MudTooltip Text="@GetRestartTooltip(lastRestart)">
                                <MudText Typo="Typo.caption"
                                         Color="@GetRestartColor(lastRestart)"
                                         Style="display:block;max-width:18rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    @GetRestartSummary(lastRestart)
                                </MudText>
                            </MudTooltip>
                        }
                        @if (ShouldShowLatestErrorLine(server.UniqueName))
                        {
                            <MudTooltip Text="Open console at latest error lines">
                                <MudLink Typo="Typo.caption" Color="Color.Error" Underline="Underline.Hover"
                                         Style="display:block;max-width:18rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
                                         @onclick="@(() => OpenErrorConsoleDialogAsync(server.UniqueName))">
                                    @GetRuntime(server.UniqueName)!.LatestErrorLogLine
                                </MudLink>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Unique name" Class="mono">@server.UniqueName</MudTd>
                    <MudTd DataLabel="Endpoint" Class="mono">
                        <MudTooltip Text="@GetDirectConnectTooltip(server)">
                            <MudLink Typo="Typo.body2" Color="Color.Primary" Underline="Underline.Hover"
                                     @onclick="@(() => CopyDirectConnectAsync(server))">
                                @server.ServerPort
                            </MudLink>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Config">
                        @if (CanOpenConfigProfile(server.ConfigProfileId))
                        {
                            <MudLink Typo="Typo.body2" Color="Color.Primary" Underline="Underline.Hover"
                                     @onclick="@(() => OpenConfigProfileAsync(server.ConfigProfileId))">
                                @GetConfigProfileName(server.ConfigProfileId)
                            </MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@GetConfigProfileName(server.ConfigProfileId)</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Players">@GetPlayerCount(server.UniqueName)</MudTd>
                    <MudTd DataLabel="Process" Class="mono">@GetProcessDisplay(server.UniqueName)</MudTd>
                    <MudTd DataLabel="Agent / WA">@GetAttachmentStatus(server.UniqueName)</MudTd>
                    <MudTd DataLabel="Name"><MudText Typo="Typo.body2">@GetDisplayName(server)</MudText></MudTd>
                    <MudTd DataLabel="" Class="quasar-actions-column">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                            @if (CanStartServer(server.UniqueName))
                            {
                                <MudTooltip Text="@GetStartTooltip(server)">
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Size="Size.Small" Disabled="@IsStartDisabled(server)" OnClick="@(() => StartAsync(server.UniqueName))" />
                                </MudTooltip>
                            }
                            @if (CanStopServer(server.UniqueName))
                            {
                                <MudTooltip Text="Stop server"><MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Error" Size="Size.Small" OnClick="@(() => StopAsync(server.UniqueName))" /></MudTooltip>
                            }
                            @if (CanKillStartingServer(server.UniqueName))
                            {
                                <MudTooltip Text="Kill starting server"><MudIconButton Icon="@Icons.Material.Filled.StopCircle" Color="Color.Error" Size="Size.Small" OnClick="@(() => KillStartingAsync(server.UniqueName))" /></MudTooltip>
                            }
                            @if (CanRestartServer(server.UniqueName))
                            {
                                <MudTooltip Text="Restart server"><MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Color="Color.Primary" Size="Size.Small" OnClick="@(() => RestartAsync(server.UniqueName))" /></MudTooltip>
                            }
                            <MudTooltip Text="Show console output"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Terminal" Color="Color.Default" OnClick="@(() => OpenConsoleDialogAsync(server.UniqueName))" /></MudTooltip>
                            <MudTooltip Text="Clone server"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Default" OnClick="@(() => OpenCloneDialogAsync(server))" /></MudTooltip>
                            <MudTooltip Text="Create world template"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Public" Color="Color.Default" Disabled="@(!CanCreateWorldTemplate(server))" OnClick="@(() => CreateWorldTemplateAsync(server))" /></MudTooltip>
                            <MudTooltip Text="Edit server"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Default" OnClick="@(() => OpenEditDialogAsync(server))" /></MudTooltip>
                            <MudTooltip Text="Delete server"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAsync(server.UniqueName))" /></MudTooltip>
                        </MudStack>
                    </MudTd>
                }
                else if (context.Cluster is { } cluster)
                {
                    <MudTd DataLabel="Type">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Cluster</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudTooltip Text="@GetClusterError(cluster.UniqueName)">
                            <MudChip T="string" Color="@GetClusterStateColor(cluster.UniqueName)" Variant="Variant.Outlined">
                                @GetClusterStateText(cluster.UniqueName)
                            </MudChip>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Unique name" Class="mono">@cluster.UniqueName</MudTd>
                    <MudTd DataLabel="Endpoint" Class="mono">@GetGatewayEndpoint(cluster)</MudTd>
                    <MudTd DataLabel="Config">
                        @if (CanOpenConfigProfile(cluster.ConfigProfileId))
                        {
                            <MudLink Typo="Typo.body2" Color="Color.Primary" Underline="Underline.Hover"
                                     @onclick="@(() => OpenConfigProfileAsync(cluster.ConfigProfileId))">
                                @GetConfigProfileName(cluster.ConfigProfileId)
                            </MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@GetConfigProfileName(cluster.ConfigProfileId)</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Players">@GetClusterPlayerCount(cluster.UniqueName)</MudTd>
                    <MudTd DataLabel="Process">@GetClusterCapacity(cluster.UniqueName)</MudTd>
                    <MudTd DataLabel="Agent / WA">@GetClusterWorldAuthority(cluster.UniqueName)</MudTd>
                    <MudTd DataLabel="Name">
                        <MudLink Href="@ClusterHref(cluster.UniqueName)" Typo="Typo.body2"
                                 Color="Color.Primary" Underline="Underline.Hover">@cluster.DisplayName</MudLink>
                    </MudTd>
                    <MudTd DataLabel="" Class="quasar-actions-column">
                        @if (cluster.GoalState == DedicatedServerGoalState.Off)
                        {
                            <MudTooltip Text="Start cluster">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.PlayArrow"
                                               Color="Color.Success" OnClick="@(() => StartClusterAsync(cluster.UniqueName))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Gracefully stop cluster">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Stop"
                                               Color="Color.Error" OnClick="@(() => StopClusterAsync(cluster.UniqueName))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Open cluster details">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.OpenInNew"
                                           Color="Color.Primary" OnClick="@(() => OpenCluster(cluster.UniqueName))" />
                        </MudTooltip>
                    </MudTd>
                }
            </RowTemplate>
            <ChildRowContent>
                @if (IsExpanded(context.UniqueName))
                {
                    <MudTr Class="servers-list-detail-row">
                        <td colspan="11" style="padding: 0.75rem 1rem; background: var(--mud-palette-background);">
                            @if (context.Server is { } server)
                            {
                                <ServerDetailPanel Server="@server" Runtime="@GetRuntime(server.UniqueName)" Agent="@GetAgent(server.UniqueName)" />
                            }
                            else if (context.Cluster is { } cluster)
                            {
                                <ClusterDetailPanel Cluster="@cluster" />
                            }
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
        </MudTable>
    }
</MudPaper>

@if (UnmanagedAgents.Count > 0)
{
    <MudPaper Class="pa-4 server-card mt-4">
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="mb-3">
            <div>
                <MudText Typo="Typo.h6">Unmanaged Agents</MudText>
                <MudText Typo="Typo.body2">Quasar.Agent processes reporting in without a matching server definition.</MudText>
            </div>
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning">@($"{UnmanagedAgents.Count} unmanaged")</MudChip>
        </MudStack>

        @foreach (var agent in UnmanagedAgents)
        {
            <MudExpansionPanel Text="@($"{agent.ServerDisplayName} · {agent.UniqueNameKey}")" Dense="true">
                <ServerDetailPanel Agent="@agent" />
            </MudExpansionPanel>
        }
    </MudPaper>
}

@code
{
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _clusterRefreshShutdown = new();
    private IReadOnlyDictionary<string, ClusterListSnapshot> _clusterSnapshots =
        new Dictionary<string, ClusterListSnapshot>(StringComparer.OrdinalIgnoreCase);
    private Task? _clusterRefreshLoop;
    [Parameter]
    public EventCallback<string> ConfigProfileSelected { get; set; }

    [Parameter]
    public bool Embedded { get; set; }

    [Parameter]
    public bool HideHeader { get; set; }

    [Parameter]
    public bool DisableResponsiveLayout { get; set; }

    [Parameter]
    public bool LaunchBlocked { get; set; }

    [Parameter]
    public string LaunchBlockedMessage { get; set; } = "Managed runtime is still preparing.";

    private Breakpoint ServerTableBreakpoint => DisableResponsiveLayout ? Breakpoint.None : Breakpoint.Md;

    private IReadOnlyList<DedicatedServerDefinition> ServerDefinitions => ServerCatalog.GetServers();
    private IReadOnlyList<ClusterDefinition> ClusterDefinitions => ClusterCatalog.GetClusters();
    private IReadOnlyList<ManagedServerRow> ManagedServers => ServerDefinitions
        .Select(server => new ManagedServerRow(server, null))
        .Concat(ClusterDefinitions.Select(cluster => new ManagedServerRow(null, cluster)))
        .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private IReadOnlyDictionary<string, DedicatedServerRuntimeSnapshot> RuntimeSnapshots => Supervisor
        .GetSnapshots()
        .ToDictionary(snapshot => snapshot.UniqueName, StringComparer.OrdinalIgnoreCase);

    private IReadOnlyDictionary<string, AgentRuntimeState> AgentsByUniqueName => Registry
        .GetAgents()
        .Where(agent => agent.IsConnected)
        .Where(agent => !string.IsNullOrWhiteSpace(agent.UniqueNameKey))
        .GroupBy(agent => agent.UniqueNameKey, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(group => group.Key, group => group.OrderByDescending(a => a.LastSeenUtc).First(), StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<AgentRuntimeState> UnmanagedAgents
    {
        get
        {
            var defined = ServerDefinitions
                .Select(definition => definition.UniqueName)
                .Concat(ClusterDefinitions.Select(definition => definition.UniqueName))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            return Registry.GetAgents()
                .Where(agent => agent.IsConnected)
                .Where(agent => !string.IsNullOrWhiteSpace(agent.UniqueNameKey))
                .Where(agent => !defined.Contains(agent.UniqueNameKey))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ServerCatalog.Changed += HandleChanged;
        Supervisor.Changed += HandleChanged;
        Registry.Changed += HandleChanged;
        ConfigProfiles.Changed += HandleChanged;
        WorldTemplates.Changed += HandleChanged;
        ClusterCatalog.Changed += HandleClusterChanged;
        await RefreshClusterSnapshotsAsync(_clusterRefreshShutdown.Token, render: false);
        _clusterRefreshLoop = RunClusterRefreshLoopAsync(_clusterRefreshShutdown.Token);
    }

    public void Dispose()
    {
        ServerCatalog.Changed -= HandleChanged;
        Supervisor.Changed -= HandleChanged;
        Registry.Changed -= HandleChanged;
        ConfigProfiles.Changed -= HandleChanged;
        WorldTemplates.Changed -= HandleChanged;
        ClusterCatalog.Changed -= HandleClusterChanged;
        _clusterRefreshShutdown.Cancel();
        _clusterRefreshShutdown.Dispose();
    }

    private async Task RunClusterRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await RefreshClusterSnapshotsAsync(cancellationToken);
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RefreshClusterSnapshotsAsync(CancellationToken cancellationToken, bool render = true)
    {
        ClusterDefinition[] clusters = ClusterCatalog.GetClusters().ToArray();
        ClusterListSnapshot[] snapshots = await Task.WhenAll(clusters.Select(cluster =>
            LoadClusterSnapshotAsync(cluster, cancellationToken)));
        if (cancellationToken.IsCancellationRequested)
            return;
        _clusterSnapshots = snapshots.ToDictionary(item => item.UniqueName,
            StringComparer.OrdinalIgnoreCase);
        if (render)
            await InvokeAsync(StateHasChanged);
    }

    private async Task<ClusterListSnapshot> LoadClusterSnapshotAsync(
        ClusterDefinition cluster, CancellationToken cancellationToken)
    {
        Task<Admin.AdminEnvelope<Admin.ClusterStatus>> statusTask =
            ClusterGatewayClient.GetStatusAsync(cluster, cancellationToken);
        Task<Admin.AdminEnvelope<Admin.NodePlan[]>> planTask =
            ClusterGatewayClient.GetPlanAsync(cluster, cancellationToken);
        Admin.ClusterStatus? status = null;
        Admin.NodePlan[] plan = [];
        var errors = new List<string>();
        try
        {
            status = (await statusTask).Data;
        }
        catch (ClusterGatewayException exception)
        {
            errors.Add(exception.Message);
        }
        try
        {
            plan = (await planTask).Data;
        }
        catch (ClusterGatewayException exception)
        {
            errors.Add(exception.Message);
        }
        return new ClusterListSnapshot(cluster.UniqueName, status, plan,
            errors.Count == 0 ? null : string.Join(" ", errors.Distinct()));
    }

    private void HandleClusterChanged()
    {
        _ = RefreshClusterSnapshotsAsync(_clusterRefreshShutdown.Token);
        HandleChanged();
    }

    private bool IsExpanded(string uniqueName) => _expanded.Contains(uniqueName);

    private void ToggleExpanded(string uniqueName)
    {
        if (!_expanded.Add(uniqueName))
            _expanded.Remove(uniqueName);
    }

    private AgentRuntimeState? GetAgent(string uniqueName)
    {
        AgentsByUniqueName.TryGetValue(uniqueName, out var agent);
        return agent;
    }

    private Task OpenCreateDialogAsync() => ServerActions.OpenCreateDialogAsync();

    private Task OpenCloneDialogAsync(DedicatedServerDefinition definition) =>
        ServerActions.OpenCloneDialogAsync(definition);

    private Task OpenEditDialogAsync(DedicatedServerDefinition definition) =>
        ServerActions.OpenEditDialogAsync(definition);

    private async Task OpenConfigProfileAsync(string configProfileId)
    {
        if (!CanOpenConfigProfile(configProfileId))
            return;

        if (ConfigProfileSelected.HasDelegate)
        {
            await ConfigProfileSelected.InvokeAsync(configProfileId);
            return;
        }

        Navigation.NavigateTo($"/configs?profileId={Uri.EscapeDataString(configProfileId)}");
    }

    private async Task CopyDirectConnectAsync(DedicatedServerDefinition definition)
    {
        var address = GetDirectConnectAddress(definition);
        var ok = await JS.InvokeAsync<bool>("quasarConfigs.copyText", address);
        Snackbar.Add(
            ok ? $"Copied {address} to clipboard." : "Copy failed - select and copy the port manually.",
            ok ? Severity.Info : Severity.Warning);
    }

    private Task OpenConsoleDialogAsync(string uniqueName) =>
        ServerActions.OpenConsoleDialogAsync(uniqueName);

    private Task OpenErrorConsoleDialogAsync(string uniqueName)
    {
        var kind = GetRuntime(uniqueName)?.LatestErrorLogKind ?? string.Empty;
        return ServerActions.OpenConsoleDialogAsync(uniqueName, kind, "errors");
    }

    private Task CreateWorldTemplateAsync(DedicatedServerDefinition definition) =>
        ServerActions.CreateWorldTemplateAsync(definition);

    private async Task StartAsync(string uniqueName)
    {
        try
        {
            if (LaunchBlocked)
            {
                Snackbar.Add(LaunchBlockedMessage, Severity.Warning);
                return;
            }

            var definition = ServerCatalog.GetServer(uniqueName);
            var worldBlockMessage = GetWorldLaunchBlockMessage(definition);
            if (worldBlockMessage is not null)
            {
                Snackbar.Add(worldBlockMessage, Severity.Warning);
                return;
            }

            await Supervisor.SetGoalStateAsync(uniqueName, DedicatedServerGoalState.On, reconcile: false);
            await Supervisor.StartServerAsync(uniqueName);
            Snackbar.Add("Server start requested.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task StopAsync(string uniqueName)
    {
        if (!await ConfirmDestructiveActionAsync(
                "Stop server?",
                $"Server '{uniqueName}' will save and shut down normally.",
                "Stop"))
        {
            return;
        }

        try
        {
            await Supervisor.SetGoalStateAsync(uniqueName, DedicatedServerGoalState.Off);
            Snackbar.Add("Server stop requested.", Severity.Info);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task StartClusterAsync(string uniqueName)
    {
        try
        {
            await ClusterCommands.SetGoalAsync(uniqueName,
                new ClusterGoalRequest(DedicatedServerGoalState.On),
                Guid.NewGuid().ToString("N"), "web-ui");
            Snackbar.Add("Cluster start requested.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task StopClusterAsync(string uniqueName)
    {
        if (!await ConfirmDestructiveActionAsync(
                "Stop cluster?",
                $"Cluster '{uniqueName}' will disconnect players, save every partition and global state, then stop the Gateway last.",
                "Stop"))
            return;
        try
        {
            await ClusterCommands.SetGoalAsync(uniqueName,
                new ClusterGoalRequest(DedicatedServerGoalState.Off),
                Guid.NewGuid().ToString("N"), "web-ui");
            Snackbar.Add("Graceful cluster stop requested.", Severity.Info);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task KillStartingAsync(string uniqueName)
    {
        if (!await ConfirmDestructiveActionAsync(
                "Kill starting server?",
                $"Server '{uniqueName}' will be killed while it is starting. Unsaved startup progress can be lost.",
                "Kill"))
        {
            return;
        }

        try
        {
            await Supervisor.KillStartingServerAsync(uniqueName);
            Snackbar.Add("Starting server killed.", Severity.Warning);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task<bool> ConfirmDestructiveActionAsync(string title, string message, string yesText)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            title,
            message,
            yesText: yesText,
            cancelText: "Cancel");

        return confirmed == true;
    }

    private async Task RestartAsync(string uniqueName)
    {
        try
        {
            await Supervisor.RestartServerAsync(uniqueName);
            Snackbar.Add("Server restart requested.", Severity.Info);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private Task DeleteAsync(string uniqueName) => ServerActions.DeleteAsync(uniqueName);

    private string GetAttachmentStatus(string uniqueName)
    {
        var runtime = GetRuntime(uniqueName);
        if (runtime is null)
            return "not attached";

        return runtime.AgentAttached ? "attached" : "not attached";
    }

    private static string GetDisplayName(DedicatedServerDefinition definition)
    {
        return string.IsNullOrWhiteSpace(definition.DisplayName) ? definition.UniqueName : definition.DisplayName;
    }

    private string GetPlayerCount(string uniqueName)
    {
        var snapshot = GetAgent(uniqueName)?.Snapshot;
        if (snapshot is null)
            return "-";

        var server = ServerCatalog
            .GetServers()
            .FirstOrDefault(item => string.Equals(item.UniqueName, uniqueName, StringComparison.OrdinalIgnoreCase));
        var configuredMaxPlayers = string.IsNullOrWhiteSpace(server?.ConfigProfileId)
            ? null
            : ConfigProfiles.GetProfile(server.ConfigProfileId)?.SessionSettings.MaxPlayers;
        var maxPlayers = configuredMaxPlayers is > 0
            ? configuredMaxPlayers.GetValueOrDefault()
            : snapshot.Metrics.MaxPlayers;

        return $"{snapshot.Metrics.PlayersOnline}/{maxPlayers}";
    }

    private int GetPlayerSortValue(string uniqueName) =>
        GetAgent(uniqueName)?.Snapshot?.Metrics.PlayersOnline ?? -1;

    private string GetProcessDisplay(string uniqueName)
    {
        var runtime = GetRuntime(uniqueName);
        return runtime?.ProcessId?.ToString() ?? "stopped";
    }

    private int GetProcessSortValue(string uniqueName) =>
        GetRuntime(uniqueName)?.ProcessId ?? -1;

    private string GetConfigProfileName(string configProfileId)
    {
        if (string.IsNullOrWhiteSpace(configProfileId))
            return "-";

        return ConfigProfiles.GetProfile(configProfileId)?.Name ?? $"Missing: {configProfileId}";
    }

    private bool CanOpenConfigProfile(string configProfileId) =>
        !string.IsNullOrWhiteSpace(configProfileId) &&
        ConfigProfiles.GetProfile(configProfileId) is not null;

    private string GetDirectConnectTooltip(DedicatedServerDefinition definition) =>
        $"Copy direct connect address {GetDirectConnectAddress(definition)}";

    private string GetDirectConnectAddress(DedicatedServerDefinition definition)
    {
        var fallbackHost = Navigation.ToAbsoluteUri(Navigation.BaseUri).Host;
        var host = ResolveDirectConnectHost(definition.ServerIP, fallbackHost);
        if (host.Contains(':', StringComparison.Ordinal) &&
            !host.StartsWith("[", StringComparison.Ordinal) &&
            !host.EndsWith("]", StringComparison.Ordinal))
        {
            host = $"[{host}]";
        }

        return $"{host}:{definition.ServerPort}";
    }

    private static string ResolveDirectConnectHost(string? configuredHost, string fallbackHost)
    {
        var host = configuredHost?.Trim() ?? string.Empty;
        if (IsAnyAddress(host))
            host = fallbackHost?.Trim() ?? string.Empty;

        if (IsAnyAddress(host) || string.IsNullOrWhiteSpace(host))
            return "127.0.0.1";

        return host;
    }

    private static bool IsAnyAddress(string value)
    {
        var normalized = value.Trim().Trim('[', ']');
        return string.IsNullOrWhiteSpace(normalized) ||
               string.Equals(normalized, "0.0.0.0", StringComparison.Ordinal) ||
               string.Equals(normalized, "::", StringComparison.Ordinal) ||
               string.Equals(normalized, "*", StringComparison.Ordinal) ||
               string.Equals(normalized, "+", StringComparison.Ordinal);
    }

    private string GetStateText(string uniqueName)
    {
        var runtime = GetRuntime(uniqueName);
        return runtime?.State.ToString().ToLowerInvariant() ?? "stopped";
    }

    private Color GetStateColor(string uniqueName)
    {
        var state = GetRuntime(uniqueName)?.State ?? DedicatedServerProcessState.Stopped;
        return state switch
        {
            DedicatedServerProcessState.Running => Color.Success,
            DedicatedServerProcessState.Starting => Color.Info,
            DedicatedServerProcessState.Restarting => Color.Warning,
            DedicatedServerProcessState.Stopping => Color.Warning,
            DedicatedServerProcessState.Crashed => Color.Error,
            DedicatedServerProcessState.Faulted => Color.Error,
            _ => Color.Default,
        };
    }

    private static string GetRestartSummary(DedicatedServerRestartInfo restart)
    {
        var prefix = restart.Outcome switch
        {
            DedicatedServerRestartOutcome.Pending => "Restart pending",
            DedicatedServerRestartOutcome.Failed => "Last restart failed",
            _ => "Last restart recovered",
        };
        return $"{prefix} · {GetRestartCauseLabel(restart.Cause)}";
    }

    private static string GetRestartTooltip(DedicatedServerRestartInfo restart) =>
        $"{GetRestartSummary(restart)} · {restart.RequestedAtUtc:yyyy-MM-dd HH:mm:ss} UTC · {restart.Reason}";

    private static Color GetRestartColor(DedicatedServerRestartInfo restart) => restart.Outcome switch
    {
        DedicatedServerRestartOutcome.Pending => Color.Warning,
        DedicatedServerRestartOutcome.Failed => Color.Error,
        _ => Color.Success,
    };

    private static string GetRestartCauseLabel(DedicatedServerRestartCause cause) => cause switch
    {
        DedicatedServerRestartCause.HealthPolicy => "Health policy",
        DedicatedServerRestartCause.AgentAttachRecovery => "Agent attach recovery",
        DedicatedServerRestartCause.Scheduled => "Scheduled",
        DedicatedServerRestartCause.MaximumUptime => "Maximum uptime",
        DedicatedServerRestartCause.Manual => "Manual",
        DedicatedServerRestartCause.InGame => "In-game",
        DedicatedServerRestartCause.CrashRecovery => "Crash recovery",
        _ => "Unknown",
    };

    private bool ShouldShowLatestErrorLine(string uniqueName)
    {
        var runtime = GetRuntime(uniqueName);
        return runtime?.State is DedicatedServerProcessState.Crashed or DedicatedServerProcessState.Faulted &&
               !string.IsNullOrWhiteSpace(runtime.LatestErrorLogLine);
    }

    private bool IsRunning(string uniqueName)
    {
        var state = GetRuntime(uniqueName)?.State ?? DedicatedServerProcessState.Stopped;
        return state is DedicatedServerProcessState.Starting
            or DedicatedServerProcessState.Running
            or DedicatedServerProcessState.Restarting
            or DedicatedServerProcessState.Stopping;
    }

    private bool CanStartServer(string uniqueName)
    {
        var state = GetRuntime(uniqueName)?.State ?? DedicatedServerProcessState.Stopped;
        return state is DedicatedServerProcessState.Stopped
            or DedicatedServerProcessState.Crashed
            or DedicatedServerProcessState.Faulted;
    }

    private bool IsStartDisabled(DedicatedServerDefinition definition) =>
        LaunchBlocked || string.IsNullOrWhiteSpace(definition.WorldSaveName);

    private string GetStartTooltip(DedicatedServerDefinition definition)
    {
        if (LaunchBlocked)
            return LaunchBlockedMessage;

        var worldBlockMessage = GetWorldLaunchBlockMessage(definition, checkFiles: false);
        return worldBlockMessage ?? "Start server";
    }

    private static string? GetWorldLaunchBlockMessage(DedicatedServerDefinition? definition, bool checkFiles = true)
    {
        if (definition is null)
            return "Server definition not found.";

        if (string.IsNullOrWhiteSpace(definition.WorldSaveName))
            return "Select a world save before starting this server.";

        if (!checkFiles)
            return null;

        var worldPath = definition.GetWorldSavePath();
        if (string.IsNullOrWhiteSpace(worldPath) || !Directory.Exists(worldPath))
            return $"World save folder not found: {worldPath}";

        return File.Exists(Path.Combine(worldPath, "Sandbox.sbc"))
            ? null
            : $"World save '{worldPath}' is missing Sandbox.sbc.";
    }

    private bool CanStopServer(string uniqueName)
    {
        var state = GetRuntime(uniqueName)?.State ?? DedicatedServerProcessState.Stopped;
        return state == DedicatedServerProcessState.Running;
    }

    private bool CanKillStartingServer(string uniqueName)
    {
        var state = GetRuntime(uniqueName)?.State ?? DedicatedServerProcessState.Stopped;
        return state is DedicatedServerProcessState.Starting
            or DedicatedServerProcessState.Restarting;
    }

    private bool CanRestartServer(string uniqueName)
    {
        var state = GetRuntime(uniqueName)?.State ?? DedicatedServerProcessState.Stopped;
        return state == DedicatedServerProcessState.Running;
    }

    private bool CanCreateWorldTemplate(DedicatedServerDefinition definition) =>
        ServerActions.CanCreateWorldTemplate(definition);

    private ClusterListSnapshot? GetClusterSnapshot(string uniqueName) =>
        _clusterSnapshots.TryGetValue(uniqueName, out ClusterListSnapshot? snapshot) ? snapshot : null;

    private string GetManagedStateText(ManagedServerRow row) => row.Server is not null
        ? GetStateText(row.UniqueName) : GetClusterStateText(row.UniqueName);

    private object GetEndpointSortValue(ManagedServerRow row) => row.Server is not null
        ? row.Server.ServerPort : GetGatewayEndpoint(row.Cluster!);

    private object GetManagedPlayerSortValue(ManagedServerRow row) => row.Server is not null
        ? GetPlayerSortValue(row.UniqueName)
        : GetClusterSnapshot(row.UniqueName)?.Status?.Counts.ConnectedClients ?? -1;

    private object GetManagedProcessSortValue(ManagedServerRow row) => row.Server is not null
        ? GetProcessSortValue(row.UniqueName)
        : GetClusterSnapshot(row.UniqueName)?.Plan.Count(item =>
            item.Observed == Admin.NodeObservation.Ready) ?? -1;

    private string GetManagedAttachmentStatus(ManagedServerRow row) => row.Server is not null
        ? GetAttachmentStatus(row.UniqueName) : GetClusterWorldAuthority(row.UniqueName);

    private string GetClusterStateText(string uniqueName) =>
        GetClusterSnapshot(uniqueName)?.Status?.Phase.ToString().ToLowerInvariant() ?? "unavailable";

    private Color GetClusterStateColor(string uniqueName) => GetClusterSnapshot(uniqueName)?.Status?.Phase switch
    {
        Admin.ClusterPhase.Serving => Color.Success,
        Admin.ClusterPhase.Degraded => Color.Warning,
        Admin.ClusterPhase.Bootstrapping => Color.Info,
        Admin.ClusterPhase.Draining => Color.Warning,
        Admin.ClusterPhase.Down => Color.Default,
        _ => Color.Error,
    };

    private string GetClusterError(string uniqueName) =>
        GetClusterSnapshot(uniqueName)?.Error ?? "Gateway status is current.";

    private static string GetGatewayEndpoint(ClusterDefinition cluster) =>
        Uri.TryCreate(cluster.GatewayUrl, UriKind.Absolute, out Uri? gateway) ? gateway.Authority : "-";

    private string GetClusterPlayerCount(string uniqueName) =>
        GetClusterSnapshot(uniqueName)?.Status?.Counts.ConnectedClients.ToString() ?? "-";

    private string GetClusterCapacity(string uniqueName)
    {
        ClusterListSnapshot? snapshot = GetClusterSnapshot(uniqueName);
        if (snapshot is null)
            return "-";
        int ready = snapshot.Plan.Count(item => item.Observed == Admin.NodeObservation.Ready);
        int wanted = snapshot.Plan.Count(item => item.Goal == Admin.NodeGoal.Wanted);
        return wanted == 0 && snapshot.Status is not null
            ? $"{snapshot.Status.Counts.Nodes} registered" : $"{ready}/{wanted} ready";
    }

    private string GetClusterWorldAuthority(string uniqueName) =>
        GetClusterSnapshot(uniqueName)?.Status?.WorldAuthority.Node ?? "-";

    private static string ClusterHref(string uniqueName) =>
        $"/clusters/{Uri.EscapeDataString(uniqueName)}";

    private void OpenCluster(string uniqueName) => Navigation.NavigateTo(ClusterHref(uniqueName));

    private DedicatedServerRuntimeSnapshot? GetRuntime(string uniqueName)
    {
        RuntimeSnapshots.TryGetValue(uniqueName, out var runtime);
        return runtime;
    }

    private void HandleChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private sealed record ManagedServerRow(
        DedicatedServerDefinition? Server,
        ClusterDefinition? Cluster)
    {
        public string UniqueName => Server?.UniqueName ?? Cluster!.UniqueName;
        public string DisplayName => Server is null
            ? Cluster!.DisplayName
            : string.IsNullOrWhiteSpace(Server.DisplayName) ? Server.UniqueName : Server.DisplayName;
        public string ConfigProfileId => Server?.ConfigProfileId ?? Cluster!.ConfigProfileId;
        public string Kind => Server is null ? "Cluster" : "Standalone";
    }

    private sealed record ClusterListSnapshot(
        string UniqueName,
        Admin.ClusterStatus? Status,
        Admin.NodePlan[] Plan,
        string? Error);

}
