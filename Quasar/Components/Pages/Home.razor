    private IReadOnlyList<FleetActivity> RecentActivity
    {
        get
        {
            var events = new List<FleetActivity>();
            var clusters = Clusters.ToDictionary(cluster => cluster.UniqueName, StringComparer.OrdinalIgnoreCase);
            foreach (var runtime in RuntimeSnapshotList)
            {
                if (runtime.StartedAtUtc is { } started) events.Add(new(started, runtime.UniqueName, "Server started", "quasar-text-success"));
                if (runtime.StoppedAtUtc is { } stopped) events.Add(runtime.State is DedicatedServerProcessState.Crashed or DedicatedServerProcessState.Faulted
                    ? new(stopped, runtime.UniqueName, runtime.LastMessage, "quasar-text-error")
                    : new(stopped, runtime.UniqueName, "Server stopped", ""));
                if (runtime.LastRestart is { } restart) events.Add(new(restart.CompletedAtUtc ?? restart.RequestedAtUtc, runtime.UniqueName,
                    string.IsNullOrWhiteSpace(restart.Reason) ? "Restart " + restart.Outcome.ToString().ToLowerInvariant() : restart.Reason,
                    restart.Outcome == DedicatedServerRestartOutcome.Failed ? "quasar-text-error" : "quasar-text-warning"));
            }
            foreach (var operation in ClusterOperations.GetRecent(clusters.Keys, 5))
            {
                var name = clusters[operation.Cluster].DisplayName;
                events.Add(new(operation.UpdatedAt, string.IsNullOrWhiteSpace(name) ? operation.Cluster : name,
                    ClusterActivityMessage(operation), operation.State switch
                    {
                        ClusterOperationState.Failed => "quasar-text-error",
                        ClusterOperationState.Running => "quasar-text-warning",
                        _ => "quasar-text-success",
                    }));
            }
            foreach (var agent in Agents.Where(agent => !agent.IsCluster || clusters.ContainsKey(agent.ClusterId)))
                foreach (var result in agent.CommandResults.Where(result => !string.IsNullOrWhiteSpace(result.Message)).Take(6))
                    events.Add(new(result.CompletedAtUtc, agent.ServerDisplayName, result.Message, result.Success ? "" : "quasar-text-error"));
            return events.OrderByDescending(entry => entry.At).Take(5).ToArray();
        }
    }
    private sealed record FleetActivity(DateTimeOffset At, string Server, string Message, string Tone);

    private static string ClusterActivityMessage(ClusterOperation operation)
    {
        var action = operation.Kind switch
        {
            "cluster.goal.set" when operation.Result is { ValueKind: System.Text.Json.JsonValueKind.Object } result
                && result.TryGetProperty("goal", out var goal) => goal.ToString() switch
                {
                    "On" => "Cluster start requested",
                    "Off" => "Cluster stop requested",
                    _ => "Cluster state change",
                },
            "cluster.goal.set" => "Cluster state change",
            "cluster.lifecycle.shutdown" or "cluster.shutdown" => "Cluster shutdown",
            "cluster.gateway-restart" => "Cluster Gateway restart",
            "cluster.save-all" => "Cluster world save",
            "cluster.kick" => "Cluster player kick",
            "cluster.ban" => "Cluster player ban",
            "cluster.unban" => "Cluster player unban",
            "cluster.setup" => "Cluster setup",
            "cluster.backup.create" => "Cluster backup",
            "cluster.backup.prepare-restore" => "Cluster restore preparation",
            "cluster.backup.restore" => "Cluster restore",
            "cluster.deployment.prepare" => "Cluster deployment preparation",
            "cluster.deployment.activate" => "Cluster deployment activation",
            "cluster.update.begin" => "Cluster update",
            "cluster.update.abandon" => "Cluster update cancellation",
            "cluster.recover" or "cluster.gateway.recover" => "Cluster recovery",
            _ => "Cluster operation",
        };
        return action + (operation.State switch
        {
            ClusterOperationState.Running => " · in progress",
            ClusterOperationState.Failed => " · failed",
            _ => " · completed",
        });
    }

    private int ConfiguredServerCount => Servers.Count + Clusters.Count;

    private int RunningServerCount => RuntimeSnapshotList.Count(snapshot =>
        snapshot.State is DedicatedServerProcessState.Starting
            or DedicatedServerProcessState.Running
            or DedicatedServerProcessState.Restarting
            or DedicatedServerProcessState.Stopping);

    private (Severity Severity, string Message, string? ClearErrorUniqueName)? ProblemBanner
    {
        get
        {
            var stateError = RuntimeSnapshotList.FirstOrDefault(snapshot =>
                snapshot.State is DedicatedServerProcessState.Crashed or DedicatedServerProcessState.Faulted);
            if (stateError is not null)
                return (Severity.Error, $"{stateError.UniqueName}: {FirstNonEmpty(stateError.LastMessage, stateError.HealthSummary, "Server needs attention.")}", stateError.UniqueName);

            var healthError = RuntimeSnapshotList.FirstOrDefault(snapshot =>
                snapshot.HealthState == DedicatedServerHealthState.Unhealthy);
            if (healthError is not null)
                return (Severity.Error, $"{healthError.UniqueName}: {FirstNonEmpty(healthError.HealthSummary, healthError.LastMessage, "Server needs attention.")}", null);

            var warning = RuntimeSnapshotList.FirstOrDefault(snapshot => snapshot.HealthState == DedicatedServerHealthState.Warning);
            if (warning is not null)
                return (Severity.Warning, $"{warning.UniqueName}: {FirstNonEmpty(warning.HealthSummary, warning.LastMessage, "Health warning.")}", null);

            return null;
        }
    }

    private int WorldTemplateCount => WorldTemplates.GetTemplates().Count;

    private string? _setupWorldTemplateId;
    private int? _setupStepOverride;

    private QuasarWorldTemplate? SetupWorldTemplate
    {
        get
        {
            var templates = WorldTemplates.GetTemplates();
            var selected = templates.FirstOrDefault(template =>
                string.Equals(template.WorldTemplateId, _setupWorldTemplateId, StringComparison.OrdinalIgnoreCase));
            if (selected is not null)
                return selected;

            return templates
                .OrderByDescending(template => template.UpdatedAtUtc)
                .FirstOrDefault();
        }
    }

    private QuasarConfigProfile? SetupConfigProfile
    {
        get
        {
            var worldTemplateId = SetupWorldTemplate?.WorldTemplateId;
            if (string.IsNullOrWhiteSpace(worldTemplateId))
                return null;

            return ConfigProfiles.GetProfiles().FirstOrDefault(profile =>
                profile.WasCreatedFromWorldTemplate(worldTemplateId));
        }
    }

    private bool IsSetupStepComplete(int index) => index switch
    {
        0 => SetupWorldTemplate is not null,
        1 => SetupConfigProfile is not null,
        2 => ConfiguredServerCount > 0,
        3 => RunningServerCount > 0,
        4 => ConnectedAgentCount > 0,
        _ => true,
    };

    private int CurrentSetupStep
    {
        get
        {
            if (_setupStepOverride is int forced)
                return Math.Clamp(forced, 0, 4);

            for (var i = 0; i < 5; i++)
                if (!IsSetupStepComplete(i))
                    return i;

            return 4;
        }
    }

    private int SetupProgressPercent
    {
        get
        {
            var completed = 0;
            for (var i = 0; i < 5; i++)
                if (IsSetupStepComplete(i))
                    completed++;

            return completed * 100 / 5;
        }
    }

    private async Task GoToPreviousSetupStep()
    {
        var step = CurrentSetupStep;
        if (step == 0)
            return;

        _setupStepOverride = step - 1;
        await SetFirstSetupFlowAsync(FirstSetupFlow.SingleMagnetar);
    }

    private async Task GoToNextSetupStep()
    {
        var step = CurrentSetupStep;
        if (step >= 4 || !IsSetupStepComplete(step)) return;
        _setupStepOverride = step + 1;
        await SetFirstSetupFlowAsync(FirstSetupFlow.SingleMagnetar);
    }

