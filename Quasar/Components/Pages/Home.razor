    private bool _setupWizardDismissed;
    private bool _setupWizardActive;
    private string? _setupWorldTemplateId;
    private int? _setupStepOverride;

    private QuasarWorldTemplate? SetupWorldTemplate
    {
        get
        {
            var templates = WorldTemplates.GetTemplates();
            var selected = templates.FirstOrDefault(template =>
                string.Equals(template.WorldTemplateId, _setupWorldTemplateId, StringComparison.OrdinalIgnoreCase));
            if (selected is not null)
                return selected;

            return templates
                .OrderByDescending(template => template.UpdatedAtUtc)
                .FirstOrDefault();
        }
    }

    private QuasarConfigProfile? SetupConfigProfile
    {
        get
        {
            var worldTemplateId = SetupWorldTemplate?.WorldTemplateId;
            if (string.IsNullOrWhiteSpace(worldTemplateId))
                return null;

            return ConfigProfiles.GetProfiles().FirstOrDefault(profile =>
                profile.WasCreatedFromWorldTemplate(worldTemplateId));
        }
    }

    private bool IsSetupStepComplete(int index) => index switch
    {
        0 => SetupWorldTemplate is not null,
        1 => SetupConfigProfile is not null,
        2 => ConfiguredServerCount > 0,
        3 => RunningServerCount > 0,
        4 => ConnectedAgentCount > 0,
        _ => true,
    };

    private int CurrentSetupStep
    {
        get
        {
            if (_setupStepOverride is int forced)
                return Math.Clamp(forced, 0, 4);

            for (var i = 0; i < 5; i++)
                if (!IsSetupStepComplete(i))
                    return i;

            return 4;
        }
    }

    private int SetupProgressPercent
    {
        get
        {
            var completed = 0;
            for (var i = 0; i < 5; i++)
                if (IsSetupStepComplete(i))
                    completed++;

            return completed * 100 / 5;
        }
    }

    private void GoToPreviousSetupStep()
    {
        var step = CurrentSetupStep;
        if (step == 0)
            return;

        _setupStepOverride = step - 1;
    }

