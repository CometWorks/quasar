@page "/"
@implements IDisposable
@inject AgentRegistry Registry
@inject DedicatedServerCatalog ServerCatalog
@inject ClusterCatalog ClusterCatalog
@inject ClusterOperationStore ClusterOperations
@inject ClusterPlayerService ClusterPlayers
@inject AuthenticationStateProvider AuthenticationState
@inject DedicatedServerSupervisor Supervisor
@inject QuasarConfigProfileCatalog ConfigProfiles
@inject QuasarWorldTemplateCatalog WorldTemplates
@inject QuasarWorkshopModResolver WorkshopMods
@inject ManagedRuntimeWarmupService RuntimeWarmup
@inject DataHandlingConsentCatalog DataHandlingConsent
@inject ServerManagementActions ServerActions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject BrowserStorageService BrowserStorage
@inject QuasarPermissionService Permissions

<PageTitle>Fleet overview</PageTitle>

@if (ShowDataHandlingConsentPrompt)
{
    <section class=" mb-4 quasar-panel quasar-section">
        <div class="quasar-stack">
            <div class="quasar-row quasar-between">
                <div class="setup-wizard-copy quasar-stack">
                    <h3>Data Handling Consent</h3>
                    <p>
                        The updated data-handling policy requires a new decision. YES automatically enrolls this Quasar instance with CometWorks at https://log.se-servers.net and allows anonymous plugin usage statistics, logging and error reports. Reports include error details, bounded recent logs, software versions and execution context. Logs may contain private player or server information. Memory dumps require separate consent. While YES and diagnostic reports remain enabled, Quasar also checks CometWorks announcements for the notification bell and Notifications page, or service logs in headless mode.
                    </p>
                    <p class="quasar-muted quasar-caption quasar-tone-secondary">
                        Server listings require this consent and working log delivery. When a listing is explicitly enabled, its name, public join address and summary statistics are public; Quasar admin Steam identities are shared privately to authorize description edits. Existing statistics consent does not enable reports or listings.
                        Until a new decision is accepted, sharing remains off. Memory dumps and public listing visibility are separate opt-ins in <a href="settings/security">Security</a>; both are off by default.
                    </p>
                </div>
                <div class="quasar-row">
                    <button class="quasar-button quasar-tone-success" type="button" @onclick="@(() => SaveDataHandlingConsentAsync(true))"><QuasarIcon Icon="@QuasarIcons.Check" />
                        YES
                    </button>
                    <button class="quasar-button quasar-tone-warning" type="button" @onclick="@(() => SaveDataHandlingConsentAsync(false))"><QuasarIcon Icon="@QuasarIcons.Close" />
                        NO
                    </button>
                </div>
            </div>
        </div>
    </section>
}

<div class="quasar-page-heading">
    <div><div class="quasar-eyebrow">Infrastructure / overview</div><h1>Fleet overview</h1><p>Server health, live telemetry, and lifecycle controls.</p></div>
    <div class="quasar-dashboard-actions">
        <button type="button" class="quasar-button" disabled="@ShowSetupWizard" @onclick="ShowSetupWizardAgain"><QuasarIcon Icon="@QuasarIcons.RestartAlt" />Setup guide</button>
        <button type="button" class="quasar-button" @onclick="OpenExistingServerImportDialogAsync"><QuasarIcon Icon="@QuasarIcons.MoveToInbox" />Import server</button>
        <button type="button" class="quasar-button quasar-button-primary" @onclick="OpenCreateServerDialogAsync"><QuasarIcon Icon="@QuasarIcons.Add" />New server</button>
    </div>
</div>

@if (Supervisor.HealthMonitoringDisabled)
{
    <div class="mb-4 quasar-notice quasar-notice-info" role="status">
        Health monitoring disabled for this Quasar instance (development mode or configuration).
    </div>
}

@if (_firstSetupFlow == FirstSetupFlow.Cluster)
{
    var cluster = Clusters.FirstOrDefault();
    var deployed = cluster?.ActiveDeployment is not null;
    var destination = deployed ? $"clusters/{Uri.EscapeDataString(cluster!.UniqueName)}"
        : cluster is not null ? $"clusters/new?resume={Uri.EscapeDataString(cluster.UniqueName)}" : "clusters/new";
    <section class="quasar-panel quasar-section mb-6">
        <div class="quasar-stack">
            <h2>First Setup · Cluster</h2>
            <p>@(deployed ? "Your cluster is deployed. Open its controls to review and start it, then close setup when you are finished." : "Continue guided cluster setup to configure and deploy your cluster.")</p>
            <div class="quasar-row">
                <a class="quasar-button quasar-button-primary" href="@destination">@(deployed ? "Open cluster controls" : "Continue cluster setup")</a>
                <button class="quasar-button" type="button" @onclick="HideSetupWizard">@(deployed ? "Close setup" : "Skip setup")</button>
            </div>
        </div>
    </section>
}

@if (ShowSetupWizard)
{
    <section class=" mb-6 quasar-panel quasar-section">
        <div class="quasar-stack">
            <div class="quasar-row quasar-between">
                <div>
                    <h2>First Setup</h2>
                    <p>Start from a Dedicated Server world. Quasar creates its world template first, then a matching config profile.</p>
                </div>
                <button class="quasar-button quasar-tone-default" type="button" @onclick="HideSetupWizard"><QuasarIcon Icon="@QuasarIcons.Close" />
                    Skip setup
                </button>
            </div>

            <div class="quasar-notice quasar-notice-info" role="status">
                @GetNextSetupHint()
            </div>

            <QuasarProgress Label="Setup progress" Value="@SetupProgressPercent" />
            <p class="quasar-muted quasar-caption">@GetSetupProgressText()</p>

            <div class="setup-wizard-steps">
                @if (CurrentSetupStep == 0)
                {
                <div class="setup-wizard-step">
                    <div class="quasar-stack">
                        <div class="quasar-row quasar-between">
                            <div class="setup-wizard-copy quasar-stack">
                                <div class="quasar-row">
                                    <h3>Create world template</h3>
                                    <span class="quasar-status quasar-tone-@((SetupWorldTemplate is not null ? Color.Success : Color.Warning).ToString().ToLowerInvariant())">
                                        @(SetupWorldTemplate is not null ? "Done" : "Required")
                                    </span>
                                </div>
                                <p>
                                    @if (SetupWorldTemplate is { } worldTemplate)
                                    {
                                        @($"Using '{worldTemplate.Name}' as setup world template.")
                                    }
                                    else
                                    {
                                        @("Choose a world supplied with Space Engineers Dedicated Server. Quasar copies it into managed template storage.")
                                    }
                                </p>
                            </div>

                            <div class="setup-wizard-actions quasar-row">
                                <button class="quasar-button quasar-tone-@((SetupWorldTemplate is not null ? Color.Default : Color.Primary).ToString().ToLowerInvariant())" type="button" disabled="@(!IsDedicatedServerAvailable)" @onclick="OpenSetupWorldTemplateDialogAsync"><QuasarIcon Icon="@QuasarIcons.Public" />
                                    @(SetupWorldTemplate is not null ? "Choose Another World" : "Choose DS World")
                                </button>
                            </div>
                        </div>

                        @if (SetupWorldTemplate is null)
                        {
                            <DedicatedServerSetupStatus />
                        }
                        @if (SetupWorldTemplate is not null)
                        {
                            <div class="quasar-row">
                                <span class="quasar-status">@SetupWorldTemplate.Name</span>
                                <span class="quasar-status">@WorldTemplateCount total</span>
                            </div>
                        }
                    </div>
                </div>
                }

                @if (CurrentSetupStep == 1)
                {
                <div class="setup-wizard-step">
                    <div class="quasar-stack">
                        <div class="quasar-row quasar-between">
                            <div class="setup-wizard-copy quasar-stack">
                                <div class="quasar-row">
                                    <h3>Create matching config profile</h3>
                                    <span class="quasar-status quasar-tone-@((SetupConfigProfile is not null ? Color.Success : Color.Warning).ToString().ToLowerInvariant())">
                                        @(SetupConfigProfile is not null ? "Done" : "Required")
                                    </span>
                                </div>
                                <p>
                                    @if (SetupConfigProfile is { } configProfile)
                                    {
                                        @($"'{configProfile.Name}' was created from '{SetupWorldTemplate?.Name}' and is ready for this world.")
                                    }
                                    else
                                    {
                                        @($"Copy world settings and mods from '{SetupWorldTemplate?.Name}' into a compatible config profile.")
                                    }
                                </p>
                            </div>

                            <div class="setup-wizard-actions quasar-row">
                                <button class="quasar-button quasar-tone-@((SetupConfigProfile is not null ? Color.Default : Color.Primary).ToString().ToLowerInvariant())" type="button" @onclick="OpenSetupConfigProfileDialogAsync"><QuasarIcon Icon="@QuasarIcons.Tune" />
                                    @(SetupConfigProfile is not null ? "Review Config Profile" : "Create From World")
                                </button>
                            </div>
                        </div>

                        @if (SetupConfigProfile is not null)
                        {
                            <div class="quasar-row">
                                <span class="quasar-status">@SetupConfigProfile.Name</span>
                            </div>
                        }
                    </div>
                </div>
                }

                @if (CurrentSetupStep == 2)
                {
                <div class="setup-wizard-step">
                    <div class="quasar-stack">
                        <div class="quasar-row quasar-between">
                            <div class="setup-wizard-copy quasar-stack">
                                <div class="quasar-row">
                                    <h3>Create server</h3>
                                    <span class="quasar-status quasar-tone-@((ConfiguredServerCount > 0 ? Color.Success : Color.Warning).ToString().ToLowerInvariant())">
                                        @(ConfiguredServerCount > 0 ? "Done" : "Required")
                                    </span>
                                </div>
                                <p>
                                    @if (ConfiguredServerCount > 0)
                                    {
                                        @($"{ConfiguredServerCount} server definition(s) saved on dashboard.")
                                    }
                                    else
                                    {
                                        @("Required. Define identity, template assignments, runtime policy, restart policy, health policy here.")
                                    }
                                </p>
                            </div>

                            <div class="setup-wizard-actions quasar-row">
                                <button class="quasar-button quasar-tone-@((ConfiguredServerCount > 0 ? Color.Default : Color.Primary).ToString().ToLowerInvariant())" type="button" @onclick="OpenSetupCreateServerDialogAsync"><QuasarIcon Icon="@QuasarIcons.Storage" />
                                    @(ConfiguredServerCount > 0 ? "Add Server" : "Create Server")
                                </button>
                            </div>
                        </div>

                        @if (Servers.Count > 0)
                        {
                            <div class="setup-wizard-status-list quasar-stack">
                                @foreach (var server in Servers.Take(4))
                                {
                                    <div class="setup-wizard-status-row">
                                        <div class="setup-wizard-copy quasar-stack">
                                            <p class="mono">@server.UniqueName</p>
                                            <p class="quasar-muted quasar-caption">@GetServerSetupSummary(server)</p>
                                        </div>
                                        <div class="quasar-row">
                                            <span class="quasar-status quasar-tone-@(GetSetupStateColor(server.UniqueName).ToString().ToLowerInvariant())">
                                                @GetSetupStateText(server.UniqueName)
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                }

                @if (CurrentSetupStep == 3)
                {
                <div class="setup-wizard-step">
                    <div class="quasar-stack">
                        <div class="quasar-row quasar-between">
                            <div class="setup-wizard-copy quasar-stack">
                                <div class="quasar-row">
                                    <h3>Start server</h3>
                                    <span class="quasar-status quasar-tone-@((RunningServerCount > 0 ? Color.Success : Color.Warning).ToString().ToLowerInvariant())">
                                        @(RunningServerCount > 0 ? "Done" : "Required")
                                    </span>
                                </div>
                                <p>
                                    @if (RunningServerCount > 0)
                                    {
                                        @($"{RunningServerCount} server(s) launching or running now.")
                                    }
                                    else if (ConfiguredServerCount == 0)
                                    {
                                        @("Create server first. Launch buttons appear here after save.")
                                    }
                                    else
                                    {
                                        @("Required. Launch saved server here. Quasar prepares runtime and starts server from dashboard.")
                                    }
                                </p>
                            </div>

                            <div class="setup-wizard-actions quasar-row">
                                @if (StartableServers.Count == 0)
                                {
                                    <button class="quasar-button quasar-tone-default" type="button" disabled="true"><QuasarIcon Icon="@QuasarIcons.PlayArrow" />
                                        @(ConfiguredServerCount == 0 ? "Create Server First" : "All Servers Running")
                                    </button>
                                }
                                else
                                {
                                    @foreach (var server in StartableServers)
                                    {
                                        <button class="quasar-button quasar-tone-primary quasar-button-fill" type="button" disabled="@(IsLaunchBlocked || string.IsNullOrWhiteSpace(server.WorldSaveName))" @onclick="@(() => StartAsync(server.UniqueName))"><QuasarIcon Icon="@QuasarIcons.PlayArrow" />
                                            Start @server.UniqueName
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
                }

                @if (CurrentSetupStep == 4)
                {
                <div class="setup-wizard-step">
                    <div class="quasar-stack">
                        <div class="quasar-row quasar-between">
                            <div class="setup-wizard-copy quasar-stack">
                                <div class="quasar-row">
                                    <h3>Wait for Quasar.Agent</h3>
                                    <span class="quasar-status quasar-tone-@((ConnectedAgentCount > 0 ? Color.Success : Color.Warning).ToString().ToLowerInvariant())">
                                        @(ConnectedAgentCount > 0 ? "Done" : "Waiting")
                                    </span>
                                </div>
                                <p>
                                    @if (ConnectedAgentCount > 0)
                                    {
                                        @($"{ConnectedAgentCount} connected agent(s) reporting live server data.")
                                    }
                                    else if (RunningServerCount == 0)
                                    {
                                        @("No running server yet. Launch one above, then dashboard watches attach here.")
                                    }
                                    else
                                    {
                                        @("Dashboard watching live attach now. Keep page open while Quasar.Agent connects.")
                                    }
                                </p>
                            </div>

                            @if (IsSetupStepComplete(4))
                            {
                                <div class="setup-wizard-actions quasar-row">
                                    <button class="quasar-button quasar-tone-success quasar-button-fill" type="button" @onclick="HideSetupWizard"><QuasarIcon Icon="@QuasarIcons.Check" />
                                        Close
                                    </button>
                                </div>
                            }

                        </div>

                        @if (LaunchedServers.Count > 0)
                        {
                            <div class="setup-wizard-status-list quasar-stack">
                                @foreach (var server in LaunchedServers)
                                {
                                    <div class="setup-wizard-status-row">
                                        <div class="setup-wizard-copy quasar-stack">
                                            <p class="mono">@server.UniqueName</p>
                                            <p class="quasar-muted quasar-caption">@GetSetupRuntimeSummary(server.UniqueName)</p>
                                        </div>
                                        <div class="quasar-row">
                                            <span class="quasar-status quasar-tone-@(GetSetupStateColor(server.UniqueName).ToString().ToLowerInvariant())">
                                                @GetSetupStateText(server.UniqueName)
                                            </span>
                                            <span class="quasar-status quasar-tone-@(GetSetupAgentColor(server.UniqueName).ToString().ToLowerInvariant())">
                                                @GetSetupAgentText(server.UniqueName)
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                }

                @if (CurrentSetupStep > 0 || IsSetupStepComplete(CurrentSetupStep))
                {
                    <div class="mt-1 quasar-row">
                        @if (CurrentSetupStep > 0)
                        {
                            <button class="quasar-button quasar-tone-default" type="button" @onclick="GoToPreviousSetupStep"><QuasarIcon Icon="@QuasarIcons.ArrowBack" />Back</button>
                        }
                        @if (CurrentSetupStep < 4 && IsSetupStepComplete(CurrentSetupStep))
                        {
                            <button class="quasar-button quasar-button-primary" type="button" @onclick="GoToNextSetupStep"><QuasarIcon Icon="@Icons.Material.Filled.ArrowForward" />Next</button>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (ProblemBanner is { } problemBanner)
{
    <div class="mb-4 quasar-notice quasar-notice-@(problemBanner.Severity.ToString().ToLowerInvariant())" role="status">
        <div class="quasar-row quasar-between">
            <p>@problemBanner.Message</p>
            @if (!string.IsNullOrWhiteSpace(problemBanner.ClearErrorUniqueName))
            {
                <button class="quasar-button quasar-tone-inherit" type="button" @onclick="@(() => ClearErrorStatusAsync(problemBanner.ClearErrorUniqueName))"><QuasarIcon Icon="@QuasarIcons.Clear" />
                    Clear Error Status
                </button>
            }
        </div>
    </div>
}

@if (ShouldShowRuntimeWarmup() && !(ShowSetupWizard && CurrentSetupStep == 0 && SetupWorldTemplate is null))
{
    <section class=" runtime-status mb-4 quasar-panel quasar-section">
        <div class="quasar-stack">
            <div class="quasar-row quasar-between">
                <div class="runtime-status-copy quasar-stack">
                    <h3>Managed Runtime</h3>
                    <p>@RuntimeWarmupSnapshot.Message</p>
                </div>
                <span class="quasar-status quasar-tone-@(GetRuntimeWarmupColor().ToString().ToLowerInvariant())">
                    @GetRuntimeWarmupLabel()
                </span>
            </div>

            <div class="runtime-status-grid">
                @foreach (var component in RuntimeWarmupSnapshot.Components)
                {
                    <div class="runtime-status-row">
                        <div class="runtime-status-copy quasar-stack">
                            <p>@component.DisplayName</p>
                            <p class="quasar-muted quasar-caption">@component.Message</p>
                            @if (!string.IsNullOrWhiteSpace(component.Path))
                            {
                                <CopyablePath Value="@component.Path" TextClass="" />
                            }
                        </div>
                        <div class="runtime-status-progress">
                            @if (component.State is ManagedRuntimeComponentState.Checking or ManagedRuntimeComponentState.Downloading or ManagedRuntimeComponentState.Installing)
                            {
                                <QuasarOperationLoader @key="component.Component" Title="@component.DisplayName" Message="@component.Message" Percent="@((double?)component.Percent)" />
                            }
                            else
                            {
                                <QuasarProgress Label="@component.DisplayName" Value="@(component.State == ManagedRuntimeComponentState.Ready ? 100 : 0)" />
                            }
                            <div class="quasar-row quasar-between">
                                <p class="quasar-muted quasar-caption">@GetRuntimeComponentLabel(component)</p>
                                @if (CanRetryRuntimeComponent(component))
                                {
                                    <button class="quasar-button quasar-tone-primary" type="button" @onclick="RetryRuntimeWarmupAsync"><QuasarIcon Icon="@QuasarIcons.Refresh" />
                                        Retry
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@{
    var fleet = FleetSummary.Build(Servers, RuntimeSnapshotList, Agents,
        Clusters.ToDictionary(cluster => cluster.UniqueName, cluster => ClusterPlayers.GetSnapshot(cluster.UniqueName), StringComparer.OrdinalIgnoreCase));
}
<section class="quasar-summary" aria-label="Fleet summary">
    <div class="quasar-metric">
        <span class="quasar-metric-label">Servers<QuasarIcon Icon="@QuasarIcons.Storage" /></span>
        <strong class="quasar-metric-value">@(fleet.UnobservedClusters > 0 ? (fleet.RunningServers > 0 ? fleet.RunningServers + "+" : "—") : fleet.RunningServers.ToString())<small>/ @fleet.ConfiguredServers running</small></strong>
        <span class="quasar-metric-note">@Servers.Count standalone · @Clusters.Count @(Clusters.Count == 1 ? "cluster" : "clusters")@if (fleet.UnobservedClusters > 0) { <span> · cluster status unavailable: @fleet.UnobservedClusters</span> }</span>
    </div>
    <div class="quasar-metric">
        <span class="quasar-metric-label">Players online<QuasarIcon Icon="@QuasarIcons.Groups" /></span>
        <strong class="quasar-metric-value">@(fleet.PlayersOnline?.ToString() ?? "—")<small>/ @(fleet.PlayerCapacity?.ToString() ?? "—") slots</small></strong>
        <span class="quasar-metric-note">@fleet.ReportingServers of @fleet.ConfiguredServers servers reporting</span>
    </div>
    <div class="quasar-metric @(fleet.HealthWarnings > 0 ? "quasar-metric-warning" : null)">
        <span class="quasar-metric-label">Average sim speed<QuasarIcon Icon="@QuasarIcons.QueryStats" /></span>
        <strong class="quasar-metric-value">@(fleet.AverageSimSpeed?.ToString("0.00") ?? "—")<small>×</small></strong>
        <span class="quasar-metric-note">@fleet.SimulationProcesses active game processes · @fleet.HealthWarnings warnings · @fleet.HealthErrors errors</span>
    </div>
    <div class="quasar-metric @(fleet.HealthErrors > 0 ? "quasar-metric-error" : null)">
        <span class="quasar-metric-label">Game process memory<QuasarIcon Icon="@QuasarIcons.Memory" /></span>
        <strong class="quasar-metric-value">@(fleet.MemoryGiB?.ToString("0.0") ?? "—")<small>GiB</small></strong>
        <span class="quasar-metric-note">@fleet.MemoryProcesses server and node processes reporting</span>
    </div>
</section>

@if (!IsListView)
{
    <div class="quasar-dashboard-heading"><h2>Fleet workspace</h2><div class="quasar-dashboard-actions">@FleetViewActions</div></div>
}

@* Keep this conditional: the landing page must not build hidden server-list/card DOM. *@
@if (IsListView)
{
    <Servers Embedded="true"
             HideHeader="true"
             HideCreateActions="true"
             HeaderActions="@FleetViewActions"
             DisableResponsiveLayout="true"
             LaunchBlocked="@IsLaunchBlocked"
             LaunchBlockedMessage="@RuntimeWarmupSnapshot.Message"
             ConfigProfileSelected="OpenConfigProfileFromServerListAsync" />
}
else if (Servers.Count == 0 && Clusters.Count == 0)
{
    @if (!ShowSetupWizard)
    {
        <p class="quasar-notice">
            No servers configured yet. Create a server to manage a Space Engineers dedicated server.
        </p>
    }
}
else
{
    <div class="quasar-card-grid">
        @foreach (var server in Servers)
        {
            <div class="quasar-card-cell" @key="@("server:" + server.UniqueName)">
                <ServerCard Server="@server"
                            Runtime="@GetRuntime(server.UniqueName)"
                            Agent="@GetAgent(server.UniqueName)"
                            LaunchBlocked="@IsLaunchBlocked"
                            StartRequested="StartAsync"
                            StopRequested="StopAsync"
                            KillStartingRequested="KillStartingAsync"
                            RestartRequested="RestartAsync"
                            ConfigProfileSelected="OpenConfigProfileFromServerListAsync" />
            </div>
        }
        @foreach (var cluster in Clusters)
        {
            <div class="quasar-card-cell" @key="@("cluster:" + cluster.UniqueName)">
                <ClusterCard Cluster="@cluster" />
            </div>
        }
    </div>
}

<div class="quasar-insights">
    <FleetTelemetryChart Servers="@Servers" Clusters="@Clusters" Agents="@Agents" />
    <section class="quasar-panel">
        <div class="quasar-panel-heading"><h2>Recent activity</h2><span>Lifecycle &amp; commands</span></div>
        @if (RecentActivity.Count == 0)
        {
            <div class="quasar-empty"><h2>No recent activity</h2><p>Server and cluster starts, stops, restarts, and command results appear here.</p></div>
        }
        else
        {
            <ol class="quasar-activity">
                @foreach (var activity in RecentActivity)
                {
                    <li><time datetime="@activity.At.ToString("O")" title="@activity.At.ToLocalTime().ToString("g")">@activity.At.ToLocalTime().ToString("HH:mm")</time><div><strong class="@activity.Tone">@activity.Message</strong><p>@activity.Server</p></div></li>
                }
            </ol>
        }
    </section>
</div>

@code
{
    private RenderFragment FleetViewActions => @<text>
        <div class="quasar-segmented quasar-view-selector" role="group" aria-label="Server view">
            <button type="button" aria-pressed="@(IsCardsView ? "true" : "false")" @onclick="@(() => SetServerViewAsync(DashboardServerView.Cards))"><QuasarIcon Icon="@QuasarIcons.Dashboard" />Cards</button>
            <button type="button" aria-pressed="@(IsListView ? "true" : "false")" @onclick="@(() => SetServerViewAsync(DashboardServerView.List))"><QuasarIcon Icon="@QuasarIcons.ViewList" />List</button>
        </div>
    </text>;

    private const string ServerViewStorageKey = "quasar.dashboard.serverView";
    private const string FirstSetupStorageKey = "quasar.dashboard.firstSetup";
    private enum FirstSetupFlow { Choice, SingleMagnetar, Import, Cluster, Dismissed }
    private sealed record FirstSetupProgress(FirstSetupFlow Flow, string? WorldTemplateId, int? StepOverride = null);
    private FirstSetupFlow _firstSetupFlow = FirstSetupFlow.Choice;
    private bool _disposed;

    private enum DashboardServerView
    {
        Cards,
        List,
    }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ServerViewQuery { get; set; }

    private IReadOnlyList<AgentRuntimeState> Agents => Registry.GetAgents();
    private IReadOnlyList<DedicatedServerDefinition> Servers => ServerCatalog.GetServers();
    private System.Security.Claims.ClaimsPrincipal? _user;
    private IReadOnlyList<ClusterDefinition> Clusters => _user is null ? []
        : ClusterCatalog.GetClusters().Where(cluster => _user.CanQueryCluster(cluster.UniqueName)).ToArray();
    private IReadOnlyList<DedicatedServerRuntimeSnapshot> RuntimeSnapshotList => Supervisor.GetSnapshots();
    private ManagedRuntimeWarmupSnapshot RuntimeWarmupSnapshot => RuntimeWarmup.GetSnapshot();
