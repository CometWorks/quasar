    private string GetNextSetupHint()
    {
        if (ConfiguredServerCount == 0)
        {
            if (SetupWorldTemplate is null)
                return IsDedicatedServerAvailable
                    ? "First: choose a world supplied with Space Engineers Dedicated Server."
                    : DedicatedServerWarmup?.Message ?? "Wait for Space Engineers Dedicated Server download to finish.";

            if (SetupConfigProfile is null)
                return $"Next: create a matching config profile from '{SetupWorldTemplate.Name}'.";

            return "Next: create first server. Matching world template and config profile will already be selected.";
        }

        if (RunningServerCount == 0)
            return "Next: start saved server below. Quasar handles runtime prep on launch.";

        if (ConnectedAgentCount == 0)
            return "Last step: wait here for Quasar.Agent attach. Dashboard updates live when server reports in.";

        return "Setup complete. Dashboard now stays focused on live running servers.";
    }

