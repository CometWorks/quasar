            "Create Matching Config Profile",
            parameters,
            new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result is null || result.Canceled ||
            result.Data is not WorldTemplateConfigProfileDialog.WorldTemplateConfigProfileDialogResult { Profile: { } profile })
        {
            return;
        }

        try
        {
            await ResolveProfileModDependenciesAsync(profile);
            await ConfigProfiles.UpsertAsync(profile);
            Snackbar.Add($"Config profile '{profile.Name}' created from '{worldTemplate.Name}'.", Severity.Success);
            _setupStepOverride = null;
            await InvokeAsync(StateHasChanged);
