    private async Task StartAsync(string uniqueName)
    {
        if (!await EnsureAuthorizedAsync(QuasarPolicyNames.CanControlServers))
            return;

        try
        {
            if (IsLaunchBlocked)
            {
                Snackbar.Add(RuntimeWarmupSnapshot.Message, Severity.Warning);
                return;
            }

            var definition = ServerCatalog.GetServer(uniqueName);
            var worldBlockMessage = GetWorldLaunchBlockMessage(definition);
            if (worldBlockMessage is not null)
            {
                Snackbar.Add(worldBlockMessage, Severity.Warning);
                return;
            }

            await Supervisor.SetGoalStateAsync(uniqueName, DedicatedServerGoalState.On, reconcile: false);
            await Supervisor.StartServerAsync(uniqueName);
            Snackbar.Add($"Start requested for '{uniqueName}'.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task RetryRuntimeWarmupAsync()
    {
        if (!await EnsureAuthorizedAsync(QuasarPolicyNames.CanEditServers))
            return;

        _ = RuntimeWarmup.RetryAsync();
        Snackbar.Add("Dedicated Server download retry started.", Severity.Info);
    }

    private static string? GetWorldLaunchBlockMessage(DedicatedServerDefinition? definition)
    {
        if (definition is null)
            return "Server definition not found.";

        if (string.IsNullOrWhiteSpace(definition.WorldSaveName))
            return "Select a world save before starting this server.";

        var worldPath = definition.GetWorldSavePath();
        if (string.IsNullOrWhiteSpace(worldPath) || !Directory.Exists(worldPath))
            return $"World save folder not found: {worldPath}";

        return File.Exists(Path.Combine(worldPath, "Sandbox.sbc"))
            ? null
            : $"World save '{worldPath}' is missing Sandbox.sbc.";
    }

    private async Task StopAsync(string uniqueName)
    {
        if (!await EnsureAuthorizedAsync(QuasarPolicyNames.CanControlServers))
            return;

        if (!await ConfirmDestructiveActionAsync(
                "Stop server?",
                $"Server '{uniqueName}' will save and shut down normally.",
                "Stop"))
        {
            return;
        }

        try
        {
            await Supervisor.SetGoalStateAsync(uniqueName, DedicatedServerGoalState.Off);
            Snackbar.Add($"Stop requested for '{uniqueName}'.", Severity.Warning);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task ClearErrorStatusAsync(string uniqueName)
    {
        if (!await EnsureAuthorizedAsync(QuasarPolicyNames.CanControlServers))
            return;

        try
        {
            var cleared = await Supervisor.ClearErrorStatusAsync(uniqueName);
            Snackbar.Add(
                cleared
                    ? $"Error status cleared for '{uniqueName}'."
                    : $"No clearable error status for '{uniqueName}'.",
                cleared ? Severity.Success : Severity.Info);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task KillStartingAsync(string uniqueName)
    {
        if (!await EnsureAuthorizedAsync(QuasarPolicyNames.CanControlServers))
            return;

        if (!await ConfirmDestructiveActionAsync(
                "Kill starting server?",
                $"Server '{uniqueName}' will be killed while it is starting. Unsaved startup progress can be lost.",
                "Kill"))
        {
            return;
        }

        try
        {
            await Supervisor.KillStartingServerAsync(uniqueName);
            Snackbar.Add($"Starting server '{uniqueName}' killed.", Severity.Warning);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task<bool> ConfirmDestructiveActionAsync(string title, string message, string yesText)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            title,
            message,
            yesText: yesText,
            cancelText: "Cancel");

        return confirmed == true;
    }

    private async Task RestartAsync(string uniqueName)
    {
        if (!await EnsureAuthorizedAsync(QuasarPolicyNames.CanControlServers))
            return;

        try
        {
            await Supervisor.RestartServerAsync(uniqueName);
            Snackbar.Add($"Restart requested for '{uniqueName}'.", Severity.Info);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task<bool> EnsureAuthorizedAsync(string policyName)
    {
        if (await Permissions.IsAuthorizedAsync(policyName))
            return true;

        Snackbar.Add("Access denied: your current role cannot perform this action.", Severity.Error);
        return false;
    }

    private bool IsRunning(string uniqueName)
    {
        var state = GetRuntime(uniqueName)?.State ?? DedicatedServerProcessState.Stopped;
        return state is DedicatedServerProcessState.Starting
            or DedicatedServerProcessState.Running
            or DedicatedServerProcessState.Restarting
            or DedicatedServerProcessState.Stopping;
    }

    private DedicatedServerRuntimeSnapshot? GetRuntime(string uniqueName)
    {
        RuntimeSnapshots.TryGetValue(uniqueName, out var runtime);
        return runtime;
    }

    private AgentRuntimeState? GetAgent(string uniqueName)
    {
        return Agents
            .Where(agent => agent.IsConnected && !agent.IsCluster)
            .FirstOrDefault(agent => string.Equals(agent.UniqueNameKey, uniqueName, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsOpen(string uniqueName)
    {
        var runtime = GetRuntime(uniqueName);
        var agent = GetAgent(uniqueName);
        return runtime?.State == DedicatedServerProcessState.Running &&
               agent?.IsConnected == true &&
               agent.Snapshot is not null;
    }

    private static string GetProblemCardClass(int count, bool error) =>
        count <= 0
            ? ""
            : error
                ? " summary-card-error"
                : " summary-card-warning";

    private static string FirstNonEmpty(params string[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private string GetServerSetupSummary(DedicatedServerDefinition server)
    {
        var configProfileName = string.IsNullOrWhiteSpace(server.ConfigProfileId)
            ? "No config profile"
            : ConfigProfiles.GetProfile(server.ConfigProfileId)?.Name ?? $"Missing config: {server.ConfigProfileId}";

        var worldTemplateName = string.IsNullOrWhiteSpace(server.WorldSaveName)
            ? "No world save"
            : $"Save: {server.WorldSaveName}";

        return $"{configProfileName} | {worldTemplateName}";
    }

    private string GetSetupRuntimeSummary(string uniqueName)
    {
        var runtime = GetRuntime(uniqueName);
        if (runtime is null)
            return "No runtime snapshot yet.";

        if (runtime.AgentAttached)
            return "Agent attached. Live dashboard data ready.";

        if (runtime.ProcessId is int processId)
            return $"Process {processId} running. Waiting for Quasar.Agent attach.";

        return "Launch requested. Waiting for process and agent.";
    }

    private string GetSetupStateText(string uniqueName)
    {
        return (GetRuntime(uniqueName)?.State ?? DedicatedServerProcessState.Stopped)
            .ToString()
            .ToLowerInvariant();
    }

    private Color GetSetupStateColor(string uniqueName)
    {
        var state = GetRuntime(uniqueName)?.State ?? DedicatedServerProcessState.Stopped;
        return state switch
        {
            DedicatedServerProcessState.Running => Color.Success,
            DedicatedServerProcessState.Starting => Color.Info,
            DedicatedServerProcessState.Restarting => Color.Warning,
            DedicatedServerProcessState.Stopping => Color.Warning,
            DedicatedServerProcessState.Crashed => Color.Error,
            DedicatedServerProcessState.Faulted => Color.Error,
            _ => Color.Default,
        };
    }

    private string GetSetupAgentText(string uniqueName)
    {
        var runtime = GetRuntime(uniqueName);
        if (runtime is null)
            return "not attached";

        return runtime.AgentAttached ? "attached" : "waiting";
    }

    private Color GetSetupAgentColor(string uniqueName)
    {
        var runtime = GetRuntime(uniqueName);
        if (runtime is null)
            return Color.Default;

        return runtime.AgentAttached ? Color.Success : Color.Warning;
    }

    private Color GetRuntimeWarmupColor()
    {
        var snapshot = RuntimeWarmupSnapshot;
        if (snapshot.Components.Any(IsRuntimeComponentActive))
            return Color.Info;

        return snapshot.State switch
        {
            ManagedRuntimeWarmupState.Complete => Color.Success,
            ManagedRuntimeWarmupState.Failed => Color.Error,
            ManagedRuntimeWarmupState.Running => Color.Info,
            _ => Color.Default,
        };
    }

    private string GetRuntimeWarmupLabel()
    {
        var snapshot = RuntimeWarmupSnapshot;
        if (snapshot.Components.Any(IsRuntimeComponentActive))
            return "Updating";

        return snapshot.State switch
        {
            ManagedRuntimeWarmupState.Complete => "Ready",
            ManagedRuntimeWarmupState.Failed => "Failed",
            ManagedRuntimeWarmupState.Running => "Preparing",
            _ => "Pending",
        };
    }

    private bool ShouldShowRuntimeWarmup()
    {
        var snapshot = RuntimeWarmupSnapshot;
        return snapshot.State != ManagedRuntimeWarmupState.Complete ||
               snapshot.Components.Any(IsRuntimeComponentActive) ||
               snapshot.Components.Any(component =>
                   component.Component == ManagedRuntimeInstallComponent.SteamCmd &&
                   component.State == ManagedRuntimeComponentState.Failed);
    }

    private static bool IsRuntimeComponentActive(ManagedRuntimeComponentSnapshot component) =>
        component.State is ManagedRuntimeComponentState.Checking
            or ManagedRuntimeComponentState.Downloading
            or ManagedRuntimeComponentState.Installing;

    private static Color GetRuntimeComponentColor(ManagedRuntimeComponentSnapshot component) => component.State switch
    {
        ManagedRuntimeComponentState.Ready => Color.Success,
        ManagedRuntimeComponentState.Failed => Color.Error,
        ManagedRuntimeComponentState.Downloading => Color.Info,
        ManagedRuntimeComponentState.Installing => Color.Info,
        ManagedRuntimeComponentState.Checking => Color.Info,
        _ => Color.Default,
    };

    private static string GetRuntimeComponentLabel(ManagedRuntimeComponentSnapshot component) => component.State switch
    {
        ManagedRuntimeComponentState.Ready => "Ready",
        ManagedRuntimeComponentState.Failed => "Failed",
        ManagedRuntimeComponentState.Downloading when component.Percent.HasValue => $"{component.Percent.Value}%",
        ManagedRuntimeComponentState.Downloading => "Downloading",
        ManagedRuntimeComponentState.Installing => "Installing",
        ManagedRuntimeComponentState.Checking => "Checking",
        _ => "Pending",
    };

    private static bool CanRetryRuntimeComponent(ManagedRuntimeComponentSnapshot component) =>
        component.Component is (ManagedRuntimeInstallComponent.DedicatedServer
            or ManagedRuntimeInstallComponent.Magnetar
            or ManagedRuntimeInstallComponent.SteamCmd) &&
        component.State == ManagedRuntimeComponentState.Failed;

}
