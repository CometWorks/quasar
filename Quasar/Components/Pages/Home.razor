    private async Task LoadServerViewPreferenceAsync()
    {
        if (_serverViewLoadedFromStorage || TryParseServerView(ServerViewQuery, out _))
            return;

        _serverViewLoadedFromStorage = true;
        try
        {
            var stored = await BrowserStorage.GetStringAsync(ServerViewStorageKey);
            if (TryParseServerView(stored, out var storedView) && storedView != _serverView)
            {
                _serverView = storedView;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ShowFirstSetupChoiceOnceAsync()
    {
        if (_firstSetupChoiceAttempted || ConfiguredServerCount > 0)
            return;

        _firstSetupChoiceAttempted = true;
        try
        {
            var stored = await BrowserStorage.GetStringAsync(FirstSetupChoiceStorageKey);
            if (string.Equals(stored, "shown", StringComparison.OrdinalIgnoreCase))
                return;
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }

        if (!await EnsureServerSetupAuthorizedAsync())
            return;

        try
        {
            await BrowserStorage.SetStringAsync(FirstSetupChoiceStorageKey, "shown");
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }

        await OpenServerSetupDialogCoreAsync(offerCreateNew: true);
    }

