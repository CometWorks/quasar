    protected override void OnParametersSet()
    {
        if (TryParseServerView(ServerViewQuery, out var queryView))
        {
            _serverView = queryView;
            _serverViewLoadedFromStorage = true;
            _ = SaveServerViewPreferenceAsync(queryView);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadServerViewPreferenceAsync();
        await ShowFirstSetupChoiceOnceAsync();
    }

    private async Task LoadServerViewPreferenceAsync()
    {
        if (_serverViewLoadedFromStorage || TryParseServerView(ServerViewQuery, out _))
            return;

        _serverViewLoadedFromStorage = true;
        try
        {
            var stored = await BrowserStorage.GetStringAsync(ServerViewStorageKey);
            if (TryParseServerView(stored, out var storedView) && storedView != _serverView)
            {
                _serverView = storedView;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ShowFirstSetupChoiceOnceAsync()
    {
        if (_firstSetupChoiceAttempted || _disposed)
            return;

        _firstSetupChoiceAttempted = true;
        FirstSetupProgress? saved = null;
        try
        {
            saved = await BrowserStorage.GetJsonAsync<FirstSetupProgress>(FirstSetupStorageKey);
        }
        catch (Exception error) when (error is InvalidOperationException or JSException or System.Text.Json.JsonException) { }

        if (_disposed) return;
        if (saved?.Flow == FirstSetupFlow.Dismissed || saved is null && ConfiguredServerCount > 0)
            return;

        if (!await EnsureServerSetupAuthorizedAsync())
            return;

        if (saved is not null && Enum.IsDefined(saved.Flow))
        {
            _setupWorldTemplateId = saved.WorldTemplateId;
            _setupStepOverride = saved.StepOverride is >= 0 and <= 4 ? saved.StepOverride : null;
            _firstSetupFlow = saved.Flow;
            if (_firstSetupFlow == FirstSetupFlow.Cluster && (!OperatingSystem.IsLinux()
                || !await Permissions.IsAuthorizedAsync(QuasarPolicyNames.ClusterManage)))
                _firstSetupFlow = FirstSetupFlow.Choice;
            if (_firstSetupFlow is FirstSetupFlow.SingleMagnetar or FirstSetupFlow.Cluster)
            {
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        await OpenServerSetupDialogCoreAsync(offerCreateNew: true, startInImport: _firstSetupFlow == FirstSetupFlow.Import);
    }

