        _setupStepOverride = null;
        await SetFirstSetupFlowAsync(FirstSetupFlow.SingleMagnetar);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenSetupConfigProfileDialogAsync()
    {
        if (!await EnsureAuthorizedAsync(QuasarPolicyNames.CanEditConfigs))
            return;

        if (SetupConfigProfile is { } existingProfile)
        {
            await OpenConfigProfileFromServerListAsync(existingProfile.ConfigProfileId);
            return;
        }

        var worldTemplate = SetupWorldTemplate;
        if (worldTemplate is null)
            return;

        var parameters = new DialogParameters
        {
            [nameof(WorldTemplateConfigProfileDialog.WorldName)] = worldTemplate.Name,
            [nameof(WorldTemplateConfigProfileDialog.WorldPath)] = WorldTemplates.GetWorldDirectory(worldTemplate.WorldTemplateId),
            [nameof(WorldTemplateConfigProfileDialog.WorldTemplateId)] = worldTemplate.WorldTemplateId,
            [nameof(WorldTemplateConfigProfileDialog.AllowSkip)] = false,
        };
        var dialog = await DialogService.ShowAsync<WorldTemplateConfigProfileDialog>(
            "Create Matching Config Profile",
            parameters,
            new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result is null || result.Canceled ||
            result.Data is not WorldTemplateConfigProfileDialog.WorldTemplateConfigProfileDialogResult { Profile: { } profile })
        {
            return;
        }

        try
        {
            await ResolveProfileModDependenciesAsync(profile);
            await ConfigProfiles.UpsertAsync(profile);
            Snackbar.Add($"Config profile '{profile.Name}' created from '{worldTemplate.Name}'.", Severity.Success);
            _setupStepOverride = null;
            await SetFirstSetupFlowAsync(FirstSetupFlow.SingleMagnetar);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

