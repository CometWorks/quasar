    private async Task ResolveProfileModDependenciesAsync(QuasarConfigProfile profile)
    {
        if (profile.Mods.Count == 0)
            return;

        var result = await WorkshopMods.ResolveDependenciesAsync(profile.Mods);
        profile.Mods = result.Mods.ToList();
        profile.RootSettings.AutodetectDependencies = result.Warnings.Count > 0;

        if (result.AddedDependencyCount > 0)
            Snackbar.Add($"Added {result.AddedDependencyCount} dependency mod(s).", Severity.Success);

        if (result.Warnings.Count > 0)
            Snackbar.Add($"Mod dependency check: {SummarizeWarnings(result.Warnings)}", Severity.Warning);
    }

    private static string SummarizeWarnings(IReadOnlyList<string> warnings)
    {
        var preview = warnings.Take(2).ToList();
        var summary = string.Join(" ", preview);
        return warnings.Count > preview.Count
            ? $"{summary} (+{warnings.Count - preview.Count} more)"
            : summary;
    }

