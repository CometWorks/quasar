    private async Task<bool> EnsureServerSetupAuthorizedAsync() =>
        await EnsureAuthorizedAsync(QuasarPolicyNames.CanEditServers) &&
        await EnsureAuthorizedAsync(QuasarPolicyNames.CanEditConfigs);

    private async Task OpenServerSetupDialogCoreAsync(bool offerCreateNew, bool startInImport = false)
    {
        if (_serverSetupDialogOpen || _disposed)
            return;

        _serverSetupDialogOpen = true;
        try
        {
            await SetFirstSetupFlowAsync(!offerCreateNew || startInImport ? FirstSetupFlow.Import : FirstSetupFlow.Choice);
            var parameters = new DialogParameters
            {
                [nameof(ExistingServerImportDialog.OfferCreateNew)] = offerCreateNew,
                [nameof(ExistingServerImportDialog.OfferCluster)] = OperatingSystem.IsLinux()
                    && await Permissions.IsAuthorizedAsync(QuasarPolicyNames.ClusterManage),
                [nameof(ExistingServerImportDialog.StartInImport)] = startInImport,
                [nameof(ExistingServerImportDialog.ImportModeChanged)] = EventCallback.Factory.Create<bool>(this,
                    importing => SetFirstSetupFlowAsync(importing ? FirstSetupFlow.Import : FirstSetupFlow.Choice)),
                [nameof(ExistingServerImportDialog.ImportCompleted)] = EventCallback.Factory.Create<ExistingServerImportResult>(this, async imported =>
                {
                    if (_disposed) return;
                    _setupWorldTemplateId = imported.Server.WorldTemplateId;
                    _setupStepOverride = null;
                    await SetFirstSetupFlowAsync(FirstSetupFlow.SingleMagnetar);
                }),
            };

            var dialog = await DialogService.ShowAsync<ExistingServerImportDialog>(
                offerCreateNew ? "Set Up First Server" : "Import Existing Server",
                parameters,
                new DialogOptions
                {
                    CloseOnEscapeKey = false,
                    BackdropClick = false,
                    FullWidth = true,
                    MaxWidth = MaxWidth.Large,
                });
            var result = await dialog.Result;
            if (_disposed) return;
            if (result is null || result.Canceled ||
                result.Data is not ExistingServerImportDialog.DialogOutcome outcome)
            {
                await HideSetupWizard();
                return;
            }

            if (outcome.StartClusterSetup)
            {
                if (OperatingSystem.IsLinux() && await EnsureAuthorizedAsync(QuasarPolicyNames.ClusterManage))
                {
                    await SetFirstSetupFlowAsync(FirstSetupFlow.Cluster);
                    Navigation.NavigateTo("clusters/new");
                }
                return;
            }
            if (outcome.StartNewSetup)
            {
                _setupStepOverride = null;
                await SetFirstSetupFlowAsync(FirstSetupFlow.SingleMagnetar);
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (outcome.ImportResult is not { } imported)
                return;

            await HideSetupWizard();
            Snackbar.Add($"Imported server '{imported.Server.DisplayName}'. Review it before starting.", Severity.Success);
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _serverSetupDialogOpen = false;
        }
    }

