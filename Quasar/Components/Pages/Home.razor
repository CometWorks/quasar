            return;

        var parameters = new DialogParameters
        {
            [nameof(WorldTemplateQuickImportDialog.TemplateOnly)] = true,
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Large,
        };

        var dialog = await DialogService.ShowAsync<WorldTemplateQuickImportDialog>(
            "Choose Dedicated Server World",
            parameters,
            options);
        var result = await dialog.Result;
        if (result is null || result.Canceled ||
            result.Data is not WorldTemplateQuickImportDialog.WorldTemplateQuickImportResult importResult)
