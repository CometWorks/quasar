@page "/world-templates"
@page "/worlds"
@attribute [Authorize(Policy = QuasarPolicyNames.CanView)]
@implements IDisposable
@inject QuasarPermissionService Permissions
@inject QuasarWorldTemplateCatalog WorldTemplateCatalog
@inject QuasarConfigProfileCatalog ConfigProfiles
@inject QuasarWorkshopModResolver WorkshopMods
@inject DedicatedServerCatalog Servers
@inject DedicatedServerSupervisor Supervisor
@inject ServerManagementActions ServerActions
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Worlds</PageTitle>
<QuasarPageHeading Section="Configuration">
    <Title>Worlds</Title>
    <Description>Import worlds directly into existing servers, or manage reusable starting templates.</Description>
    <Actions>
        <AuthorizeView Policy="@QuasarPolicyNames.CanEditServers">
            <button type="button" class="quasar-button quasar-button-primary" @onclick="OpenImportToServerAsync"><QuasarIcon Icon="@QuasarIcons.Public" />Import World to Server...</button>
        </AuthorizeView>
    </Actions>
</QuasarPageHeading>
<MudTabs Elevation="0" Outlined="true" ApplyEffectsToContainer="true" TabPanelsClass="worlds-tab-content">
    <MudTabPanel Text="Server worlds" Icon="@Icons.Material.Filled.Dns">
        <section class="quasar-panel pa-4">
            <h2 class="quasar-text quasar-type-h6">Server worlds</h2>
            <p>Each standalone server selects its own save. Importing selects a new save and keeps the previous save on disk. Cluster worlds use the cluster deployment flow.</p>
            <MudTable T="DedicatedServerDefinition" Items="_serverRows.Reuse(Servers.GetServers())" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent><MudTh>Server</MudTh><MudTh>Selected save</MudTh><MudTh>Configuration profile</MudTh><MudTh>Status / goal</MudTh><MudTh>Actions</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Server">@(string.IsNullOrWhiteSpace(context.DisplayName) ? context.UniqueName : context.DisplayName)<br /><small class="mono">@context.UniqueName</small></MudTd>
                    <MudTd DataLabel="Selected save">@context.WorldSaveName</MudTd>
                    <MudTd DataLabel="Configuration profile">@(ConfigProfiles.GetProfile(context.ConfigProfileId)?.Name ?? context.ConfigProfileId)</MudTd>
                    <MudTd DataLabel="Status / goal">@Status(context) / @context.GoalState</MudTd>
                    <MudTd DataLabel="Actions">
                        <AuthorizeView Policy="@QuasarPolicyNames.CanEditServers" Context="importPermission">
                            <span title="@(ServerActions.CanImportWorld(context) ? "Import a save folder or ZIP" : "Stop the server and set its goal Off; wait for any backup, restore or import")">
                                <button type="button" class="quasar-button" disabled="@(!ServerActions.CanImportWorld(context))" @onclick="@(() => ServerActions.OpenWorldImportDialogAsync(context))">Import World...</button>
                            </span>
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><p class="pa-4">No standalone servers yet. Create a server from Dashboard before importing a world into it.</p></NoRecordsContent>
            </MudTable>
        </section>
    </MudTabPanel>
    <MudTabPanel Text="Templates" Icon="@QuasarIcons.Public">
        <section class="quasar-panel pa-4 server-card">
            <div class="quasar-panel-heading">
                <h2 class="quasar-text quasar-type-h6">Reusable templates</h2>
                <AuthorizeView Policy="@QuasarPolicyNames.CanEditConfigs" Context="addTemplatePermission">
                    <button type="button" class="quasar-button quasar-button-primary" @onclick="OpenAddTemplateAsync">Add Template...</button>
                </AuthorizeView>
            </div>
            
            <div>
                <p class="quasar-text quasar-type-body2 mb-4">Keep reusable starting worlds here. Add predefined worlds, a save folder or a ZIP, then create independent server saves from templates.</p>
            </div>

            @if (Templates.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No world templates yet. Use Add Template to import a predefined world, save folder or ZIP.
                </MudAlert>
            }
            else
            {
                <MudTable T="WorldTemplateRow" Dense="true" Hover="true" Items="Templates">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<WorldTemplateRow, object>(x => x.FileSizeMb)">Size</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<WorldTemplateRow, object>(x => x.Template.UpdatedAtUtc)">Updated</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<WorldTemplateRow, object>(x => x.Template.Name)">Name</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<WorldTemplateRow, object>(x => x.Template.Description)">Description</MudTableSortLabel></MudTh>
                        <MudTh Class="quasar-actions-column"><span class="quasar-visually-hidden">Actions</span></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Size">
                            @if (context.WorldExists)
                            {
                                <span class="quasar-text quasar-type-caption">@context.FileSizeMb MB</span>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">missing</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Updated"><QuasarStackedTimestamp Value="@context.Template.UpdatedAtUtc" /></MudTd>
                        <MudTd DataLabel="Name">@context.Template.Name</MudTd>
                        <MudTd DataLabel="Description">@context.Template.Description</MudTd>
                        <MudTd DataLabel="" Class="quasar-actions-column">
                            <AuthorizeView Policy="@QuasarPolicyNames.CanEditConfigs" Context="permissionContext">
                            <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-0">
                                <MudTooltip Text="Create config profile from world settings">
                                    <MudIconButton Icon="@Icons.Material.Filled.SettingsApplications"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => CreateConfigProfileFromTemplateAsync(context))"
                                                   Disabled="@(!context.WorldExists || _importing)" />
                                </MudTooltip>
                                <MudTooltip Text="Clone template">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   OnClick="@(() => CloneAsync(context))"
                                                   Disabled="@(!context.WorldExists || _importing)" />
                                </MudTooltip>
                                <MudTooltip Text="Delete template">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteAsync(context.Template))" />
                                </MudTooltip>
                            </div>
                            </AuthorizeView>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </section>
    </MudTabPanel>
</MudTabs>

@code
{
    private bool _importing;

    private sealed record WorldTemplateRow(
        QuasarWorldTemplate Template,
        bool WorldExists,
        long FileSizeMb);

    private readonly StableRows<DedicatedServerDefinition> _serverRows = new(server => server.UniqueName);
    private readonly StableRows<WorldTemplateRow> _templateRows = new(row => row.Template.WorldTemplateId);

    private IReadOnlyList<WorldTemplateRow> Templates => _templateRows.Reuse(
        WorldTemplateCatalog.GetTemplates()
            .Select(p =>
            {
                var worldDir = WorldTemplateCatalog.GetWorldDirectory(p.WorldTemplateId);
                var exists = Directory.Exists(worldDir);
                var sizeMb = exists
                    ? (long)Math.Round(new DirectoryInfo(worldDir).GetFiles("*", SearchOption.AllDirectories).Sum(f => f.Length) / 1048576.0)
                    : 0;
                return new WorldTemplateRow(p, exists, sizeMb);
            })
            .ToList());

    protected override void OnInitialized()
    {
        WorldTemplateCatalog.Changed += HandleChanged;
        Servers.Changed += HandleChanged;
        Supervisor.Changed += HandleChanged;
        ConfigProfiles.Changed += HandleChanged;
    }

    public void Dispose()
    {
        WorldTemplateCatalog.Changed -= HandleChanged;
        Servers.Changed -= HandleChanged;
        Supervisor.Changed -= HandleChanged;
        ConfigProfiles.Changed -= HandleChanged;
    }

    private string Status(DedicatedServerDefinition server) =>
        (Supervisor.GetSnapshots().FirstOrDefault(item => item.UniqueName.Equals(server.UniqueName, StringComparison.OrdinalIgnoreCase))?.State
            ?? DedicatedServerProcessState.Stopped).ToString();

    private async Task OpenImportToServerAsync()
    {
        if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanEditServers)) return;
        var dialog = await DialogService.ShowAsync<ServerWorldImportTargetDialog>("Import World to Server",
            new DialogParameters(), new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false, Data: DedicatedServerDefinition server })
            await ServerActions.OpenWorldImportDialogAsync(server);
    }

    private async Task OpenAddTemplateAsync()
    {
        if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanEditConfigs)) return;
        await DialogService.ShowAsync<WorldTemplateQuickImportDialog>("Add World Template",
            new DialogParameters(), new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium });
    }

    private async Task CloneAsync(WorldTemplateRow row)
    {
        if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanEditConfigs)) return;
        var sourceDir = WorldTemplateCatalog.GetWorldDirectory(row.Template.WorldTemplateId);
        var newName = $"{row.Template.Name} (Copy)";
        _importing = true;
        try
        {
            await WorldTemplateCatalog.ImportAsync(newName, row.Template.Description, sourceDir);
            Snackbar.Add($"World template '{newName}' created.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task CreateConfigProfileFromTemplateAsync(WorldTemplateRow row)
    {
        if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanEditConfigs)) return;
        if (!row.WorldExists)
            return;

        var profilePrompt = await PromptForConfigProfileAsync(row.Template, allowSkip: false);
        if (profilePrompt.Canceled || profilePrompt.Profile is null)
            return;

        _importing = true;
        try
        {
            await CreateConfigProfileAsync(profilePrompt.Profile, row.Template.WorldTemplateId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task<(bool Canceled, QuasarConfigProfile? Profile)> PromptForConfigProfileAsync(
        QuasarWorldTemplate template,
        bool allowSkip)
    {
        var parameters = new DialogParameters
        {
            [nameof(WorldTemplateConfigProfileDialog.WorldName)] = template.Name,
            [nameof(WorldTemplateConfigProfileDialog.WorldPath)] = WorldTemplateCatalog.GetWorldDirectory(template.WorldTemplateId),
            [nameof(WorldTemplateConfigProfileDialog.WorldTemplateId)] = template.WorldTemplateId,
            [nameof(WorldTemplateConfigProfileDialog.AllowSkip)] = allowSkip,
        };

        var dialog = await DialogService.ShowAsync<WorldTemplateConfigProfileDialog>(
            "Config Profile From World",
            parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled)
            return (true, null);

        if (result.Data is WorldTemplateConfigProfileDialog.WorldTemplateConfigProfileDialogResult profileResult)
            return (false, profileResult.Profile);

        return (false, null);
    }

    private async Task<string?> CreateConfigProfileAsync(QuasarConfigProfile? profile, string worldTemplateId)
    {
        if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanEditConfigs)) return null;
        if (profile is null)
            return null;

        profile.SourceWorldTemplateId = worldTemplateId;
        await ResolveProfileModDependenciesAsync(profile);
        if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanEditConfigs)) return null;
        await ConfigProfiles.UpsertAsync(profile);
        Snackbar.Add($"Config profile '{profile.Name}' created from world settings.", Severity.Success);
        await OpenConfigProfileEditorAsync(profile.ConfigProfileId);
        return profile.ConfigProfileId;
    }

    private async Task ResolveProfileModDependenciesAsync(QuasarConfigProfile profile)
    {
        if (profile.Mods.Count == 0)
            return;

        var result = await WorkshopMods.ResolveDependenciesAsync(profile.Mods);
        profile.Mods = result.Mods.ToList();
        profile.RootSettings.AutodetectDependencies = result.Warnings.Count > 0;

        if (result.AddedDependencyCount > 0)
            Snackbar.Add($"Added {result.AddedDependencyCount} dependency mod(s).", Severity.Success);

        if (result.Warnings.Count > 0)
            Snackbar.Add($"Mod dependency check: {SummarizeWarnings(result.Warnings)}", Severity.Warning);
    }

    private static string SummarizeWarnings(IReadOnlyList<string> warnings)
    {
        var preview = warnings.Take(2).ToList();
        var summary = string.Join(" ", preview);
        if (warnings.Count > preview.Count)
            summary = $"{summary} (+{warnings.Count - preview.Count} more)";

        return summary;
    }

    private async Task OpenConfigProfileEditorAsync(string configProfileId)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfigsPageDialog.InitialProfileId)] = configProfileId,
        };

        var dialog = await DialogService.ShowAsync<ConfigsPageDialog>(
            "Config Profiles",
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                FullScreen = true,
            });

        await dialog.Result;
    }

    private async Task DeleteAsync(QuasarWorldTemplate template)
    {
        if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanEditConfigs)) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete world template?",
            $"'{template.Name}' will be permanently removed along with its imported world files. This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanEditConfigs)) return;
        await WorldTemplateCatalog.DeleteAsync(template.WorldTemplateId);
        Snackbar.Add("World template deleted.", Severity.Info);
    }

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);
}
