@page "/clusters/new"
@attribute [Authorize(Policy = QuasarPolicyNames.ClusterManage)]
@attribute [ExcludeFromInteractiveRouting]
@using Quasar.Client.Components
@layout WasmPageLayout

<PageTitle>Set up cluster</PageTitle>
<SetupCluster Resume="@Resume" Register="Register" Attempt="Attempt" @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />

@code {
    [SupplyParameterFromQuery] public string? Resume { get; set; }
    [SupplyParameterFromQuery] public bool Register { get; set; }
    [SupplyParameterFromQuery] public Guid? Attempt { get; set; }
}
