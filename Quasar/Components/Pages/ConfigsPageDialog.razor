<MudDialog>
    <TitleContent>
        <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-1">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="Close" title="Back to dashboard" />
            <h2 class="quasar-text quasar-type-h6">Config Profiles</h2>
        </div>
    </TitleContent>
    <DialogContent>
        <Configs @ref="_configs" InitialProfileId="@InitialProfileId" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Done</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? InitialProfileId { get; set; }

    private Configs? _configs;

    private async Task Close()
    {
        if (_configs is not null && !await _configs.ConfirmPendingChangesBeforeLeavingAsync())
            return;

        MudDialog.Close();
    }
}
