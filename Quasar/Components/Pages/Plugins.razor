@page "/plugins"
@attribute [Authorize(Policy = QuasarPolicyNames.CanView)]
@implements IDisposable
@inject AgentRegistry Registry
@inject DedicatedServerCatalog ServerCatalog
@inject PluginConfigService ConfigService

<PageTitle>Plugins</PageTitle>

<QuasarPageHeading Section="Operations">
    <Title>Plugin configuration</Title>
    <Description>Live configuration for plugins that expose a Quasar config provider.</Description>
</QuasarPageHeading>

@if (ConfigAgents.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No connected server is exposing editable plugin configuration.
    </MudAlert>
}
else
{
    var selectedAgent = GetSelectedConfigAgent();

    <MudSelect T="string"
               Label="Server"
               Value="@selectedAgent?.AgentId"
               ValueChanged="HandleConfigAgentChanged"
               Variant="Variant.Outlined"
               Dense="true"
               Class="mb-4"
               Style="max-width: 24rem;">
        @foreach (var agent in ConfigAgents)
        {
            <MudSelectItem T="string" Value="@agent.AgentId">@ResolveServerName(agent)</MudSelectItem>
        }
    </MudSelect>

    @if (selectedAgent is not null)
    {
        <section class="quasar-panel server-card mb-4 pa-4">
            <h2 class="quasar-text quasar-type-h6">@ResolveServerName(selectedAgent)</h2>
            <span class="quasar-text quasar-type-caption mud-text-secondary d-block mb-3">@selectedAgent.HostDisplayName</span>
            <MudExpansionPanels Class="mb-2" MultiExpansion="true">
                @foreach (var plugin in ConfigService.GetConfigsForAgent(selectedAgent.AgentId))
                {
                    var pluginId = plugin.PluginId;
                    <MudExpansionPanel Text="@plugin.DisplayName"
                                       Expanded="@(_expandedConfigPluginId == pluginId)"
                                       ExpandedChanged="expanded => HandleConfigPanelToggled(pluginId, expanded)">
                        @if (_expandedConfigPluginId == pluginId)
                        {
                            // Construct the editor only while its panel is open. Keeping every
                            // plugin's editor mounted at once is too many DOM nodes.
                            <AuthorizeView Policy="@QuasarPolicyNames.CanEditConfigs" Context="configPermission">
                            <Authorized>
                            @if (selectedAgent.IsCluster)
                            {
                                <MudAlert Severity="Severity.Info">
                                    Plugin configuration is managed for the whole cluster.
                                    Open the cluster's plugin settings to use the configuration editor and stage changes for all nodes.
                                </MudAlert>
                                <MudButton Href="@($"clusters/{Uri.EscapeDataString(selectedAgent.ClusterId)}#cluster-settings")"
                                           Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3">
                                    Open cluster plugin settings
                                </MudButton>
                            }
                            else
                            {
                                <PluginConfigEditor @key="(selectedAgent.AgentId, selectedAgent.ConnectionId, plugin.PluginId)" AgentId="@selectedAgent.AgentId" ConnectionId="@selectedAgent.ConnectionId" Plugin="@plugin" />
                            }
                            </Authorized>
                            <NotAuthorized>
                                <p class="quasar-muted">Configuration values require editor access because they may contain credentials.</p>
                            </NotAuthorized>
                            </AuthorizeView>
                        }
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </section>
    }
}

<h2 class="quasar-text quasar-type-h5 mt-8 mb-2">Plugin logs</h2>
<p class="quasar-text quasar-type-body2 mb-4 mud-text-secondary">
    Structured logs emitted by plugins through the PluginSdk, captured from managed dedicated servers.
</p>

<PluginLogPanel />

@code
{
    private string? _selectedConfigAgentId;

    // PluginId of the single config panel currently expanded (null = none). Only the
    // open panel's editor is constructed, and opening one collapses any other.
    private string? _expandedConfigPluginId;

    private List<AgentRuntimeState> ConfigAgents => Registry
        .GetAgents()
        .Where(agent => agent.IsConnected && ConfigService.HasConfigs(agent.AgentId))
        .ToList();

    protected override void OnInitialized()
    {
        Registry.Changed += HandleRegistryChanged;
        ServerCatalog.Changed += HandleRegistryChanged;
        ConfigService.Changed += HandleRegistryChanged;
    }

    public void Dispose()
    {
        Registry.Changed -= HandleRegistryChanged;
        ServerCatalog.Changed -= HandleRegistryChanged;
        ConfigService.Changed -= HandleRegistryChanged;
    }

    private void HandleRegistryChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    // Prefer the name configured for the server in Quasar over the agent's in-game
    // server name (ConfigDedicated.ServerName, often blank and falling back to
    // "Space Engineers {pid}"). Matches how the Servers/dashboard cards resolve it.
    private string ResolveServerName(AgentRuntimeState agent)
    {
        if (agent.IsCluster) return $"{agent.ClusterId} / {agent.ClusterSlot} / {agent.ClusterNodeId} / epoch {agent.ClusterEpoch}";
        var configuredName = ServerCatalog.GetServer(agent.UniqueNameKey)?.DisplayName;
        return string.IsNullOrWhiteSpace(configuredName) ? agent.ServerDisplayName : configuredName;
    }

    // The selected server falls back to the first available one so the panel always
    // shows a server's plugins even before the user picks one (or after the selected
    // server disconnects).
    private AgentRuntimeState? GetSelectedConfigAgent()
    {
        var agents = ConfigAgents;
        if (agents.Count == 0)
            return null;

        return agents.FirstOrDefault(agent =>
            string.Equals(agent.AgentId, _selectedConfigAgentId, StringComparison.OrdinalIgnoreCase))
            ?? agents[0];
    }

    private void HandleConfigAgentChanged(string agentId)
    {
        _selectedConfigAgentId = agentId;
        // Switching servers tears down the old server's panels, so drop the open one.
        _expandedConfigPluginId = null;
    }

    private void HandleConfigPanelToggled(string pluginId, bool expanded)
    {
        // Single-open: track the newly opened panel, or clear when it collapses.
        if (expanded)
            _expandedConfigPluginId = pluginId;
        else if (_expandedConfigPluginId == pluginId)
            _expandedConfigPluginId = null;
    }
}
