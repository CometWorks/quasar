@page "/settings/server-list"
@attribute [Authorize(Policy = QuasarPolicyNames.CanView)]
@using Quasar.Services.ServerList
@inject ServerListSettingsCatalog Settings
@inject DedicatedServerCatalog Servers
@inject ClusterCatalog Clusters
@inject DataHandlingConsentCatalog Consent
@inject RbacConfigCatalog Rbac
@inject QuasarPermissionService Permissions
@inject ISnackbar Snackbar

<PageTitle>Server listing</PageTitle>
<div class="quasar-page-heading"><div><div class="quasar-eyebrow">Settings</div><h1>Server listing</h1><p>Choose which standalone Magnetar servers and clusters appear on se-servers.net.</p></div></div>
<p class="quasar-muted">Names and game ports are suggested from your existing servers. Enter the address players use to connect.</p>
<section class="quasar-panel quasar-section"><div class="quasar-stack">
    <label class="quasar-check"><input name="listing-visibility" type="checkbox" @bind:get="Consent.GetSettings().ListingGranted" @bind:set="SaveVisibilityAsync" disabled="@(_saving || !_canManage)" />Show configured servers on se-servers.net</label>
    @if (!Consent.GetSettings().DiagnosticsGranted)
    {
        <p class="quasar-notice quasar-notice-warning" role="status">Accept diagnostic data handling in <a href="/settings/security">Security</a> before publishing.</p>
    }
    @if (ServerListProtocol.GetAdmins(Rbac.GetConfig()).Length == 0)
    {
        <p class="quasar-notice quasar-notice-warning" role="status">Add a Steam identity with the admin role in <a href="/settings/security">Security</a> to publish and manage your listings.</p>
    }
    @if (Settings.LoadError is { } error) { <p class="quasar-notice quasar-notice-error" role="status">@error</p> }
    <p>Listings become visible when the backoffice confirms current Quasar log delivery. No crash or memory dump is required. Saved changes apply immediately; delivery may take up to two minutes.</p>
</div></section>
@if (_entries.Count == 0)
{
    <p class="quasar-notice">Create a standalone server or cluster first. It will appear here automatically.</p>
}
<form @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <fieldset class="quasar-fieldset" disabled="@(_saving || !_canManage)">
        <div class="quasar-card-grid">
            @foreach (var entry in _entries)
            {
                <section class="quasar-panel quasar-section" @key="@($"{entry.Kind}:{entry.UniqueName}")"><div class="quasar-stack">
                    <h2>@SourceName(entry)</h2>
                    <p class="quasar-muted">@(entry.Kind == "cluster" ? "Cluster · Steam gateway" : "Standalone Magnetar server")</p>
                    @if (!SourceExists(entry)) { <p class="quasar-notice quasar-notice-warning">This source no longer exists. Its listing will be omitted from publication.</p> }
                    <label class="quasar-check"><input name="publish" type="checkbox" @bind="entry.Enabled" disabled="@(!SourceExists(entry) && !entry.Enabled)" />Publish this server</label>
                    <label class="quasar-field"><span>Public server name</span><input name="public-name" @bind="entry.Name" @bind:event="oninput" maxlength="128" /></label>
                    <label class="quasar-field"><span>Public hostname or IP address</span><input name="public-host" @bind="entry.PublicHost" @bind:event="oninput" required="@entry.Enabled" /><small>For example, play.example.org. Enter only the hostname or IP, without a URL scheme or port.</small></label>
                    <label class="quasar-field"><span>Public game port</span><input name="public-port" type="number" @bind="entry.PublicPort" min="1" max="65535" required /><small>Use the port exposed to players; for a cluster, use its Steam gateway port.</small></label>
                </div></section>
            }
        </div>
        @if (_canManage)
        {
            <div class="quasar-row quasar-form-actions">
                <button type="submit" class="quasar-button quasar-button-primary"><QuasarIcon Icon="@QuasarIcons.Save" />Save listings</button>
            </div>
        }
    </fieldset>
</form>

<button type="button" class="quasar-button" @onclick="Reload">Reload</button>

@code {
    private List<ServerListEntry> _entries = [];
    private HashSet<(string Kind, string UniqueName)> _savedSources = [];
    private long _revision;
    private bool _saving;

    private bool _canManage;

    protected override async Task OnInitializedAsync()
    {
        _canManage = await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanManageSecurity);
        Reload();
    }

    private void Reload()
    {
        var (options, revision) = Settings.GetSnapshot();
        _revision = revision;
        _savedSources = options.Listings.Select(e => (e.Kind, e.UniqueName.ToLowerInvariant())).ToHashSet();
        if (!options.Enabled) foreach (var entry in options.Listings) entry.Enabled = false;
        _entries = ServerListSettingsCatalog.CreateDrafts(options, Servers.GetServers(), Clusters.GetClusters());
    }

    private bool SourceExists(ServerListEntry entry) => entry.Kind == "server"
        ? Servers.GetServer(entry.UniqueName) is not null : Clusters.GetCluster(entry.UniqueName) is not null;

    private string SourceName(ServerListEntry entry) => (entry.Kind == "server"
        ? Servers.GetServer(entry.UniqueName)?.DisplayName : Clusters.GetCluster(entry.UniqueName)?.DisplayName)
            is { Length: > 0 } name ? name : entry.UniqueName;

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanManageSecurity))
            { Snackbar.Add("You no longer have permission to manage server listings.", Severity.Error); return; }
            var entries = _entries.Where(e => e.Enabled || !string.IsNullOrWhiteSpace(e.PublicHost)
                || _savedSources.Contains((e.Kind, e.UniqueName.ToLowerInvariant()))).Select(e => e.Clone()).ToList();
            await Settings.SaveAsync(new() { Enabled = entries.Any(e => e.Enabled), Listings = entries }, _revision);
            Reload();
            Snackbar.Add("Server listings saved. Publication will update automatically.", Severity.Success);
        }
        catch (Exception error) { Snackbar.Add($"Could not save listings: {error.Message}", Severity.Error); }
        finally { _saving = false; }
    }

    private async Task SaveVisibilityAsync(bool visible)
    {
        if (_saving) return;
        _saving = true;
        try
        {
            if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanManageSecurity))
            { Snackbar.Add("You no longer have permission to manage server listings.", Severity.Error); return; }
            await Consent.SaveListingVisibilityAsync(visible);
            Snackbar.Add("Listing visibility saved.", Severity.Success);
        }
        catch (Exception error) { Snackbar.Add($"Could not save visibility: {error.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
