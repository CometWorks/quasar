@page "/entities"
@attribute [Authorize(Policy = QuasarPolicyNames.CanView)]
@implements IDisposable
@inject QuasarPermissionService Permissions
@inject AgentRegistry Registry
@inject DedicatedServerCatalog ServerCatalog
@inject ClusterCatalog ClusterCatalog
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.Security.Claims
@inject EntityService EntityService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Entities</PageTitle>

<QuasarExtensionOutlet TargetKey="@QuasarExtensionTargets.EntitiesPage">
<QuasarPageHeading Section="Operations">
    <Title>Entities</Title>
    <Description>Live world entities for a server or whole cluster. Query grids, characters, dropped items and terrain, then inspect or delete them with full admin control.</Description>
</QuasarPageHeading>

<div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-gap-2 mb-4">
    <MudSelect T="string"
               Label="Server / cluster"
               Value="_selectedTargetId"
               ValueChanged="OnServerChangedAsync"
               Variant="Variant.Outlined"
               Dense="true"
               Disabled="@(TargetOptions.Count == 0 || _deletingSelected)"
               Style="min-width: 16rem;">
        @foreach (var target in TargetOptions)
        {
            <MudSelectItem T="string" Value="@target.Key">@target.DisplayName</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="string"
               Label="Type"
               Value="_typeFilter"
               ValueChanged="OnTypeChangedAsync"
               Variant="Variant.Outlined"
               Dense="true"
               Disabled="@_deletingSelected"
               Style="min-width: 12rem;">
        @foreach (var option in TypeOptions)
        {
            <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
        }
    </MudSelect>

    <MudTextField T="string"
                  Value="_searchText"
                  ValueChanged="OnSearchChanged"
                  Label="Search name / id / owner"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Immediate="true"
                  Disabled="@_deletingSelected"
                  Style="min-width: 16rem;" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadAsync"
               Disabled="@(_loading || _deletingSelected || GetSelectedTarget() is null)">
        Refresh
    </MudButton>
</div>

<div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-gap-2 mb-4">
    @if (_lastResult is not null)
    {
        <MudChip T="string" Variant="Variant.Outlined">Matching @_lastResult.TotalCount</MudChip>
        <MudChip T="string" Variant="Variant.Outlined">Shown @FilteredEntities.Count</MudChip>
        @if (_lastResult.TotalEntityCount is { } total)
        {
            <MudChip T="string" Variant="Variant.Outlined">Live total @total</MudChip>
        }
        @if (IsClusterSelected)
        {
            <MudChip T="string" Variant="Variant.Outlined">Nodes checked @_lastResult.QueriedNodes / @_lastResult.ExpectedNodes</MudChip>
        }
    }
    @if (_lastUpdated is not null)
    {
        <span class="quasar-text quasar-type-caption">Last updated: @_lastUpdated.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
    }
    @if (_lastResult is not null)
    {
        <MudChip T="string" Variant="Variant.Outlined" Color="@(_selectedEntityIds.Count > 0 ? Color.Primary : Color.Default)">
            Selected @_selectedEntityIds.Count
        </MudChip>
        <MudTooltip Text="Select all entities shown by the current filters">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.SelectAll"
                       OnClick="SelectFilteredEntities"
                       Disabled="@(_loading || _deletingSelected || FilteredEntities.Count == 0)">
                Select shown
            </MudButton>
        </MudTooltip>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="ClearSelection"
                   Disabled="@(_loading || _deletingSelected || _selectedEntityIds.Count == 0)">
            Clear
        </MudButton>
        <AuthorizeView Policy="@QuasarPolicyNames.CanControlServers" Context="permissionContext">
        <MudTooltip Text="Select only entities with a verified owning node to delete.">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="DeleteSelectedEntitiesAsync"
                   Disabled="@(!CanDeleteSelected)">
            Delete selected
        </MudButton>
        </MudTooltip>
        </AuthorizeView>
    }
</div>
@if (_loading)
{
    <QuasarOperationLoader Title="Loading entities" Message="@_loadMessage" />
    <MudButton Variant="Variant.Outlined" OnClick="CancelLoad">Cancel</MudButton>
}
@if (_lastResult is { Warnings.Count: > 0 })
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        <strong>Partial cluster view.</strong>
        @foreach (var warning in _lastResult.Warnings.Distinct())
        {
            <p>@warning</p>
        }
    </MudAlert>
}
@if (IsClusterSelected)
{
    <p class="quasar-text quasar-type-caption">One row per entity across the cluster. Shared copies are combined. This live view includes loaded entities on responding nodes; entities in offline partitions are not listed.</p>
}

@if (TargetOptions.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No connected servers. Entities can only be listed for a server with a live Quasar agent.
    </MudAlert>
}
else if (GetSelectedTarget() is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        The selected server is no longer connected. Pick another server above.
    </MudAlert>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else if (_lastResult is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Select a server and press Refresh to load the live entity list.
    </MudAlert>
}
else if (FilteredEntities.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No entities match the current filter.
    </MudAlert>
}
else
{
    <MudTable T="EntitySummary"
              @ref="_entityTable"
              Items="FilteredEntities"
              Dense="true"
              Hover="true"
              Breakpoint="Breakpoint.Md"
              FixedHeader="true"
              Height="60vh"
              OnRowClick="HandleRowClick"
              RowClassFunc="GetEntityRowClass">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<EntitySummary, object>(e => EntityPresentation.Name(e))">Name</MudTableSortLabel></MudTh>
            <MudTh>Type</MudTh>
            @if (IsClusterSelected) { <MudTh>Node(s)</MudTh> }
            <QuasarExtensionOutlet TargetKey="@QuasarExtensionTargets.EntityViewerColumnHeader" />
            <MudTh>Details</MudTh>
            <MudTh>Quantity</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<EntitySummary, object>(e => e.BlockCount ?? -1)">Blocks</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<EntitySummary, object>(e => e.Pcu ?? -1)">PCU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<EntitySummary, object>(e => e.SizeMeters)">Size (m)</MudTableSortLabel></MudTh>
            <MudTh>Owner</MudTh>
            <MudTh>Position</MudTh>
            <MudTh>Entity ID</MudTh>
            <MudTh Class="quasar-actions-column"><span class="quasar-visually-hidden">Actions</span></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@EntityPresentation.Name(context)</MudTd>
            <MudTd DataLabel="Type">
                <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.TypeTag)" Variant="Variant.Outlined">@EntityPresentation.TypeLabel(context.TypeTag)</MudChip>
            </MudTd>
            @if (IsClusterSelected)
            {
                <MudTd DataLabel="Node(s)">@GetEntityRow(context)?.NodeLabel</MudTd>
            }
            <QuasarExtensionOutlet
                TargetKey="@QuasarExtensionTargets.EntityViewerColumnCell"
                Parameters="@CreateEntityExtensionParameters(context)" />
            <MudTd DataLabel="Details">@EntityPresentation.Details(context)</MudTd>
            <MudTd DataLabel="Quantity">@EntityPresentation.Quantity(context)</MudTd>
            <MudTd DataLabel="Blocks">@(context.BlockCount?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="PCU">@(context.Pcu?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="Size (m)">@context.SizeMeters.ToString("0")</MudTd>
            <MudTd DataLabel="Owner">@FormatOwner(context)</MudTd>
            <MudTd DataLabel="Position" Class="mono">@FormatPosition(context)</MudTd>
            <MudTd DataLabel="Entity ID">
                <p class="quasar-text quasar-type-body2 mono">@context.EntityId</p>
            </MudTd>
            <MudTd DataLabel="" Class="quasar-actions-column">
                <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-1 plugin-actions" @onclick:stopPropagation="true">
                    <QuasarExtensionOutlet
                        TargetKey="@QuasarExtensionTargets.EntityActions"
                        DefaultPolicy="@QuasarPolicyNames.CanControlServers"
                        Parameters="@CreateEntityExtensionParameters(context)">
                        <AuthorizeView Policy="@QuasarPolicyNames.CanControlServers" Context="permissionContext">
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="@(DeleteUnavailableReason(context) ?? "Delete entity")">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Disabled="@(_loading || _deletingSelected || DeleteUnavailableReason(context) is not null)"
                                               OnClick="@(() => DeleteEntityAsync(context))" />
                            </MudTooltip>
                        </span>
                        </AuthorizeView>
                    </QuasarExtensionOutlet>
                </div>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 25, 50, 100, 250 }" />
        </PagerContent>
    </MudTable>
}
</QuasarExtensionOutlet>

@code
{
    private static readonly (string Value, string Label)[] TypeOptions =
    {
        ("All", "All types"),
        ("Grid", "Grids"),
        ("Character", "Characters"),
        ("Float", "Dropped items"),
        ("Voxel", "Terrain (asteroids / planets)"),
        ("Other", "Other entities"),
    };

    private string? _selectedTargetId;
    private string _typeFilter = "All";
    private string _searchText = string.Empty;
    private IReadOnlyList<EntitySummary> _entities = Array.Empty<EntitySummary>();
    private readonly HashSet<long> _selectedEntityIds = new();
    private MudTable<EntitySummary>? _entityTable;
    private EntityQueryResult? _lastResult;
    private Dictionary<long, EntityQueryRow> _rowsById = [];
    private CancellationTokenSource? _loadCts;
    private string _loadMessage = string.Empty;
    private ClaimsPrincipal _user = new();
    private bool _canQueryClusters;
    private DateTimeOffset? _lastUpdated;
    private long? _selectionAnchorEntityId;
    private bool _loading;
    private bool _deletingSelected;
    private bool _disposed;
    private string? _error;

    private List<AgentRuntimeState> ConnectedAgents => Registry.GetAgents()
        .Where(agent => agent.IsConnected && (!agent.IsCluster || _canQueryClusters && _user.CanQueryCluster(agent.ClusterId)))
        .ToList();

    private List<EntitySummary> FilteredEntities => _entities
        .Where(MatchesSearch)
        .ToList();

    private IReadOnlyList<EntityTarget> TargetOptions
    {
        get
        {
            var targets = ConnectedAgents.Where(agent => !agent.IsCluster)
                .Select(agent => new EntityTarget("agent:" + agent.AgentId, ResolveServerName(agent), Agent: agent)).ToList();
            if (_canQueryClusters)
            {
                var clusters = ClusterCatalog.GetClusters().Where(cluster => _user.CanQueryCluster(cluster.UniqueName));
                targets.AddRange(clusters.Select(cluster => new EntityTarget("cluster:" + cluster.UniqueName,
                    string.IsNullOrWhiteSpace(cluster.DisplayName) ? cluster.UniqueName : cluster.DisplayName, Cluster: cluster)));
            }
            return targets.OrderBy(target => target.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private bool IsClusterSelected => GetSelectedTarget()?.Cluster is not null;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAccessAsync();
        Registry.Changed += HandleChanged;
        ServerCatalog.Changed += HandleChanged;
        ClusterCatalog.Changed += HandleChanged;
        _selectedTargetId ??= TargetOptions.FirstOrDefault()?.Key;
    }

    public void Dispose()
    {
        _disposed = true;
        Registry.Changed -= HandleChanged;
        ServerCatalog.Changed -= HandleChanged;
        ClusterCatalog.Changed -= HandleChanged;
        _loadCts?.Cancel();
    }

    // Prefer the name configured for the server in Quasar over the agent's in-game
    // server name (which is ConfigDedicated.ServerName, often blank and falling back
    // to "Space Engineers {pid}"). Matches how the Servers/dashboard cards resolve it.
    private string ResolveServerName(AgentRuntimeState agent)
    {
        var configuredName = ServerCatalog.GetServer(agent.UniqueNameKey)?.DisplayName;
        return string.IsNullOrWhiteSpace(configuredName) ? agent.ServerDisplayName : configuredName;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _lastResult is null && GetSelectedTarget() is not null)
            await LoadAsync();
    }

    private async Task OnServerChangedAsync(string targetId)
    {
        _selectedTargetId = targetId;
        ClearSelection();
        await LoadAsync();
    }

    private async Task OnTypeChangedAsync(string typeTag)
    {
        _typeFilter = typeTag;
        ClearSelection();
        await LoadAsync();
    }

    private void OnSearchChanged(string searchText)
    {
        _searchText = searchText ?? string.Empty;
        PruneSelectionToFilteredEntities();
    }

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        using var cts = new CancellationTokenSource();
        _loadCts = cts;
        _entities = [];
        _rowsById.Clear();
        _lastResult = null;
        _lastUpdated = null;
        ClearSelection();
        _loading = true;
        _error = null;
        _loadMessage = "Querying live world entities…";
        StateHasChanged();
        try
        {
            await RefreshAccessAsync();
            if (!ReferenceEquals(_loadCts, cts) || cts.IsCancellationRequested)
                return;
            var target = GetSelectedTarget();
            if (target is null)
                return;
            var filter = new EntityListFilter { TypeTag = _typeFilter, Limit = 500 };
            var progress = new Progress<string>(message =>
            {
                if (!_disposed && ReferenceEquals(_loadCts, cts))
                {
                    _loadMessage = message;
                    _ = InvokeAsync(StateHasChanged);
                }
            });
            var result = target.Cluster is { } cluster
                ? await EntityService.QueryClusterAsync(cluster, filter, progress, cts.Token)
                : await EntityService.QueryAsync(target.Agent!, filter, cts.Token);
            if (!ReferenceEquals(_loadCts, cts) || cts.IsCancellationRequested)
                return;
            _lastResult = result;
            _rowsById = result.Rows.ToDictionary(row => row.Entity.EntityId);
            _entities = result.Rows.Select(row => row.Entity).ToArray();
            _lastUpdated = result.CapturedAtUtc;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (ReferenceEquals(_loadCts, cts))
                _error = exception.Message;
        }
        finally
        {
            if (ReferenceEquals(_loadCts, cts))
            {
                _loadCts = null;
                _loading = false;
                if (!_disposed)
                    StateHasChanged();
            }
        }
    }

    private void CancelLoad() => _loadCts?.Cancel();

    private bool CanDeleteSelected => GetSelectedTarget() is not null
                                      && !_loading
                                      && !_deletingSelected
                                      && _selectedEntityIds.Count > 0
                                      && _selectedEntityIds.All(id => _rowsById.TryGetValue(id, out var row)
                                          && DeleteUnavailableReason(row.Entity) is null);

    private async Task DeleteSelectedEntitiesAsync()
    {
        if (!await CanControlSelectionAsync()) return;
        var target = GetSelectedTarget();
        if (target is null)
        {
            Snackbar.Add("The selected server is not connected.", Severity.Error);
            return;
        }

        var selectedRows = _entities
            .Where(entity => _selectedEntityIds.Contains(entity.EntityId))
            .Select(GetEntityRow).OfType<EntityQueryRow>()
            .ToList();

        if (selectedRows.Count == 0)
        {
            ClearSelection();
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete selected entities",
            $"Permanently delete {selectedRows.Count} selected entities? This cannot be undone.",
            yesText: "Delete selected",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        _deletingSelected = true;
        StateHasChanged();

        var deletedCount = 0;
        var failedMessages = new List<string>();

        try
        {
            foreach (var row in selectedRows)
            {
                var entity = row.Entity;
                try
                {
                    if (!await CanControlEntityAsync(row)) break;
                    var result = await EntityService.DeleteEntityAsync(row);
                    if (result.Success)
                    {
                        deletedCount++;
                    }
                    else
                    {
                        failedMessages.Add(string.IsNullOrWhiteSpace(result.Message)
                            ? $"#{entity.EntityId}: Delete failed."
                            : $"#{entity.EntityId}: {result.Message}");
                    }
                }
                catch (Exception exception)
                {
                    failedMessages.Add($"#{entity.EntityId}: {exception.Message}");
                }
            }
        }
        finally
        {
            _deletingSelected = false;
        }

        if (deletedCount > 0)
        {
            Snackbar.Add($"Deleted {deletedCount} selected entities.", Severity.Success);
            ClearSelection();
            await LoadAsync();
        }

        if (failedMessages.Count > 0)
        {
            Snackbar.Add($"Failed to delete {failedMessages.Count} selected entities. First error: {failedMessages[0]}", Severity.Error);
        }

        StateHasChanged();
    }

    private async Task DeleteEntityAsync(EntitySummary entity)
    {
        if (!await CanControlSelectionAsync()) return;
        var target = GetSelectedTarget();
        if (target is null)
        {
            Snackbar.Add("The selected server is not connected.", Severity.Error);
            return;
        }
        var row = GetEntityRow(entity);
        if (row is null)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete entity",
            $"Permanently delete \"{entity.DisplayName}\" (#{entity.EntityId})? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            if (!await CanControlEntityAsync(row)) return;
            var result = await EntityService.DeleteEntityAsync(row);
            if (result.Success)
            {
                Snackbar.Add(string.IsNullOrWhiteSpace(result.Message) ? "Entity deleted." : result.Message, Severity.Success);
                _selectedEntityIds.Remove(entity.EntityId);
                if (_selectionAnchorEntityId == entity.EntityId)
                    _selectionAnchorEntityId = null;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(string.IsNullOrWhiteSpace(result.Message) ? "Delete failed." : result.Message, Severity.Error);
            }
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private void HandleRowClick(TableRowClickEventArgs<EntitySummary> args)
    {
        var entity = args.Item;
        if (entity is null)
            return;

        var additive = args.MouseEventArgs.CtrlKey || args.MouseEventArgs.MetaKey;
        var range = args.MouseEventArgs.ShiftKey;

        if (range && _selectionAnchorEntityId is { } anchorId)
        {
            SelectRange(anchorId, entity.EntityId, additive);
        }
        else if (additive)
        {
            ToggleSelection(entity.EntityId);
        }
        else
        {
            _selectedEntityIds.Clear();
            _selectedEntityIds.Add(entity.EntityId);
        }

        _selectionAnchorEntityId = entity.EntityId;
    }

    private void SelectRange(long anchorEntityId, long targetEntityId, bool additive)
    {
        var visibleEntities = GetSelectionOrder();
        var anchorIndex = visibleEntities.FindIndex(entity => entity.EntityId == anchorEntityId);
        var targetIndex = visibleEntities.FindIndex(entity => entity.EntityId == targetEntityId);

        if (anchorIndex < 0 || targetIndex < 0)
        {
            if (!additive)
                _selectedEntityIds.Clear();

            _selectedEntityIds.Add(targetEntityId);
            return;
        }

        if (!additive)
            _selectedEntityIds.Clear();

        var start = Math.Min(anchorIndex, targetIndex);
        var end = Math.Max(anchorIndex, targetIndex);
        for (var i = start; i <= end; i++)
            _selectedEntityIds.Add(visibleEntities[i].EntityId);
    }

    private void ToggleSelection(long entityId)
    {
        if (!_selectedEntityIds.Add(entityId))
            _selectedEntityIds.Remove(entityId);
    }

    private void SelectFilteredEntities()
    {
        var visibleEntities = FilteredEntities;
        _selectedEntityIds.Clear();

        foreach (var entity in visibleEntities)
            _selectedEntityIds.Add(entity.EntityId);

        _selectionAnchorEntityId = visibleEntities.LastOrDefault()?.EntityId;
    }

    private List<EntitySummary> GetSelectionOrder()
    {
        return (_entityTable?.FilteredItems ?? FilteredEntities).ToList();
    }

    private void ClearSelection()
    {
        _selectedEntityIds.Clear();
        _selectionAnchorEntityId = null;
    }

    private void PruneSelectionToFilteredEntities()
    {
        var visibleIds = FilteredEntities.Select(entity => entity.EntityId).ToHashSet();
        _selectedEntityIds.RemoveWhere(entityId => !visibleIds.Contains(entityId));

        if (_selectionAnchorEntityId is { } anchorId && !visibleIds.Contains(anchorId))
            _selectionAnchorEntityId = null;
    }

    private string GetEntityRowClass(EntitySummary entity, int rowNumber)
    {
        return _selectedEntityIds.Contains(entity.EntityId)
            ? "entity-row-selectable quasar-row-selected"
            : "entity-row-selectable";
    }

    private EntityTarget? GetSelectedTarget() => TargetOptions.FirstOrDefault(target => target.Key == _selectedTargetId);

    private EntityQueryRow? GetEntityRow(EntitySummary entity) => _rowsById.GetValueOrDefault(entity.EntityId);

    private AgentRuntimeState? GetEntityAgent(EntitySummary entity)
    {
        var row = GetEntityRow(entity);
        if (row is null)
            return null;
        if (row.DeletionSource is { } owner && EntityService.IsCurrent(owner.Agent.AgentId, owner.TelemetryKey))
            return owner.Agent;
        return row.Observations
            .FirstOrDefault(source => EntityService.IsCurrent(source.Agent.AgentId, source.TelemetryKey))?.Agent;
    }

    private string? DeleteUnavailableReason(EntitySummary entity)
    {
        var row = GetEntityRow(entity);
        if (row?.DeletionSource is not { } source)
            return row?.DeleteUnavailableReason ?? "Refresh the entity list before deleting.";
        return EntityService.IsCurrent(source.Agent.AgentId, source.TelemetryKey) ? null
            : "The entity's node disconnected or was replaced. Refresh before deleting.";
    }

    private async Task<bool> CanControlSelectionAsync() =>
        await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanControlServers)
        && (!IsClusterSelected || _user.CanQueryCluster(GetSelectedTarget()!.Cluster!.UniqueName)
            && await Permissions.IsAuthorizedAsync(QuasarPolicyNames.ClusterManage));

    private async Task RefreshAccessAsync()
    {
        _user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _canQueryClusters = await Permissions.IsAuthorizedAsync(QuasarPolicyNames.ClusterQuery);
    }

    private async Task<bool> CanControlEntityAsync(EntityQueryRow row)
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        return await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanControlServers)
            && (!row.ViewingSource.Agent.IsCluster || user.CanQueryCluster(row.ViewingSource.Agent.ClusterId)
                && await Permissions.IsAuthorizedAsync(QuasarPolicyNames.ClusterManage));
    }

    private bool CanViewEntity(EntitySummary entity)
    {
        return GetEntityAgent(entity) is not null
               && (string.Equals(entity.TypeTag, "Grid", StringComparison.OrdinalIgnoreCase)
                   || (string.Equals(entity.TypeTag, "Voxel", StringComparison.OrdinalIgnoreCase)
                       && string.Equals(entity.SubType, "Asteroid", StringComparison.OrdinalIgnoreCase)));
    }

    private IReadOnlyDictionary<string, object?> CreateEntityExtensionParameters(EntitySummary entity)
    {
        var agent = GetEntityAgent(entity);
        var canView = CanViewEntity(entity);
        return new Dictionary<string, object?>
        {
            ["AgentId"] = agent?.AgentId,
            ["ServerName"] = GetSelectedTarget()?.DisplayName,
            ["EntityId"] = entity.EntityId,
            ["EntityType"] = entity.TypeTag,
            ["EntitySubType"] = entity.SubType,
            ["EntityDisplayName"] = entity.DisplayName,
            ["OwnerSteamId"] = entity.OwnerSteamId,
            ["CanViewEntity"] = canView,
        };
    }

    private bool MatchesSearch(EntitySummary entity)
    {
        var search = _searchText?.Trim();
        if (string.IsNullOrWhiteSpace(search))
            return true;

        return Contains(entity.DisplayName, search)
               || Contains(entity.SubType, search)
               || Contains(EntityPresentation.TypeLabel(entity.TypeTag), search)
               || Contains(EntityPresentation.Details(entity), search)
               || Contains(EntityPresentation.Name(entity), search)
               || Contains(entity.OwnerName, search)
               || entity.EntityId.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
               || (entity.OwnerSteamId?.ToString().Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void HandleChanged()
    {
        if (_disposed)
            return;
        // Connected-server list and connection status can change underneath us; just
        // re-render. The entity list itself is only refreshed on explicit user action.
        _selectedTargetId ??= TargetOptions.FirstOrDefault()?.Key;
        _ = InvokeAsync(StateHasChanged);
    }

    private sealed record EntityTarget(string Key, string DisplayName, AgentRuntimeState? Agent = null, ClusterDefinition? Cluster = null);

    private static bool Contains(string? value, string search)
    {
        return !string.IsNullOrWhiteSpace(value)
               && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatOwner(EntitySummary entity)
    {
        if (!string.IsNullOrWhiteSpace(entity.OwnerName))
            return entity.OwnerName;

        return entity.OwnerSteamId is { } steamId && steamId != 0
            ? steamId.ToString()
            : "-";
    }

    private static string FormatPosition(EntitySummary entity)
    {
        return $"{entity.PositionX:0}, {entity.PositionY:0}, {entity.PositionZ:0}";
    }

    private static Color GetTypeColor(string typeTag)
    {
        return typeTag switch
        {
            "Grid" => Color.Primary,
            "Character" => Color.Success,
            "Float" => Color.Warning,
            "Voxel" => Color.Info,
            _ => Color.Default,
        };
    }
}
