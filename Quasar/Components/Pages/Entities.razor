@page "/entities"
@attribute [Authorize(Policy = QuasarPolicyNames.CanView)]
@attribute [ExcludeFromInteractiveRouting]
@layout WasmPageLayout
@inject NavigationManager Navigation
@inject QuasarUiPluginCatalog Plugins

<PageTitle>Entities</PageTitle>
<Quasar.Client.Components.EntitiesView @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />

@code {
    protected override void OnInitialized()
    {
        if (Plugins.RequiresServerExtensions(QuasarExtensionTargets.EntitiesPage, QuasarExtensionTargets.EntityActions,
            QuasarExtensionTargets.EntityViewerColumnCell, QuasarExtensionTargets.EntityViewerColumnHeader))
            Navigation.NavigateTo("compat/entities", forceLoad: true, replace: true);
    }
}
