@page "/clusters/{UniqueName}"
@attribute [Authorize(Policy = QuasarPolicyNames.ClusterQuery)]
@inject ClusterCatalog ClusterCatalog
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>@(Cluster?.DisplayName ?? "Cluster")</PageTitle>

@if (Cluster is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        Cluster '@UniqueName' was not found.
    </MudAlert>
}
else
{
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween" Spacing="2" Class="mb-3">
        <div>
            <MudText Typo="Typo.h5">@Cluster.DisplayName</MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Cluster</MudChip>
                <MudText Typo="Typo.body2" Class="mono">@Cluster.UniqueName</MudText>
            </MudStack>
        </div>
        <MudButton Href="/" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">
            Servers
        </MudButton>
    </MudStack>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
        Manage this cluster as one server. Gateway, World Authority, and node placement are
        shown for visibility; the Registry remains authoritative for fleet decisions.
    </MudAlert>

    <AuthorizeView Policy="@QuasarPolicyNames.ClusterManage" Context="conversionAuth">
        <MudButton Href="@("/clusters/" + Uri.EscapeDataString(Cluster.UniqueName) + "/convert-to-server")" StartIcon="@Icons.Material.Filled.Dns">Convert to standalone server</MudButton>
    </AuthorizeView>
    <div @key="Cluster.UniqueName">
        <ClusterDetailPanel Cluster="Cluster" />
        <ClusterAdminPanel @ref="_admin" Cluster="Cluster" />
        <ClusterDeploymentPanel Cluster="Cluster" />
        <ClusterFleetPanel Cluster="Cluster" Command="ExecuteCommandAsync" />
    </div>
}

@code
{
    [Parameter]
    public string UniqueName { get; set; } = string.Empty;

    private ClusterDefinition? Cluster { get; set; }
    private ClusterAdminPanel? _admin;
    private Task ExecuteCommandAsync(ClusterAdminCommand command) => _admin?.SubmitAsync(command) ?? Task.CompletedTask;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        Cluster = user.CanQueryCluster(UniqueName) ? ClusterCatalog.GetCluster(UniqueName) : null;
    }
}
