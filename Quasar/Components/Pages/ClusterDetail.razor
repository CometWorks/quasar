@page "/clusters/{UniqueName}"
@implements IDisposable
@attribute [Authorize(Policy = QuasarPolicyNames.ClusterQuery)]
@inject ClusterCatalog ClusterCatalog
@inject AuthenticationStateProvider AuthenticationState
@inject ClusterSetupService Setup
@inject ClusterReleaseMonitor ClusterReleases
@inject NavigationManager Navigation

<PageTitle>@(Cluster?.DisplayName ?? "Cluster")</PageTitle>

@if (Cluster is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        Cluster '@UniqueName' was not found.
    </MudAlert>
}
else
{
    <ClusterBetaNotice />
    <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-justify-spacebetween quasar-gap-2 mb-3">
        <div>
            <QuasarPageHeading Section="Infrastructure"><Title>@Cluster.DisplayName</Title></QuasarPageHeading>
            <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-1">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Cluster</MudChip>
                <p class="quasar-text quasar-type-body2 mono">@Cluster.UniqueName</p>
            </div>
        </div>
        <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-gap-1">
        <ClusterConsoleButton Cluster="Cluster" />
        <MudButton Href="./" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">
            Servers
        </MudButton>
        </div>
    </div>

    <div class="quasar-layout quasar-gap-4 cluster-control-page" @key="Cluster.UniqueName">
        @if (ClusterReleaseMonitor.IsUpdateAvailable(Cluster, ClusterReleases.GetSnapshot().Release))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                The latest published cluster package (@ClusterReleases.GetSnapshot().Release!.Version) differs from the selected package.
                <AuthorizeView Policy="@QuasarPolicyNames.ClusterManage">
                    <button class="quasar-button quasar-tone-primary" type="button" disabled="@(!CanSelectView("configuration"))" @onclick='() => SelectView("configuration")'>Open cluster update</button>
                </AuthorizeView>
            </MudAlert>
        }
        @if (Cluster.ActiveDeployment is null)
        {
            <MudAlert Severity="Severity.Info">
                @if (Setup.GetStatus(Cluster.UniqueName) is { } setup)
                {
                    <p class="quasar-text quasar-type-body1">@setup.Phase @setup.Error</p>
                    <AuthorizeView Policy="@QuasarPolicyNames.ClusterManage">
                        <MudButton Href="@($"clusters/new?resume={Uri.EscapeDataString(Cluster.UniqueName)}")" Variant="Variant.Outlined" Color="Color.Primary">Resume guided setup</MudButton>
                    </AuthorizeView>
                }
                else
                {
                    <p class="quasar-text quasar-type-body1">This cluster has no active deployment. Use guided setup to create a managed cluster, or remove this registration if it is no longer needed.</p>
                    <AuthorizeView Policy="@QuasarPolicyNames.ClusterManage"><MudButton Href="clusters/new" Variant="Variant.Outlined" Color="Color.Primary">Set up a new cluster</MudButton></AuthorizeView>
                }
            </MudAlert>
        }
        <nav class="quasar-console-tabs cluster-view-tabs" aria-label="Cluster views">
            @foreach (var view in Views)
            {
                <button type="button" disabled="@(!CanSelectView(view.Key))" aria-pressed="@(_view == view.Key ? "true" : "false")"
                        aria-controls="@($"cluster-{view.Key}")" aria-describedby="@(!CanSelectView(view.Key) ? "cluster-gateway-connection" : null)"
                        @onclick="@(() => SelectView(view.Key))">@view.Label</button>
            }
        </nav>
        @if (_gatewayAvailable != true)
        {
            <p id="cluster-gateway-connection" class="quasar-muted" role="status">@(_gatewayAvailable is null
                ? "Checking Gateway admin connection. Nodes, Partitions, Events and Mods & plugins will be available when it responds."
                : "Gateway admin connection unavailable. Nodes, Partitions, Events and Mods & plugins will be available when it reconnects. Maintenance and Settings remain available.")</p>
        }
        <section id="cluster-settings" aria-label="Cluster controls and settings">
            <ClusterAdminPanel @ref="_admin" Cluster="Cluster" Compact="@(_view != "settings")" GatewayAvailable="@(_gatewayAvailable == true)" />
            @if (_view == "settings")
            {
                <AuthorizeView Policy="@QuasarPolicyNames.ClusterManage"><Authorized Context="settingsAuthorization">
                    <details class="quasar-details"><summary>Remove cluster</summary><p>Stop the cluster before removing it. Review the removal dialog before continuing.</p><ClusterDeleteButton Cluster="Cluster" ReturnToServers="true" /></details>
                </Authorized><NotAuthorized><p>Cluster management permission is required to edit settings.</p></NotAuthorized></AuthorizeView>
            }
        </section>
        <section id="cluster-overview" aria-label="Cluster overview" hidden="@(_view != "overview")">
            <ClusterDetailPanel Cluster="Cluster" ShowConfigurationLinks="false" CollapseDetails="true" ShowTopology="true"
                                GatewayAvailabilityChanged="GatewayAvailabilityChanged" />
        </section>
        <section id="cluster-nodes" aria-label="Cluster nodes" hidden="@(_view != "nodes")">
            @if (_visited.Contains("nodes"))
            {
                <ClusterFleetPanel Cluster="Cluster" Command="ExecuteCommandAsync" ShowEvents="false" />
            }
        </section>
        <section id="cluster-partitions" aria-label="Cluster partitions" hidden="@(_view != "partitions")">
            @if (_visited.Contains("partitions"))
            {
                <ClusterPartitionsPanel Cluster="Cluster" @key="Cluster.UniqueName" />
            }
        </section>
        <section id="cluster-events" aria-label="Cluster events" hidden="@(_view != "events")">
            @if (_visited.Contains("events"))
            {
                <ClusterFleetPanel Cluster="Cluster" ShowEvents="true" />
            }
        </section>
        <section id="cluster-content" aria-label="Cluster content updates" hidden="@(_view != "content")">
            @if (_visited.Contains("content"))
            {
                @if (Cluster.ActiveDeployment is not null) { <ClusterContentPanel Cluster="Cluster" /> }
                else { <p>Deploy the cluster to manage its mods and plugins.</p> }
            }
        </section>
        <section id="cluster-configuration" aria-label="Cluster maintenance" hidden="@(_view != "configuration")" class="quasar-stack">
            @if (_visited.Contains("configuration"))
            {
                var releaseSnapshot = ClusterReleases.GetSnapshot();
                <details class="quasar-details" open="@(_view == "configuration")">
                <summary>Maintenance</summary>
                <section class="quasar-panel quasar-card-content" aria-label="Cluster versions">
                    <div class="quasar-detail-metrics">
                        <div>
                            <p class="quasar-eyebrow">Deployed version</p>
                            <strong class="cluster-long-value">@(Cluster.ActiveDeployment is null ? "Not deployed" : ClusterReleaseMonitor.GetDeployedVersion(Cluster) ?? "Unknown")</strong>
                        </div>
                        <div>
                            <p class="quasar-eyebrow">Latest available version</p>
                            <strong class="cluster-long-value">@(releaseSnapshot.Release?.Version ?? (releaseSnapshot.Error is not null ? "Unavailable" : "Not checked"))</strong>
                        </div>
                    </div>
                    @if (releaseSnapshot.LastCheckedUtc is { } checkedAt)
                    {
                        <p class="quasar-muted quasar-caption">Release checked: @checkedAt.ToLocalTime().ToString("g")</p>
                    }
                    @if (releaseSnapshot.Error is { } releaseError)
                    {
                        <p class="quasar-text-warning">@releaseError</p>
                    }
                </section>
                <ClusterDeploymentPanel Cluster="Cluster" />
                </details>
            }
        </section>
    </div>
}

@code
{
    [Parameter]
    public string UniqueName { get; set; } = string.Empty;

    private ClusterDefinition? Cluster { get; set; }
    private ClusterAdminPanel? _admin;
    private static readonly (string Key, string Label)[] Views = [("overview", "Overview"), ("nodes", "Nodes"), ("partitions", "Partitions"), ("events", "Events"), ("content", "Mods & plugins"), ("configuration", "Maintenance"), ("settings", "Settings")];
    private string _requestedView = "overview";
    private string _view => CanSelectView(_requestedView) ? _requestedView : "overview";
    private bool? _gatewayAvailable;
    private readonly HashSet<string> _visited = ["overview"];
    private bool CanSelectView(string view) => view is "overview" or "configuration" or "settings" || _gatewayAvailable == true;
    private void SelectView(string view)
    {
        if (!CanSelectView(view)) return;
        // Blazor's same-page fragment navigation does not notify server LocationChanged listeners.
        _requestedView = view;
        _visited.Add(view);
        Navigation.NavigateTo($"clusters/{Uri.EscapeDataString(UniqueName)}#cluster-{view}");
    }
    private void GatewayAvailabilityChanged(bool available)
    {
        _gatewayAvailable = available;
        _visited.Add(_view);
    }
    private void ReadView()
    {
        string fragment = new Uri(Navigation.Uri).Fragment;
        _requestedView = Views.FirstOrDefault(view => fragment == "#cluster-" + view.Key).Key ?? "overview";
        _visited.Add(_view);
    }
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
        => _ = InvokeAsync(() => { ReadView(); StateHasChanged(); });
    private Task ExecuteCommandAsync(ClusterAdminCommand command) => _admin?.SubmitAsync(command) ?? Task.CompletedTask;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += LocationChanged;
        ReadView();
        ClusterCatalog.Changed += CatalogChanged;
        ClusterReleases.Changed += CatalogChanged;
    }
    private void CatalogChanged() => _ = InvokeAsync(async () => { await OnParametersSetAsync(); StateHasChanged(); });
    public void Dispose()
    {
        Navigation.LocationChanged -= LocationChanged;
        ClusterCatalog.Changed -= CatalogChanged;
        ClusterReleases.Changed -= CatalogChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(Cluster?.UniqueName, UniqueName, StringComparison.OrdinalIgnoreCase))
        {
            _gatewayAvailable = null;
            _visited.Clear();
            ReadView();
        }
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        Cluster = user.CanQueryCluster(UniqueName) ? ClusterCatalog.GetCluster(UniqueName) : null;
    }
}
