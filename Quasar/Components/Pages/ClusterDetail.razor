@page "/clusters/{UniqueName}"
@implements IDisposable
@attribute [Authorize(Policy = QuasarPolicyNames.ClusterQuery)]
@inject ClusterCatalog ClusterCatalog
@inject AuthenticationStateProvider AuthenticationState
@inject ClusterSetupService Setup
@inject ClusterReleaseMonitor ClusterReleases
@inject ClusterReconciler Reconciler

<PageTitle>@(Cluster?.DisplayName ?? "Cluster")</PageTitle>

@if (Cluster is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        Cluster '@UniqueName' was not found.
    </MudAlert>
}
else
{
    <ClusterBetaNotice />
    <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-justify-spacebetween quasar-gap-2 mb-3">
        <div>
            <QuasarPageHeading Section="Infrastructure">
    <Title>@Cluster.DisplayName</Title>
</QuasarPageHeading>
            <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-1">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Cluster</MudChip>
                <p class="quasar-text quasar-type-body2 mono">@Cluster.UniqueName</p>
            </div>
        </div>
        <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-gap-1">
        <ClusterConsoleButton Cluster="Cluster" />
        <ClusterDeleteButton Cluster="Cluster" ReturnToServers="true" />
        <MudButton Href="/" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">
            Servers
        </MudButton>
        </div>
    </div>

    <div class="quasar-layout quasar-gap-4 cluster-control-page" @key="Cluster.UniqueName">
        @if (ClusterReleaseMonitor.IsUpdateAvailable(Cluster, ClusterReleases.GetSnapshot().Release))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                The latest published cluster package (@ClusterReleases.GetSnapshot().Release!.Version) differs from the selected package.
                <AuthorizeView Policy="@QuasarPolicyNames.ClusterManage">
                    <MudButton Href="#cluster-configuration" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SystemUpdateAlt">Open cluster update</MudButton>
                </AuthorizeView>
            </MudAlert>
        }
        @if (Cluster.ActiveDeployment is null)
        {
            <MudAlert Severity="Severity.Info">
                @if (Setup.GetStatus(Cluster.UniqueName) is { } setup)
                {
                    <p class="quasar-text quasar-type-body1">@setup.Phase @setup.Error</p>
                    <AuthorizeView Policy="@QuasarPolicyNames.ClusterManage">
                        <MudButton Href="@($"/clusters/new?resume={Uri.EscapeDataString(Cluster.UniqueName)}")" Variant="Variant.Outlined" Color="Color.Primary">Resume guided setup</MudButton>
                    </AuthorizeView>
                }
                else
                {
                    <p class="quasar-text quasar-type-body1">This cluster has no active deployment. Use guided setup to create a managed cluster, or remove this registration if it is no longer needed.</p>
                    <AuthorizeView Policy="@QuasarPolicyNames.ClusterManage"><MudButton Href="/clusters/new" Variant="Variant.Outlined" Color="Color.Primary">Set up a new cluster</MudButton></AuthorizeView>
                }
            </MudAlert>
        }
        <ClusterAdminPanel @ref="_admin" Cluster="Cluster" />
        <ClusterDetailPanel Cluster="Cluster" ShowConfigurationLinks="false" />
        @if (Cluster.Gateway is null || Cluster.GoalState == DedicatedServerGoalState.On
            || Reconciler.GetStatus(Cluster.UniqueName).GatewayObserved == Quasar.Host.Contract.V1.GatewayObservedState.Running)
        {
            <ClusterFleetPanel Cluster="Cluster" Command="ExecuteCommandAsync" />
        }
        @if (Cluster.ActiveDeployment is not null)
        {
            <section id="cluster-content" aria-label="Cluster content updates">
                <ClusterContentPanel Cluster="Cluster" />
            </section>
        }
        <section id="cluster-configuration" aria-label="Cluster configuration">
            <ClusterDeploymentPanel Cluster="Cluster" />
        </section>
    </div>
}

@code
{
    [Parameter]
    public string UniqueName { get; set; } = string.Empty;

    private ClusterDefinition? Cluster { get; set; }
    private ClusterAdminPanel? _admin;
    private Task ExecuteCommandAsync(ClusterAdminCommand command) => _admin?.SubmitAsync(command) ?? Task.CompletedTask;

    protected override void OnInitialized()
    {
        ClusterCatalog.Changed += CatalogChanged;
        ClusterReleases.Changed += CatalogChanged;
    }
    private void CatalogChanged() => _ = InvokeAsync(async () => { await OnParametersSetAsync(); StateHasChanged(); });
    public void Dispose()
    {
        ClusterCatalog.Changed -= CatalogChanged;
        ClusterReleases.Changed -= CatalogChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        Cluster = user.CanQueryCluster(UniqueName) ? ClusterCatalog.GetCluster(UniqueName) : null;
    }
}
