<MudDialog>
    <DialogContent>
        <div class="quasar-layout quasar-gap-3">
            <p class="quasar-text quasar-type-body1">Remove '@Cluster.DisplayName' from Quasar? Its definition will be archived. Worlds, plugins, Host executor data and backups stay on disk for the days set in Keep deleted clusters on the Backup page (default 7). Quasar then removes them, manual backups included, unless that setting is 0.</p>
            <MudCheckBox T="bool" @bind-Value="_forget" Label="Forget registration without checking remote processes" />
            @if (_forget)
            {
                <MudAlert Severity="Severity.Warning">Quasar will stop managing this cluster. Any running cluster services or nodes will keep running independently. Use this for a stale registration or host machines you manage separately. This does not stop or delete remote processes.</MudAlert>
                <MudTextField T="string" Label="Confirm cluster ID" @bind-Value="_confirmation" Immediate="true"
                              HelperText="@($"Type {Cluster.UniqueName} exactly. This ID cannot be reused for a new cluster.")" />
            }
            else
            {
                <p class="quasar-text quasar-type-body1">Nodes must be stopped and all operations complete. Quasar checks each Host executor before removing the definition, and stops a Gateway still running after an unclean shutdown.</p>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(_forget && _confirmation != Cluster.UniqueName)"
                   OnClick="@(() => Dialog.Close(DialogResult.Ok(_forget)))">@(_forget ? "Forget registration" : "Delete definition")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public ClusterDefinition Cluster { get; set; } = default!;
    private bool _forget;
    private string _confirmation = "";
}
