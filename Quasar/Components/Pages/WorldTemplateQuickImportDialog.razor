@implements IDisposable
@inject ManagedRuntimeWarmupService RuntimeWarmup

<MudDialog>
    <DialogContent>
        @if (_importing)
        {
            <QuasarOperationLoader Title="@($"Preparing '{_name}'")" Message="@_importMessage" Percent="@_importPercent" />
            <p class="quasar-text quasar-type-body2">Quasar copies the world into its own storage and leaves the original unchanged. Keep this dialog open until it finishes.</p>
        }
        @if (_importError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_importError Check available disk space and folder access, then try again.</MudAlert>
        }
        @if (!_importing && _step == ImportStep.Details)
        {
            <MudTabs Elevation="0"
                     Rounded="true"
                     Outlined="true"
                     ApplyEffectsToContainer="true"
                     KeepPanelsAlive="false"
                     TabPanelsClass="pa-4"
                     @bind-ActivePanelIndex="_activeDetailsTabIndex">
                <MudTabPanel Text="Predefined worlds" Icon="@Icons.Material.Filled.Public">
                    <div class="quasar-layout quasar-gap-2">
                        <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-justify-spacebetween quasar-gap-3">
                            <div>
                                <h3 class="quasar-text quasar-type-subtitle1">Predefined Worlds</h3>
                                <p class="quasar-text quasar-type-body2">
                                    Choose your starting world. Quasar copies it into a reusable template; your server's name, settings and mods come next.
                                </p>
                                <p class="quasar-text quasar-type-body2">Custom Worlds are starting maps, Quick Starts are ready-made starts, and Scenarios contain scenario-specific gameplay. Pick the world you want your players to start in.</p>
                            </div>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_installedTemplates.Count</MudChip>
                        </div>

                        <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-gap-1">
                            <MudTextField
                                @bind-Value="_installedTemplateSearch"
                                Label="Search installed templates"
                                Variant="Variant.Outlined"
                                Immediate="true"
                                Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.Search"
                                Class="flex-grow-1" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshInstalledTemplatesAsync" Disabled="_discovering">
                                Refresh
                            </MudButton>
                        </div>

                        @if (_discovering)
                        {
                            <QuasarOperationLoader Title="Finding starting worlds" Message="Checking installed Dedicated Server content for worlds and scenarios. Results will appear here automatically." />
                        }
                        @if (_discoveryError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_discoveryError Check folder access, then use Refresh to try again.</MudAlert>
                        }
                        @foreach (var warning in _discoveryWarnings)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@warning</MudAlert>
                        }
                        @if (!_discovering && _installedTemplates.Count == 0)
                        {
                            @if (!IsDedicatedServerReady)
                            {
                                <DedicatedServerSetupStatus />
                                <p>Waiting for the server's starting worlds. Quasar will check again automatically when the Dedicated Server is ready. You can also use Custom import if you already have a save folder on this machine.</p>
                            }
                            else if (_discoveryError is null)
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                    Server files are ready, but no starting worlds were found. Use Updates to check or repair the Dedicated Server installation, then Refresh here. Or use Custom import to choose an existing save folder containing Sandbox.sbc.
                                </MudAlert>
                            }
                        }
                        @if (_installedTemplates.Count > 0)
                        {
                            <MudTable T="InstalledWorldTemplateSource" Dense="true" Hover="true" Items="FilteredInstalledTemplates" Breakpoint="Breakpoint.Sm" Class="installed-world-template-table">
                                <ColGroup>
                                    <col class="installed-world-template-name-column" />
                                    <col class="installed-world-template-source-column" />
                                    <col class="installed-world-template-action-column" />
                                </ColGroup>
                                <HeaderContent>
                                    <MudTh Class="installed-world-template-name-cell">Name</MudTh>
                                    <MudTh Class="installed-world-template-source-cell">Source</MudTh>
                                    <MudTh Class="installed-world-template-action-cell quasar-actions-column"><span class="quasar-visually-hidden">Actions</span></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Name" Class="installed-world-template-name-cell">
                                        <p class="quasar-text quasar-type-body2 installed-world-template-name-text">@context.DisplayName</p>
                                    </MudTd>
                                    <MudTd DataLabel="Source" Class="installed-world-template-source-cell">
                                        <div class="quasar-layout quasar-gap-0 installed-world-template-source-stack">
                                            <span class="quasar-text quasar-type-caption installed-world-template-source-text">@context.Category</span>
                                            <span class="quasar-text quasar-type-caption mono installed-world-template-source-text">@context.SourceDisplayPath</span>
                                        </div>
                                    </MudTd>
                                    <MudTd DataLabel="" Class="installed-world-template-action-cell quasar-actions-column">
                                        <MudButton Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                                                   OnClick="@(() => ImportPredefinedTemplateAsync(context))">Use this world</MudButton>
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="ma-4">
                                        No installed templates match current search.
                                        <MudButton OnClick="@(() => _installedTemplateSearch = string.Empty)">Clear search</MudButton>
                                    </MudAlert>
                                </NoRecordsContent>
                            </MudTable>
                        }
                        @if (_discoveryLocations.Count > 0)
                        {
                            <details>
                                <summary>Where Quasar looked</summary>
                                <p>Folders on the machine running Quasar, including its detected Dedicated Server installation.</p>
                                @foreach (var location in _discoveryLocations)
                                {
                                    <p class="quasar-text quasar-type-caption mono" style="overflow-wrap:anywhere">@location</p>
                                }
                            </details>
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Custom import" Icon="@Icons.Material.Filled.FolderOpen">
                    <MudForm @ref="_form" @bind-IsValid="_formIsValid">
                    <div class="quasar-layout quasar-gap-3">
                        <p class="quasar-text quasar-type-body2">
                            Import an existing Space Engineers save folder as a reusable world template, then select it in the server editor.
                        </p>

                        <MudTextField
                            @bind-Value="_name"
                            Label="Template name"
                            Variant="Variant.Outlined"
                            Immediate="true"
                            AutoFocus="true"
                            Required="true"
                            RequiredError="Template name required." />

                        <MudTextField
                            @bind-Value="_description"
                            Label="Description"
                            Variant="Variant.Outlined"
                            Immediate="true"
                            Lines="3"
                            Sizing="InputSizing.Auto"
                            MaxLines="10000" />

                        <div class="quasar-layout quasar-layout-row quasar-align-start quasar-gap-1">
                            <MudTextField
                                @bind-Value="_sourcePath"
                                Label="Source world path"
                                Variant="Variant.Outlined"
                                Immediate="true"
                                Class="flex-grow-1"
                                Required="true"
                                RequiredError="Source world path required."
                                HelperText="Absolute path to an existing SE save folder containing Sandbox.sbc." />
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.FolderOpen"
                                       Class="world-template-browse-button"
                                       OnClick="OpenFolderPickerAsync">
                                Browse
                            </MudButton>
                        </div>
                    </div>
                    </MudForm>
                </MudTabPanel>
            </MudTabs>
        }
        else if (!_importing)
        {
            <div class="quasar-layout quasar-gap-3">
                <h3 class="quasar-text quasar-type-subtitle2">Template config profile</h3>
                @if (!string.IsNullOrWhiteSpace(_sourceProfileLoadError))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        Could not read world settings from <code>@WorldSandboxConfigEditor.SandboxConfigFileName</code>. @_sourceProfileLoadError
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Found @_sourceSettingCount session setting(s) and @_sourceMods.Count mod(s) in the source world's <code>@WorldSandboxConfigEditor.SandboxConfigFileName</code>. Quasar writes the selected config profile's session settings and mods into the active world on server start.
                    </MudAlert>
                }

                <MudRadioGroup T="WorldImportModAction" @bind-Value="_modAction">
                    <div class="quasar-layout quasar-gap-1">
                        <MudRadio T="WorldImportModAction"
                                  Value="WorldImportModAction.CreateProfile"
                                  Color="Color.Primary"
                                  Disabled="@(!CanCreateProfileFromSource)">
                            Create new config profile from world settings
                        </MudRadio>
                        <MudRadio T="WorldImportModAction" Value="WorldImportModAction.ExistingProfile" Color="Color.Primary" Disabled="@(!CanImportModsIntoExistingProfile)">
                            Import mods into existing config profile
                        </MudRadio>
                        <MudRadio T="WorldImportModAction" Value="WorldImportModAction.None" Color="Color.Primary">
                            Import the world template only
                        </MudRadio>
                    </div>
                </MudRadioGroup>

                @if (_modAction == WorldImportModAction.CreateProfile && CanCreateProfileFromSource)
                {
                    <MudTextField
                        @bind-Value="_newProfileName"
                        Label="Profile name"
                        Variant="Variant.Outlined"
                        Immediate="true"
                        Required="true"
                        RequiredError="Profile name required." />

                    <MudTextField
                        @bind-Value="_newProfileDescription"
                        Label="Description"
                        Variant="Variant.Outlined"
                        Immediate="true"
                        Lines="3"
                        Sizing="InputSizing.Auto"
                        MaxLines="10000" />
                }
                else if (_modAction == WorldImportModAction.ExistingProfile)
                {
                    <MudSelect T="string"
                               @bind-Value="_selectedConfigProfileId"
                               Label="Config profile"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="Config profile required.">
                        @foreach (var profile in ConfigProfiles.GetProfiles())
                        {
                            <MudSelectItem T="string" Value="@profile.ConfigProfileId">@profile.Name</MudSelectItem>
                        }
                    </MudSelect>
                }

                @if (_sourceMods.Count > 0)
                {
                    <MudTable T="QuasarModSelection" Items="_sourceMods" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Workshop ID</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">@context.DisplayName</MudTd>
                            <MudTd DataLabel="Workshop ID" Class="mono">@context.WorkshopId</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (_step == ImportStep.ConfigProfile)
        {
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="BackToDetails" Disabled="@_importing">Back</MudButton>
        }
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="@_importing">Cancel</MudButton>
        @if (_step == ImportStep.ConfigProfile || IsCustomImportTabActive)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueAsync" Disabled="@_importing">
                @GetPrimaryButtonText()
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject]
    private QuasarWorldTemplateCatalog WorldTemplates { get; set; } = default!;

    [Inject]
    private QuasarConfigProfileCatalog ConfigProfiles { get; set; } = default!;

    [Inject]
    private QuasarWorkshopModResolver WorkshopMods { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    [Inject]
    private IDialogService DialogService { get; set; } = default!;

    [Inject]
    private WorldTemplateImportLocationService ImportLocations { get; set; } = default!;

    [Parameter]
    public string? InitialConfigProfileId { get; set; }

    [Parameter]
    public bool TemplateOnly { get; set; }

    private MudForm? _form;
    private bool _formIsValid;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _sourcePath = string.Empty;
    private string _installedTemplateSearch = string.Empty;
    private string _selectedConfigProfileId = string.Empty;
    private string _newProfileName = string.Empty;
    private string _newProfileDescription = string.Empty;
    private QuasarConfigProfile? _sourceConfigProfile;
    private List<QuasarModSelection> _sourceMods = [];
    private int _sourceSettingCount;
    private string? _sourceProfileLoadError;
    private IReadOnlyList<InstalledWorldTemplateSource> _installedTemplates = [];
    private ImportStep _step = ImportStep.Details;
    private int _activeDetailsTabIndex;
    private WorldImportModAction _modAction = WorldImportModAction.CreateProfile;
    private bool _importing;
    private string? _importError;
    private string _importMessage = string.Empty;
    private double? _importPercent;
    private bool _copyComplete;
    private bool _discovering;
    private bool _rescanRequested;
    private bool _disposed;
    private bool _wasDedicatedServerReady;
    private string? _discoveryError;
    private IReadOnlyList<string> _discoveryLocations = [];
    private IReadOnlyList<string> _discoveryWarnings = [];
    private readonly CancellationTokenSource _stop = new();
    private bool IsDedicatedServerReady => RuntimeWarmup.GetSnapshot().Components.Any(c =>
        c.Component == ManagedRuntimeInstallComponent.DedicatedServer && c.State == ManagedRuntimeComponentState.Ready);

    private bool IsCustomImportTabActive => _activeDetailsTabIndex == CustomImportTabIndex;

    private bool CanCreateProfileFromSource =>
        _sourceConfigProfile is not null && string.IsNullOrWhiteSpace(_sourceProfileLoadError);

    private bool CanImportModsIntoExistingProfile =>
        _sourceMods.Count > 0 && ConfigProfiles.GetProfiles().Count > 0;

    private IReadOnlyList<InstalledWorldTemplateSource> FilteredInstalledTemplates =>
        _installedTemplates
            .Where(MatchesInstalledTemplateSearch)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        RuntimeWarmup.Changed += RuntimeChanged;
        _wasDedicatedServerReady = IsDedicatedServerReady;
        if (!TemplateOnly)
        {
            _selectedConfigProfileId = GetInitialConfigProfileId();
            if (!string.IsNullOrWhiteSpace(_selectedConfigProfileId))
                _modAction = WorldImportModAction.ExistingProfile;
        }
        await RefreshInstalledTemplatesAsync();
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void BackToDetails()
    {
        _step = ImportStep.Details;
    }

    private async Task OpenFolderPickerAsync()
    {
        var initialPath = await ImportLocations.GetInitialPathAsync(_sourcePath);
        var parameters = new DialogParameters
        {
            [nameof(FolderPickerDialog.InitialPath)] = initialPath,
            [nameof(FolderPickerDialog.AdditionalShortcuts)] = ImportLocations.GetContentShortcuts(),
        };

        var dialog = await DialogService.ShowAsync<FolderPickerDialog>(
            "Pick world folder",
            parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string path })
        {
            _sourcePath = path;
            await ImportLocations.RememberAsync(path);
        }
    }

    private async Task ContinueAsync()
    {
        if (_step == ImportStep.ConfigProfile)
        {
            await ImportAsync();
            return;
        }

        if (_form is null)
        {
            Snackbar.Add("Choose a predefined world or open Custom import.", Severity.Info);
            return;
        }

        await _form!.ValidateAsync();
        if (!_formIsValid)
            return;

        await ContinueFromDetailsAsync();
    }

    private async Task ImportPredefinedTemplateAsync(InstalledWorldTemplateSource source)
    {
        if (_importing) return;
        _name = source.DisplayName;
        _description = source.Description;
        _sourcePath = source.SourcePath;
        await ContinueFromDetailsAsync();
    }

    private async Task ContinueFromDetailsAsync()
    {
        if (TemplateOnly)
        {
            await ImportAsync();
            return;
        }

        LoadSourceConfigProfile();

        _newProfileName = string.IsNullOrWhiteSpace(_newProfileName)
            ? $"{_name.Trim()} Config"
            : _newProfileName;
        _newProfileDescription = string.IsNullOrWhiteSpace(_newProfileDescription)
            ? $"Created from imported world template '{_name.Trim()}'."
            : _newProfileDescription;

        _selectedConfigProfileId = FirstExistingProfileId(_selectedConfigProfileId) ?? ConfigProfiles.GetProfiles().FirstOrDefault()?.ConfigProfileId ?? string.Empty;
        if (_modAction == WorldImportModAction.ExistingProfile && !CanImportModsIntoExistingProfile)
            _modAction = CanCreateProfileFromSource ? WorldImportModAction.CreateProfile : WorldImportModAction.None;
        if (_modAction == WorldImportModAction.CreateProfile && !CanCreateProfileFromSource)
            _modAction = CanImportModsIntoExistingProfile ? WorldImportModAction.ExistingProfile : WorldImportModAction.None;

        _step = ImportStep.ConfigProfile;
    }

    private async Task RefreshInstalledTemplatesAsync()
    {
        if (_disposed) return;
        if (_discovering) { _rescanRequested = true; return; }
        do
        {
            _rescanRequested = false;
            _discovering = true;
            _discoveryError = null;
            StateHasChanged();
            try
            {
                var token = _stop.Token;
                var result = await Task.Run(() => ImportLocations.DiscoverInstalledWorldTemplates(token), token);
                if (_disposed) return;
                _installedTemplates = result.Templates;
                _discoveryLocations = result.Locations;
                _discoveryWarnings = result.Warnings;
            }
            catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
            catch (Exception exception) { if (!_disposed) _discoveryError = $"World discovery failed: {exception.Message}"; }
            finally { _discovering = false; }
        } while (_rescanRequested && !_disposed);
        if (!_disposed) StateHasChanged();
    }

    private void RuntimeChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        bool ready = IsDedicatedServerReady;
        bool becameReady = ready && !_wasDedicatedServerReady;
        _wasDedicatedServerReady = ready;
        if (becameReady) await RefreshInstalledTemplatesAsync();
        if (!_disposed) StateHasChanged();
    });

    public void Dispose()
    {
        _disposed = true;
        RuntimeWarmup.Changed -= RuntimeChanged;
        _stop.Cancel();
        _stop.Dispose();
    }

    private bool MatchesInstalledTemplateSearch(InstalledWorldTemplateSource template)
    {
        var search = _installedTemplateSearch?.Trim();
        if (string.IsNullOrWhiteSpace(search))
            return true;

        return Contains(template.DisplayName, search) ||
               Contains(template.Category, search) ||
               Contains(template.SourceDisplayPath, search) ||
               Contains(template.SourcePath, search);
    }

    private static bool Contains(string value, string search) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private async Task ImportAsync()
    {
        if (_importing) return;
        if (_modAction == WorldImportModAction.CreateProfile && _step == ImportStep.ConfigProfile && string.IsNullOrWhiteSpace(_newProfileName))
        {
            Snackbar.Add("Profile name required.", Severity.Warning);
            return;
        }

        if (_modAction == WorldImportModAction.CreateProfile && _step == ImportStep.ConfigProfile && !CanCreateProfileFromSource)
        {
            Snackbar.Add("World settings could not be read for a new config profile.", Severity.Warning);
            return;
        }

        if (_modAction == WorldImportModAction.ExistingProfile &&
            _step == ImportStep.ConfigProfile &&
            string.IsNullOrWhiteSpace(_selectedConfigProfileId))
        {
            Snackbar.Add("Config profile required.", Severity.Warning);
            return;
        }

        if (_modAction == WorldImportModAction.ExistingProfile &&
            _step == ImportStep.ConfigProfile &&
            _sourceMods.Count == 0)
        {
            Snackbar.Add("No template mods to import.", Severity.Warning);
            return;
        }

        _importing = true;
        _importError = null;
        _importPercent = null;
        _copyComplete = false;
        _importMessage = "Finding files to copy. Large worlds can take several minutes.";
        StateHasChanged();
        try
        {
            var progress = new Progress<WorldTemplateImportProgress>(update =>
            {
                _ = InvokeAsync(() =>
                {
                    if (_disposed || !_importing || _copyComplete) return;
                    _importMessage = $"Copying world files: {update.CompletedFiles} of {update.TotalFiles}.";
                    _importPercent = update.TotalFiles > 0 ? 100d * update.CompletedFiles / update.TotalFiles : null;
                    StateHasChanged();
                });
            });
            var template = await WorldTemplates.ImportAsync(_name.Trim(), _description?.Trim() ?? string.Empty, _sourcePath.Trim(), _stop.Token, progress);
            _copyComplete = true;
            if (_disposed) return;
            _importMessage = "World copied. Preparing the selected configuration and checking mod dependencies.";
            _importPercent = null;
            StateHasChanged();
            var configProfileId = await ApplyModActionAsync(template.WorldTemplateId);
            if (!_disposed) MudDialog.Close(DialogResult.Ok(new WorldTemplateQuickImportResult(template, configProfileId)));
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (!_disposed) _importError = $"Could not finish preparing this world: {exception.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task<string?> ApplyModActionAsync(string worldTemplateId)
    {
        if (_step != ImportStep.ConfigProfile || _modAction == WorldImportModAction.None)
            return null;

        if (_modAction == WorldImportModAction.ExistingProfile)
        {
            var profile = ConfigProfiles.GetProfile(_selectedConfigProfileId)
                ?? throw new InvalidOperationException("Selected config profile no longer exists.");
            var added = MergeMods(profile, _sourceMods);
            await ResolveProfileModDependenciesAsync(profile);
            await ConfigProfiles.UpsertAsync(profile);
            Snackbar.Add(added > 0
                ? $"Imported {added} mod(s) into config profile '{profile.Name}'."
                : $"Config profile '{profile.Name}' already has these mods.",
                added > 0 ? Severity.Success : Severity.Info);
            return profile.ConfigProfileId;
        }

        if (_sourceConfigProfile is null)
            return null;

        var newProfile = _sourceConfigProfile;
        newProfile.ConfigProfileId = string.Empty;
        newProfile.SourceWorldTemplateId = worldTemplateId;
        newProfile.Name = _newProfileName.Trim();
        newProfile.Description = _newProfileDescription?.Trim() ?? string.Empty;
        QuasarDefaultPlugins.Apply(newProfile, enable: true);

        await ResolveProfileModDependenciesAsync(newProfile);
        await ConfigProfiles.UpsertAsync(newProfile);
        Snackbar.Add($"Config profile '{newProfile.Name}' created from world settings.", Severity.Success);
        await OpenConfigProfileEditorAsync(newProfile.ConfigProfileId);
        return newProfile.ConfigProfileId;
    }

    private async Task OpenConfigProfileEditorAsync(string configProfileId)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfigsPageDialog.InitialProfileId)] = configProfileId,
        };

        var dialog = await DialogService.ShowAsync<ConfigsPageDialog>(
            "Config Profiles",
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                FullScreen = true,
            });

        await dialog.Result;
    }

    private void LoadSourceConfigProfile()
    {
        _sourceConfigProfile = null;
        _sourceMods = [];
        _sourceSettingCount = 0;
        _sourceProfileLoadError = null;

        var sandboxConfigPath = Path.Combine(_sourcePath.Trim(), WorldSandboxConfigEditor.SandboxConfigFileName);
        try
        {
            var import = WorldSandboxConfigEditor.ReadConfigProfile(sandboxConfigPath);
            _sourceConfigProfile = import.Profile;
            _sourceMods = import.Profile.Mods.ToList();
            _sourceSettingCount = import.SessionSettingCount;
        }
        catch (Exception exception)
        {
            _sourceProfileLoadError = exception.Message;
        }
    }

    private string GetInitialConfigProfileId() =>
        FirstExistingProfileId(InitialConfigProfileId) ?? ConfigProfiles.GetProfiles().FirstOrDefault()?.ConfigProfileId ?? string.Empty;

    private string? FirstExistingProfileId(string? configProfileId)
    {
        if (string.IsNullOrWhiteSpace(configProfileId))
            return null;

        var trimmed = configProfileId.Trim();
        return ConfigProfiles.GetProfile(trimmed) is null ? null : trimmed;
    }

    private string GetPrimaryButtonText() =>
        _importing
            ? "Importing..."
            : TemplateOnly
                ? "Create World Template"
                : _step == ImportStep.ConfigProfile
                    ? "Import World Template"
                    : "Continue";

    private static int MergeMods(QuasarConfigProfile profile, IEnumerable<QuasarModSelection> mods)
    {
        var existing = profile.Mods.Select(mod => mod.WorkshopId).ToHashSet();
        var added = 0;
        foreach (var mod in mods)
        {
            if (mod.WorkshopId <= 0 || !existing.Add(mod.WorkshopId))
                continue;

            profile.Mods.Add(new QuasarModSelection
            {
                WorkshopId = mod.WorkshopId,
                DisplayName = mod.DisplayName,
            });
            added++;
        }

        return added;
    }

    private async Task ResolveProfileModDependenciesAsync(QuasarConfigProfile profile)
    {
        if (profile.Mods.Count == 0)
            return;

        var result = await WorkshopMods.ResolveDependenciesAsync(profile.Mods);
        profile.Mods = result.Mods.ToList();
        profile.RootSettings.AutodetectDependencies = result.Warnings.Count > 0;

        if (result.AddedDependencyCount > 0)
            Snackbar.Add($"Added {result.AddedDependencyCount} dependency mod(s).", Severity.Success);

        if (result.Warnings.Count > 0)
            Snackbar.Add($"Mod dependency check: {SummarizeWarnings(result.Warnings)}", Severity.Warning);
    }

    private static string SummarizeWarnings(IReadOnlyList<string> warnings)
    {
        var preview = warnings.Take(2).ToList();
        var summary = string.Join(" ", preview);
        if (warnings.Count > preview.Count)
            summary = $"{summary} (+{warnings.Count - preview.Count} more)";

        return summary;
    }

    public sealed record WorldTemplateQuickImportResult(QuasarWorldTemplate Template, string? ConfigProfileId);

    private enum ImportStep
    {
        Details,
        ConfigProfile,
    }

    private const int CustomImportTabIndex = 1;

    private enum WorldImportModAction
    {
        CreateProfile,
        ExistingProfile,
        None,
    }
}
