@page "/notifications"
@attribute [Authorize(Policy = QuasarPolicyNames.CanView)]
@implements IDisposable
@inject QuasarUpdateService Updates
@inject ClusterReleaseMonitor Releases
@inject ClusterContentMonitor Content
@inject ClusterCatalog Clusters
@inject AuthenticationStateProvider AuthenticationState
@inject BrowserPushState Push
@inject PushNotificationService NotificationService
@inject ILogger<Notifications> Logger

<PageTitle>Notifications</PageTitle>

<div class="quasar-stack">
    <h1>Notifications</h1>
    <p>
        Quasar and cluster updates, plus optional UI plugin updates and instance health alerts. Open a notice to review its details.
    </p>
    <section class="pa-4 quasar-panel quasar-section">
        <div class="quasar-stack">
            <h2>Browser push notifications</h2>
            <p>@(!Push.Checked ? "Checking this browser…" : Push.Enabled ? "Push notifications are enabled on this browser." : "Push notifications are not enabled on this browser.")</p>
            <p class="quasar-muted quasar-caption">These controls affect only this browser and account. Other subscribed clients keep receiving notifications.</p>
            <div class="quasar-row">
                @if (Push.Enabled)
                {
                    <button class="quasar-button quasar-tone-primary" type="button" disabled="@Push.Busy" @onclick="Push.DisableAsync"><QuasarIcon Icon="@QuasarIcons.NotificationsOff" />Disable push notifications</button>
                }
                else
                {
                    <button class="quasar-button quasar-tone-primary quasar-button-fill" type="button" disabled="@(!Push.Checked || !Push.Supported || !Push.ServiceAvailable || Push.Busy)" @onclick="Push.EnableAsync"><QuasarIcon Icon="@QuasarIcons.NotificationsActive" />Enable push notifications</button>
                }
                <button class="quasar-button" type="button" disabled="@Push.Busy" @onclick="Push.RefreshAsync"><QuasarIcon Icon="@QuasarIcons.Refresh" />Refresh status</button>
            </div>
            @if (Push.Error is not null)
            {
                <div class="quasar-notice quasar-notice-warning" role="status">@Push.Error</div>
            }
            else if (Push.Checked && !Push.Supported)
            {
                <div class="quasar-notice quasar-notice-info" role="status">Push requires HTTPS or localhost and a supported browser.</div>
            }
        </div>
    </section>
    <section class="pa-4 quasar-panel quasar-section">
        <div class="quasar-stack">
            <h2>Notification preferences</h2>
            <p>Choose which notices appear here, in the bell, and in browser push. Preferences apply to your account across browsers. Instance alerts are off by default.</p>
            @if (_preferences is not null)
            {
                <form @onsubmit="SavePreferencesAsync" @onsubmit:preventDefault><fieldset class="quasar-fieldset" disabled="@_saving">
                    <div class="quasar-stack">
                        <label class="quasar-check"><input type="checkbox" @bind="_preferences.Updates" />Quasar and cluster updates</label>
                        <AuthorizeView Policy="@QuasarPolicyNames.CanManageSecurity"><label class="quasar-check"><input type="checkbox" @bind="_preferences.UiPluginUpdates" />Quasar UI plugin updates</label></AuthorizeView>
                        <label class="quasar-check"><input type="checkbox" @bind="_preferences.Crashes" />Instance crashes and failures (including automatic crash recovery)</label>
                        <label class="quasar-check"><input type="checkbox" @bind="_preferences.HealthRestarts" />Restarts caused by health checks or agent attach failures</label>
                        <div class="quasar-detail-metrics">
                            <div class="quasar-detail-metric">
                                <label class="quasar-check"><input type="checkbox" @bind="_preferences.LowSimSpeed" />Low simulation speed</label>
                                <label class="quasar-field"><span>Alert below simulation speed</span><input type="number" @bind="_preferences.SimSpeedThreshold" min="0.001" max="1" step="any" required disabled="@(!_preferences.LowSimSpeed)" /></label>
                            </div>
                            <div class="quasar-detail-metric">
                                <label class="quasar-check"><input type="checkbox" @bind="_preferences.HighCpu" />High process CPU usage</label>
                                <label class="quasar-field"><span>Alert above CPU (%)</span><input type="number" @bind="_preferences.CpuThreshold" min="0.1" max="100000" step="any" required disabled="@(!_preferences.HighCpu)" /><small>100% equals one logical CPU; process usage can exceed 100%.</small></label>
                            </div>
                            <div class="quasar-detail-metric">
                                <label class="quasar-check"><input type="checkbox" @bind="_preferences.HighMemory" />High memory usage</label>
                                <label class="quasar-field"><span>Alert above working set (MB)</span><input type="number" @bind="_preferences.MemoryThresholdMb" min="1" max="1048576" step="1" required disabled="@(!_preferences.HighMemory)" /></label>
                            </div>
                            <div class="quasar-detail-metric">
                                <label class="quasar-check"><input type="checkbox" @bind="_preferences.UnsavedWorld" />World has unsaved changes</label>
                                <label class="quasar-field"><span>Alert above unsaved game time (minutes)</span><input type="number" @bind="_preferences.UnsavedThresholdMinutes" min="1" max="10080" step="1" required disabled="@(!_preferences.UnsavedWorld)" /></label>
                            </div>
                            <div class="quasar-detail-metric">
                                <label class="quasar-field"><span>Metric alert duration (seconds)</span><input type="number" @bind="_preferences.SustainedSeconds" min="5" max="3600" step="1" required disabled="false" /><small>A metric must stay past its threshold for this long.</small></label>
                            </div>
                            <div class="quasar-detail-metric">
                                <label class="quasar-field"><span>Metric alert cooldown (seconds)</span><input type="number" @bind="_preferences.CooldownSeconds" min="30" max="86400" step="1" required disabled="false" /><small>Minimum time between alerts for the same instance and metric.</small></label>
                            </div>
                        </div>
                        <label class="quasar-check"><input type="checkbox" @bind="_preferences.Recoveries" />Notify when an alerted metric recovers</label>
                        <p class="quasar-muted quasar-caption">Metric alerts use fresh telemetry from running instances, including cluster nodes. Crash and health-restart alerts cover locally supervised instances. Recent instance alerts remain here for up to 24 hours (100 per account), until Quasar restarts or preferences are saved.</p>
                        <div><button class="quasar-button quasar-tone-primary quasar-button-fill" type="button" disabled="@_saving" @onclick="SavePreferencesAsync">Save preferences</button></div>
                    </div>
                </fieldset></form>
            }
            @if (_settingsError is not null)
            {
                <div class="quasar-notice quasar-notice-error" role="status">@_settingsError</div>
            }
            @if (_saved)
            {
                <div class="quasar-notice quasar-notice-success" role="status">Notification preferences saved.</div>
            }
        </div>
    </section>
    @if (_notices.Length == 0)
    {
        <div class="quasar-notice quasar-notice-info" role="status">No notifications.</div>
    }
    else
    {
        @foreach (var notice in _notices)
        {
            <section class="pa-4 quasar-panel quasar-section" @key="notice.Key">
                <div class="quasar-stack">
                    <h2>@notice.Title</h2>
                    @if (notice.OccurredAt is { } occurredAt)
                    {
                        <p class="quasar-muted quasar-caption">@occurredAt.UtcDateTime.ToString("u")</p>
                    }
                    <p>@notice.Body</p>
                    <div>
                        <a class="quasar-button quasar-tone-primary" aria-label="@($"Open {notice.Title}: {notice.Body}")" href="@notice.Url"><QuasarIcon Icon="@QuasarIcons.OpenInNew" />
                            Open details
                        </a>
                    </div>
                </div>
            </section>
        }
    }
</div>

@code {
    private UpdateNotice[] _notices = [];
    private NotificationPreferences? _preferences;
    private bool _saving;
    private bool _saved;
    private string? _settingsError;

    protected override async Task OnInitializedAsync()
    {
        Updates.Changed += Changed;
        Releases.Changed += Changed;
        Content.Changed += Changed;
        Clusters.Changed += Changed;
        Push.Changed += Changed;
        NotificationService.Changed += Changed;
        AuthenticationState.AuthenticationStateChanged += AuthenticationChanged;
        try
        {
            var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            _preferences = await NotificationService.GetPreferencesAsync(user);
            await RefreshAsync();
        }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Could not load notification preferences.");
            _settingsError = "Notification settings are unavailable. Check Quasar logs and refresh this page.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Push.RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        try { _notices = await NotificationService.GetNoticesAsync(user); }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Could not load notifications.");
            _notices = [];
            _settingsError = "Notifications are unavailable. Check Quasar logs and refresh this page.";
        }
    }

    private async Task SavePreferencesAsync()
    {
        if (_saving || _preferences is null) return;
        _saving = true;
        _saved = false;
        _settingsError = null;
        try
        {
            var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            await NotificationService.SavePreferencesAsync(user, _preferences);
            _saved = true;
            await RefreshAsync();
        }
        catch (InvalidDataException error) { _settingsError = error.Message; }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Could not save notification preferences.");
            _settingsError = "Could not save notification preferences. Refresh this page and try again.";
        }
        finally { _saving = false; }
    }

    private void Changed() => _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
    private void AuthenticationChanged(Task<AuthenticationState> _) => Changed();

    public void Dispose()
    {
        Updates.Changed -= Changed;
        Releases.Changed -= Changed;
        Content.Changed -= Changed;
        Clusters.Changed -= Changed;
        Push.Changed -= Changed;
        NotificationService.Changed -= Changed;
        AuthenticationState.AuthenticationStateChanged -= AuthenticationChanged;
    }
}
