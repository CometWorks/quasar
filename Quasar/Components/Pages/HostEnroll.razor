@page "/hosts/enroll"
@attribute [Authorize(Policy = QuasarPolicyNames.CanManageSecurity)]

@using Quasar.Client.Components
@attribute [ExcludeFromInteractiveRouting]
@layout WasmPageLayout

<PageTitle>Add host machine</PageTitle>
<section class="quasar-panel server-card"><div class="quasar-card-content">
    <QuasarPageHeading Section="Infrastructure">
    <Title>Add host machine</Title>
    <Description>Connect a host machine to the control plane.</Description>
</QuasarPageHeading>
    <HostEnrollmentForm @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />
    <MudButton Href="clusters/new" Class="mt-3">Continue cluster setup</MudButton>
</div></section>
