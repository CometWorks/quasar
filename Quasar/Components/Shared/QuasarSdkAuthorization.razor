@using Quasar.Plugin.Abstractions.Operations
@inject AuthenticationStateProvider Authentication
@inject QuasarOperationService Operations
@inject RbacConfigCatalog Rbac

<MudExpansionPanels Elevation="0" Outlined="true">
    <MudExpansionPanel Text="Plugin endpoint authorization">
        <div class="quasar-layout quasar-gap-3">
            <p>SDK endpoints require authentication. Change their required policies or disable an operation for every supported transport.</p>
            @if (_message is not null)
            {
                <p role="status">@_message</p>
            }
            @foreach (var row in _rows)
            {
                <fieldset class="sdk-authorization-rule quasar-layout quasar-gap-2">
                    <legend class="mono">@row.Settings.PluginId / @row.Settings.OperationId</legend>
                    <div class="quasar-layout quasar-gap-1 quasar-type-caption mud-text-secondary">
                        <p>Declared policies: @string.Join(", ", row.Settings.DefaultPolicies)</p>
                        <p>Effective policies: @string.Join(", ", row.Settings.EffectiveRule?.RequiredPolicies ?? []) (@(row.Settings.Overridden ? "installation override" : "plugin defaults"))</p>
                    </div>
                    @if (row.Settings.Error is not null)
                    {
                        <p role="alert">@row.Settings.Error</p>
                    }
                    <MudCheckBox T="bool" @bind-Value="row.Enabled" Label="Operation enabled" Color="Color.Primary" Disabled="@_saving" />
                    <MudTextField T="string" @bind-Value="row.Policies" Label="Required policies" HelperText="Separate policies with commas. Every policy must pass." Variant="Variant.Outlined" FullWidth="true" Disabled="@_saving" />
                    <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-gap-2">
                        <MudButton OnClick="@(() => SaveAsync(row))" Disabled="@_saving" Variant="Variant.Outlined">Save endpoint rule</MudButton>
                        <MudButton OnClick="@(() => ResetAsync(row))" Disabled="@_saving" Variant="Variant.Outlined">Restore declared policies</MudButton>
                    </div>
                </fieldset>
            }
            @if (_rows.Count == 0 && _message is null)
            {
                <p>No plugins have registered SDK operations.</p>
            }
            <section class="sdk-authorization-policies quasar-layout quasar-gap-2">
                <h3 class="quasar-text quasar-type-subtitle1">Shared policy role grants</h3>
                <p>Changing a shared policy affects every endpoint using it, including existing Quasar endpoints. Empty role grants deny that policy. Security administration must retain the admin role.</p>
                @foreach (var policy in _policyOverrides)
                {
                    <p>@policy.Key: @(policy.Value.Count == 0 ? "deny all" : string.Join(", ", policy.Value))</p>
                }
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_policyName" Label="Policy name" Variant="Variant.Outlined" FullWidth="true" Disabled="@_saving" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_policyRoles" Label="Allowed roles" HelperText="Separate roles with commas. Leave empty to deny this policy." Variant="Variant.Outlined" FullWidth="true" Disabled="@_saving" />
                    </MudItem>
                </MudGrid>
                <div>
                    <MudButton OnClick="SaveRolesAsync" Disabled="@_saving" Variant="Variant.Outlined">Save policy role grants</MudButton>
                </div>
            </section>
            <section class="sdk-authorization-policies quasar-layout quasar-gap-2">
                <h3 class="quasar-text quasar-type-subtitle1">Assistant roles</h3>
                <p>The roles the admin assistant and the player agent act with. The assistant also never does more than the person asking it could do. Neither can hold the admin role, and security, RBAC, credential and shutdown operations stay closed to both.</p>
                <MudTextField T="string" @bind-Value="_assistantRoles" Label="Admin assistant roles" HelperText="Separate roles with commas." Variant="Variant.Outlined" FullWidth="true" Disabled="@_saving" />
                <div>
                    <MudButton OnClick="@(() => SaveAgentRolesAsync(Quasar.Plugin.Abstractions.Security.QuasarAgentKind.Assistant, _assistantRoles))" Disabled="@_saving" Variant="Variant.Outlined">Save assistant roles</MudButton>
                </div>
                <MudTextField T="string" @bind-Value="_playerRoles" Label="Player agent roles" HelperText="Separate roles with commas." Variant="Variant.Outlined" FullWidth="true" Disabled="@_saving" />
                <div>
                    <MudButton OnClick="@(() => SaveAgentRolesAsync(Quasar.Plugin.Abstractions.Security.QuasarAgentKind.Player, _playerRoles))" Disabled="@_saving" Variant="Variant.Outlined">Save player agent roles</MudButton>
                </div>
            </section>
        </div>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private List<EditRule> _rows = [];
    private Dictionary<string, List<string>> _policyOverrides = new();
    private string _policyName = "";
    private string _policyRoles = "";
    private string _assistantRoles = "";
    private string _playerRoles = "";
    private string? _message;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        try { await ReloadAsync(); }
        catch (UnauthorizedAccessException) { _message = "Security administration permission is required."; }
    }

    private async Task ReloadAsync()
    {
        var caller = (await Authentication.GetAuthenticationStateAsync()).User;
        _rows = (await Operations.GetSettingsAsync(caller)).Select(settings => new EditRule(settings)).ToList();
        var config = Rbac.GetConfig();
        _policyOverrides = config.PolicyOverrides;
        _assistantRoles = string.Join(", ", config.AgentRoles.GetValueOrDefault(RbacConfig.AgentRoleKey(Quasar.Plugin.Abstractions.Security.QuasarAgentKind.Assistant), []));
        _playerRoles = string.Join(", ", config.AgentRoles.GetValueOrDefault(RbacConfig.AgentRoleKey(Quasar.Plugin.Abstractions.Security.QuasarAgentKind.Player), []));
    }

    private Task SaveAsync(EditRule row) => ChangeAsync(user => Operations.SaveRuleAsync(user,
        row.Settings.PluginId, row.Settings.OperationId, new QuasarOperationRule { Enabled = row.Enabled, RequiredPolicies = Split(row.Policies) }));

    private Task ResetAsync(EditRule row) => ChangeAsync(user => Operations.SaveRuleAsync(user,
        row.Settings.PluginId, row.Settings.OperationId, null));

    private Task SaveRolesAsync() => ChangeAsync(user => Operations.SavePolicyRolesAsync(user, _policyName.Trim(), Split(_policyRoles)));

    private Task SaveAgentRolesAsync(Quasar.Plugin.Abstractions.Security.QuasarAgentKind kind, string roles) =>
        ChangeAsync(user => Operations.SaveAgentRolesAsync(user, kind, Split(roles)));

    private async Task ChangeAsync(Func<System.Security.Claims.ClaimsPrincipal, Task> change)
    {
        _saving = true;
        try
        {
            await change((await Authentication.GetAuthenticationStateAsync()).User);
            await ReloadAsync();
            _message = "Authorization settings saved.";
        }
        catch (Exception error) when (error is UnauthorizedAccessException or ArgumentException or InvalidOperationException or IOException)
        { _message = error.Message; }
        finally { _saving = false; }
    }

    private static List<string> Split(string value) => value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private sealed class EditRule(QuasarOperationSettings settings)
    {
        public QuasarOperationSettings Settings { get; } = settings;
        public bool Enabled { get; set; } = settings.EffectiveRule?.Enabled == true;
        public string Policies { get; set; } = string.Join(", ", settings.EffectiveRule?.RequiredPolicies ?? []);
    }
}
