@using Quasar.Hosting
@inject HostedPanelService Hosted
@inject QuasarPermissionService Permissions
@inject RbacConfigCatalog Rbac
@inject QuasarAuthOptions Auth
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<MudDialog>
    <DialogContent>
        <div class="access-setup">
            <div class="access-setup-section">
                <MudProgressLinear Value="@WizardProgress" Color="Color.Primary" aria-label="Setup steps" />
                <span class="quasar-text quasar-type-caption">Step @CurrentStep of @TotalSteps · @StepTitle</span>
            </div>
            @if (NeedsAdministrator)
            {
                <header class="access-setup-header">
                    <h2>Set the first Quasar administrator</h2>
                    <p>Add your SteamID64 so you can sign in after enabling public access.</p>
                </header>
                <MudTextField T="string" @bind-Value="_adminSteamId" Label="Administrator SteamID64" HelperText="Your 17-digit Steam account ID, not your display name or profile URL." Variant="Variant.Outlined" Immediate="true" />
                <p class="access-setup-note">This grants administrator access to this Quasar installation; Nebula hosting entitlement is separate. Use an existing trusted-network administrator session for initial setup. Signing in with Steam alone does not claim an unconfigured panel.</p>
            }
            else if (_connecting)
            {
                <header class="access-setup-header">
                    <h2>@(Hosted.IsReady ? "Your hosted panel is ready" : "Connecting your hosted panel")</h2>
                    <p class="access-setup-address">@Hosted.State.DashboardUrl</p>
                </header>
                <section class="access-setup-card" aria-label="Connection progress">
                    <progress class="access-setup-progress" max="1" value="@(Hosted.IsReady ? "1" : null)" aria-label="Hosted panel connection"></progress>
                    <p role="status" aria-live="polite">@ConnectionStatus</p>
                    <ol class="access-setup-steps">
                        <li data-complete="@Completed(Hosted.State.EnrollmentId is not null)">Create enrollment</li>
                        <li data-complete="@Completed(Hosted.AccessActive)">Confirm Steam account and hosting activation</li>
                        <li data-complete="@Completed(Hosted.ConnectorHealth?.TunnelRegistered == true)">Connect secure tunnel</li>
                        <li data-complete="@Completed(Hosted.IsReady)">Verify Quasar dashboard</li>
                    </ol>
                </section>
                @if (!Hosted.IsReady)
                {
                    @if (!Hosted.AccessActive && Hosted.State.BrowserUrl is { } browserUrl)
                    {
                        <section class="access-setup-section">
                            <p>Continue on Nebula to confirm this installation with Steam and activate hosting. This window updates automatically.</p>
                            <div><MudButton Href="@browserUrl" Target="_blank" rel="noopener noreferrer" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.OpenInNew">Continue enrollment with Steam</MudButton></div>
                        </section>
                    }
                    <p class="access-setup-note">Keep Quasar Bootstrap running while the tunnel connects. Cancel stops hosted setup and its connection; it does not cancel an existing subscription.</p>
                }
                else
                {
                    <p>Open your dashboard and sign in with your configured Steam account. Your existing Quasar permissions apply.</p>
                }
            }
            else if (_hosted)
            {
                <header class="access-setup-header">
                    <h2>Host your Quasar panel with Nebula</h2>
                    <p>Get a public dashboard address without configuring router ports, DNS or certificates. Local access and your game servers keep working independently.</p>
                </header>
                <p class="access-setup-note">Moving or recovering an existing panel? Enter its current public name and confirm replacement on Nebula as its billing owner. Your subscription and remaining paid access stay with it; the old registration is removed automatically.</p>
                <MudTextField T="string" @bind-Value="_panelId" Label="Public panel name" HelperText="3–63 lowercase letters and digits, separated by single dashes." Variant="Variant.Outlined" Immediate="true" />
                <section class="access-setup-card" aria-label="Public dashboard address">
                    <h3>Your public dashboard</h3>
                    <p class="access-setup-address">https://dash.se-servers.net/@(_panelId)/</p>
                </section>
                <section class="access-setup-section">
                    <p>All configured Steam administrators can enroll and manage this panel in Nebula. One payer holds the subscription; another administrator can request a transfer with that payer’s approval and use their own payment details.</p>
                    <h3>€2.99 / month or €29.99 / year</h3>
                    <p>One panel and secure tunnel, in EUR including applicable taxes. Choose your plan on Nebula. Your dashboard connects automatically after activation; configured Nebula super admins can enroll free.</p>
                    <p class="access-setup-note">Your subscription provides hosted access to your Quasar panel and also supports ongoing development and future CometWorks projects.</p>
                </section>
                @if (!Auth.Enabled || !Auth.Steam.Enabled)
                {
                    <MudAlert Severity="Severity.Warning">Enable Steam authentication in Quasar before enrolling a public panel.</MudAlert>
                }
            }
            else
            {
                <header class="access-setup-header">
                    <h2>Choose how you reach Quasar</h2>
                    <p>Local access and your game servers keep working independently of public hosting.</p>
                </header>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <div class="access-setup-section">
                            <MudButton Variant="@ChoiceVariant("self")" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Dns"
                                       Style="width: 100%; min-height: 72px;" aria-pressed="@Completed(_selectedChoice == "self")"
                                       OnClick="@(() => _selectedChoice = "self")">Self-deploy</MudButton>
                            <p class="access-setup-note">Manage your own reverse proxy, domain and certificate using Quasar's security settings.</p>
                        </div>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <div class="access-setup-section">
                            <MudButton Variant="@ChoiceVariant("hosted")" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Cloud"
                                       Style="width: 100%; min-height: 72px;" aria-pressed="@Completed(_selectedChoice == "hosted")"
                                       OnClick="@(() => _selectedChoice = "hosted")">Use hosted panel</MudButton>
                            <p class="access-setup-note">Let Nebula connect your panel automatically and provide a public dashboard URL. Sign in using your existing Steam permissions.</p>
                        </div>
                    </MudItem>
                </MudGrid>
            }
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="access-setup-actions">
            @if (_connecting && !NeedsAdministrator)
            {
                @if (Hosted.IsReady)
                {
                    <MudButton Href="https://dash.se-servers.net/account" Target="_blank" rel="noopener noreferrer" Variant="Variant.Outlined">Manage Nebula hosting and billing</MudButton>
                    <MudButton OnClick="Close" Disabled="@_busy">Done</MudButton>
                    <MudButton Href="@Hosted.State.DashboardUrl" Variant="Variant.Filled" Color="Color.Primary">Open Quasar dashboard</MudButton>
                }
                else
                {
                    <MudButton OnClick="CancelEnrollmentAsync" Disabled="@_canceling" Variant="Variant.Outlined">Cancel</MudButton>
                }
            }
            else
            {
                @if (NeedsAdministrator)
                {
                    <MudButton OnClick="SaveAdministratorAsync" Disabled="@(_busy || !RbacConfigCatalog.IsSteamId64(_adminSteamId?.Trim()))" Variant="Variant.Filled" Color="Color.Primary">Save administrator and continue</MudButton>
                    <MudButton OnClick="DismissAsync" Disabled="@_busy">Cancel</MudButton>
                }
                else if (_hosted)
                {
                    <MudButton OnClick="Back" Disabled="@_busy" StartIcon="@Icons.Material.Filled.ArrowBack">Back</MudButton>
                    <MudButton OnClick="DismissAsync" Disabled="@_busy">Cancel</MudButton>
                    <MudButton OnClick="HostedAsync" Disabled="@(_busy || !Auth.Enabled || !Auth.Steam.Enabled || !HostedPanelState.IsPanelId(_panelId))" Variant="Variant.Filled" Color="Color.Primary">Start hosted enrollment</MudButton>
                }
                else
                {
                    <MudButton OnClick="DismissAsync" Disabled="@_busy">Cancel</MudButton>
                    <MudButton OnClick="ContinueChoiceAsync" Disabled="@(_busy || _selectedChoice is null)" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">Next</MudButton>
                }
            }
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    private bool _hosted, _busy, _connecting, _starting, _canceling, _administratorStepIncluded;
    private string _panelId = "";
    private string _adminSteamId = "";
    private string? _error;
    private string? _selectedChoice;
    private CancellationTokenSource? _enrollmentCancellation;
    private bool NeedsAdministrator => !RbacConfigCatalog.HasAdminMapping(Rbac.GetConfig());
    private string ConnectionStatus => _starting ? "Creating your enrollment…"
        : Hosted.IsReady ? "Hosted dashboard ready"
        : Hosted.Status == "Not enrolled" ? "Waiting for hosting activation and the secure tunnel…" : Hosted.Status;
    private static string Completed(bool value) => value ? "true" : "false";
    private int CurrentStep => NeedsAdministrator ? 1 : (_administratorStepIncluded ? 1 : 0) + (_connecting ? 3 : _hosted ? 2 : 1);
    private int TotalSteps => (_administratorStepIncluded ? 1 : 0) + (_selectedChoice == "self" ? 1 : 3);
    private double WizardProgress => 100d * CurrentStep / TotalSteps;
    private string StepTitle => NeedsAdministrator ? "Administrator" : _connecting ? "Connection" : _hosted ? "Hosted panel" : "Access method";
    private Variant ChoiceVariant(string choice) => _selectedChoice == choice ? Variant.Filled : Variant.Outlined;

    protected override void OnInitialized()
    {
        var state = Hosted.State;
        _panelId = state.PanelId;
        _hosted = state.Choice == "hosted";
        _selectedChoice = state.Choice is "self" or "hosted" ? state.Choice : null;
        _administratorStepIncluded = NeedsAdministrator;
        _connecting = _hosted && state.EnrollmentId is not null;
        Hosted.Changed += Changed;
        Rbac.Changed += Changed;
    }
    private void Changed() => _ = InvokeAsync(() =>
    {
        if (_connecting && !_starting && Hosted.State.EnrollmentId is null)
        {
            _connecting = false;
            _error = Hosted.Status;
        }
        StateHasChanged();
    });
    private Task SaveAdministratorAsync() => RunAsync(() => Rbac.AddFirstSteamAdminAsync(_adminSteamId));
    private async Task SelfDeployAsync() => await RunAsync(async () =>
    {
        EnsureAdministrator();
        await Hosted.ChooseAsync("self");
        Dialog.Close();
        Navigation.NavigateTo("settings/security");
    });
    private void Close() => Dialog.Close();
    private void Back() { _hosted = false; _error = null; }
    private Task ContinueChoiceAsync() => _selectedChoice == "self" ? SelfDeployAsync() : RunAsync(() =>
    {
        EnsureAdministrator();
        if (_selectedChoice != "hosted") throw new InvalidOperationException("Choose how you want to access Quasar.");
        _hosted = true;
        return Task.CompletedTask;
    });
    private async Task DismissAsync() => await RunAsync(async () =>
    {
        if (Hosted.State.Choice == "") await Hosted.ChooseAsync("dismissed");
        Dialog.Close();
    });
    private Task HostedAsync() => RunAsync(async () =>
    {
        EnsureAdministrator();
        _connecting = true;
        _starting = true;
        using var cancellation = new CancellationTokenSource();
        _enrollmentCancellation = cancellation;
        try
        {
            var url = await Hosted.EnrollAsync(_panelId, cancellation.Token);
            cancellation.Token.ThrowIfCancellationRequested();
            // Keep the enrollment link visible when opening a new tab is blocked.
            try { await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer"); }
            catch (JSException) { _error = "Use the Steam enrollment button above to continue in Nebula."; }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            _enrollmentCancellation = null;
            _starting = false;
            if (Hosted.State.EnrollmentId is null) _connecting = false;
        }
    });
    private async Task CancelEnrollmentAsync()
    {
        _canceling = true;
        try
        {
            await RunAsync(async () =>
            {
                _enrollmentCancellation?.Cancel();
                await Hosted.ChooseAsync("self");
                Dialog.Cancel();
            });
        }
        finally { _canceling = false; }
    }
    private void EnsureAdministrator()
    {
        if (NeedsAdministrator) throw new InvalidOperationException("Configure a Quasar administrator before choosing public access.");
    }
    private async Task RunAsync(Func<Task> action)
    {
        if (!await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanManageSecurity)) { _error = "Administrator permission is required."; return; }
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is ArgumentException or InvalidOperationException or HttpRequestException or TaskCanceledException or IOException or UnauthorizedAccessException or System.Text.Json.JsonException)
        { _error = e.Message; }
        finally { _busy = false; }
    }
    public void Dispose()
    {
        _enrollmentCancellation?.Cancel();
        Hosted.Changed -= Changed;
        Rbac.Changed -= Changed;
    }
}
