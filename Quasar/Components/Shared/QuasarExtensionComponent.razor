@if (Contribution is not null)
{
    if (string.IsNullOrWhiteSpace(EffectivePolicy))
    {
        <DynamicComponent Type="@Contribution.ComponentType" Parameters="@EffectiveParameters" />
    }
    else
    {
        <AuthorizeView Policy="@EffectivePolicy">
            <Authorized>
                <DynamicComponent Type="@Contribution.ComponentType" Parameters="@EffectiveParameters" />
            </Authorized>
            <NotAuthorized>
                @NotAuthorizedContent
            </NotAuthorized>
        </AuthorizeView>
    }
}

@code
{
    [Parameter]
    public QuasarExtensionContribution? Contribution { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, object?>? Parameters { get; set; }

    [Parameter]
    public string? DefaultPolicy { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? NotAuthorizedContent { get; set; }

    private string? EffectivePolicy => string.IsNullOrWhiteSpace(Contribution?.Policy)
        ? DefaultPolicy
        : Contribution.Policy;

    private IDictionary<string, object?> EffectiveParameters
    {
        get
        {
            var parameters = Parameters is null
                ? new Dictionary<string, object?>()
                : new Dictionary<string, object?>(Parameters, StringComparer.Ordinal);

            if (ChildContent is not null)
                parameters[nameof(ChildContent)] = ChildContent;

            return parameters;
        }
    }
}
