@inject IJSRuntime JS
@inject ISnackbar Snackbar

@if (!string.IsNullOrWhiteSpace(Value))
{
    <span class="@RootCssClass">
        <span class="@TextCssClass" title="@(ShowValueTooltip ? ResolvedValueTooltip : null)">@ResolvedDisplayValue</span>
        <QuasarIconButton Label="@Tooltip" Icon="@QuasarIcons.ContentCopy" Class="copyable-path-button" OnClick="CopyAsync" />
    </span>
}

@code
{
    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? DisplayValue { get; set; }

    [Parameter]
    public Typo Typo { get; set; } = Typo.caption;

    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public string TextClass { get; set; } = "quasar-muted";

    [Parameter]
    public bool Inline { get; set; }

    [Parameter]
    public string Tooltip { get; set; } = "Copy path";

    [Parameter]
    public bool ShowValueTooltip { get; set; }

    [Parameter]
    public string? ValueTooltip { get; set; }

    [Parameter]
    public string SuccessMessage { get; set; } = "Path copied to clipboard.";

    [Parameter]
    public string FailureMessage { get; set; } = "Copy failed - select and copy the path manually.";

    private string RootCssClass => Inline
        ? JoinCss("copyable-path-inline", Class)
        : JoinCss("copyable-path", Class);

    private string TextCssClass => JoinCss("copyable-path-text", TextClass);

    private string ResolvedDisplayValue => string.IsNullOrWhiteSpace(DisplayValue) ? Value : DisplayValue;

    private string ResolvedValueTooltip => string.IsNullOrWhiteSpace(ValueTooltip) ? Value : ValueTooltip;

    private async Task CopyAsync()
    {
        var ok = await JS.InvokeAsync<bool>("quasarConfigs.copyText", Value);
        Snackbar.Add(ok ? SuccessMessage : FailureMessage, ok ? Severity.Info : Severity.Warning);
    }

    private static string JoinCss(params string?[] values) =>
        string.Join(" ", values.Where(value => !string.IsNullOrWhiteSpace(value)));
}
