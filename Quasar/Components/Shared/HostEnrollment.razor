@implements IDisposable
@inject ClusterHostCatalog Hosts
@inject ClusterHostInstaller Installer
@inject ClusterHostTunnels Tunnels
@inject QuasarPermissionService Permissions
@inject NavigationManager Navigation

<MudStack Spacing="3">
    <MudText>Install a Host executor (Quasar.Host) on a Linux x64 host machine. It connects back to Quasar securely; its control port stays on loopback. Cluster Registry, Cluster Gateway and game nodes continue running if Quasar disconnects.</MudText>
    <MudSelect T="string" Label="Registration" Value="_existing" ValueChanged="SelectExisting">
        <MudSelectItem Value="@(string.Empty)">New host machine</MudSelectItem>
        @foreach (var host in Hosts.GetAll()) { <MudSelectItem Value="host.Id">@host.Name — resume or update Host executor</MudSelectItem> }
    </MudSelect>
    <MudTextField T="string" Label="Host machine ID" @bind-Value="_id" Disabled="@(_host is not null)" HelperText="A unique lowercase ID, such as game-host-1. Letters, numbers and hyphens only." />
    <MudTextField T="string" Label="Host machine name" @bind-Value="_name" OnBlur="@(_ => EnsureName())" Disabled="@(_host is not null)" HelperText="The name shown in placement and monitoring. A blank name receives an editable generated suggestion." />
    <MudTextField T="string" Label="Cluster network IP address" @bind-Value="_address" Disabled="@(_host is not null)" HelperText="The private LAN or VPN address reachable by the other host machines in the cluster and Quasar. Use 127.0.0.1 only for a cluster entirely on this PC." />
    <MudTextField T="string" Label="Quasar address reachable by this host machine" @bind-Value="_origin" HelperText="Your Quasar HTTPS URL, for example https://quasar.example.com. Remote machines cannot use localhost. Local installation may use HTTP on loopback." />
    <MudSelect T="string" Label="Installation method" @bind-Value="_method">
        <MudSelectItem Value="@("local")">Install on this PC</MudSelectItem>
        <MudSelectItem Value="@("command")">Run an enrollment command on the host machine</MudSelectItem>
        <MudSelectItem Value="@("ssh")">Install over SSH</MudSelectItem>
        <MudSelectItem Value="@("manual")">Download package for manual installation</MudSelectItem>
    </MudSelect>
    @if (_method == "ssh")
    {
        <MudTextField T="string" Label="SSH address" @bind-Value="_sshAddress" HelperText="DNS name or IP used to log in to the remote host machine." />
        <MudTextField T="string" Label="SSH username" @bind-Value="_sshUser" HelperText="The account that will own the cluster processes and data." />
        <MudNumericField T="int" Label="SSH port" @bind-Value="_sshPort" Min="1" Max="65535" />
        <MudTextField T="string" Label="SSH private key file (optional)" @bind-Value="_sshKey" HelperText="An existing key path on the Quasar host machine. Leave empty to use its SSH agent/default keys. The remote host key must already be trusted in known_hosts; Quasar never disables host-key checking." />
    }
    <MudText Typo="Typo.body2">Automatic installation uses your account and generates credentials. Missing Python 3 and util-linux are installed when root or passwordless sudo is available. The local Host executor uses Quasar's installed .NET 10 toolchain. Automatic service installation needs a working systemd user session; choose manual installation to use another service manager. Remote host machines need .NET 10. Enrolled Host executors check for binary updates every 15 minutes and preserve configuration, credentials and cluster processes. Enable user lingering (loginctl enable-linger) if the service must run after logout.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InstallAsync" Disabled="_busy">@(_method == "command" ? "Generate enrollment command" : _method == "manual" ? "Prepare manual enrollment" : "Install Host executor")</MudButton>
    @if (_host is not null && _method == "manual")
    {
        <MudText Typo="Typo.body2">Download and extract this package on the host machine, then follow its README to start Quasar.Host with your preferred service manager. The package contains this host machine's credentials; keep it private.</MudText>
        <MudButton Href="@($"/api/v1/host-enrollment/{Uri.EscapeDataString(_host.Id)}/manual?quasarUrl={Uri.EscapeDataString(_origin)}")" Variant="Variant.Outlined">Download manual host package</MudButton>
    }
    @if (_busy) { <MudProgressLinear Indeterminate="true" /> }
    @if (_error is not null) { <MudAlert Severity="Severity.Warning">@_error</MudAlert> }
    @if (_ticket is not null)
    {
        <MudText>Run this command as the account that will own the cluster processes. It expires at @_ticket.ExpiresAt.ToString("u") and can be downloaded once. Treat it as a password.</MudText>
        <MudTextField T="string" Label="Enrollment command" Value="_ticket.Command" ReadOnly="true" Lines="5" />
    }
    @if (_host is not null)
    {
        <MudButton OnClick="CheckConnection">Check connection</MudButton>
        @if (_connected) { <MudAlert Severity="Severity.Success">Host executor connected. It is ready for cluster placement.</MudAlert> }
        else { <MudText>Waiting for this Host executor to connect. Check its service log if installation has finished.</MudText> }
    }
</MudStack>

@code {
    private readonly CancellationTokenSource _stop = new();
    private string _existing = "";
    private string _id = "", _name = "", _address = "127.0.0.1", _origin = "", _method = "local";
    private string _sshAddress = "", _sshUser = "", _sshKey = "";
    private int _sshPort = 22;
    private bool _busy, _connected;
    private string? _error;
    private EnrolledClusterHost? _host;
    private HostInstallTicket? _ticket;
    protected override void OnInitialized() { EnsureName(); _origin = Navigation.BaseUri; _ = RefreshAsync(); }
    private void EnsureName()
    {
        if (_host is not null) return;
        if (string.IsNullOrWhiteSpace(_name))
        { _name = IdentifierSlug.SuggestName("host-machine"); if (string.IsNullOrWhiteSpace(_id)) _id = _name; }
        if (string.IsNullOrWhiteSpace(_id)) _id = IdentifierSlug.SuggestName("host-machine");
    }
    private async Task RefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(() => { CheckConnection(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }
    public void Dispose() { _stop.Cancel(); _stop.Dispose(); }
    private void SelectExisting(string id)
    {
        _existing = id; _host = Hosts.Get(id); _ticket = null; _error = null;
        if (_host is not null) { _id = _host.Id; _name = _host.Name; _address = _host.Address; }
        else { _id = ""; _name = ""; EnsureName(); }
        CheckConnection();
    }
    private void CheckConnection() => _connected = _host is not null && Tunnels.IsConnected(_host.Id);
    private async Task InstallAsync()
    {
        if (_busy || !await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanManageSecurity)) return;
        EnsureName();
        _busy = true; _error = null;
        try
        {
            ClusterHostInstaller.ValidateOrigin(_origin);
            _host ??= await Hosts.RegisterAsync(_id, _name, _address, 18400, default);
            if (_method == "command") _ticket = Installer.Issue(_host.Id, _origin);
            else if (_method == "ssh") await Installer.InstallSshAsync(_host.Id, _origin, new(_sshAddress, _sshUser, _sshPort, _sshKey), default);
            else if (_method == "local") await Installer.InstallLocalAsync(_host.Id, _origin, default);
            CheckConnection();
        }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException or IOException or System.ComponentModel.Win32Exception or OperationCanceledException)
        { _error = error.Message; }
        finally { _busy = false; }
    }
}
