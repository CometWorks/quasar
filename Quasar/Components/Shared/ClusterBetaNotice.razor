@inject ClusterBetaNoticeCatalog Notices
@inject AuthenticationStateProvider AuthenticationState

@if (_show)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="cluster-beta-notice mb-3">
        <div class="quasar-layout quasar-layout-row quasar-align-center quasar-justify-spacebetween quasar-gap-2">
            <p class="quasar-text quasar-type-body1">Managed clusters are still in beta. Review your backups before changing worlds, mods, or plugins.</p>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Size="Size.Small" Variant="Variant.Outlined" Class="flex-shrink-0"
                           Disabled="_closing" OnClick="CloseAsync" aria-label="Dismiss cluster beta notice" />
        </div>
        @if (_error is not null) { <span class="quasar-text quasar-type-caption">@_error</span> }
    </MudAlert>
}

@code {
    private bool _show, _closing;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        _show = user.Identity?.IsAuthenticated == true && !Notices.IsDismissed(user);
    }

    private async Task CloseAsync()
    {
        _closing = true;
        try
        {
            await Notices.DismissAsync((await AuthenticationState.GetAuthenticationStateAsync()).User);
            _show = false;
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        { _error = "Could not save this dismissal. Try again."; }
        finally { _closing = false; }
    }
}
