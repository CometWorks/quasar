@using Quasar.Services.Players
@using Quasar.Services.Discord
@inject IServiceProvider Services
@inject QuasarPermissionService Permissions
@implements IDisposable

@if (_catalog is not null)
{
    @if (_error.Length != 0) { <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_error</MudAlert> }
    @if (_notice.Length != 0) { <MudAlert Severity="Severity.Success" Class="mb-4">@_notice</MudAlert> }
    <MudExpansionPanels Class="mb-4">
        <MudExpansionPanel Text="@(_browser!.Ready ? "Connection setup · Public website ready" : "Connection setup · Set up public access")" Expanded="@(!_browser.Ready)">
        <div class="quasar-stack">
            <p>Players sign in with Steam on your website and authenticate Discord through <a href="@PlayerAuthEndpoints.AuthenticationOrigin" target="_blank" rel="noopener noreferrer">auth.se-servers.net</a>. No Discord application or OAuth secret is needed on this panel.</p>
            <p>Quasar's existing Discord bot checks membership and roles. Configure the bot, enable its Server Members intent and turn on member tracking on <a href="discord">Discord</a>. These settings never grant dashboard permissions.</p>
            <MudTextField T="string" @bind-Value="_settings.PublicUrl" Label="Self-hosted public website" HelperText="For example https://quasar.example.com. Leave empty when using Nebula hosting." />
            <p>Public access: @(_browser!.PublicUrl is { } url ? url : "Not verified or hosting inactive").</p>
            @if (_settings.VerifiedUntil is { } until) { <p>Self-hosted verification expires: @until.ToString("u"). Verify again before expiry.</p> }
            @if (_browser.Ready)
            {
                <MudButton Href="@(_browser.PublicUrl + PlayerAuthBrowser.Path)" Target="_blank" rel="noopener noreferrer" Variant="Variant.Outlined">Open player authentication</MudButton>
            }
            <div class="quasar-row">
                <MudButton OnClick="SaveAsync" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled">Save access settings</MudButton>
                <MudButton OnClick="VerifyAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_settings.PublicUrl))" Variant="Variant.Outlined">Verify saved website</MudButton>
            </div>
        </div>
        </MudExpansionPanel>
    </MudExpansionPanels>
    <section class="quasar-panel pa-4 mb-4">
        <div class="quasar-stack">
            <h2 class="quasar-text quasar-type-h6">Server access policies</h2>
            <p>Choose who can join each server or cluster and which Discord roles grant game privileges.</p>
            <p>Discord server: <strong>@DiscordServerName</strong>. <a href="discord">Manage bot</a></p>
            @if (BotGuild is null)
            {
                <MudAlert Severity="Severity.Warning">Connect Quasar's Discord bot to load role names. Saved role IDs remain available and are preserved while the bot is offline.</MudAlert>
            }
            <MudButton OnClick="RefreshStatus" Variant="Variant.Text">Refresh bot and roles</MudButton>
            @if (_targets.Count == 0)
            {
                <MudAlert Severity="Severity.Info">Create a server or cluster before configuring its player access policy.</MudAlert>
            }
            <MudSelect T="string" Value="_selected" ValueChanged="SelectTarget" Label="Server or cluster" Disabled="_busy">
                @foreach (var target in _targets) { <MudSelectItem T="string" Value="@target.Key">@target.Name</MudSelectItem> }
            </MudSelect>
            @if (_policy is not null)
            {
                <MudCheckBox T="bool" @bind-Value="_policy.Enabled" Label="Enable player authentication for this server" />
                <MudCheckBox T="bool" @bind-Value="_policy.Whitelist" Label="Require authorization before joining (whitelist)" />
                <p>Without the whitelist, unlinked players can join; authenticated players can still receive role-based promotions and priority access. Existing bans, passwords and other access restrictions remain in force.</p>
                <MudTextField T="string" @bind-Value="_policy.Instructions" Label="Player instructions" Lines="4" MaxLength="5000" />
                <MudSelect T="ulong" MultiSelection="true" SelectedValues="_policy.RequiredRoles" SelectedValuesChanged="@(values => _policy.RequiredRoles = values.ToList())"
                           ToStringFunc="RoleName" Label="Required Discord roles" HelperText="Any selected role grants access. Leave empty to allow every member of the bot's Discord server." Disabled="_busy">
                    @foreach (var role in Roles) { <MudSelectItem T="ulong" Value="@role.Id">@role.Name</MudSelectItem> }
                </MudSelect>
                <MudSelect T="ulong" MultiSelection="true" SelectedValues="_policy.PriorityRoles" SelectedValuesChanged="@(values => _policy.PriorityRoles = values.ToList())"
                           ToStringFunc="RoleName" Label="Priority Discord roles" HelperText="Bypass the normal player cap without kicking players or creating a queue." Disabled="_busy">
                    @foreach (var role in Roles) { <MudSelectItem T="ulong" Value="@role.Id">@role.Name</MudSelectItem> }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_allowedSteam" Label="Explicit Steam allowlist" Lines="3" HelperText="SteamID64 values separated by commas or newlines. These accounts can pass the whitelist without Discord. Keep a recovery administrator here." />
                <h4 class="quasar-text quasar-type-subtitle2">Promotion roles</h4>
                @foreach (var row in _promotions)
                {
                    <div class="quasar-row" @key="row">
                        <MudSelect T="ulong" @bind-Value="row.Role" ToStringFunc="RoleName" Label="Discord role" Disabled="_busy">
                            @foreach (var role in Roles) { <MudSelectItem T="ulong" Value="@role.Id">@role.Name</MudSelectItem> }
                        </MudSelect>
                        <MudSelect T="int" @bind-Value="row.Level" Label="Game promotion">
                            <MudSelectItem T="int" Value="0">None</MudSelectItem>
                            <MudSelectItem T="int" Value="1">Scripter</MudSelectItem>
                            <MudSelectItem T="int" Value="2">Moderator</MudSelectItem>
                            <MudSelectItem T="int" Value="3">Space Master</MudSelectItem>
                            <MudSelectItem T="int" Value="4">Admin</MudSelectItem>
                        </MudSelect>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Remove promotion mapping" OnClick="@(() => _promotions.Remove(row))" />
                    </div>
                }
                <MudButton OnClick="@(() => _promotions.Add(new()))" Variant="Variant.Outlined">Add promotion role</MudButton>
                <p>The highest matching promotion applies. Owner cannot be assigned. Removing a role restores the manual promotion baseline.</p>
                <MudButton OnClick="SaveAsync" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled">Save access settings</MudButton>
                <hr class="quasar-divider" />
                <h3 class="quasar-text quasar-type-subtitle1">Enforcement and player checks</h3>
                <p role="status">@_worker!.Status(_selected)</p>
                <MudButton OnClick="RefreshStatus" Variant="Variant.Text">Refresh enforcement status</MudButton>
                <MudButton OnClick="CheckPlayersAsync" Disabled="_busy" Variant="Variant.Outlined">Check player authorization</MudButton>
                <p class="quasar-muted">Player checks use the saved policy and show why each linked account is eligible or unavailable.</p>
                @if (_players.Count != 0)
                {
                    <MudTable T="AccessRow" Items="_players" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Steam ID</MudTh><MudTh>Discord ID</MudTh><MudTh>Authorization</MudTh>
                            <MudTh>Promotion</MudTh><MudTh>Priority</MudTh><MudTh>Decision valid until</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Steam ID">@context.Steam</MudTd>
                            <MudTd DataLabel="Discord ID">@context.Discord</MudTd>
                            <MudTd DataLabel="Authorization">@context.Decision.Reason</MudTd>
                            <MudTd DataLabel="Promotion">@PromotionName(context.Decision.Grant.Promotion)</MudTd>
                            <MudTd DataLabel="Priority">@(context.Decision.Grant.Priority ? "Yes" : "No")</MudTd>
                            <MudTd DataLabel="Decision valid until">@context.Decision.Grant.ExpiresAt.ToString("u")</MudTd>
                        </RowTemplate>
                        <PagerContent><MudTablePager /></PagerContent>
                    </MudTable>
                }
            }
        </div>
    </section>
}

@code {
    private PlayerAccessCatalog? _catalog;
    private PlayerAuthBrowser? _browser;
    private PlayerAccessWorker? _worker;
    private DiscordBotService? _bot;
    private DiscordOptionsCatalog? _discord;
    private PlayerAccessSettings _settings = new();
    private IReadOnlyList<PlayerAccessTarget> _targets = [];
    private PlayerAccessPolicy? _policy;
    private string _selected = "", _allowedSteam = "", _error = "", _notice = "";
    private bool _busy;
    private List<PromotionRow> _promotions = [];
    private List<AccessRow> _players = [];
    private readonly CancellationTokenSource _stop = new();
    private global::Discord.WebSocket.SocketGuild? BotGuild => _bot?.CurrentClient?.GetGuild(_discord!.GetOptions().GuildId);
    private string DiscordServerName => BotGuild?.Name ?? (_discord?.GetOptions().GuildId is > 0 and var guild ? guild.ToString() : "Not configured");
    private IReadOnlyList<(ulong Id, string Name)> Roles
    {
        get
        {
            var roles = BotGuild?.Roles.Where(r => !r.IsEveryone).OrderByDescending(r => r.Position).Select(r => (r.Id, r.Name + " (" + r.Id + ")")).ToList() ?? [];
            var saved = _settings.Policies.SelectMany(p => p.RequiredRoles.Concat(p.PriorityRoles).Concat(p.Promotions.Select(m => m.RoleId)))
                .Concat(_promotions.Select(p => p.Role)).Where(id => id != 0).Distinct();
            foreach (var id in saved.Where(id => roles.All(r => r.Id != id))) roles.Add((id, "Unavailable role (" + id + ")"));
            return roles;
        }
    }
    private string RoleName(ulong id) => id == 0 ? "Choose a Discord role" : Roles.FirstOrDefault(r => r.Id == id).Name ?? id.ToString();

    protected override void OnInitialized()
    {
        _catalog = Services.GetService<PlayerAccessCatalog>();
        if (_catalog is null) return;
        _browser = Services.GetRequiredService<PlayerAuthBrowser>();
        _worker = Services.GetRequiredService<PlayerAccessWorker>();
        _discord = Services.GetRequiredService<DiscordOptionsCatalog>();
        _bot = Services.GetService<DiscordBotService>();
        _discord.Changed += BotChanged;
        if (_bot is not null) _bot.Changed += BotChanged;
        _settings = _catalog.GetSettings();
        _targets = Services.GetRequiredService<PlayerAccessService>().Targets();
        if (_targets.Count != 0) SelectTarget(_targets[0].Key);
    }

    private void SelectTarget(string value)
    {
        try { Capture(); }
        catch (Exception error) { _error = error.Message; return; }
        _selected = value;
        _players = [];
        _policy = _settings.Policies.FirstOrDefault(p => p.Target == value);
        if (_policy is null)
        {
            _policy = new() { Target = value, GuildId = Services.GetRequiredService<DiscordOptionsCatalog>().GetOptions().GuildId };
            _settings.Policies.Add(_policy);
        }
        _allowedSteam = string.Join("\n", _policy.AllowedSteamIds);
        _promotions = _policy.Promotions.Select(p => new PromotionRow { Role = p.RoleId, Level = p.Level }).ToList();
    }

    private static string[] Split(string value) => value.Split([',', '\n', '\r', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private void Capture()
    {
        if (_policy is null) return;
        _policy.GuildId = _discord!.GetOptions().GuildId;
        if (_promotions.Any(p => p.Role == 0)) throw new InvalidOperationException("Choose a Discord role for each promotion mapping or remove the empty mapping.");
        _policy.AllowedSteamIds = Split(_allowedSteam).Distinct().ToList();
        _policy.Promotions = _promotions.Select(p => new PlayerPromotionMapping(p.Role, p.Level)).ToList();
    }

    private async Task SaveAsync()
    {
        if (_busy || !await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanManageSecurity)) return;
        _busy = true; _error = _notice = "";
        try
        {
            Capture();
            var bot = Services.GetRequiredService<DiscordOptionsCatalog>().GetOptions();
            foreach (var policy in _settings.Policies.Where(p => p.Enabled))
            {
                if (Services.GetRequiredService<AgentRegistry>().GetAgents().Any(a => a.IsConnected
                    && (a.IsCluster ? "cluster:" + a.ClusterId : "server:" + a.UniqueNameKey) == policy.Target
                    && a.Snapshot?.Plugins.Any(PlayerAccessWorker.IsLegacyAuthentication) == true))
                    throw new InvalidOperationException("Remove the separate GameServerAuth plugin before enabling built-in access.");
                if (_browser?.Ready != true || !bot.Enabled || bot.GuildId == 0 || policy.GuildId != bot.GuildId)
                    throw new InvalidOperationException("Verify public access or activate Nebula hosting first, then enable Quasar's Discord bot and use its configured server.");
                if (!_targets.Any(t => t.Key == policy.Target)) throw new InvalidOperationException("A configured server no longer exists.");
                if (policy.Target.StartsWith("cluster:"))
                {
                    var cluster = Services.GetRequiredService<ClusterCatalog>().GetClusters().Single(c => "cluster:" + c.UniqueName == policy.Target);
                    await Services.GetRequiredService<ClusterHostClient>().RequirePlayerAccessHostAsync(cluster, CancellationToken.None);
                    var caps = (await Services.GetRequiredService<ClusterGatewayClient>().GetCapabilitiesAsync(cluster, CancellationToken.None)).Data;
                    if (!caps.Operations.Contains("PUT /admin/v1/players/access")) throw new InvalidOperationException("Update and connect the cluster package before enabling player access.");
                }
                else if (Services.GetRequiredService<AgentRegistry>().GetAgents().Any(a => !a.IsCluster && a.IsConnected
                    && "server:" + a.UniqueNameKey == policy.Target && a.Hello?.PlayerAccessVersion != 1))
                    throw new InvalidOperationException("Restart this server to load the updated Agent before enabling player authentication.");
            }
            await _catalog!.SaveSettingsAsync(_settings);
            var selected = _selected;
            _policy = null;
            _settings = _catalog.GetSettings();
            if (selected.Length != 0) SelectTarget(selected);
            _notice = "Access settings saved. Check enforcement status before relying on the whitelist.";
        }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }

    private async Task VerifyAsync()
    {
        if (_busy || !await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanManageSecurity)) return;
        _busy = true; _error = _notice = "";
        try
        {
            await _browser!.VerifyAsync();
            _settings.Revision = _catalog!.GetSettings().Revision;
            _settings.VerifiedUntil = _catalog.GetSettings().VerifiedUntil;
            _notice = "Public website verified for seven days.";
        }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }

    private void RefreshStatus() => StateHasChanged();
    private async Task CheckPlayersAsync()
    {
        if (_busy || !await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanManageSecurity)) return;
        _busy = true; _error = "";
        try
        {
            var policy = _catalog!.GetSettings().Policies.FirstOrDefault(p => p.Target == _selected && p.Enabled)
                ?? throw new InvalidOperationException("Save and enable this server policy before checking authorization.");
            var links = Services.GetRequiredService<QuasarPlayerLinks>().GetLinks();
            var decisions = new List<AccessRow>();
            foreach (var steam in links.Select(link => link.SteamId).Concat(policy.AllowedSteamIds).Distinct().Order())
                decisions.Add(new(steam, links.FirstOrDefault(link => link.SteamId == steam)?.DiscordUserId ?? "Not linked",
                    await Services.GetRequiredService<PlayerAccessService>().EvaluateAsync(policy, steam, _stop.Token)));
            _players = decisions;
            if (decisions.Count == 0) _notice = "No linked accounts or explicit Steam entries to check.";
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }
    private static string PromotionName(int level) => new[] { "None", "Scripter", "Moderator", "Space Master", "Admin" }[level];
    private void BotChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        if (_discord is not null) _discord.Changed -= BotChanged;
        if (_bot is not null) _bot.Changed -= BotChanged;
        _stop.Cancel(); _stop.Dispose();
    }
    private sealed record AccessRow(string Steam, string Discord, PlayerAccessDecision Decision);
    private sealed class PromotionRow { public ulong Role { get; set; } public int Level { get; set; } }
}
