@inject QuasarUiPluginCatalog Plugins

<CascadingAuthenticationState>
    <WasmPageLayout>
        <Body>
            @if (PageType == typeof(Quasar.Components.Pages.Error))
            {
                <Quasar.Components.Pages.Error />
            }
            else if (PageType == typeof(Quasar.Components.Pages.NotFound))
            {
                <Quasar.Components.Pages.NotFound />
            }
            else
            {
                <Quasar.Client.Components.DashboardRouter PluginPages="Plugins.BrowserPageAssemblies" InitialAssemblyName="@PageType?.Assembly.FullName"
                    @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />
            }
        </Body>
    </WasmPageLayout>
</CascadingAuthenticationState>

@code {
    [CascadingParameter] private Microsoft.AspNetCore.Http.HttpContext? RequestContext { get; set; }

    private Type? PageType => RequestContext?.GetEndpoint()?.Metadata
        .GetMetadata<Microsoft.AspNetCore.Components.Endpoints.ComponentTypeMetadata>()?.Type;
}
