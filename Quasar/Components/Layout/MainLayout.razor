@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject ThemePreferenceService ThemePreference
@inject QuasarShutdownService ShutdownService
@inject WebServiceOptions WebServiceOptions
@inject BrandingService BrandingService
@inject QuasarUpdateService UpdateService
@inject BrowserPushState BrowserPush
@inject PushNotificationService Notifications
@inject ClusterReleaseMonitor ClusterReleases
@inject ClusterContentMonitor ClusterContent
@inject ClusterCatalog ClusterCatalog
@inject RbacConfigCatalog RbacConfigCatalog
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService

@* Temporary compatibility providers for pages and UI plugins still being migrated. *@
<MudThemeProvider Theme="@BrandingService.BuildMudTheme()" IsDarkMode="@_isDarkMode" ObserveSystemDarkModeChange="false" />
<BrandingHeadContent />

<a class="quasar-skip-link" href="#quasar-main">Skip to content</a>
<div class="quasar-shell @(!_drawerOpen ? "quasar-nav-collapsed" : null) @(_mobileDrawerOpen ? "quasar-nav-open" : null)"
     style="@PaletteStyle" data-theme="@(_isDarkMode ? "dark" : "light")" @onkeydown="HandleShellKeyDownAsync">
    <aside id="quasar-navigation" class="quasar-sidebar" aria-label="Main navigation" inert="@(_isShuttingDown ? string.Empty : null)">
        <a class="quasar-brand" href="/" @onclick="CloseMobileDrawer">
            <img class="quasar-brand-mark" src="@LogoSrc" alt="@($"{BrandingService.Settings.AppName} logo")" />
            <div><strong title="@BrandingService.Settings.AppName">@BrandingService.Settings.AppName</strong><span title="@BrandingService.Settings.AppSubtitle">@BrandingService.Settings.AppSubtitle</span></div>
        </a>
        <div @onclick="CloseMobileDrawer"><NavMenu /></div>
        <div class="quasar-sidebar-footer">
            <strong>@BrandingService.Settings.AppName <span class="mono">@AppVersion</span></strong>
            <span>Space Engineers control plane</span>
        </div>
    </aside>
    <div class="quasar-shell-body">
        <header class="quasar-topbar" inert="@(_isShuttingDown ? string.Empty : null)">
            <div class="quasar-topbar-identity">
                <button id="quasar-nav-toggle-desktop" type="button" class="quasar-icon-button quasar-desktop-nav-toggle" @onclick="@(() => _drawerOpen = !_drawerOpen)"
                        aria-label="Toggle navigation" aria-controls="quasar-navigation" aria-expanded="@(_drawerOpen ? "true" : "false")">
                    <QuasarIcon Icon="@QuasarIcons.Menu" />
                </button>
                <button id="quasar-nav-toggle" type="button" class="quasar-icon-button quasar-mobile-nav-toggle" @onclick="@(() => _mobileDrawerOpen = !_mobileDrawerOpen)"
                        aria-label="Toggle navigation" aria-controls="quasar-navigation" aria-expanded="@(_mobileDrawerOpen ? "true" : "false")">
                    <QuasarIcon Icon="@QuasarIcons.Menu" />
                </button>
                <nav class="quasar-breadcrumb" aria-label="Breadcrumb">
                    <a href="/">@BrandingService.Settings.AppName</a>
                    <span aria-hidden="true">/</span><span aria-current="page">@CurrentPageLabel</span>
                </nav>
            </div>
            <div class="quasar-topbar-actions">
                <a class="quasar-icon-button quasar-update-bell @GetUpdateBellClass()" href="@(CurrentNotice?.Url ?? "/notifications")"
                   title="@GetUpdateBellTooltip()" aria-label="Open current notification">
                    <QuasarIcon Icon="@(BrowserPush.Enabled ? QuasarIcons.Notifications : QuasarIcons.NotificationsOutlined)" />
                    @if (HasUpdateBellBadge) { <span class="quasar-notification-dot" aria-hidden="true"></span> }
                </a>
                <label class="quasar-theme-select">
                    <QuasarIcon Icon="@GetThemeModeIcon()" />
                    <select value="@_themeMode" @onchange="HandleThemeSelectionAsync" aria-label="Color theme">
                        <option value="@ThemeMode.System">System</option>
                        <option value="@ThemeMode.Light">Light</option>
                        <option value="@ThemeMode.Dark">Dark</option>
                    </select>
                </label>
                <AuthorizeView>
                    <Authorized Context="authContext">
                        <span class="quasar-user-name">@authContext.User.Identity?.Name</span>
                        <a class="quasar-icon-button" href="/logout" title="@GetAuthTooltip(authContext.User)" aria-label="@GetAuthTooltip(authContext.User)"><QuasarIcon Icon="@QuasarIcons.Logout" /></a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="quasar-icon-button" href="/login" title="Sign in" aria-label="Sign in"><QuasarIcon Icon="@QuasarIcons.Login" /></a>
                    </NotAuthorized>
                </AuthorizeView>
                <AuthorizeView Policy="@QuasarPolicyNames.CanShutdownQuasar">
                    <Authorized>
                        <button type="button" class="quasar-icon-button quasar-text-error" title="Quasar power actions" aria-label="Quasar power actions"
                                disabled="@_isShuttingDown" @onclick="HandlePowerClickAsync"><QuasarIcon Icon="@QuasarIcons.PowerSettingsNew" /></button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>
        <main id="quasar-main" class="quasar-main" tabindex="-1" inert="@(_isShuttingDown ? string.Empty : null)">@Body</main>
        <div class="quasar-overlays">
            <MudPopoverProvider />
            <MudDialogProvider />
            <MudSnackbarProvider />
        </div>
    </div>
    @if (_mobileDrawerOpen)
    {
        <button type="button" class="quasar-nav-scrim" @onclick="CloseMobileDrawer" aria-label="Close navigation"></button>
    }
    @if (_isShuttingDown)
    {
        <div class="quasar-shutdown-overlay" role="alert" aria-busy="true"><span class="quasar-spinner" aria-hidden="true"></span><p>@_shutdownStatus</p></div>
    }
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private ThemeMode _themeMode = ThemeMode.System;
    private bool _isShuttingDown = false;
    private string _shutdownStatus = string.Empty;
    private string _lastUpdateNotice = string.Empty;
    private string _lastClusterNotice = string.Empty;
    private QuasarUpdateSnapshot _updateSnapshot = new();
    private ClusterReleaseSnapshot _clusterReleaseSnapshot = new(null, null, null);
    private System.Security.Claims.ClaimsPrincipal? _currentUser;
    private UpdateNotice[] _notices = [];

    // The worker is restartable only when it was launched by the Quasar launcher, which
    // injects QUASAR_LAUNCHER_TOKEN (surfaced as WebServiceOptions.LauncherToken).
    // Standalone runs have no launcher to respawn the worker, so restart is disabled.
    private bool IsUnderBootstrap => !string.IsNullOrWhiteSpace(WebServiceOptions.LauncherToken);

    private string LogoSrc => _isDarkMode
        ? (BrandingService.Settings.LogoDarkPath ?? "/Quasar.png")
        : (BrandingService.Settings.LogoLightPath ?? "/Quasar-inverted-transparent.png");

    private bool _mobileDrawerOpen;
    private IJSObjectReference? _themeModule;
    private IJSObjectReference? _themeSubscription;
    private DotNetObjectReference<MainLayout>? _themeCallback;

    private string PaletteStyle => QuasarTheme.BuildCss(
        _isDarkMode ? BrandingService.Settings.DarkPalette : BrandingService.Settings.LightPalette, _isDarkMode);

    private static string AppVersion => typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "";
    private string CurrentPageLabel => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/') switch
    {
        "" => "Fleet overview", "configs" => "Configuration profiles", "world-templates" => "World templates",
        "plugins" => "Server plugins", "players" => "Players", "chat" => "Chat", "entities" => "Entities",
        "analytics" => "Analytics", "discord" => "Discord", "hosts" => "Host machines", "hosts/enroll" => "Add host machine",
        "backup" => "Backups", "notifications" => "Notifications", "settings/appearance" => "Appearance",
        "settings/security" => "Security", "settings/ui-plugins" => "UI plugins", "settings/updates" => "Updates",
        "settings/server-list" => "Server listing", "clusters/new" => "Set up cluster",
        var route when route.StartsWith("clusters/", StringComparison.Ordinal) => "Cluster management",
        var route when route.StartsWith("servers/", StringComparison.Ordinal) => "Server management",
        _ => "Control plane",
    };

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        CloseMobileDrawer();
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        BrandingService.Changed += OnBrandingChanged;
        UpdateService.Changed += OnUpdatesChanged;
        ClusterReleases.Changed += OnClusterReleasesChanged;
        ClusterContent.Changed += OnClusterCatalogChanged;
        BrowserPush.Changed += OnClusterCatalogChanged;
        Notifications.Changed += OnClusterCatalogChanged;
        ClusterCatalog.Changed += OnClusterCatalogChanged;
        RbacConfigCatalog.Changed += OnRbacChanged;
        _updateSnapshot = UpdateService.GetSnapshot();
        _clusterReleaseSnapshot = ClusterReleases.GetSnapshot();
        _currentUser = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        await RefreshNoticesAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        BrandingService.Changed -= OnBrandingChanged;
        UpdateService.Changed -= OnUpdatesChanged;
        ClusterReleases.Changed -= OnClusterReleasesChanged;
        ClusterContent.Changed -= OnClusterCatalogChanged;
        BrowserPush.Changed -= OnClusterCatalogChanged;
        Notifications.Changed -= OnClusterCatalogChanged;
        ClusterCatalog.Changed -= OnClusterCatalogChanged;
        RbacConfigCatalog.Changed -= OnRbacChanged;
        try
        {
            if (_themeSubscription is not null)
            {
                await _themeSubscription.InvokeVoidAsync("dispose");
                await _themeSubscription.DisposeAsync();
            }
            if (_themeModule is not null) await _themeModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _themeCallback?.Dispose(); }

    }

    private void OnBrandingChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnClusterCatalogChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshNoticesAsync();
        StateHasChanged();
    });

    private async Task RefreshNoticesAsync()
    {
        try { _notices = await Notifications.GetNoticesAsync(_currentUser ?? new System.Security.Claims.ClaimsPrincipal()); }
        catch (Exception) { _notices = []; }
    }

    private void OnClusterReleasesChanged()
    {
        var snapshot = ClusterReleases.GetSnapshot();
        _ = InvokeAsync(async () =>
        {
            _clusterReleaseSnapshot = snapshot;
            await RefreshNoticesAsync();
            var available = AvailableClusterUpdates;
            if (available.Count > 0 && snapshot.Release is { } release
                && _lastClusterNotice != release.Version)
            {
                _lastClusterNotice = release.Version;
                Snackbar.Add($"Cluster package {release.Version} available for {available.Count} cluster(s). Open the cluster page.", Severity.Info);
            }
            StateHasChanged();
        });
    }

    private void OnRbacChanged()
    {
        _ = InvokeAsync(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true));
    }

    private void OnUpdatesChanged()
    {
        var snapshot = UpdateService.GetSnapshot();
        _ = InvokeAsync(async () =>
        {
            _updateSnapshot = snapshot;
            await RefreshNoticesAsync();
            StateHasChanged();
        });

        var web = GetPrimaryWebUpdate(snapshot);
        var bootstrap = snapshot.Bootstrap;
        var tokenWarning = snapshot.GitHubTokenWarning;
        var noticeKey = $"{web?.Version}:{web?.IsStaged}:{bootstrap?.Version}:{tokenWarning}";
        if (noticeKey == _lastUpdateNotice)
            return;

        _lastUpdateNotice = noticeKey;
        if (!string.IsNullOrWhiteSpace(tokenWarning))
        {
            _ = InvokeAsync(() => Snackbar.Add(tokenWarning, snapshot.GitHubTokenExpired ? Severity.Error : Severity.Warning));
            return;
        }

        if (web is not null && web.IsStaged)
        {
            _ = InvokeAsync(() => Snackbar.Add($"Quasar UI {web.Version} is staged. Open Updates to activate.", Severity.Info));
            return;
        }

        if (web is not null)
        {
            _ = InvokeAsync(() => Snackbar.Add($"Quasar UI {web.Version} is ready to download.", Severity.Info));
            return;
        }

        if (bootstrap is not null)
            _ = InvokeAsync(() => Snackbar.Add($"Quasar launcher {bootstrap.Version} update available.", Severity.Info));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var (mode, isDark) = await ThemePreference.InitializeAsync();
        _themeMode = mode;
        _isDarkMode = isDark;
        _themeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./quasar-theme.js");
        _themeCallback = DotNetObjectReference.Create(this);
        _themeSubscription = await _themeModule.InvokeAsync<IJSObjectReference>("observeSystemTheme", _themeCallback);
        await BrowserPush.RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void CloseMobileDrawer() => _mobileDrawerOpen = false;

    private async Task HandleShellKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || !_mobileDrawerOpen) return;
        CloseMobileDrawer();
        await JS.InvokeVoidAsync("quasarConfigs.focusElement", "quasar-nav-toggle");
    }

    private Task HandleThemeSelectionAsync(ChangeEventArgs args) =>
        Enum.TryParse<ThemeMode>(args.Value?.ToString(), out var mode)
            ? SetThemeModeAsync(mode)
            : Task.CompletedTask;

    private async Task SetThemeModeAsync(ThemeMode mode)
    {
        await ThemePreference.SetModeAsync(mode);
        _themeMode = mode;
        _isDarkMode = ThemePreference.IsDarkMode;
    }

    [JSInvokable]
    public async Task OnSystemDarkModeChangedAsync(bool isDark)
    {
        ThemePreference.SyncSystemDarkMode(isDark);
        _isDarkMode = ThemePreference.IsDarkMode;
        await InvokeAsync(StateHasChanged);
    }

    private string GetThemeModeIcon() => _themeMode switch
    {
        ThemeMode.Light => QuasarIcons.LightMode,
        ThemeMode.Dark => QuasarIcons.DarkMode,
        _ => QuasarIcons.BrightnessAuto,
    };

    private UpdateNotice? CurrentNotice => _notices.FirstOrDefault();

    private bool HasUpdateBellBadge => CurrentNotice is not null;

    private IReadOnlyList<Quasar.Models.ClusterDefinition> AvailableClusterUpdates =>
        _currentUser is null ? [] : ClusterCatalog.GetClusters()
            .Where(cluster => _currentUser.CanQueryCluster(cluster.UniqueName)
                && ClusterReleaseMonitor.IsUpdateAvailable(cluster, _clusterReleaseSnapshot.Release)).ToArray();

    private string GetUpdateBellClass() => _updateSnapshot.GitHubTokenExpired && CurrentNotice?.Key.StartsWith("token:", StringComparison.Ordinal) == true
        ? "quasar-text-error"
        : HasUpdateBellBadge ? "quasar-text-warning" : string.Empty;

    private string GetUpdateBellTooltip() => CurrentNotice?.Body ?? "Notifications";

    private static QuasarUpdateCandidate? GetPrimaryWebUpdate(QuasarUpdateSnapshot snapshot) =>
        snapshot.WebReleases.FirstOrDefault(candidate => candidate.IsNewer && candidate.IsStaged) ??
        snapshot.WebReleases.FirstOrDefault(candidate => candidate.IsNewer);

    private static string GetAuthTooltip(System.Security.Claims.ClaimsPrincipal principal)
    {
        var displayName = principal.GetQuasarDisplayName();
        return string.IsNullOrWhiteSpace(displayName) ? "Sign out" : $"Sign out {displayName}";
    }

    private async Task HandlePowerClickAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(QuasarControlDialog.IsRestartAvailable)] = IsUnderBootstrap,
            [nameof(QuasarControlDialog.AgentOfflineShutdownSeconds)] = WebServiceOptions.AgentOfflineShutdownSeconds,
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<QuasarControlDialog>("Quasar power", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not QuasarControlAction action)
            return;

        switch (action)
        {
            case QuasarControlAction.RestartQuasar:
                await RestartQuasarAsync();
                break;
            case QuasarControlAction.ShutdownQuasar:
                await ShutdownQuasarAsync();
                break;
            case QuasarControlAction.ShutdownAllServers:
                ShutdownAllServers();
                break;
        }
    }

    private async Task RestartQuasarAsync()
    {
        _isShuttingDown = true;
        _shutdownStatus = "Restarting Quasar… the page will reload when it is back.";
        await InvokeAsync(StateHasChanged);

        // The worker is about to stop, dropping this Blazor circuit, so hand off to a
        // browser-side poller that reloads to the Dashboard once the new worker is
        // healthy. Invoke it before stopping so the call reaches the client in time.
        await JS.InvokeVoidAsync("quasarConfigs.reloadWhenHealthy", "/", new
        {
            requireUnhealthy = true,
            showFeedback = true,
            title = "Restarting Quasar",
            message = "Stopping the current web worker. The page will reload when Quasar is healthy again.",
            initialStatus = "Submitting restart request.",
            waitingForStopMessage = "Waiting for the current worker to stop.",
            pollingMessage = "Waiting for the restarted worker to pass /api/health.",
            successMessage = "Quasar is healthy. Reloading Dashboard.",
            timeoutMessage = "Still waiting for Quasar. Reloading Dashboard now.",
        });

        await ShutdownService.RestartWorkerAsync();
    }

    private async Task ShutdownQuasarAsync()
    {
        _isShuttingDown = true;
        _shutdownStatus = "Shutting down Quasar… start Quasar again to bring the UI back.";
        await InvokeAsync(StateHasChanged);
        try
        {
            await ShutdownService.ShutdownQuasarPreservingServersAsync();
        }
        catch (Exception exception)
        {
            _isShuttingDown = false;
            Snackbar.Add($"Failed shutting down Quasar: {exception.Message}", Severity.Error);
        }
    }

    private void ShutdownAllServers()
    {
        // Issue a stop on every running server — exactly as if Stop had been pressed on
        // each card. The servers wind down in the background and the Dashboard / Servers
        // list reflect their status, so there is no blocking overlay or status readout here.
        _ = ShutdownService.StopAllServersAsync(setGoalStateOff: true);
        Snackbar.Add("Server shutdown queued.", Severity.Info);
    }
}
