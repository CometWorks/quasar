@using MudBlazor.Utilities
@inherits LayoutComponentBase
@implements IDisposable
@inject ThemePreferenceService ThemePreference
@inject QuasarShutdownService ShutdownService
@inject WebServiceOptions WebServiceOptions
@inject BrandingService BrandingService
@inject QuasarUpdateService UpdateService
@inject PushNotificationService PushNotifications
@inject ClusterReleaseMonitor ClusterReleases
@inject ClusterCatalog ClusterCatalog
@inject RbacConfigCatalog RbacConfigCatalog
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ILogger<MainLayout> Logger

<MudThemeProvider Theme="@ThemePreference.Theme" IsDarkMode="@_isDarkMode" IsDarkModeChanged="OnSystemDarkModeChangedAsync" ObserveSystemDarkModeChange="@(_themeMode == ThemeMode.System)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<BrandingHeadContent />

<MudLayout Style="@HoverPaletteStyle">
    <MudAppBar Elevation="0" Class="magnetar-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="quasar-brand">
            <img class="quasar-brand-mark"
                 src="@LogoSrc"
                 alt="@($"{BrandingService.Settings.AppName} logo")" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@BrandingService.Settings.AppName</MudText>
                <MudText Typo="Typo.caption" Class="magnetar-appbar-subtitle">@BrandingService.Settings.AppSubtitle</MudText>
            </MudStack>
        </MudStack>
        <MudSpacer />
        <MudTooltip Text="@GetUpdateBellTooltip()">
            <MudBadge Visible="@HasUpdateBellBadge" Color="Color.Warning" Dot="true" Overlap="true">
                <MudMenu Icon="@(_pushEnabled ? Icons.Material.Filled.Notifications : Icons.Material.Outlined.Notifications)"
                         Color="@GetUpdateBellColor()" Dense="true" OpenChanged="OnBellOpenChangedAsync"
                         AriaLabel="Notifications"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick="EnablePushAsync" Disabled="@(!_pushChecked || !_pushSupported || !_pushServiceAvailable || _pushEnabled)">Enable push notifications</MudMenuItem>
                    <MudMenuItem Href="@GetUpdateBellHref()" Disabled="@(!HasUpdateBellBadge)">Open current notification</MudMenuItem>
                    @if (_pushEnabled)
                    {
                        <MudMenuItem OnClick="DisablePushAsync">Disable push notifications on this browser</MudMenuItem>
                    }
                    @if (_pushChecked && !_pushSupported)
                    {
                        <MudMenuItem Disabled="true">Push requires HTTPS or localhost and a supported browser</MudMenuItem>
                    }
                    else if (_pushChecked && !_pushServiceAvailable)
                    {
                        <MudMenuItem Disabled="true">Push settings are unavailable. Check Quasar logs.</MudMenuItem>
                    }
                </MudMenu>
            </MudBadge>
        </MudTooltip>
        <MudMenu Icon="@GetThemeModeIcon()" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <MudMenuItem Icon="@Icons.Material.Filled.BrightnessAuto" IconColor="@(_themeMode == ThemeMode.System ? Color.Primary : Color.Default)" OnClick="@(() => SetThemeModeAsync(ThemeMode.System))">System</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LightMode" IconColor="@(_themeMode == ThemeMode.Light ? Color.Primary : Color.Default)" OnClick="@(() => SetThemeModeAsync(ThemeMode.Light))">Light</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DarkMode" IconColor="@(_themeMode == ThemeMode.Dark ? Color.Primary : Color.Default)" OnClick="@(() => SetThemeModeAsync(ThemeMode.Dark))">Dark</MudMenuItem>
        </MudMenu>
        <AuthorizeView>
            <Authorized Context="authContext">
                <MudTooltip Text="@GetAuthTooltip(authContext.User)">
                    <MudIconButton
                        Icon="@Icons.Material.Filled.Logout"
                        Color="Color.Inherit"
                        Href="/logout" />
                </MudTooltip>
            </Authorized>
            <NotAuthorized>
                <MudTooltip Text="Sign in">
                    <MudIconButton
                        Icon="@Icons.Material.Filled.Login"
                        Color="Color.Inherit"
                        Href="/login" />
                </MudTooltip>
            </NotAuthorized>
        </AuthorizeView>
        <AuthorizeView Policy="@QuasarPolicyNames.CanShutdownQuasar">
            <Authorized>
                <MudTooltip Text="Quasar power actions">
                    <MudIconButton
                        Icon="@Icons.Material.Filled.PowerSettingsNew"
                        Color="Color.Error"
                        Disabled="@_isShuttingDown"
                        OnClick="HandlePowerClickAsync" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudOverlay Visible="@_isShuttingDown" DarkBackground="true" AutoClose="false" ZIndex="9999">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h6">@_shutdownStatus</MudText>
        </MudStack>
    </MudOverlay>

    <MudDrawer
        @bind-Open="_drawerOpen"
        Variant="DrawerVariant.Responsive"
        Breakpoint="Breakpoint.Md"
        ClipMode="DrawerClipMode.Always"
        Elevation="0"
        Width="180px"
        Class="magnetar-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="magnetar-body">
        <MudContainer MaxWidth="MaxWidth.False" Class="magnetar-shell-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private ThemeMode _themeMode = ThemeMode.System;
    private bool _isShuttingDown = false;
    private string _shutdownStatus = string.Empty;
    private string _lastUpdateNotice = string.Empty;
    private string _lastClusterNotice = string.Empty;
    private QuasarUpdateSnapshot _updateSnapshot = new();
    private ClusterReleaseSnapshot _clusterReleaseSnapshot = new(null, null, null);
    private System.Security.Claims.ClaimsPrincipal? _currentUser;
    private bool _pushChecked, _pushSupported, _pushEnabled, _pushServiceAvailable = true;
    private sealed record BrowserPushStatus(bool Supported, BrowserPushSubscription? Subscription);

    // The worker is restartable only when it was launched by the Quasar launcher, which
    // injects QUASAR_LAUNCHER_TOKEN (surfaced as WebServiceOptions.LauncherToken).
    // Standalone runs have no launcher to respawn the worker, so restart is disabled.
    private bool IsUnderBootstrap => !string.IsNullOrWhiteSpace(WebServiceOptions.LauncherToken);

    private string LogoSrc => _isDarkMode
        ? (BrandingService.Settings.LogoDarkPath ?? "/Quasar.png")
        : (BrandingService.Settings.LogoLightPath ?? "/Quasar-inverted-transparent.png");

    private string HoverPaletteStyle
    {
        get
        {
            var settings = BrandingService.Settings;
            var hoverPalette = _isDarkMode ? settings.DarkPalette : settings.LightPalette;
            var fallbackPalette = _isDarkMode ? ThemePalette.QuasarDark() : ThemePalette.QuasarLight();
            var background = NormalizeCssColor(hoverPalette.HoverBackground, fallbackPalette.HoverBackground);
            var text = NormalizeCssColor(hoverPalette.HoverContrastText, fallbackPalette.HoverContrastText);

            return $"--quasar-hover-list-background:{background};--quasar-hover-list-text:{text};";
        }
    }

    private static string NormalizeCssColor(string value, string fallback)
    {
        if (MudColor.TryParse(value, out var color))
            return color.ToString(MudColorOutputFormats.HexA);

        return MudColor.TryParse(fallback, out var fallbackColor)
            ? fallbackColor.ToString(MudColorOutputFormats.HexA)
            : fallback;
    }

    protected override async Task OnInitializedAsync()
    {
        BrandingService.Changed += OnBrandingChanged;
        UpdateService.Changed += OnUpdatesChanged;
        ClusterReleases.Changed += OnClusterReleasesChanged;
        ClusterCatalog.Changed += OnClusterCatalogChanged;
        RbacConfigCatalog.Changed += OnRbacChanged;
        _updateSnapshot = UpdateService.GetSnapshot();
        _clusterReleaseSnapshot = ClusterReleases.GetSnapshot();
        _currentUser = (await AuthenticationState.GetAuthenticationStateAsync()).User;
    }

    public void Dispose()
    {
        BrandingService.Changed -= OnBrandingChanged;
        UpdateService.Changed -= OnUpdatesChanged;
        ClusterReleases.Changed -= OnClusterReleasesChanged;
        ClusterCatalog.Changed -= OnClusterCatalogChanged;
        RbacConfigCatalog.Changed -= OnRbacChanged;
    }

    private void OnBrandingChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnClusterCatalogChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnClusterReleasesChanged()
    {
        var snapshot = ClusterReleases.GetSnapshot();
        _ = InvokeAsync(() =>
        {
            _clusterReleaseSnapshot = snapshot;
            var available = AvailableClusterUpdates;
            if (available.Count > 0 && snapshot.Release is { } release
                && _lastClusterNotice != release.Version)
            {
                _lastClusterNotice = release.Version;
                Snackbar.Add($"Cluster package {release.Version} available for {available.Count} cluster(s). Open the cluster page.", Severity.Info);
            }
            StateHasChanged();
        });
    }

    private void OnRbacChanged()
    {
        _ = InvokeAsync(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true));
    }

    private void OnUpdatesChanged()
    {
        var snapshot = UpdateService.GetSnapshot();
        _ = InvokeAsync(() =>
        {
            _updateSnapshot = snapshot;
            StateHasChanged();
        });

        var web = GetPrimaryWebUpdate(snapshot);
        var bootstrap = snapshot.Bootstrap;
        var tokenWarning = snapshot.GitHubTokenWarning;
        var noticeKey = $"{web?.Version}:{web?.IsStaged}:{bootstrap?.Version}:{tokenWarning}";
        if (noticeKey == _lastUpdateNotice)
            return;

        _lastUpdateNotice = noticeKey;
        if (!string.IsNullOrWhiteSpace(tokenWarning))
        {
            _ = InvokeAsync(() => Snackbar.Add(tokenWarning, snapshot.GitHubTokenExpired ? Severity.Error : Severity.Warning));
            return;
        }

        if (web is not null && web.IsStaged)
        {
            _ = InvokeAsync(() => Snackbar.Add($"Quasar UI {web.Version} is staged. Open Updates to activate.", Severity.Info));
            return;
        }

        if (web is not null)
        {
            _ = InvokeAsync(() => Snackbar.Add($"Quasar UI {web.Version} is ready to download.", Severity.Info));
            return;
        }

        if (bootstrap is not null)
            _ = InvokeAsync(() => Snackbar.Add($"Quasar launcher {bootstrap.Version} update available.", Severity.Info));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var (mode, isDark) = await ThemePreference.InitializeAsync();
        _themeMode = mode;
        _isDarkMode = isDark;
        await RefreshPushStatusAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task SetThemeModeAsync(ThemeMode mode)
    {
        await ThemePreference.SetModeAsync(mode);
        _themeMode = mode;
        _isDarkMode = ThemePreference.IsDarkMode;
    }

    private async Task OnSystemDarkModeChangedAsync(bool isDark)
    {
        _isDarkMode = isDark;
        ThemePreference.SyncSystemDarkMode(isDark);
        await InvokeAsync(StateHasChanged);
    }

    private string GetThemeModeIcon() => _themeMode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    private UpdateNotice? CurrentNotice => UpdateNotices.Current(_updateSnapshot, _clusterReleaseSnapshot,
        ClusterCatalog.GetClusters(), _currentUser ?? new System.Security.Claims.ClaimsPrincipal());

    private bool HasUpdateBellBadge => CurrentNotice is not null;

    private IReadOnlyList<Quasar.Models.ClusterDefinition> AvailableClusterUpdates =>
        _currentUser is null ? [] : ClusterCatalog.GetClusters()
            .Where(cluster => _currentUser.CanQueryCluster(cluster.UniqueName)
                && ClusterReleaseMonitor.IsUpdateAvailable(cluster, _clusterReleaseSnapshot.Release)).ToArray();

    private Color GetUpdateBellColor()
    {
        if (_updateSnapshot.GitHubTokenExpired)
            return Color.Error;

        return HasUpdateBellBadge ? Color.Warning : Color.Inherit;
    }

    private string GetUpdateBellTooltip() => CurrentNotice?.Body ?? "Notifications";

    private string GetUpdateBellHref() => CurrentNotice?.Url ?? "/settings/updates";

    private Task OnBellOpenChangedAsync(bool open) => open ? RefreshPushStatusAsync() : Task.CompletedTask;

    private async Task RefreshPushStatusAsync()
    {
        _pushSupported = false;
        _pushServiceAvailable = true;
        try
        {
            var status = await JS.InvokeAsync<BrowserPushStatus>("quasarPush.status");
            _pushSupported = status.Supported;
            if (_pushSupported) await PushNotifications.GetPublicKeyAsync();
            _pushEnabled = status.Subscription is not null && _currentUser is not null
                && await PushNotifications.IsRegisteredAsync(_currentUser, status.Subscription.Endpoint);
        }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Could not read this browser's push subscription.");
            _pushEnabled = false;
            if (_pushSupported) _pushServiceAvailable = false;
        }
        _pushChecked = true;
    }

    private async Task EnablePushAsync()
    {
        try
        {
            var user = _currentUser ?? throw new InvalidOperationException("Sign in to enable push notifications.");
            string key = await PushNotifications.GetPublicKeyAsync();
            var subscription = await JS.InvokeAsync<BrowserPushSubscription>("quasarPush.subscribe", key);
            await PushNotifications.SubscribeAsync(user, subscription);
            _pushEnabled = true;
            Snackbar.Add("Push notifications enabled on this browser.", Severity.Success);
        }
        catch (JSException error) when (error.Message.Contains("Registration failed - push service error", StringComparison.OrdinalIgnoreCase))
        {
            Logger.LogWarning(error, "The browser's push service could not register a subscription.");
            Snackbar.Add("Browser push service unavailable. Check your network; in Brave, enable Google services for push messaging in Privacy settings.", Severity.Error);
        }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Could not enable browser push notifications.");
            Snackbar.Add("Could not enable push notifications. Check browser permission and try again.", Severity.Error);
        }
    }

    private async Task DisablePushAsync()
    {
        try
        {
            string? endpoint = await JS.InvokeAsync<string?>("quasarPush.unsubscribe");
            if (endpoint is not null && _currentUser is not null)
                await PushNotifications.UnsubscribeAsync(_currentUser, endpoint);
            _pushEnabled = false;
            Snackbar.Add("Push notifications disabled on this browser.", Severity.Info);
        }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Could not disable browser push notifications.");
            Snackbar.Add("Could not disable push notifications. Try again.", Severity.Error);
        }
    }

    private static QuasarUpdateCandidate? GetPrimaryWebUpdate(QuasarUpdateSnapshot snapshot) =>
        snapshot.WebReleases.FirstOrDefault(candidate => candidate.IsNewer && candidate.IsStaged) ??
        snapshot.WebReleases.FirstOrDefault(candidate => candidate.IsNewer);

    private static string GetAuthTooltip(System.Security.Claims.ClaimsPrincipal principal)
    {
        var displayName = principal.GetQuasarDisplayName();
        return string.IsNullOrWhiteSpace(displayName) ? "Sign out" : $"Sign out {displayName}";
    }

    private async Task HandlePowerClickAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(QuasarControlDialog.IsRestartAvailable)] = IsUnderBootstrap,
            [nameof(QuasarControlDialog.AgentOfflineShutdownSeconds)] = WebServiceOptions.AgentOfflineShutdownSeconds,
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<QuasarControlDialog>("Quasar power", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not QuasarControlAction action)
            return;

        switch (action)
        {
            case QuasarControlAction.RestartQuasar:
                await RestartQuasarAsync();
                break;
            case QuasarControlAction.ShutdownQuasar:
                await ShutdownQuasarAsync();
                break;
            case QuasarControlAction.ShutdownAllServers:
                ShutdownAllServers();
                break;
        }
    }

    private async Task RestartQuasarAsync()
    {
        _isShuttingDown = true;
        _shutdownStatus = "Restarting Quasar… the page will reload when it is back.";
        await InvokeAsync(StateHasChanged);

        // The worker is about to stop, dropping this Blazor circuit, so hand off to a
        // browser-side poller that reloads to the Dashboard once the new worker is
        // healthy. Invoke it before stopping so the call reaches the client in time.
        await JS.InvokeVoidAsync("quasarConfigs.reloadWhenHealthy", "/", new
        {
            requireUnhealthy = true,
            showFeedback = true,
            title = "Restarting Quasar",
            message = "Stopping the current web worker. The page will reload when Quasar is healthy again.",
            initialStatus = "Submitting restart request.",
            waitingForStopMessage = "Waiting for the current worker to stop.",
            pollingMessage = "Waiting for the restarted worker to pass /api/health.",
            successMessage = "Quasar is healthy. Reloading Dashboard.",
            timeoutMessage = "Still waiting for Quasar. Reloading Dashboard now.",
        });

        await ShutdownService.RestartWorkerAsync();
    }

    private async Task ShutdownQuasarAsync()
    {
        _isShuttingDown = true;
        _shutdownStatus = "Shutting down Quasar… start Quasar again to bring the UI back.";
        await InvokeAsync(StateHasChanged);
        try
        {
            await ShutdownService.ShutdownQuasarPreservingServersAsync();
        }
        catch (Exception exception)
        {
            _isShuttingDown = false;
            Snackbar.Add($"Failed shutting down Quasar: {exception.Message}", Severity.Error);
        }
    }

    private void ShutdownAllServers()
    {
        // Issue a stop on every running server — exactly as if Stop had been pressed on
        // each card. The servers wind down in the background and the Dashboard / Servers
        // list reflect their status, so there is no blocking overlay or status readout here.
        _ = ShutdownService.StopAllServersAsync(setGoalStateOff: true);
        Snackbar.Add("Server shutdown queued.", Severity.Info);
    }
}
