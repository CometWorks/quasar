@inject NavigationManager PanelNavigation
@foreach (var navItem in ZoneItems)
{
    var policy = ResolvePolicy(navItem);

    if (string.IsNullOrWhiteSpace(policy))
    {
        <NavLink @key="navItem.Href" class="quasar-nav-link" href="@PanelNavigation.PanelUrl(navItem.Href)"><QuasarIcon Icon="@navItem.Icon" />
            @navItem.Text
        </NavLink>
    }
    else
    {
        <AuthorizeView @key="navItem.Href" Policy="@policy">
            <Authorized>
                <NavLink class="quasar-nav-link" href="@PanelNavigation.PanelUrl(navItem.Href)"><QuasarIcon Icon="@navItem.Icon" />
                    @navItem.Text
                </NavLink>
            </Authorized>
        </AuthorizeView>
    }
}

@code
{
    [Parameter]
    public IEnumerable<QuasarNavItem> Items { get; set; } = [];

    [Parameter]
    public string Zone { get; set; } = QuasarNavZones.Main;

    [Parameter]
    public string? DefaultPolicy { get; set; }

    private IEnumerable<QuasarNavItem> ZoneItems => Items
        .Where(item => string.Equals(item.Zone, Zone, StringComparison.OrdinalIgnoreCase))
        .OrderBy(item => item.Order)
        .ThenBy(item => item.Text, StringComparer.OrdinalIgnoreCase);

    private string? ResolvePolicy(QuasarNavItem item) =>
        string.IsNullOrWhiteSpace(item.Policy)
            ? DefaultPolicy
            : item.Policy;
}
