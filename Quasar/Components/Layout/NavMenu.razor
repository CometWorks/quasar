@inject QuasarUiPluginCatalog UiPlugins

<MudStack Class="pa-4" Spacing="3">
    <MudNavMenu Class="magnetar-nav-menu">
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
            Dashboard
        </MudNavLink>
        <AuthorizeView Policy="@QuasarPolicyNames.CanEditConfigs">
            <Authorized>
                <MudNavLink Href="/configs" Icon="@Icons.Material.Filled.Tune">Configs</MudNavLink>
                <MudNavLink Href="/world-templates" Icon="@Icons.Material.Filled.Public">Worlds</MudNavLink>
                <MudNavLink Href="/plugins" Icon="@Icons.Material.Filled.Extension">Plugins</MudNavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@QuasarPolicyNames.CanControlServers">
            <Authorized>
                <MudNavLink Href="/players" Icon="@Icons.Material.Filled.Groups">Players</MudNavLink>
                <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat">Chat</MudNavLink>
                <MudNavLink Href="/entities" Icon="@Icons.Material.Filled.ViewInAr">Entities</MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="/analytics" Icon="@Icons.Material.Filled.QueryStats">
            Analytics
        </MudNavLink>
        <AuthorizeView Policy="@QuasarPolicyNames.CanManageDiscord">
            <Authorized>
                <MudNavLink Href="/discord" Icon="@Icons.Material.Filled.Forum">Discord</MudNavLink>
            </Authorized>
        </AuthorizeView>
        <PluginNavItems Items="@UiPlugins.NavItems" Zone="@QuasarNavZones.Main" />
    </MudNavMenu>

    <MudDivider />

    <MudText Typo="Typo.overline" Class="px-4">Tools</MudText>
    <MudNavMenu Class="magnetar-nav-menu">
        <MudNavLink Href="/hosts" Icon="@Icons.Material.Filled.Dns">
            Hosts
        </MudNavLink>
        <PluginNavItems Items="@UiPlugins.NavItems" Zone="@QuasarNavZones.Tools" />
    </MudNavMenu>

    <MudDivider />

    <MudNavMenu Class="magnetar-nav-menu">
        <AuthorizeView Policy="@QuasarPolicyNames.CanManageAppearance">
            <Authorized>
                <MudNavLink Href="/settings/appearance" Icon="@Icons.Material.Filled.Palette">Appearance</MudNavLink>
            </Authorized>
        </AuthorizeView>
        <PluginNavItems Items="@UiPlugins.NavItems" Zone="@QuasarNavZones.Settings" />
        <AuthorizeView Policy="@QuasarPolicyNames.CanManageSecurity">
            <Authorized>
                <MudNavLink Href="/settings/security" Icon="@Icons.Material.Filled.Security">
                    Security
                </MudNavLink>
                <MudNavLink Href="/settings/ui-plugins" Icon="@Icons.Material.Filled.Extension">
                    UI Plugins
                </MudNavLink>
                <MudNavLink Href="/backup" Icon="@Icons.Material.Filled.Backup">
                    Backup
                </MudNavLink>
                <MudNavLink Href="/settings/updates" Icon="@Icons.Material.Filled.Upgrade">
                    Updates
                </MudNavLink>
                <PluginNavItems
                    Items="@UiPlugins.NavItems"
                    Zone="@QuasarNavZones.Admin"
                    DefaultPolicy="@QuasarPolicyNames.CanManageSecurity" />
            </Authorized>
        </AuthorizeView>
    </MudNavMenu>
</MudStack>
