@using Quasar.Client.Components
@using Magnetar.Protocol.Model
@using Quasar.Services.PluginSdk
@inject QuasarPermissionService Permissions
@inject PluginConfigService Service

<SchemaConfigEditor PluginId="@Plugin.PluginId" DisplayName="@Plugin.DisplayName" ConfigJson="@Plugin.ConfigJson"
                    SaveValues="ApplyAsync" ApplyLabel="@ApplyLabel" SuccessMessage="@SuccessMessage" />

@code {
    [Parameter, EditorRequired] public string ConnectionId { get; set; } = "";
    [Parameter, EditorRequired] public string AgentId { get; set; } = "";
    [Parameter, EditorRequired] public PluginConfigData Plugin { get; set; } = null!;
    [Parameter] public Func<string, Task>? SaveValues { get; set; }
    [Parameter] public string ApplyLabel { get; set; } = "Apply changes";
    [Parameter] public string? SuccessMessage { get; set; }

    private async Task ApplyAsync(string json)
    {
        if (SaveValues is not null) { await SaveValues(json); return; }
        if (await Permissions.IsAuthorizedAsync(QuasarPolicyNames.CanEditConfigs))
            await Service.UpdatePluginConfigAsync(AgentId, Plugin.PluginId, json, ConnectionId);
    }
}
