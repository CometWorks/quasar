<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.10.3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quasar\Quasar.csproj" />
    <ProjectReference Include="..\Quasar.Host\Quasar.Host.csproj" Aliases="Host" />
    <ProjectReference Include="..\Quasar.Agent\Quasar.Agent.csproj" />
    <Reference Include="PluginSdk" HintPath="$(MagnetarBin)/PluginSdk.dll" />
    <!-- Command alias tests exercise the real SDK config serializer and dispatcher without a game process. -->
    <Reference Include="VRage.Math" HintPath="$(DS64)/VRage.Math.dll" Private="True" />
    <Reference Include="VRage" HintPath="$(DS64)/VRage.dll" Private="True" />
    <Reference Include="VRage.Library" HintPath="$(DS64)/VRage.Library.dll" Private="True" />
    <Reference Include="VRage.Game" HintPath="$(DS64)/VRage.Game.dll" Private="True" />
    <Reference Include="Sandbox.Common" HintPath="$(DS64)/Sandbox.Common.dll" Private="True" />
    <!-- Bootstrap and worker both compile the shared networking types. -->
    <ProjectReference Include="..\Quasar.Bootstrap\Quasar.Bootstrap.csproj" Aliases="Bootstrap" />
  </ItemGroup>
</Project>
