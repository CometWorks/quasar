# Image tag: latest, v1.1.0.31, or 1.1.0.31.
QUASAR_VERSION=latest

# Required on first start. Quasar writes this mapping to quasar-data/rbac.json.
QUASAR_ADMIN_STEAM_ID=YOUR_17_DIGIT_STEAM_ID

# Stable identity and browser-facing URL for this Quasar host.
QUASAR_HOST_ID=quasar-docker
QUASAR_PUBLIC_BASE_URL=http://127.0.0.1:8080

QUASAR_LOG_FORMAT=text
QUASAR_LOG_MIN_LEVEL=Warn

# Optional separate disk for diagnostic logs, encrypted queues and dumps.
# Native services: absolute directory. Docker: use docker-compose.diagnostics.yml instead.
QUASAR_DIAGNOSTICS_DIRECTORY=
# Docker host path used only by the optional diagnostics Compose override.
QUASAR_DIAGNOSTICS_HOST_DIRECTORY=
# Optional plain application-log directory (native services).
QUASAR_LOG_DIR=

# Diagnostic uplink: requires separate opt-in consent and a provisioned installation token.
Quasar__Diagnostics__BackofficeUrl=https://log.se-servers.net/
Quasar__Diagnostics__UploadToken=

# Opt-in automatic Quasar application (UI + Bootstrap matching release), and UI plugins.
# Both may restart Quasar while preserving running game servers.
# QUASAR_UPDATES_AUTO_APPLY=false
# QUASAR_UPDATES_AUTO_UPDATE_UI_PLUGINS=false
