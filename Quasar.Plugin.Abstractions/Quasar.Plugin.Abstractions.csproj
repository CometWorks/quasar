<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Quasar.Plugin.Abstractions</AssemblyName>
    <RootNamespace>Quasar.Plugin.Abstractions</RootNamespace>
    <PackageId>Quasar.Plugin.Abstractions</PackageId>
    <Description>Public contract surface for Quasar UI plugins.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Only core builds agent principals. -->
    <InternalsVisibleTo Include="Quasar" />
    <InternalsVisibleTo Include="Quasar.Tests" />
  </ItemGroup>

</Project>
