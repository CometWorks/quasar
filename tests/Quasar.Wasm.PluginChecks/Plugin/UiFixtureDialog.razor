@using Microsoft.AspNetCore.Components.Web
@using Quasar.Ui

<header class="quasar-dialog-header">
    <h2 class="quasar-dialog-title">@Dialog.Title</h2>
</header>
<div class="quasar-dialog-content">
    <div class="quasar-layout quasar-gap-3">
        <p class="quasar-text">@Message</p>
        @if (LateDescription)
        {
            @if (_descriptionVisible)
            {
                <p class="quasar-text" data-quasar-dialog-description>Late description added after open.</p>
            }
            <button type="button" class="quasar-button" @onclick="ShowDescription">Add description</button>
        }
        @if (LongContent)
        {
            @for (var i = 1; i <= 40; i++)
            {
                <p class="quasar-text">Long-content line @i. The dialog content should scroll while its actions remain reachable.</p>
            }
        }
    </div>
</div>
<footer class="quasar-dialog-actions">
    <button type="button" class="quasar-button" @onclick="Cancel">Cancel</button>
    <button type="button" class="quasar-button quasar-button-primary" @onclick="Confirm">Confirm</button>
</footer>

@code {
    [CascadingParameter] private IQuasarDialogInstance Dialog { get; set; } = default!;

    [Parameter] public string Message { get; set; } = "Fixture dialog content.";

    [Parameter] public bool LongContent { get; set; }

    [Parameter] public bool LateDescription { get; set; }

    private bool _descriptionVisible;

    private void ShowDescription() => _descriptionVisible = true;

    private void Confirm() => Dialog.Close(QuasarDialogResult.Ok("confirmed"));

    private void Cancel() => Dialog.Cancel();
}
