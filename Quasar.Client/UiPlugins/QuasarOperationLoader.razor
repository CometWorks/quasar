@namespace Quasar.Components.Shared
@using Quasar.Client.Formatting
@implements IDisposable
@inject TimeProvider Time

<section class="quasar-operation-loader" aria-label="@Title">
    <div class="quasar-row quasar-between">
        <strong>@Title</strong>
        <span class="quasar-muted quasar-caption">Elapsed @Elapsed.ToString(@"hh\:mm\:ss")</span>
    </div>
    <p role="status" aria-live="polite">@Message</p>
    <div aria-busy="true">
        <QuasarProgress Label="@Title" Value="@(Percent ?? 0)" Indeterminate="@(!Percent.HasValue)" />
    </div>
    @if (Percent is { } percent)
    {
        <span class="quasar-muted quasar-caption">@NumberText.Display(Math.Clamp(percent, 0, 100), "0")%</span>
    }
    @if (Elapsed.TotalSeconds >= 30)
    {
        <p class="quasar-muted quasar-caption">Still working. Some operations take several minutes.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
    [Parameter] public double? Percent { get; set; }
    private long _started;
    private ITimer? _timer;
    private bool _disposed;
    private TimeSpan Elapsed => Time.GetElapsedTime(_started);

    protected override void OnInitialized()
    {
        _started = Time.GetTimestamp();
        var second = TimeSpan.FromSeconds(1);
        _timer = Time.CreateTimer(_ => InvokeAsync(() => { if (!_disposed) StateHasChanged(); }), null, second, second);
    }
    public void Dispose() { _disposed = true; _timer?.Dispose(); }
}
