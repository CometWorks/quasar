@using Quasar.Components.Shared
@using Quasar.Client.Fleet
@using Quasar.Services
@using MudBlazor
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@inject DashboardSdk Sdk
@inject IJSRuntime JS
@inject ViewerTimeZone ViewerTime
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@implements IDisposable

@if (_error is not null){<p class="quasar-notice quasar-notice-error" role="alert">@_error</p>}
<div class="quasar-row">
    @if (_live?.Saving == true) { <span class="quasar-status">Save in progress</span> }
    else if (_live?.LastSave is {} saved)
    {
        <span class="quasar-status">Saved @ViewerTime.Format(saved) @if (_live.UnsavedSeconds is > 0) { <span> · Unsaved @TimeSpan.FromSeconds(_live.UnsavedSeconds.Value).ToString("g")</span> }</span>
    }
    @if (CanControl)
    {
        <button type="button" class="quasar-button" disabled="@(_busy || !Connected)" @onclick="@(() => Send("chat.node.refresh", new { UniqueName }))"><QuasarIcon Icon="@QuasarIcons.Refresh" />Refresh</button>
        <button type="button" class="quasar-button quasar-tone-info" disabled="@(_busy || !Connected || !Running || _live?.Saving == true)" @onclick="@(() => Send("servers.save", new { UniqueName }))"><QuasarIcon Icon="@QuasarIcons.Save" />Save</button>
    }
</div>
@if (CanControl)
{
    <form class="quasar-chat-form" @onsubmit="Broadcast" @onsubmit:preventDefault>
        <label class="quasar-field"><span>Broadcast message</span><input @bind="_message" @bind:event="oninput" disabled="@(!Connected)" /></label>
        <button type="submit" class="quasar-button quasar-button-primary" disabled="@(_busy || !Connected || string.IsNullOrWhiteSpace(_message))">Send</button>
    </form>
}
@if (_live is {} data)
{
    <h3>Players</h3>
    <div class="quasar-table-scroll">
        <table class="quasar-server-table quasar-players-table">
            <thead><tr><th scope="col">Steam ID</th><th scope="col">Service</th><th scope="col">Faction</th><th scope="col">Role</th><th scope="col">Ping</th><th scope="col">Name</th>
                @if (CanControl) { <th scope="col"><span class="quasar-visually-hidden">Actions</span></th> }
            </tr></thead>
            <tbody>
                @foreach (var player in data.Players)
                {
                    var actionsId = $"{_playerActionsId}-{player.SteamId}";
                    <tr @key="player.SteamId">
                        <td class="mono">@player.SteamId</td><td>@player.Service</td><td>@player.Faction</td><td>@player.Role</td><td>@player.Ping</td>
                        <td>@player.Name
                            @if (player.Platform.Length > 0 && player.Platform != player.Name) { <span class="quasar-server-secondary quasar-muted">Platform: @player.Platform</span> }
                        </td>
                        @if (CanControl)
                        {
                            <td>
                                <button type="button" class="quasar-icon-button" popovertarget="@actionsId" title="Player actions" aria-label="@($"Actions for {player.Name}")" disabled="@(!Connected)"><QuasarIcon Icon="@QuasarIcons.MoreVert" /></button>
                                <div id="@actionsId" popover="auto" class="quasar-player-actions">
                                    <strong>@player.Name</strong><p class="quasar-muted">Set role</p>
                                    @foreach (var level in Levels)
                                    {
                                        <button type="button" popovertarget="@actionsId" popovertargetaction="hide" disabled="@(_busy || !Connected || player.Role == level)" @onclick="@(() => Moderate(player, "players.promotion.set", level))">@level</button>
                                    }
                                    <hr class="quasar-divider" />
                                    <button type="button" class="quasar-tone-error" popovertarget="@actionsId" popovertargetaction="hide" disabled="@(_busy || !Connected)" @onclick="@(() => Moderate(player, "players.kick"))">Kick</button>
                                    <button type="button" class="quasar-tone-error" popovertarget="@actionsId" popovertargetaction="hide" disabled="@(_busy || !Connected)" @onclick="@(() => Moderate(player, "players.ban"))">Ban</button>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <h3>Recent Chat</h3>
    <div class="quasar-chat-list">
        @foreach (var message in data.Chat)
        {
            <div class="quasar-chat-row">
                <time class="mono quasar-muted" datetime="@(message.At?.ToString("O"))">@(message.At is {} at ? ViewerTime.Format(at) : "")</time>
                <p><span class="mono">[@message.Channel]</span> <strong>@message.Author</strong>: <span class="chat-text">@message.Content</span></p>
            </div>
        }
    </div>
    @if (data.Results.Length > 0)
    {
        <h3>Recent Command Results</h3>
        @foreach (var result in data.Results) { <p class="quasar-notice" role="status">@result</p> }
    }
}
@code {
    [Parameter, EditorRequired] public string UniqueName {get;set;}="";
    [Parameter] public string? AgentId { get; set; }
    [Parameter] public bool Connected {get;set;}
    [Parameter] public bool Running {get;set;}
    [Parameter] public bool CanControl {get;set;}
    private readonly string _playerActionsId = "player-actions-" + Guid.NewGuid().ToString("N");
    private static readonly string[] Levels=["None","Scripter","Moderator","SpaceMaster","Admin"];
    private readonly CancellationTokenSource _lifetime=new();
    private FleetLive? _live;
    private string? _error;
    private string _message="";
    private bool _busy,_loading;
    private DateTimeOffset _refreshAfter;
    protected override async Task OnParametersSetAsync()
    {
        if(!_loading && DateTimeOffset.UtcNow >= _refreshAfter) await Refresh();
    }
    private async Task Refresh()
    {
        _loading=true;
        try { _live=await JS.InvokeAsync<FleetLive>("quasarSdk.readJson",_lifetime.Token,"quasar.core","fleet.live",new FleetLiveRequest(UniqueName,AgentId));_error=null; }
        catch(OperationCanceledException) when (_lifetime.IsCancellationRequested) {}
        catch(Exception e){_live=null;_error=e.Message;}
        finally{_loading=false;_refreshAfter=DateTimeOffset.UtcNow.AddSeconds(4);}
    }
    private async Task<bool> Send(string operation,object target)
    {
        if(_busy)return false;
        _busy=true;
        try{await Sdk.RequestAsync<JsonElement>(operation,target);await Refresh();return true;}
        catch(Exception e){Snackbar.Add(e.Message,Severity.Error);return false;}
        finally{_busy=false;}
    }
    private async Task Broadcast()
    {
        var text=_message.Trim();
        if(text.Length>0 && await Send("chat.send",new{UniqueName,text}))_message="";
    }
    private async Task Moderate(FleetPlayer player,string operation,string? level=null)
    {
        if(await Dialogs.ShowMessageBoxAsync("Player action",$"{(operation=="players.promotion.set" ? "Set role to "+level : operation=="players.ban" ? "Ban" : "Kick")} — {player.Name}?",yesText:"Confirm",cancelText:"Cancel")==true)
            await Send(operation,new{UniqueName,player.SteamId,level});
    }
    public void Dispose(){_lifetime.Cancel();_lifetime.Dispose();}
}
