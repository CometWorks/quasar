@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (Access.CanOpen(Route.PageType))
{
    <RouteView RouteData="Route" />
}
else
{
    <p role="alert">You do not have permission to view this page.</p>
    <a href="login" data-enhance-nav="false">Sign in</a>
}

@code {
    [Parameter, EditorRequired] public RouteData Route { get; set; } = default!;
    [Parameter, EditorRequired] public DashboardAccess Access { get; set; } = default!;
    private string? _lastUri;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_lastUri == Navigation.Uri) return;
        _lastUri = Navigation.Uri;
        await JS.InvokeVoidAsync("quasarSdk.dashboardNavigated");
    }
}
