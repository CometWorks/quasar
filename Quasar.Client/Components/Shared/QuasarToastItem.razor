@namespace Quasar.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@using Quasar.Client.Ui.Toasts
@using Quasar.Ui
@inject QuasarToastService Toasts
@inject ILogger<QuasarToastItem> Logger

@*
    One native toast.

    Accessibility:
      - Warning and Error use role="alert" (assertive); other severities use
        role="status" (polite).
      - aria-atomic="true" makes the message and action announce as one unit.
      - The close button has an explicit label rather than an icon-only name.

    Timing:
      - pointerenter/focusin pause the dismiss timer; pointerleave/focusout
        resume it with the remaining time. This lets a user read a long message
        or reach the action button without racing the timer.

    Styling:
      - quasar-toast and quasar-toast-<severity> are public classes.
      - Caller Class and Style are appended so plugin CSS can override tokens.
*@
<div class="quasar-toast quasar-toast-@SeverityClass @Toast.Options.Class"
     style="order:@Order;@Toast.Options.Style"
     role="@Role"
     aria-atomic="true"
     @onmouseenter="PointerEntered"
     @onmouseleave="PointerLeft"
     @onfocusin="FocusEntered"
     @onfocusout="FocusLeft">
    @if (Toast.Options.ShowIcon)
    {
        <QuasarIcon Icon="@Icon" TrustedMarkup="@TrustedIcon" Class="quasar-toast-icon" />
    }
    <div class="quasar-toast-content">
        <div class="quasar-toast-message">@Toast.Message</div>
        @if (ActionText is not null)
        {
            <button type="button" class="quasar-button quasar-toast-action" disabled="@_actionRunning" @onclick="RunActionAsync">@ActionText</button>
        }
    </div>
    @if (Toast.Options.Closable)
    {
        <QuasarIconButton Label="Dismiss notification" Icon="@QuasarIcons.Close" OnClick="Dismiss" Class="quasar-toast-close" />
    }
</div>

@code {
    /// <summary>The immutable toast model supplied by the host.</summary>
    [Parameter, EditorRequired] public QuasarToast Toast { get; set; } = default!;

    /// <summary>Flex order used to show the newest toast first without moving DOM nodes.</summary>
    [Parameter] public int Order { get; set; }

    private bool _pointerInside;
    private bool _focusInside;
    private bool _actionRunning;

    /// <summary>
    /// Urgent severities announce immediately. Everything else is polite so a
    /// stream of routine notifications does not interrupt the user.
    /// </summary>
    private string Role => Toast.Severity is QuasarSeverity.Warning or QuasarSeverity.Error ? "alert" : "status";

    /// <summary>CSS suffix used for the severity accent color.</summary>
    private string SeverityClass => Toast.Severity.ToString().ToLowerInvariant();

    /// <summary>Per-toast icon override, otherwise the severity default.</summary>
    private string Icon => Toast.Options.Icon ?? QuasarToastIcons.For(Toast.Severity);

    /// <summary>
    /// Only the built-in severity icons are trusted SVG markup. A plugin
    /// override is rendered as text unless it is an icon-font name.
    /// </summary>
    private bool TrustedIcon => Toast.Options.Icon is null;

    /// <summary>
    /// The action button renders only when both the label and the callback are
    /// set. A label without a callback is ignored rather than becoming a
    /// dismiss-only button that looks like an action.
    /// </summary>
    private string? ActionText =>
        Toast.Options.OnAction is not null ? Toast.Options.ActionText : null;

    private void PointerEntered()
    {
        _pointerInside = true;
        UpdatePause();
    }

    private void PointerLeft()
    {
        _pointerInside = false;
        UpdatePause();
    }

    private void FocusEntered()
    {
        _focusInside = true;
        UpdatePause();
    }

    private void FocusLeft()
    {
        _focusInside = false;
        UpdatePause();
    }

    /// <summary>
    /// Pauses while either the pointer or keyboard focus is inside. A single
    /// exit event must not resume the timer while the other interaction remains.
    /// </summary>
    private void UpdatePause()
    {
        if (_pointerInside || _focusInside)
            Toasts.Pause(Toast.Id);
        else
            Toasts.Resume(Toast.Id);
    }

    /// <summary>Removes the toast immediately.</summary>
    private void Dismiss() => Toasts.Remove(Toast.Id);

    /// <summary>
    /// Runs the optional action, then removes the toast. A failing action is
    /// logged and does not leave the toast stuck on screen.
    /// </summary>
    private async Task RunActionAsync()
    {
        if (_actionRunning)
            return;

        _actionRunning = true;
        try
        {
            if (Toast.Options.OnAction is { } action)
            {
                try
                {
                    await action();
                }
                catch (Exception error)
                {
                    Logger.LogWarning(error, "A toast action failed.");
                }
            }
        }
        finally
        {
            Toasts.Remove(Toast.Id);
        }
    }
}
