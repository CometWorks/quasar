@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@using Quasar.Client.Fleet
@implements IAsyncDisposable
@inject DashboardSdk Sdk
@inject IJSRuntime JS
@inject NavigationManager Navigation

<section class="quasar-panel quasar-card-content quasar-stack" aria-label="@Title">
    <h2 class="quasar-text quasar-type-h6">@Title</h2>
    @if (Server is not null)
    {
        <p>Current save <strong>@Server.Save</strong>. Importing selects a new save and keeps the previous save on disk. The server remains stopped.</p>
    }
    @if (_world is null && Existing is null)
    {
        <div aria-label="World source" class="quasar-row">
            @if (Server is null) { <MudButton OnClick='() => SetModeAsync("installed")' Disabled="_busy">Predefined worlds</MudButton> }
            <MudButton OnClick='() => SetModeAsync("folder")' Disabled="_busy">Server folder</MudButton>
            <MudButton OnClick='() => SetModeAsync("zip")' Disabled="_busy">Upload ZIP</MudButton>
        </div>
        @if (_mode == "installed")
        {
            <MudTextField @bind-Value="_search" Immediate="true" Label="Search installed worlds" />
            <MudButton OnClick="DiscoverAsync" Disabled="_busy">Refresh</MudButton>
            @if (_discovering) { <MudProgressLinear Indeterminate="true" aria-label="Finding installed worlds" /> }
            @if (_installed is { } installed)
            {
                @foreach (var warning in installed.Warnings) { <MudAlert Severity="Severity.Warning">@warning</MudAlert> }
                @if (installed.Worlds.Length == 0)
                {
                    <p>@(installed.RuntimeReady ? "No starting worlds found. Check Dedicated Server content in Updates, or import a completed save." : "Waiting for the Dedicated Server installation. Custom folders and ZIP files can be used now.")</p>
                }
                @foreach (var item in installed.Worlds.Where(Matches))
                {
                    <div class="quasar-row quasar-between">
                        <span><strong>@item.Name</strong><br />@item.Category · @item.DisplayPath</span>
                        <MudButton OnClick="@(() => ChooseInstalledAsync(item))" Disabled="_busy">Select world</MudButton>
                    </div>
                }
            }
        }
        else if (_mode == "folder")
        {
            <MudTextField Label="Source folder on Quasar" Value="@_path" ValueChanged="@( (string value) => { _path = value; _stopped = false; })" Disabled="_busy" />
            <MudButton OnClick="@(() => BrowseAsync(_path))" Disabled="_busy">Browse folders</MudButton>
            @if (_folders is { } folders)
            {
                <div class="quasar-stack">
                    <div>
                        @foreach (var shortcut in folders.Shortcuts) { <MudButton OnClick="@(() => BrowseAsync(shortcut.Path))">@shortcut.Name</MudButton> }
                    </div>
                    <div>
                        @foreach (var crumb in folders.Breadcrumbs) { <MudButton OnClick="@(() => BrowseAsync(crumb.Path))">@crumb.Name</MudButton> }
                    </div>
                    <MudCheckBox T="bool" Value="_hidden" ValueChanged="ToggleHiddenAsync" Label="Show hidden folders" />
                    <MudTextField Label="Filter current folder" @bind-Value="_folderFilter" Immediate="true" />
                    @foreach (var folder in folders.Entries.Where(f => f.Name.Contains(_folderFilter, StringComparison.OrdinalIgnoreCase)))
                    {
                        <MudButton OnClick="@(() => BrowseAsync(folder.Path))">@folder.Name @(folder.World ? "(world)" : "")</MudButton>
                    }
                    <MudButton OnClick="UseFolderAsync" Disabled="@(!folders.World)">Use this world folder</MudButton>
                </div>
            }
            <MudCheckBox T="bool" Label="The source world is stopped or is a completed save snapshot." @bind-Value="_stopped" Disabled="_busy" />
            <MudButton OnClick="ReadFolderAsync" Disabled="@(_busy || !_stopped || string.IsNullOrWhiteSpace(_path))">Read World</MudButton>
        }
        else
        {
            <label>World ZIP (at most 10 GiB)<InputFile @ref="_input" OnChange="ChooseZip" accept=".zip,application/zip" disabled="@_busy" /></label>
            <MudButton OnClick="ReadZipAsync" Disabled="@(_busy || _file is null)">Read World</MudButton>
        }
    }
    @if (_world is { } world)
    {
        @if (!ProfileOnly)
        {
            <MudTextField Label="@(Server is null ? "Template name" : "New save folder name")" @bind-Value="_name" Disabled="_busy" />
            @if (Server is null) { <MudTextField Label="Template description" @bind-Value="_description" Disabled="_busy" /> }
        }
        @if (world.ConfigError is null)
        {
            <p>Found @world.Settings world settings and @world.Mods.Length mods.</p>
            @if (world.Mods.Length > 0)
            {
                <details><summary>World mods</summary><ul>@foreach (var mod in world.Mods) { <li>@mod.Name (@mod.Id)</li> }</ul></details>
            }
        }
        else { <MudAlert Severity="Severity.Warning">World settings could not be read. @world.ConfigError</MudAlert> }
        @if (!TemplateOnly && !ProfileOnly)
        {
            <MudSelect T="string" Label="Configuration" @bind-Value="_action" Disabled="_busy">
                <MudSelectItem Value="@("keep")">@(Server is null ? "Create template only" : $"Keep current profile ({Server.Profile})")</MudSelectItem>
                @if (Inventory.EditConfigs && world.ConfigError is null)
                {
                    <MudSelectItem Value="@("new")">Create a separate profile from world settings and mods</MudSelectItem>
                    @if (Server is null && world.Mods.Length > 0 && Inventory.Profiles.Length > 0)
                    { <MudSelectItem Value="@("existing")">Merge imported mods into an existing profile</MudSelectItem> }
                }
            </MudSelect>
        }
        @if (_action == "keep" && Server is not null)
        { <p>The current profile's settings and mod list replace the imported world's settings and mods at startup.</p> }
        @if (_action == "new" && Server is null)
        {
            <MudTextField Label="New profile name" @bind-Value="_profileName" Disabled="_busy" />
            <MudTextField Label="Profile description" @bind-Value="_profileDescription" Disabled="_busy" />
        }
        @if (_action == "new" && Server is not null)
        { <p>The new profile preserves existing plugins, access settings and Online Mode. Other servers keep their current profile.</p> }
        @if (_action == "existing")
        {
            <MudSelect T="string" Label="Configuration profile" @bind-Value="_profile" Disabled="_busy">
                @foreach (var profile in Inventory.Profiles) { <MudSelectItem Value="@profile.Id">@profile.Name</MudSelectItem> }
            </MudSelect>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanCommit)" OnClick="CommitAsync">
            @(ProfileOnly ? "Create profile" : Server is null ? "Create world template" : "Import and select save")
        </MudButton>
    }
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" aria-label="@_phase" />
        <p role="status">@(_progress?.Phase ?? _phase)
            @if (_progress?.Total > 0) { <span> · @_progress.Completed of @_progress.Total files</span> }
            @if (_progress?.Bytes > 0) { <span> · @(_progress.Bytes / 1048576) MiB</span> }
        </p>
        <MudButton OnClick="CancelTransferAsync">Cancel transfer</MudButton>
    }
    @if (_error is not null) { <MudAlert Severity="Severity.Warning" role="alert">@_error</MudAlert> }
    <MudButton OnClick="CloseAsync" Disabled="_busy">Close</MudButton>
</section>

@code {
    [Parameter, EditorRequired] public WorldInventory Inventory { get; set; } = null!;
    [Parameter] public WorldServer? Server { get; set; }
    [Parameter] public WorldTemplate? Existing { get; set; }
    [Parameter] public bool ProfileOnly { get; set; }
    [Parameter] public bool TemplateOnly { get; set; }
    [Parameter] public EventCallback<WorldSaved> Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private string Title => Server is { } s ? "Import world to " + s.Name : ProfileOnly ? "Create profile from template" : Existing is null ? "Add world template" : "Clone world template";
    private string Prefix => Server is null ? "worlds.template." : "worlds.server.";
    private readonly CancellationTokenSource _stop = new();
    private WorldTarget _target = null!;
    private IJSObjectReference? _module;
    private InputFile? _input;
    private IBrowserFile? _file;
    private ReadWorld? _world;
    private InstalledWorlds? _installed;
    private WorldFolders? _folders;
    private WorldTransferProgress? _progress;
    private bool _busy, _discovering, _stopped, _hidden, _disposed;
    private string _mode = "", _search = "", _path = "", _folderFilter = "", _phase = "", _name = "", _description = "", _profileName = "", _profileDescription = "", _action = "", _profile = "";
    private string? _error;
    private bool CanCommit => !_busy && _world is not null && (ProfileOnly || !string.IsNullOrWhiteSpace(_name)) && _action.Length > 0
        && (_action != "new" || _world.ConfigError is null && (Server is not null || !string.IsNullOrWhiteSpace(_profileName)))
        && (_action != "existing" || _profile.Length > 0);

    protected override async Task OnInitializedAsync()
    {
        _target = new(Guid.NewGuid(), Server?.Id, Server?.Revision);
        _profile = Inventory.Profiles.FirstOrDefault()?.Id ?? "";
        _mode = Server is null ? "installed" : "folder";
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", _stop.Token, new Uri(new Uri(Navigation.BaseUri), "_content/Quasar.Client/worldTransfers.js").AbsoluteUri);
            if (Existing is not null) await ReadAsync(new(Template: Existing.Id));
            else if (Server is null) await DiscoverAsync();
            else await LoadStoredPathAsync();
            if (!_disposed) _ = PollAsync(_stop.Token);
        }
        catch (JSException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_disposed) { }
    }

    private bool Matches(InstalledWorld world) => string.Join(" ", world.Name, world.DisplayPath, world.Path, world.Category).Contains(_search, StringComparison.OrdinalIgnoreCase);

    private async Task SetModeAsync(string mode)
    {
        _mode = mode; _error = null;
        if (mode == "installed" && _installed is null) await DiscoverAsync();
        if (mode == "folder" && _path.Length == 0) await LoadStoredPathAsync();
    }

    private async Task LoadStoredPathAsync()
    {
        try { _path = await JS.InvokeAsync<string?>("quasarConfigs.getLocalStorage", _stop.Token, "quasar.worldTemplates.lastSourceFolder") ?? ""; }
        catch (JSException) { }
    }

    private async Task DiscoverAsync()
    {
        if (_discovering) return;
        _discovering = true;
        try { _installed = await Sdk.RequestAsync<InstalledWorlds>("worlds.installed", token: _stop.Token); }
        catch (JSException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_disposed) { }
        finally { _discovering = false; }
    }

    private async Task BrowseAsync(string? path)
    {
        try
        {
            _folders = await Sdk.RequestAsync<WorldFolders>(Prefix + "browse", new WorldFolderQuery(path, _hidden), _stop.Token);
            _folderFilter = "";
        }
        catch (JSException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_disposed) { }
    }

    private async Task ToggleHiddenAsync(bool value) { _hidden = value; await BrowseAsync(_folders?.Path); }

    private async Task UseFolderAsync()
    {
        _path = _folders!.Path; _folders = null; _stopped = false;
        try { await JS.InvokeVoidAsync("quasarConfigs.setLocalStorage", _stop.Token, "quasar.worldTemplates.lastSourceFolder", _path); }
        catch (JSException) { }
    }

    private void ChooseZip(InputFileChangeEventArgs args) { _file = args.File; _error = null; }
    private Task ReadFolderAsync() => ReadAsync(new(_path, Stopped: _stopped));
    private Task ReadZipAsync() => ReadAsync(null);
    private async Task ChooseInstalledAsync(InstalledWorld item)
    {
        _name = item.Name; _description = item.Description;
        await ReadAsync(new(item.Path, Stopped: true));
    }

    private async Task ReadAsync(WorldSource? source)
    {
        if (_busy || _module is null) return;
        _phase = source is null ? $"Uploading {_file?.Name} ({_file?.Size / 1048576} MiB)" : "Reading world files";
        if (source is null && (_file is null || _file.Size > 10L * 1024 * 1024 * 1024)) { _error = "Select a ZIP of at most 10 GiB."; return; }
        _busy = true; _error = null; _progress = null;
        try
        {
            _world = await _module.InvokeAsync<ReadWorld>("write", _stop.Token, _target.Id, Prefix + (source is null ? "zip" : "folder"), _target, source,
                source is null ? _input?.Element : null, _file?.Name, _file?.Size);
            if (Existing is not null) { _name = Existing.Name + " (Copy)"; _description = Existing.Description; }
            else if (string.IsNullOrWhiteSpace(_name)) _name = _world.Name;
            _profileName = _world.Name + " Config";
            _action = ProfileOnly ? "new" : Server is null ? "keep" : "";
        }
        catch (JSException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_disposed) { }
        finally { _busy = false; }
    }

    private async Task CommitAsync()
    {
        if (!CanCommit || _module is null) return;
        _busy = true; _error = null; _progress = null; _phase = "Importing world";
        try
        {
            var saved = await _module.InvokeAsync<WorldSaved>("write", _stop.Token, _target.Id, Prefix + "commit", _target,
                new WorldCommit(_name, _description, _action, _profile, _profileName, _profileDescription, ProfileOnly), null, null, null);
            await Saved.InvokeAsync(saved);
        }
        catch (JSException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_disposed) { }
        finally { _busy = false; }
    }

    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            int ticks = 0;
            while (await timer.WaitForNextTickAsync(token))
            {
                if (_busy)
                {
                    try { _progress = await Sdk.RequestAsync<WorldTransferProgress?>(Prefix + "progress", _target, token); }
                    catch (JSException) { }
                }
                else if (_mode == "installed" && _world is null && _installed?.RuntimeReady == false && ++ticks % 5 == 0) await DiscoverAsync();
                else continue;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task CancelTransferAsync() { if (_module is not null) await _module.InvokeVoidAsync("cancel", _target.Id); }
    private Task CloseAsync() => Closed.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _disposed = true; _stop.Cancel();
        try
        {
            if (_module is not null)
            {
                await CancelTransferAsync();
                await _module.DisposeAsync();
            }
            if (_world is not null) await Sdk.RequestAsync<bool>(Prefix + "discard", _target);
        }
        catch (JSException) { }
        catch (OperationCanceledException) { }
        finally { _stop.Dispose(); }
    }
}
