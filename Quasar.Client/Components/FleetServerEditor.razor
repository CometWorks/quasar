    private static string BuildControlledCheckboxColorStyle(Color color)
    {
        var token = color switch
        {
            Color.Primary => "primary",
            Color.Secondary => "secondary",
            Color.Tertiary => "tertiary",
            Color.Info => "info",
            Color.Success => "success",
            Color.Warning => "warning",
            Color.Error => "error",
            Color.Dark => "dark",
            Color.Surface => "surface",
            _ => "warning",
        };

        return $"--server-editor-controlled-checkbox-color: var(--mud-palette-{token});";
    }

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _setup = await LoadOptionsAsync();
            _editor = _setup.Definition;
            _isEditing = UniqueName.Length > 0 && !Clone;
            _isClone = Clone;
            _identifierManuallyEdited = _isEditing || _isClone;
            _editor.OriginalUniqueName = _isEditing ? UniqueName : "";
            await RefreshPathsAsync();
        }
        catch (JSException e) { _error = e.Message; }
    }
    private ValueTask<ServerEditorSetup> LoadOptionsAsync() => JS.InvokeAsync<ServerEditorSetup>("quasarSdk.readJson","quasar.core","fleet.editor",Selection);
    private async Task RefreshPathsAsync()
    {
        int generation = ++_generation;
        _paths = null;
        if (string.IsNullOrWhiteSpace(_editor.UniqueName) || !UniqueNameRegex.IsMatch(_editor.UniqueName)) return;
        try
        {
            var paths = await JS.InvokeAsync<ServerEditorPaths>("quasarSdk.readJson","quasar.core","fleet.editor.paths",ServerPathInput.From(_editor));
            if (generation == _generation) { _paths = paths; _error = null; }
        }
        catch (JSException e) { if (generation == _generation) _error = e.Message; }
    }
