    private async Task OpenCreateWorldSaveFromTemplateDialogAsync()
    {
        if (_setup is null) return;
        var dialog = await DialogService.ShowAsync<FleetChooseTemplate>("Create World Save",
            new DialogParameters<FleetChooseTemplate> { { p => p.InitialTemplate, _editor.WorldTemplateId },
                { p => p.InitialProfile,_editor.ConfigProfileId }, { p => p.Options,_setup } },
            new DialogOptions { CloseOnEscapeKey = true, FullWidth = true,MaxWidth = MaxWidth.Medium });
        if ((await dialog.Result)?.Data is not FleetChooseTemplate.Selection selected) return;
        _creatingWorldSave = true;
        try
        {
            _editor.WorldSaveName = await Sdk.RequestAsync<string>("fleet.editor.world.new",new SaveFromTemplate(ServerPathInput.From(_editor),selected.Template));
            _editor.WorldTemplateId = selected.Template;
            if (!string.IsNullOrEmpty(selected.Profile)) _editor.ConfigProfileId = selected.Profile;
            _setup = await LoadOptionsAsync();
            await RefreshPathsAsync();
            Snackbar.Add($"World save '{_editor.WorldSaveName}' created.",Severity.Success);
        }
        catch (JSException e) { _error = e.Message; }
        finally { _creatingWorldSave = false; }
    }

