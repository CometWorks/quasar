    private async Task ToggleDisableImplicitMagnetarModLoadAsync()
    {
        if (_disableImplicitMagnetarModLoadDialogOpen)
            return;

        if (_editor.DisableImplicitMagnetarModLoad)
        {
            _editor.DisableImplicitMagnetarModLoad = false;
            await RefreshPathsAsync();
            await InvokeAsync(StateHasChanged);
            return;
        }

        _disableImplicitMagnetarModLoadDialogOpen = true;
        try
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                "Disable implicit Magnetar mod load",
                DisableImplicitMagnetarModLoadWarning,
                yesText: "Disable",
                cancelText: "Keep Loading");

            if (confirmed == true)
                _editor.DisableImplicitMagnetarModLoad = true;
        }
        finally
        {
            _disableImplicitMagnetarModLoadDialogOpen = false;
            await RefreshPathsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveAsync()
    {
        if (_busy || _setup is null || _form is null) return;
        _busy = true;
        try
        {
            await HandleDisplayNameBlur(new());
            await RefreshPathsAsync();
            await _form.ValidateAsync();
            if (!_formIsValid) return;
            bool copy = false;
            string? replacement = null;
            if (_isClone)
            {
                var choice = await DialogService.ShowMessageBoxAsync("Clone world state?",
                    _setup.Active ? "Copy from the source server’s latest Space Engineers Backup snapshot, or keep the selected target save?" :
                        "Copy the stopped source server’s world, or keep the selected target save?", yesText:"Copy World",noText:"Keep Save",cancelText:"Cancel");
                if (choice is null) return;
                copy = choice.Value;
                if (copy && _paths?.Available.Any(s => s.Valid && s.Name == _editor.WorldSaveName) == true)
                {
                    replacement = _paths.Selected;
                    if (await DialogService.ShowMessageBoxAsync("Replace existing clone world?", $"Replace the world save at {replacement} with the source world?",
                        yesText:"Replace World",cancelText:"Cancel") != true) return;
                }
            }
            _editor.DisplayName = NormalizeWhitespace(_editor.DisplayName);
            _editor.InGameServerName = NormalizeWhitespace(_editor.InGameServerName);
            _editor.InGameWorldName = NormalizeWhitespace(_editor.InGameWorldName);
            var commit = new ServerEditorCommit(Selection,_setup.Revision,_editor,copy,replacement);
            string result = await JS.InvokeAsync<string>("quasarSdk.uploadJson","quasar.core",
                _isEditing && UniqueName == _editor.UniqueName ? "fleet.editor.update" : "fleet.editor.save", new { },JsonSerializer.Serialize(commit));
            Snackbar.Add(result,Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (JSException e) { _error = e.Message; }
        finally { _busy = false; }
    }

