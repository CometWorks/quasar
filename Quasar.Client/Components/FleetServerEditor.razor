    private async Task HandleDisplayNameChanged(string value)
    {
        _editor.DisplayName = value ?? string.Empty;

        if (_isEditing || _identifierManuallyEdited)
            return;

        _editor.UniqueName = IdentifierSlug.CreateUnique(_editor.DisplayName,"server", name => _setup!.Servers.Any(s => s.UniqueName.Equals(name,StringComparison.OrdinalIgnoreCase)));
        await RefreshPathsAsync();
    }

    private async Task HandleDisplayNameBlur(FocusEventArgs _)
    {
        var displayName = NormalizeWhitespace(_editor.DisplayName);
        if (string.IsNullOrEmpty(displayName))
        {
            displayName = IdentifierSlug.SuggestName("server");
            await HandleDisplayNameChanged(displayName);
        }

        if (string.IsNullOrWhiteSpace(_editor.InGameServerName))
            _editor.InGameServerName = displayName;

        if (string.IsNullOrWhiteSpace(_editor.InGameWorldName))
            _editor.InGameWorldName = displayName;
    }

