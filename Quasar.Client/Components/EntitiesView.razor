@implements IDisposable
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@using Quasar.Client.Operations
@using Quasar.Client.Plugins
@using Quasar.Services
@inject DashboardSdk Sdk
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ViewerTimeZone ViewerTime

<CascadingValue TValue="IReadOnlyList<LoadedExtension>" Value="_extensions">
<BrowserExtensionOutlet TargetKey="quasar.page.entities">
<DashboardPageHeading Section="Operations">
    <Title>Entities</Title>
    <Description>Live world entities for a server or whole cluster. Query grids, characters, dropped items and terrain, then inspect them, or stop, depower, disown and delete them like in the Alt-F10 menu.</Description>
</DashboardPageHeading>

<div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-gap-2 mb-4">
    <MudSelect T="string"
               Label="Server / cluster"
               Value="_selectedTargetId"
               ValueChanged="OnServerChangedAsync"
               Variant="Variant.Outlined"
               Dense="true"
               Disabled="@(TargetOptions.Count == 0 || _deletingSelected)"
               Style="min-width: 16rem;">
        @foreach (var target in TargetOptions)
        {
            <MudSelectItem T="string" Value="@target.Key">@target.DisplayName</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="string"
               Label="Type"
               Value="_typeFilter"
               ValueChanged="OnTypeChangedAsync"
               Variant="Variant.Outlined"
               Dense="true"
               Disabled="@_deletingSelected"
               Style="min-width: 12rem;">
        @foreach (var option in TypeOptions)
        {
            <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
        }
    </MudSelect>

    <MudTextField T="string"
                  Value="_searchText"
                  ValueChanged="OnSearchChanged"
                  Label="Search name / id / owner"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Immediate="true"
                  Disabled="@_deletingSelected"
                  Style="min-width: 16rem;" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadAsync"
               Disabled="@(_loading || _deletingSelected || GetSelectedTarget() is null)">
        Refresh
    </MudButton>
</div>

<div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-gap-2 mb-4">
    @if (_lastResult is not null)
    {
        <MudChip T="string" Variant="Variant.Outlined">Matching @_lastResult.TotalCount</MudChip>
        <MudChip T="string" Variant="Variant.Outlined">Shown @FilteredEntities.Count</MudChip>
        @if (_lastResult.TotalEntityCount is { } total)
        {
            <MudChip T="string" Variant="Variant.Outlined">Live total @total</MudChip>
        }
        @if (IsClusterSelected)
        {
            <MudChip T="string" Variant="Variant.Outlined">Nodes checked @_lastResult.QueriedNodes / @_lastResult.ExpectedNodes</MudChip>
        }
    }
    @if (_lastUpdated is not null)
    {
        <span class="quasar-text quasar-type-caption">Last updated: @ViewerTime.Format(_lastUpdated.Value)</span>
    }
    @if (_lastResult is not null)
    {
        <MudChip T="string" Variant="Variant.Outlined" Color="@(_selectedEntityIds.Count > 0 ? Color.Primary : Color.Default)">
            Selected @_selectedEntityIds.Count
        </MudChip>
        <MudTooltip Text="Select all entities shown by the current filters">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.SelectAll"
                       OnClick="SelectFilteredEntities"
                       Disabled="@(_loading || _deletingSelected || FilteredEntities.Count == 0)">
                Select shown
            </MudButton>
        </MudTooltip>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="ClearSelection"
                   Disabled="@(_loading || _deletingSelected || _selectedEntityIds.Count == 0)">
            Clear
        </MudButton>
        @if (_targets?.CanControl == true && (!IsClusterSelected || _targets.CanManageClusters))
        {
        <MudTooltip Text="Select only entities with a verified owning node to delete.">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="DeleteSelectedEntitiesAsync"
                   Disabled="@(!CanDeleteSelected)">
            Delete selected
        </MudButton>
        </MudTooltip>
        <MudMenu Label="Act on selected"
                 StartIcon="@Icons.Material.Filled.PlaylistPlay"
                 EndIcon="@Icons.Material.Filled.ArrowDropDown"
                 Variant="Variant.Outlined"
                 Color="Color.Primary"
                 Dense="true"
                 Disabled="@(_loading || _deletingSelected || _selectedEntityIds.Count == 0)">
            @foreach (var choice in ActionChoices)
            {
                <MudMenuItem Icon="@choice.Icon"
                             Disabled="@(!CanActOnSelected(choice.Action))"
                             OnClick="@(() => RunSelectedEntityActionAsync(choice.Action))">@choice.Label</MudMenuItem>
            }
        </MudMenu>
        }
    }
</div>
@if (_loading)
{
    <section role="status"><span>@_loadMessage</span><progress aria-label="Loading entities"></progress></section>
    <MudButton Variant="Variant.Outlined" OnClick="CancelLoad">Cancel</MudButton>
}
@if (_lastResult is { Warnings.Count: > 0 })
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        <strong>Partial cluster view.</strong>
        @foreach (var warning in _lastResult.Warnings.Distinct())
        {
            <p>@warning</p>
        }
    </MudAlert>
}
@if (IsClusterSelected)
{
    <p class="quasar-text quasar-type-caption">One row per entity across the cluster. Shared copies are combined. This live view includes loaded entities on responding nodes; entities in offline partitions are not listed.</p>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else if (TargetOptions.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No connected servers. Entities can only be listed for a server with a live Quasar agent.
    </MudAlert>
}
else if (GetSelectedTarget() is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        The selected server is no longer connected. Pick another server above.
    </MudAlert>
}
else if (_lastResult is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Select a server and press Refresh to load the live entity list.
    </MudAlert>
}
else if (FilteredEntities.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No entities match the current filter.
    </MudAlert>
}
else
{
    <MudTable T="EntitySummary"
              @ref="_entityTable"
              Items="FilteredEntities"
              Dense="true"
              Hover="true"
              Breakpoint="Breakpoint.Md"
              FixedHeader="true"
              Height="60vh"
              OnRowClick="HandleRowClick"
              RowClassFunc="GetEntityRowClass">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<EntitySummary, object>(e => e.Name)">Name</MudTableSortLabel></MudTh>
            <MudTh>Type</MudTh>
            @if (IsClusterSelected) { <MudTh>Node(s)</MudTh> }
            <BrowserExtensionOutlet TargetKey="quasar.entities.viewer-column-header" />
            <MudTh>Details</MudTh>
            <MudTh>Quantity</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<EntitySummary, object>(e => e.BlockCount ?? -1)">Blocks</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<EntitySummary, object>(e => e.Pcu ?? -1)">PCU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<EntitySummary, object>(e => e.SizeMeters)">Size (m)</MudTableSortLabel></MudTh>
            <MudTh>Owner</MudTh>
            <MudTh>Position</MudTh>
            <MudTh>Entity ID</MudTh>
            <MudTh Class="quasar-actions-column"><span class="quasar-visually-hidden">Actions</span></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Type">
                <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.TypeTag)" Variant="Variant.Outlined">@context.TypeLabel</MudChip>
            </MudTd>
            @if (IsClusterSelected)
            {
                <MudTd DataLabel="Node(s)">@GetEntityRow(context)?.NodeLabel</MudTd>
            }
            <BrowserExtensionOutlet
                TargetKey="quasar.entities.viewer-column-cell"
                Parameters="@CreateEntityExtensionParameters(context)" />
            <MudTd DataLabel="Details">@context.Details</MudTd>
            <MudTd DataLabel="Quantity">@(context.Quantity?.ToString("0.######") ?? "—")</MudTd>
            <MudTd DataLabel="Blocks">@(context.BlockCount?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="PCU">@(context.Pcu?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="Size (m)">@context.SizeMeters.ToString("0")</MudTd>
            <MudTd DataLabel="Owner">@FormatOwner(context)</MudTd>
            <MudTd DataLabel="Position" Class="mono">@FormatPosition(context)</MudTd>
            <MudTd DataLabel="Entity ID">
                <p class="quasar-text quasar-type-body2 mono">@context.EntityId</p>
            </MudTd>
            <MudTd DataLabel="" Class="quasar-actions-column">
                <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-1 plugin-actions" @onclick:stopPropagation="true">
                    <BrowserExtensionOutlet
                        TargetKey="quasar.component.entity-actions"

                        Parameters="@CreateEntityExtensionParameters(context)">
                        @if (_targets?.CanControl == true && (!IsClusterSelected || _targets.CanManageClusters))
        {
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="@(DeleteUnavailableReason(context) ?? "Delete entity")">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Disabled="@(_loading || _deletingSelected || DeleteUnavailableReason(context) is not null)"
                                               OnClick="@(() => DeleteEntityAsync(context))" />
                            </MudTooltip>
                            <MudMenu Dense="true"
                                     Icon="@Icons.Material.Filled.MoreVert"
                                     Size="Size.Small"
                                     AriaLabel="Entity actions"
                                     Disabled="@(_loading || _deletingSelected)"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight">
                                @foreach (var choice in ActionChoices)
                                {
                                    var reason = ActionUnavailableReason(context, choice.Action);
                                    <MudMenuItem Icon="@choice.Icon"
                                                 Disabled="@(reason is not null)"
                                                 title="@(reason ?? choice.Hint)"
                                                 OnClick="@(() => RunEntityActionAsync(context, choice.Action))">@choice.Label</MudMenuItem>
                                }
                            </MudMenu>
                        </span>
                        }
                    </BrowserExtensionOutlet>
                </div>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 25, 50, 100, 250 }" />
        </PagerContent>
    </MudTable>
}
</BrowserExtensionOutlet>
</CascadingValue>

@code
{
    private static readonly (string Value, string Label)[] TypeOptions =
    {
        ("All", "All types"),
        ("Grid", "Grids"),
        ("Character", "Characters"),
        ("Float", "Dropped items"),
        ("Voxel", "Terrain (asteroids / planets)"),
        ("Other", "Other entities"),
    };

    private string? _selectedTargetId;
    private string _typeFilter = "All";
    private string _searchText = string.Empty;
    private IReadOnlyList<EntitySummary> _entities = Array.Empty<EntitySummary>();
    private readonly HashSet<long> _selectedEntityIds = new();
    private MudTable<EntitySummary>? _entityTable;
    private EntityQueryResult? _lastResult;
    private Dictionary<long, EntityQueryRow> _rowsById = [];
    private CancellationTokenSource? _loadCts;
    private string _loadMessage = string.Empty;
    private EntityTargets? _targets;
    private IReadOnlyList<LoadedExtension> _extensions = [];
    private static readonly string[] ExtensionTargets = ["quasar.page.entities", "quasar.component.entity-actions", "quasar.entities.viewer-column-header", "quasar.entities.viewer-column-cell"];
    private readonly CancellationTokenSource _lifetime = new();
    private HashSet<string> _liveOwners = [];
    private DateTimeOffset? _lastUpdated;
    private long? _selectionAnchorEntityId;
    private bool _loading;
    private bool _deletingSelected;
    private bool _disposed;
    private string? _error;

    private List<EntitySummary> FilteredEntities => _entities
        .Where(MatchesSearch)
        .ToList();

    private IReadOnlyList<EntityTarget> TargetOptions => _targets?.Targets ?? [];
    private bool IsClusterSelected => GetSelectedTarget()?.IsCluster == true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshAccessAsync();
            _extensions = await BrowserExtensions.LoadAsync(Sdk, Navigation, ExtensionTargets, _lifetime.Token);
            _selectedTargetId = TargetOptions.FirstOrDefault()?.Key;
            if (_selectedTargetId is not null) await LoadAsync();
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception ex) { _error = ex.Message; }
        if (!_disposed) _ = PollTargetsAsync();
    }

    private async Task PollTargetsAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                try
                {
                    await RefreshAccessAsync();
                    _selectedTargetId ??= TargetOptions.FirstOrDefault()?.Key;
                    await InvokeAsync(StateHasChanged);
                }
                catch (JSException) { /* Keep the current table during a transient disconnection. */ }
            }
        }
        catch (OperationCanceledException) when (_disposed) { }
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
        _loadCts?.Cancel();
    }

    private async Task OnServerChangedAsync(string targetId)
    {
        _selectedTargetId = targetId;
        ClearSelection();
        await LoadAsync();
    }

    private async Task OnTypeChangedAsync(string typeTag)
    {
        _typeFilter = typeTag;
        ClearSelection();
        await LoadAsync();
    }

    private void OnSearchChanged(string searchText)
    {
        _searchText = searchText ?? string.Empty;
        PruneSelectionToFilteredEntities();
    }

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        using var cts = new CancellationTokenSource();
        _loadCts = cts;
        _entities = [];
        _rowsById.Clear();
        _lastResult = null;
        _lastUpdated = null;
        ClearSelection();
        _loading = true;
        _error = null;
        _loadMessage = "Querying live world entities…";
        StateHasChanged();
        try
        {
            await RefreshAccessAsync();
            if (!ReferenceEquals(_loadCts, cts) || cts.IsCancellationRequested)
                return;
            var target = GetSelectedTarget();
            if (target is null)
                return;
            var result = await JS.InvokeAsync<EntityQueryResult>("quasarSdk.readJson", cts.Token,
                "quasar.core", "entities.table", new { target.Key, Type = _typeFilter });
            if (!ReferenceEquals(_loadCts, cts) || cts.IsCancellationRequested)
                return;
            _lastResult = result;
            _rowsById = result.Rows.ToDictionary(row => row.Entity.EntityId);
            _entities = result.Rows.Select(row => row.Entity).ToArray();
            _lastUpdated = result.CapturedAtUtc;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (ReferenceEquals(_loadCts, cts))
                _error = exception.Message;
        }
        finally
        {
            if (ReferenceEquals(_loadCts, cts))
            {
                _loadCts = null;
                _loading = false;
                if (!_disposed)
                    StateHasChanged();
            }
        }
    }

    private void CancelLoad() => _loadCts?.Cancel();

    private bool CanDeleteSelected => GetSelectedTarget() is not null
                                      && !_loading
                                      && !_deletingSelected
                                      && _selectedEntityIds.Count > 0
                                      && _selectedEntityIds.All(id => _rowsById.TryGetValue(id, out var row)
                                          && DeleteUnavailableReason(row.Entity) is null);

    private async Task DeleteSelectedEntitiesAsync()
    {
        if (!await CanControlSelectionAsync()) return;
        var target = GetSelectedTarget();
        if (target is null)
        {
            Snackbar.Add("The selected server is not connected.", Severity.Error);
            return;
        }

        var selectedRows = _entities
            .Where(entity => _selectedEntityIds.Contains(entity.EntityId))
            .Select(GetEntityRow).OfType<EntityQueryRow>()
            .ToList();

        if (selectedRows.Count == 0)
        {
            ClearSelection();
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete selected entities",
            $"Permanently delete {selectedRows.Count} selected entities? This cannot be undone.",
            yesText: "Delete selected",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        _deletingSelected = true;
        StateHasChanged();

        var deletedCount = 0;
        var failedMessages = new List<string>();

        try
        {
            foreach (var row in selectedRows)
            {
                var entity = row.Entity;
                try
                {
                    if (!await CanControlEntityAsync(row)) break;
                    var result = await ChangeAsync(row, null);
                    if (result.Success)
                    {
                        deletedCount++;
                    }
                    else
                    {
                        failedMessages.Add(string.IsNullOrWhiteSpace(result.Message)
                            ? $"#{entity.EntityId}: Delete failed."
                            : $"#{entity.EntityId}: {result.Message}");
                    }
                }
                catch (Exception exception)
                {
                    failedMessages.Add($"#{entity.EntityId}: {exception.Message}");
                }
            }
        }
        finally
        {
            _deletingSelected = false;
        }

        if (deletedCount > 0)
        {
            Snackbar.Add($"Deleted {deletedCount} selected entities.", Severity.Success);
            ClearSelection();
            await LoadAsync();
        }

        if (failedMessages.Count > 0)
        {
            Snackbar.Add($"Failed to delete {failedMessages.Count} selected entities. First error: {failedMessages[0]}", Severity.Error);
        }

        StateHasChanged();
    }

    private async Task DeleteEntityAsync(EntitySummary entity)
    {
        if (!await CanControlSelectionAsync()) return;
        var target = GetSelectedTarget();
        if (target is null)
        {
            Snackbar.Add("The selected server is not connected.", Severity.Error);
            return;
        }
        var row = GetEntityRow(entity);
        if (row is null)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete entity",
            $"Permanently delete \"{entity.DisplayName}\" (#{entity.EntityId})? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            if (!await CanControlEntityAsync(row)) return;
            var result = await ChangeAsync(row, null);
            if (result.Success)
            {
                Snackbar.Add(string.IsNullOrWhiteSpace(result.Message) ? "Entity deleted." : result.Message, Severity.Success);
                _selectedEntityIds.Remove(entity.EntityId);
                if (_selectionAnchorEntityId == entity.EntityId)
                    _selectionAnchorEntityId = null;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(string.IsNullOrWhiteSpace(result.Message) ? "Delete failed." : result.Message, Severity.Error);
            }
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private sealed record ActionChoice(EntityAction Action, string Label, string Icon, string Hint);

    // The Alt-F10 Entity List row actions, with the in-game semantics.
    private static readonly ActionChoice[] ActionChoices =
    [
        new(EntityAction.Stop, "Stop", Icons.Material.Filled.PanTool,
            "Stops the entity and every grid physically connected to it."),
        new(EntityAction.Depower, "Depower", Icons.Material.Filled.PowerOff,
            "Turns off the power producers of the grid and of every grid connected to it, docked ships included."),
        new(EntityAction.PowerOn, "Power on", Icons.Material.Filled.Power,
            "Turns the power producers of the grid and of every grid connected to it back on."),
        new(EntityAction.RemoveOwner, "Remove owner", Icons.Material.Filled.PersonOff,
            "Gives every block of the grid and its subgrids to nobody. This cannot be undone."),
    ];

    private string? ActionUnavailableReason(EntitySummary entity, EntityAction action)
    {
        if (action == EntityAction.Stop ? entity.TypeTag == "Voxel" : entity.TypeTag != "Grid")
            return action == EntityAction.Stop ? "Terrain does not move." : "Only grids have power and block owners.";
        return DeleteUnavailableReason(entity);
    }

    private bool CanActOnSelected(EntityAction action) => GetSelectedTarget() is not null
                                                          && !_loading
                                                          && !_deletingSelected
                                                          && _selectedEntityIds.Count > 0
                                                          && _selectedEntityIds.All(id => _rowsById.TryGetValue(id, out var row)
                                                              && ActionUnavailableReason(row.Entity, action) is null);

    private Task RunEntityActionAsync(EntitySummary entity, EntityAction action) => RunActionAsync([entity], action, false);

    private Task RunSelectedEntityActionAsync(EntityAction action) =>
        RunActionAsync(_entities.Where(entity => _selectedEntityIds.Contains(entity.EntityId)).ToList(), action, true);

    private async Task RunActionAsync(IReadOnlyList<EntitySummary> entities, EntityAction action, bool selection)
    {
        if (!await CanControlSelectionAsync()) return;
        var rows = entities.Select(GetEntityRow).OfType<EntityQueryRow>().ToList();
        if (rows.Count == 0)
            return;

        var choice = ActionChoices.Single(candidate => candidate.Action == action);
        if (action != EntityAction.Stop || selection)
        {
            var subject = selection ? $"the {rows.Count} selected entities" : $"\"{rows[0].Entity.DisplayName}\" (#{rows[0].Entity.EntityId})";
            var confirmed = await DialogService.ShowMessageBoxAsync(choice.Label, $"{choice.Label} {subject}? {choice.Hint}",
                yesText: choice.Label, cancelText: "Cancel");
            if (confirmed != true)
                return;
        }

        _deletingSelected = selection;
        var done = 0;
        string? lastMessage = null;
        var failedMessages = new List<string>();
        try
        {
            foreach (var row in rows)
            {
                try
                {
                    if (!await CanControlEntityAsync(row)) break;
                    var result = await ChangeAsync(row, action);
                    if (result.Success)
                    {
                        done++;
                        lastMessage = result.Message;
                    }
                    else
                    {
                        failedMessages.Add($"#{row.Entity.EntityId}: {(string.IsNullOrWhiteSpace(result.Message) ? choice.Label + " failed." : result.Message)}");
                    }
                }
                catch (Exception exception)
                {
                    failedMessages.Add($"#{row.Entity.EntityId}: {exception.Message}");
                }
            }
        }
        finally
        {
            _deletingSelected = false;
        }

        if (done > 0)
            Snackbar.Add(rows.Count == 1 && !string.IsNullOrWhiteSpace(lastMessage) ? lastMessage : $"{choice.Label}: done for {done} of {rows.Count} entities.", Severity.Success);
        if (failedMessages.Count > 0)
            Snackbar.Add(rows.Count == 1 ? failedMessages[0] : $"{choice.Label} failed for {failedMessages.Count} entities. First error: {failedMessages[0]}", Severity.Error);
        if (action == EntityAction.RemoveOwner && done > 0)
            await LoadAsync();
        StateHasChanged();
    }

    private void HandleRowClick(TableRowClickEventArgs<EntitySummary> args)
    {
        var entity = args.Item;
        if (entity is null)
            return;

        var additive = args.MouseEventArgs.CtrlKey || args.MouseEventArgs.MetaKey;
        var range = args.MouseEventArgs.ShiftKey;

        if (range && _selectionAnchorEntityId is { } anchorId)
        {
            SelectRange(anchorId, entity.EntityId, additive);
        }
        else if (additive)
        {
            ToggleSelection(entity.EntityId);
        }
        else
        {
            _selectedEntityIds.Clear();
            _selectedEntityIds.Add(entity.EntityId);
        }

        _selectionAnchorEntityId = entity.EntityId;
    }

    private void SelectRange(long anchorEntityId, long targetEntityId, bool additive)
    {
        var visibleEntities = GetSelectionOrder();
        var anchorIndex = visibleEntities.FindIndex(entity => entity.EntityId == anchorEntityId);
        var targetIndex = visibleEntities.FindIndex(entity => entity.EntityId == targetEntityId);

        if (anchorIndex < 0 || targetIndex < 0)
        {
            if (!additive)
                _selectedEntityIds.Clear();

            _selectedEntityIds.Add(targetEntityId);
            return;
        }

        if (!additive)
            _selectedEntityIds.Clear();

        var start = Math.Min(anchorIndex, targetIndex);
        var end = Math.Max(anchorIndex, targetIndex);
        for (var i = start; i <= end; i++)
            _selectedEntityIds.Add(visibleEntities[i].EntityId);
    }

    private void ToggleSelection(long entityId)
    {
        if (!_selectedEntityIds.Add(entityId))
            _selectedEntityIds.Remove(entityId);
    }

    private void SelectFilteredEntities()
    {
        var visibleEntities = FilteredEntities;
        _selectedEntityIds.Clear();

        foreach (var entity in visibleEntities)
            _selectedEntityIds.Add(entity.EntityId);

        _selectionAnchorEntityId = visibleEntities.LastOrDefault()?.EntityId;
    }

    private List<EntitySummary> GetSelectionOrder()
    {
        return (_entityTable?.FilteredItems ?? FilteredEntities).ToList();
    }

    private void ClearSelection()
    {
        _selectedEntityIds.Clear();
        _selectionAnchorEntityId = null;
    }

    private void PruneSelectionToFilteredEntities()
    {
        var visibleIds = FilteredEntities.Select(entity => entity.EntityId).ToHashSet();
        _selectedEntityIds.RemoveWhere(entityId => !visibleIds.Contains(entityId));

        if (_selectionAnchorEntityId is { } anchorId && !visibleIds.Contains(anchorId))
            _selectionAnchorEntityId = null;
    }

    private string GetEntityRowClass(EntitySummary entity, int rowNumber)
    {
        return _selectedEntityIds.Contains(entity.EntityId)
            ? "entity-row-selectable quasar-row-selected"
            : "entity-row-selectable";
    }

    private EntityTarget? GetSelectedTarget() => TargetOptions.FirstOrDefault(target => target.Key == _selectedTargetId);

    private EntityQueryRow? GetEntityRow(EntitySummary entity) => _rowsById.GetValueOrDefault(entity.EntityId);

    private string? GetEntityAgent(EntitySummary entity)
    {
        var row = GetEntityRow(entity);
        if (row is null) return null;
        if (_liveOwners.Contains(row.AgentId + "\u001f" + row.TelemetryKey)) return row.AgentId;
        var observer = row.Observers.FirstOrDefault(_liveOwners.Contains);
        return observer?.Split('\u001f')[0];
    }

    private string? DeleteUnavailableReason(EntitySummary entity)
    {
        var row = GetEntityRow(entity);
        if (row is null) return "Refresh the entity list first.";
        return row.DeleteUnavailableReason ?? (_liveOwners.Contains(row.AgentId + "\u001f" + row.TelemetryKey)
            ? null : "The entity's node disconnected or was replaced. Refresh first.");
    }

    private Task<bool> CanControlSelectionAsync() => Task.FromResult(_targets?.CanControl == true && (!IsClusterSelected || _targets.CanManageClusters));

    private async Task RefreshAccessAsync()
    {
        _targets = await Sdk.RequestAsync<EntityTargets>("entities.targets", token: _lifetime.Token);
        _liveOwners = _targets.LiveOwners.ToHashSet(StringComparer.Ordinal);
    }

    private Task<bool> CanControlEntityAsync(EntityQueryRow row) => Task.FromResult(DeleteUnavailableReason(row.Entity) is null);
    private sealed record ChangeResult(string Message) { public bool Success => true; }

    private Task<ChangeResult> ChangeAsync(EntityQueryRow row, EntityAction? action)
    {
        var target = GetSelectedTarget() ?? throw new InvalidOperationException("Select a connected server.");
        var operation = (target.IsCluster ? "cluster.entities." : "entities.") + (action is null ? "delete" : "action");
        return Sdk.RequestAsync<ChangeResult>(operation, new
        {
            target.UniqueName, EntityId = row.Entity.EntityId.ToString(System.Globalization.CultureInfo.InvariantCulture), Action = action?.ToString(),
            ExpectedAgentId = row.AgentId, ExpectedTelemetryKey = row.TelemetryKey,
        }, _lifetime.Token);
    }

    private bool CanViewEntity(EntitySummary entity)
    {
        return GetEntityAgent(entity) is not null
               && (string.Equals(entity.TypeTag, "Grid", StringComparison.OrdinalIgnoreCase)
                   || (string.Equals(entity.TypeTag, "Voxel", StringComparison.OrdinalIgnoreCase)
                       && string.Equals(entity.SubType, "Asteroid", StringComparison.OrdinalIgnoreCase)));
    }

    private IReadOnlyDictionary<string, object?> CreateEntityExtensionParameters(EntitySummary entity)
    {
        var agent = GetEntityAgent(entity);
        var canView = CanViewEntity(entity);
        return new Dictionary<string, object?>
        {
            ["AgentId"] = agent,
            ["ServerName"] = GetSelectedTarget()?.DisplayName,
            ["EntityId"] = entity.EntityId,
            ["EntityType"] = entity.TypeTag,
            ["EntitySubType"] = entity.SubType,
            ["EntityDisplayName"] = entity.DisplayName,
            ["OwnerSteamId"] = entity.OwnerSteamId,
            ["CanViewEntity"] = canView,
        };
    }

    private bool MatchesSearch(EntitySummary entity)
    {
        var search = _searchText?.Trim();
        if (string.IsNullOrWhiteSpace(search))
            return true;

        return Contains(entity.DisplayName, search)
               || Contains(entity.SubType, search)
               || Contains(entity.TypeLabel, search)
               || Contains(entity.Details, search)
               || Contains(entity.Name, search)
               || Contains(entity.OwnerName, search)
               || entity.EntityId.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
               || (entity.OwnerSteamId?.ToString().Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private static bool Contains(string? value, string search)
    {
        return !string.IsNullOrWhiteSpace(value)
               && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatOwner(EntitySummary entity)
    {
        if (!string.IsNullOrWhiteSpace(entity.OwnerName))
            return entity.OwnerName;

        return entity.OwnerSteamId is { } steamId && steamId != 0
            ? steamId.ToString()
            : "-";
    }

    private static string FormatPosition(EntitySummary entity)
    {
        return entity.Position;
    }

    private static Color GetTypeColor(string typeTag)
    {
        return typeTag switch
        {
            "Grid" => Color.Primary,
            "Character" => Color.Success,
            "Float" => Color.Warning,
            "Voxel" => Color.Info,
            _ => Color.Default,
        };
    }
}
