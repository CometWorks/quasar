@using Microsoft.JSInterop
@using MudBlazor
@using Quasar.Services.Discord
@inject DashboardSdk Sdk
@inject IJSRuntime JS
<MudDialog>
    <DialogContent>
        <div class="quasar-layout quasar-layout-row quasar-align-center quasar-justify-spacebetween quasar-gap-3 mb-2">
            <div class="quasar-layout quasar-gap-0">
                <p class="quasar-text quasar-type-body2 quasar-text-secondary">@DiscordLogStatusText()</p>
                <span>@_logPath</span><MudButton Size="Size.Small" OnClick="CopyPathAsync">Copy path</MudButton>
            </div>
            <div class="quasar-layout quasar-layout-row quasar-gap-1">
                <MudTooltip Text="Download full Discord log">
                    <MudIconButton Icon="@Icons.Material.Filled.Download" OnClick="DownloadLogAsync" Disabled="@(!_loaded || _missing)" Size="Size.Small" />
                </MudTooltip>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Search" OnClick="ShowExceptionsAsync">Exceptions</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync">Refresh</MudButton>
            </div>
        </div>

        @if (_missing)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Discord log not found yet. Start or save the Discord integration so Quasar can write Discord-side events.
            </MudAlert>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
        }
        else
        {
            <div id="@_scrollContainerId" class="quasar-console-output quasar-console-output-discord">
                <pre class="quasar-info-log-pre">@_content</pre>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly string _scrollContainerId = $"quasar-discord-log-{Guid.NewGuid():N}";
    private string _content = string.Empty;
    private string _logPath = string.Empty;
    private int _lineCount;
    private bool _truncated;
    private bool _missing;
    private string? _error;
    private bool _loaded;
    private bool _scrollPending;
    private string _mode = "tail";

    private async Task CopyPathAsync() => await JS.InvokeVoidAsync("quasarConfigs.copyText", _logPath);
    private Task DownloadLogAsync() => Sdk.DownloadAsync("logs.discord.read", new { });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loaded)
        {
            await LoadAsync();
            return;
        }

        if (_scrollPending)
        {
            _scrollPending = false;
            await ScrollToBottomAsync();
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("quasarConfigs.scrollToBottom", _scrollContainerId);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();
    }

    private async Task ShowExceptionsAsync()
    {
        await LoadExceptionsAsync();
    }

    private Task LoadAsync() => LoadExcerptAsync(false);
    private Task LoadExceptionsAsync() => LoadExcerptAsync(true);

    private async Task LoadExcerptAsync(bool exceptions)
    {
        try
        {
            var result = await JS.InvokeAsync<DiscordLogExcerpt>("quasarSdk.readJson", "quasar.core", "discord.log.excerpt", new { exceptions });
            _logPath = result.Path;
            _missing = result.Missing;
            _content = result.Text;
            _lineCount = CountLines(_content);
            _truncated = result.Truncated;
            _error = null;
            _mode = exceptions ? "exceptions" : "tail";
        }
        catch (JSException ex) { _error = ex.Message; _missing = false; }
        _loaded = true;
        _scrollPending = true;
        StateHasChanged();
    }

    private string DiscordLogStatusText()
    {
        if (_missing)
            return "Discord log not found yet.";

        return _mode == "exceptions"
            ? $"{_lineCount} line(s) from latest exception excerpts{(_truncated ? " (searched latest log tail)" : string.Empty)}"
            : $"{_lineCount} line(s){(_truncated ? " (tail only)" : string.Empty)}";
    }

    private static int CountLines(string text)
    {
        if (string.IsNullOrEmpty(text))
            return 0;

        var count = 1;
        foreach (var c in text)
        {
            if (c == '\n')
                count++;
        }

        if (text.EndsWith('\n'))
            count--;

        return count;
    }

    private void Close() => MudDialog.Close();
}
