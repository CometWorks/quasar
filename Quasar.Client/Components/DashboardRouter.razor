@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

@using System.Reflection
@using Quasar.Client.Plugins
@inject NavigationManager Navigation
@inject DashboardSdk Sdk

@if (_error is not null)
{
    <p role="alert">@_error</p><button type="button" @onclick="LoadAsync">Retry loading dashboard</button>
}
@if (_ready && _access is not null)
{
<Router AdditionalAssemblies="_assemblies" AppAssembly="typeof(DashboardRouter).Assembly" NotFoundPage="typeof(DashboardExternalRoute)">
    <Found Context="route">
        <DashboardRouteContent Route="route" Access="_access" />
        <FocusOnNavigate RouteData="route" Selector="h1, h2" />
    </Found>
</Router>
}

@code {
    [Parameter] public string? InitialAssemblyName { get; set; }
    [Parameter] public BrowserPluginAssembly[] PluginPages { get; set; } = [];
    private Assembly[] _assemblies = [];
    private bool _ready;
    private DashboardAccess? _access;
    private string? _error;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _error = null;
        try { _access = await Sdk.GetAccessAsync(); }
        catch (Microsoft.JSInterop.JSException error) { _error = error.Message; return; }
        var assemblies = new List<Assembly>();
        var failures = new List<string>();
        bool ready = true;
        foreach (var plugin in PluginPages)
        {
            try { assemblies.Add(await BrowserExtensions.LoadAssemblyAsync(plugin, Navigation.BaseUri, default)); }
            catch (Exception error)
            {
                failures.Add($"{plugin.PluginId}: {error.Message}");
                if (plugin.AssemblyName == InitialAssemblyName) ready = false;
            }
        }
        _assemblies = assemblies.ToArray();
        _ready = ready;
        _error = failures.Count == 0 ? null : string.Join(" ", failures);
    }
}
