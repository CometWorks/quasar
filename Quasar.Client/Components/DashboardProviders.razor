@using Microsoft.JSInterop
@inject IJSRuntime JS
@using MudBlazor
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("quasarSdk.dashboardReady");
    }
}
