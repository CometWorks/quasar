@using Microsoft.JSInterop
@using MudBlazor
@using Quasar.Components.Shared
@using Quasar.Models
@using Quasar.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Mud providers remain during the migration. The native dialog and toast
   hosts live beside them, not inside them, so the two stacks coexist without
   sharing state or markup. Both hosts are outside the routed page. *@
<MudThemeProvider Theme="_theme" IsDarkMode="_dark" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<QuasarDialogHost />
<QuasarToastHost />

@code {
    [Parameter, EditorRequired] public BrandingSettings Branding { get; set; } = default!;
    private MudTheme _theme = default!;
    private bool _dark = true;
    private DotNetObjectReference<QuasarThemeProvider>? _listener;

    protected override void OnInitialized() => _theme = QuasarTheme.Create(Branding);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _listener = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("quasarSdk.watchTheme", _listener);
        await JS.InvokeVoidAsync("quasarSdk.dashboardReady");
    }

    [JSInvokable]
    public Task ApplyTheme(bool dark, BrandingSettings? branding)
    {
        if (branding is not null) _theme = QuasarTheme.Create(branding);
        _dark = dark;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_listener is null) return;
        try { await JS.InvokeVoidAsync("quasarSdk.watchTheme", (object?)null); }
        finally { _listener.Dispose(); }
    }
}
