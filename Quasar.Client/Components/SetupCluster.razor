@using MudBlazor
@using Microsoft.JSInterop
@using Quasar.Client.Fleet
@using Quasar.Services
@implements IDisposable
@inject DashboardSdk Sdk
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDialogService Dialogs

<BrowserClusterNotice />
<section class="quasar-panel server-card"><div class="quasar-card-content">
    <DashboardPageHeading Section="Infrastructure">
    <Title>Set up cluster</Title>
    <Description>Configure hosts, worlds, and capacity for a new cluster.</Description>
</DashboardPageHeading>
    <MudTabs KeepPanelsAlive="true" ActivePanelIndex="@(Register ? 1 : 0)">
        <MudTabPanel Text="Create and deploy">
            <MudStepper @bind-ActiveIndex="_setupStep" NonLinear="true" Vertical="true">
                <ChildContent>
                    <MudStep Title="Host enrollment" Disabled="_busy" Completed="HasConnectedHosts">
                        <div class="quasar-layout quasar-gap-3">
                            <p class="quasar-text quasar-type-body1">Use an available host machine, or add one for your cluster.</p>
                            @if (_state?.HostError is not null) { <MudAlert Severity="Severity.Warning">@_state?.HostError</MudAlert> }
                            @foreach (var machine in _machines)
                            {
                                <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-2">
                                    <p class="quasar-text quasar-type-body1">@machine.Host.Name (@machine.Host.Address)</p>
                                    <MudChip T="string" Size="Size.Small" Color="@(machine.Connected ? Color.Success : Color.Warning)">@(machine.Connected ? "Connected" : "Offline")</MudChip>
                                </div>
                            }
                            @if (_state?.Enroll == true)
                            {
                                    <MudExpansionPanels>
                                        <MudExpansionPanel Text="Add host machine" @bind-Expanded="_showEnrollment">
                                            <HostEnrollmentForm />
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                }
                            else
                            {
                                    <MudAlert Severity="Severity.Info">A security administrator must enroll host machines. You can continue with an existing connected host machine.</MudAlert>
                                }
                            @if (!HasConnectedHosts) { <MudAlert Severity="Severity.Info">Waiting for a host machine to connect. You can continue when a machine shows Connected.</MudAlert> }
                        </div>
                    </MudStep>
                    <MudStep Title="Configure and deploy" Disabled="@(_busy || !HasConnectedHosts && _request is null)">
                        <div class="quasar-layout quasar-gap-3 pt-4">
                            <p class="quasar-text quasar-type-body1">Quasar downloads the verified cluster release, prepares identical plugins and configuration, copies your world, and deploys it to the selected host machines. The finished cluster remains stopped until you choose Start.</p>
                            <MudTextField T="string" Label="Cluster ID" @bind-Value="_id" Disabled="Locked" HelperText="A permanent ID for stored data, using letters, numbers, hyphens or underscores. Removed IDs cannot be reused." />
                            <MudTextField T="string" Label="Server name" @bind-Value="_name" OnBlur="@(_ => EnsureNames())" Disabled="Locked" HelperText="The name shown to players and in Quasar. A blank name receives an editable generated suggestion." />
                            <MudSelect T="string" Label="World template" @bind-Value="_world" Disabled="Locked" HelperText="Quasar converts a copy. The original template is preserved.">
                                @foreach (var world in _state?.Worlds ?? []) { <MudSelectItem Value="world.Id">@world.Name</MudSelectItem> }
                            </MudSelect>
                            <MudSelect T="string" Label="Configuration profile" @bind-Value="_profile" Disabled="Locked" HelperText="Game settings, mods and plugin selection. New clusters start with the selected plugins' SDK defaults, shared across every node.">
                                @foreach (var profile in _state?.Profiles ?? []) { <MudSelectItem Value="profile.Id">@profile.Name</MudSelectItem> }
                            </MudSelect>
                            <MudCheckBox T="bool" @bind-Value:get="_defaultPlugins" @bind-Value:set="SetDefaultPluginsAsync" Disabled="@(Locked || _confirmingDefaultPlugins)" Label="Enable the Bugfixes and Performance server plugins (recommended)" />
                            <MudAlert Severity="@(_defaultPlugins ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Dense="true">@DefaultPluginsRisk</MudAlert>
                            <p class="quasar-text quasar-type-caption">@DefaultPluginsHelp</p>
                            <h2 class="quasar-text quasar-type-h6">Host machines</h2>
                            <p class="quasar-text quasar-type-body2">Choose 1–32 regular nodes per selected host machine, with at least two in total. The Cluster Gateway host machine also runs the Cluster Registry and World Authority. Clusters on multiple host machines need mutually reachable LAN/VPN addresses; Quasar also needs to reach the Cluster Registry admin port.</p>
                            @foreach (var machine in _machines)
                            {
                                <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-gap-3">
                                    <MudCheckBox T="bool" @bind-Value="machine.Selected" Disabled="Locked" Label="@($"{machine.Host.Name} ({machine.Host.Address})")" />
                                    <MudChip T="string" Size="Size.Small" Color="@(machine.Connected ? Color.Success : Color.Warning)">@(machine.Connected ? "Connected" : "Offline")</MudChip>
                                    <MudNumericField T="int" Label="Regular nodes" @bind-Value="machine.Nodes" Min="1" Max="32" Disabled="@(!machine.Selected || Locked)" />
                                </div>
                            }
                            <MudNumericField T="int" Label="Hot spares" @bind-Value="_spares" Min="0" Max="32" Disabled="Locked" HelperText="Warm nodes that hold nothing. When a node crashes, a hot spare takes over its partitions at once and the crashed node restarts as the new spare. The cluster does this by itself; Quasar only sets how many there are." />
                            @if (_spares == 0)
                            {
                                <MudAlert Severity="Severity.Warning">Without a hot spare, the partitions of a crashed node reload on the remaining nodes, which then carry its load until it restarts.</MudAlert>
                            }
                            <MudSelect T="string" Label="Cluster Gateway and World Authority host machine" @bind-Value="_gateway" Disabled="Locked" HelperText="Players connect to this host machine. Quasar generates and installs the Cluster Registry credentials automatically.">
                                @foreach (var machine in _machines.Where(m => m.Selected)) { <MudSelectItem Value="machine.Host.Id">@machine.Host.Name</MudSelectItem> }
                            </MudSelect>
                            <MudNumericField T="int" Label="Public server port" @bind-Value="_port" Min="1024" Max="64000" Disabled="Locked" HelperText="UDP port players use, usually 28000. Setup also reserves this port through port +16 and ports +1100 to +1264 for Cluster Registry administration and node communication; keep those ports free on these host machines. Port +100 stays free for optional player connections." />
                            <p class="quasar-text quasar-type-body2">Allow the player UDP port through your firewall. Keep internal cluster traffic on your LAN/VPN. The Host executor command listener stays on loopback and connects back to Quasar over HTTPS.</p>
                            @if (HasOfflineHosts)
                            {
                                <MudAlert Severity="Severity.Warning">Every selected host machine must be connected before you can deploy. Start or reconnect the offline host machines. To change host machines after an interrupted attempt, choose Start a new setup.</MudAlert>
                            }
                            <MudButton OnClick="DeployAsync" Disabled="@(!CanDeploy)" Variant="Variant.Filled" Color="Color.Primary">@(_request is null ? "Create and deploy cluster" : "Resume setup")</MudButton>
                            @if (_busy)
                            {
                                <p role="status">@(_state?.ProgressMessage ?? _status?.Phase ?? "Checking cluster hosts and setup settings.")</p>
                                <MudProgressLinear Indeterminate="@(_state?.Percent is null)" Value="@(_state?.Percent ?? 0)" aria-label="Creating and deploying cluster" />
                            }
                            @if (_status is not null)
                            {
                                <MudAlert Severity="@(_status.Error is null ? Severity.Info : Severity.Warning)">
                                    <div>@_status.Phase@(_status.FailedPhase is { } phase ? " during: " + phase : "")</div>
                                    @if (_status.Error is { } error)
                                    {
                                        <div style="white-space: pre-wrap; overflow-wrap: anywhere;">@error</div>
                                        <p>Keep this cluster and fix the reported cause, then choose Resume setup. Completed preparation is verified and reused. Start a new setup only to change the original settings.</p>
                                    }
                                </MudAlert>
                                @if (_request is not null && _status.Error is not null)
                                {
                                    <MudButton OnClick="StartNewSetup" Disabled="_busy">Start a new setup</MudButton>
                                }
                                @if (_state?.Registered == true)
                                {
                                    <MudButton Href="@($"clusters/{Uri.EscapeDataString(_status.Request.UniqueName)}")">Open cluster controls</MudButton>
                                }
                            }
                        </div>
                    </MudStep>
                </ChildContent>
                <ActionContent>
                    @if (_setupStep == 0)
                    {
                        <MudButton OnClick="@(() => _setupStep = 1)" Disabled="@(_busy || !HasConnectedHosts)" Variant="Variant.Filled" Color="Color.Primary">Continue to cluster configuration</MudButton>
                    }
                    else
                    {
                        <MudButton OnClick="@(() => _setupStep = 0)" Disabled="_busy">Back to host enrollment</MudButton>
                    }
                </ActionContent>
            </MudStepper>
        </MudTabPanel>
        <MudTabPanel Text="Register existing cluster (advanced)">
            <div class="quasar-layout quasar-gap-3 pt-4">
                <p class="quasar-text quasar-type-body1">Use this for a cluster already installed and running. Registration connects its Cluster Registry for monitoring and administration; it does not provision host machines or deploy a new cluster.</p>
                <MudTextField T="string" Label="Cluster ID" @bind-Value="_importId" HelperText="A unique Quasar registration name, using letters, numbers, hyphens or underscores." />
                <MudTextField T="string" Label="Server name" @bind-Value="_importName" OnBlur="@(_ => EnsureNames())" HelperText="A blank name receives an editable generated suggestion." />
                <MudTextField T="string" Label="Cluster Registry admin URL" @bind-Value="_url" Placeholder="http://10.0.0.10:28016" HelperText="The Cluster Registry HTTP administration endpoint, reachable from the Quasar host machine. This is separate from the player UDP port and the Quasar website address." />
                <MudTextField T="string" Label="Admin token environment variable name" @bind-Value="_credential" Placeholder="MY_CLUSTER_ADMIN_TOKEN" HelperText="Enter the variable name, not the token itself. Set that variable on the Quasar service to the same admin token configured on this Cluster Registry, then restart Quasar. Guided creation manages credentials automatically." />
                <MudButton OnClick="ImportAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary">Register existing cluster</MudButton>
            </div>
        </MudTabPanel>
    </MudTabs>
    @if (_error is not null && !(_status?.Error is { } shown && _error.Contains(shown, StringComparison.Ordinal))) { <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert> }
</div></section>

@code {
    [Parameter] public string? Resume { get; set; }
    [Parameter] public bool Register { get; set; }
    private readonly CancellationTokenSource _stop = new();
    private string _id = "", _name = "", _world = "", _profile = "", _gateway = "";
    private string _importId = "", _importName = "", _url = "", _credential = "";
    private int _port = 28000, _setupStep, _spares = 1;
    private bool _busy, _showEnrollment, _confirmingDefaultPlugins, _defaultPlugins = true;
    private const string DefaultPluginsRisk = "Bugfixes fixes known game crashes, including a Havok physics crash. Performance reduces CPU overhead and simulation pauses on every node. A node crash or prolonged stall can interrupt players and force partition recovery; unsaved progress may be lost. Keep both plugins enabled for production clusters.";
    private IReadOnlyList<string> PendingDefaultPlugins => _state?.Profiles.FirstOrDefault(p => p.Id == _profile)?.PendingDefaults ?? ["Bugfixes", "Performance"];
    private string DefaultPluginsHelp
    {
        get
        {
            var pending = PendingDefaultPlugins;
            if (!_defaultPlugins)
                return "The cluster gets only the plugins the selected profile has. Existing profile plugins stay selected. Skipped defaults will not be added automatically later; add them manually in the cluster's profile if needed.";
            if (!string.IsNullOrWhiteSpace(_profile) && pending.Count == 0)
                return "The selected profile already has them, or they were turned off in it before. Quasar leaves its plugin selection as it is.";
            return "Adds " + (pending.Count == 0 ? "Bugfixes and Performance" : string.Join(" and ", pending))
                + " from MagnetarHub with their default settings to the cluster's own copy of the profile. The selected profile stays unchanged. You can turn either off later in the cluster's profile.";
        }
    }
    private async Task SetDefaultPluginsAsync(bool enabled)
    {
        if (Locked || _confirmingDefaultPlugins || enabled == _defaultPlugins) return;
        var pending = PendingDefaultPlugins;
        _defaultPlugins = enabled;
        if (enabled || pending.Count == 0) return;
        _confirmingDefaultPlugins = true;
        bool skip = false;
        try
        {
            string names = string.Join(" and ", pending);
            var confirmed = await Dialogs.ShowMessageBoxAsync("Skip recommended server plugins?",
                $"{names} will not be added to this cluster. {DefaultPluginsRisk} " +
                "Plugins already selected in the profile stay selected. Skipped defaults will not be added automatically later. Skip them only for deliberate compatibility testing or troubleshooting.",
                yesText: "Skip recommended plugins", cancelText: "Keep enabled");
            skip = confirmed == true;
        }
        finally { if (!Locked) _defaultPlugins = !skip; _confirmingDefaultPlugins = false; }
    }
    private string? _error;
    private ClusterSetupRequest? _request;
    private ClusterSetupStatus? _status;

    [Parameter] public Guid? Attempt { get; set; }
    private SetupSnapshot? _state;
    private string? _lookup;
    private Guid? _attempt;
    private List<MachineRow> _machines = [];
    private bool HasConnectedHosts => _machines.Any(m => m.Connected);
    private bool Locked => _busy || _request is not null;
    private bool HasOfflineHosts => (_request?.Machines.Select(m => m.HostId)
        ?? _machines.Where(m => m.Selected).Select(m => m.Host.Id)).Any(id => !_machines.Any(m => m.Host.Id == id && m.Connected));
    private bool CanDeploy => _state is not null && !_busy && !_confirmingDefaultPlugins && !HasOfflineHosts && !string.IsNullOrWhiteSpace(_id)
        && !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_world) && !string.IsNullOrWhiteSpace(_profile)
        && _machines.Any(m => m.Selected && m.Host.Id == _gateway)
        && _port is >= 1024 and <= 65000
        && _machines.Where(m => m.Selected).All(m => m.Nodes is >= 1 and <= 32)
        && _spares >= 0 && _spares <= _machines.Where(m => m.Selected).Sum(m => 32 - m.Nodes)
        && _machines.Where(m => m.Selected).Sum(m => (long)m.Nodes) is >= 2 and <= 254;
    private void EnsureNames()
    {
        if (_busy) return;
        if (_request is null)
        {
            if (string.IsNullOrWhiteSpace(_name))
            { _name = SuggestName(); if (string.IsNullOrWhiteSpace(_id)) _id = _name; }
            if (string.IsNullOrWhiteSpace(_id)) _id = SuggestName();
        }
        if (string.IsNullOrWhiteSpace(_importName))
        { _importName = SuggestName(); if (string.IsNullOrWhiteSpace(_importId)) _importId = _importName; }
        if (string.IsNullOrWhiteSpace(_importId)) _importId = SuggestName();
    }

    private static string SuggestName() => "cluster-" + Guid.NewGuid().ToString("N")[..12];

    protected override async Task OnInitializedAsync()
    {
        _lookup = Resume;
        _attempt = Attempt;
        EnsureNames();
        await RefreshAsync();
        _showEnrollment = _machines.Count == 0;
        if (!_stop.IsCancellationRequested) _ = PollAsync(_stop.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(token))
            {
                if (_sending) continue;
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private bool _sending;
    private int _revision;
    private async Task RefreshAsync()
    {
        int revision = ++_revision;
        try
        {
            var state = await Sdk.RequestAsync<SetupSnapshot>("cluster.setup.page", new SetupLookup(_lookup, _attempt), _stop.Token);
            if (revision != _revision || _stop.IsCancellationRequested) return;
            _state = state;
            _machines.RemoveAll(row => !state.Machines.Any(machine => machine.Host.Id == row.Host.Id));
            foreach (var machine in state.Machines)
            {
                var row = _machines.FirstOrDefault(m => m.Host.Id == machine.Host.Id);
                if (row is null)
                {
                    row = new(machine.Host);
                    if (_machines.Count == 0 && _request is null)
                    { row.Selected = true; row.Nodes = 2; _gateway = machine.Host.Id; }
                    _machines.Add(row);
                }
                row.Connected = machine.Connected;
            }
            _status = state.Status;
            var saved = state.ActiveRequest ?? state.Status?.Request;
            if (_request is null && saved is not null)
            {
                _request = saved;
                _setupStep = 1;
                _id = saved.UniqueName; _name = saved.DisplayName; _world = saved.WorldTemplateId;
                _profile = saved.ConfigProfileId; _gateway = saved.GatewayHost; _port = saved.PlayerPort;
                foreach (var row in _machines)
                {
                    var placement = saved.Machines.FirstOrDefault(m => m.HostId == row.Host.Id);
                    row.Selected = placement is not null; row.Nodes = placement?.RegularNodes ?? 1;
                }
                _spares = saved.HotSpares; _defaultPlugins = saved.DefaultPlugins;
            }
            bool finished = _busy && state.ActiveRequest is null && _status?.Phase == "Ready to start";
            _busy = state.ActiveRequest is not null;
            if (state.AttemptError is { } error) { _error = error; if (saved is null) _request = null; }
            if (finished) Navigation.NavigateTo("./", replace: true);
        }
        catch (JSException error)
        {
            if (revision != _revision) return;
            _state = null;
            _machines.Clear();
            _error = error.Message;
            _busy = false;
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }

    private async Task DeployAsync()
    {
        EnsureNames();
        if (!CanDeploy || _sending) return;
        _busy = true; _sending = true; _error = null; ++_revision;
        var request = _request ?? new(_id, _name, _world, _profile, _gateway, _port,
            _machines.Where(m => m.Selected).Select(m => new ClusterSetupPlacement(m.Host.Id, m.Nodes)).ToArray(), _spares, _defaultPlugins);
        _lookup = _id;
        _attempt = Guid.NewGuid();
        try
        {
            var url = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["resume"] = _lookup, ["attempt"] = _attempt.ToString() });
            await JS.InvokeVoidAsync("history.replaceState", _stop.Token, null, "", url);
            await Sdk.RequestAsync<bool>("cluster.setup.deploy", new SetupSubmission(request, _attempt.Value), _stop.Token);
            await RefreshAsync();
        }
        catch (JSException error) { _error = error.Message; _busy = false; }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        finally { _sending = false; }
    }

    private void StartNewSetup() => Navigation.NavigateTo("clusters/new", forceLoad: true, replace: true);

    private async Task ImportAsync()
    {
        EnsureNames();
        if (_busy || _sending) return;
        ++_revision; _busy = true; _sending = true; _error = null;
        try
        {
            await Sdk.RequestAsync<bool>("cluster.setup.register", new SetupRegistration(_importId, _importName, _url, _credential), _stop.Token);
            Navigation.NavigateTo("./", replace: true);
        }
        catch (JSException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        finally { _busy = false; _sending = false; }
    }

    public void Dispose() { _stop.Cancel(); _stop.Dispose(); }
    private sealed class MachineRow(HostRegistration host)
    {
        public HostRegistration Host { get; } = host;
        public bool Connected { get; set; }
        public bool Selected { get; set; }
        public int Nodes { get; set; } = 1;
    }
}
