@implements IAsyncDisposable
@using Admin = CometWorks.ClusterGateway.AdminContract.V1
@inject DashboardSdk Sdk
@inject IDialogService Dialogs
@inject ViewerTimeZone ViewerTime

<section class="quasar-panel server-card">
<div class="quasar-card-content">
<div class="quasar-layout quasar-gap-3">
    <h2 class="quasar-text quasar-type-h6">@(ShowEvents ? "Events" : "Nodes")</h2>
    @if (_error is not null) { <MudAlert Severity="Severity.Warning">Observations may be stale: @_error</MudAlert> }
    @if (_capturedAt is { } captured) { <span class="quasar-text quasar-type-caption">Cluster Registry observation: @ViewerTime.Format(captured)</span> }
    @if (!ShowEvents)
    {
            <MudTable T="PanelNode" Items="NodeRows" Dense="true" Hover="true">
                <HeaderContent><MudTh>Slot / node</MudTh><MudTh>Host machine / role</MudTh><MudTh>Goal / observed</MudTh><MudTh>Cluster Registry status</MudTh><MudTh>Performance</MudTh><MudTh>Actions</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Slot / node">@(context.Plan?.SlotKey ?? context.Fleet?.Registry.SlotKey ?? "-")
                        <span class="quasar-text quasar-type-caption">@(context.Fleet is { } node ? $"{node.Registry.Node} · epoch {node.Registry.Epoch}" : "No registered node")</span>
                    </MudTd>
                    <MudTd DataLabel="Host machine / role">@(context.Plan?.Host ?? context.Fleet?.Registry.Host ?? "-") · @RoleText(context.Plan?.Role ?? context.Fleet?.Registry.Role)
                        @if (context.Fleet?.Registry.Spare == true)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">Hot spare</MudChip>
                        }
                        @if (context.Plan is { } planned && context.Fleet is { } registered
                            && (planned.Host != registered.Registry.Host || planned.Role != registered.Registry.Role))
                        {
                            <span class="quasar-text quasar-type-caption">Registered: @(registered.Registry.Host ?? "-") · @RoleText(registered.Registry.Role)</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Goal / observed">@(context.Plan is { } plan ? $"{plan.Goal} / {plan.Observed}" : "-")</MudTd>
                    <MudTd DataLabel="Cluster Registry status">@(context.Fleet?.Registry.State.ToString() ?? "No registered node")</MudTd>
                    <MudTd DataLabel="Performance">
                        @if (context.Fleet?.Telemetry is { } telemetry)
                        {
                            <p class="quasar-text quasar-type-body2">@(telemetry.Connected ? "Connected" : "Telemetry unavailable")</p>
                            @if (telemetry.Connected)
                            {
                                @if (context.Fleet.Idle)
                                {
                                    <p class="cluster-idle-label">Idle · waiting for work</p>
                                    <p class="quasar-text quasar-type-body2">Memory @telemetry.Metrics?.MemoryWorkingSetMb MB</p>
                                }
                                else
                                {
                                    <p class="quasar-text quasar-type-body2">Sim speed @telemetry.Metrics?.SimSpeed.ToString("0.00") · Memory @telemetry.Metrics?.MemoryWorkingSetMb MB</p>
                                }
                            }
                            @if (telemetry.ReadinessVerified == false) { <p class="quasar-text quasar-type-body1 quasar-tone-@((Color.Warning).ToString().ToLowerInvariant())">Deployment not ready</p> }
                            @if (!string.IsNullOrWhiteSpace(telemetry.DeploymentFailure)) { <p class="quasar-text quasar-type-body1 quasar-tone-@((Color.Warning).ToString().ToLowerInvariant())">@telemetry.DeploymentFailure</p> }
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => LoadDetailsAsync(context.Fleet!.Registry.Node))">Details</MudButton>
                        }
                        else { <p class="quasar-text quasar-type-body2">Telemetry unavailable</p> }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        @if (context.Fleet is { } fleetNode)
                        {
                        @if (Cluster.CanManage) {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                       Disabled="@(!_available || fleetNode.Registry.Role != Admin.NodeRole.Regular || fleetNode.Registry.State != Admin.NodeState.Active || string.IsNullOrWhiteSpace(fleetNode.Registry.SlotKey))"
                                       OnClick="@(() => CloseAsync(fleetNode.Registry))">Drain</MudButton>
                        }
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (_details is { } selected)
            {
                <h3 class="quasar-text quasar-type-subtitle1 mt-3">Process telemetry · @selected.AgentId</h3>
                <span class="quasar-text quasar-type-caption">Telemetry supports diagnosis; Registry state above controls cluster health.</span>
                @foreach (var plugin in selected.Plugins)
                {
                    <p class="quasar-text quasar-type-body2">@plugin.DisplayName · @plugin.Version · @(plugin.IsLoaded ? "loaded" : "not loaded")</p>
                }
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Plugin statistics and profiler">
                        <pre style="max-height:300px;overflow:auto">@selected.StatisticsJson</pre>
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Recent plugin logs">
                        @foreach (var log in selected.Logs)
                        {
                            <p class="quasar-text quasar-type-body2">@ViewerTime.Format(log.TimestampUtc) · @log.Plugin · @log.Level · @log.Message</p>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
    }
    else
    {
            @if (_gap) { <MudAlert Severity="Severity.Info">The event history was truncated or reset at the Gateway.</MudAlert> }
            <MudTable T="Admin.AdminEvent" Items="_events.OrderByDescending(e => e.Seq)" Dense="true" RowsPerPage="25">
                <HeaderContent><MudTh>Sequence / time</MudTh><MudTh>Event</MudTh><MudTh>Actor / target</MudTh></HeaderContent>
                <RowTemplate><MudTd DataLabel="Sequence / time">@context.Seq · @ViewerTime.Format(context.At)</MudTd><MudTd DataLabel="Event">@context.Type</MudTd><MudTd DataLabel="Actor / target">@context.Actor / @context.Target</MudTd></RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
    }
</div>
</div>
</section>

@code {
    [Parameter, EditorRequired] public ClusterDashboard Cluster { get; set; } = null!;
    [Parameter] public ClusterRuntime? Runtime { get; set; }
    [Parameter] public EventCallback<PanelCommand> Command { get; set; }
    [Parameter] public bool ShowEvents { get; set; }
    private readonly CancellationTokenSource _shutdown = new();
    private Admin.AdminEvent[] _events = [];
    private long _cursor;
    private bool _gap;
    private bool _available => Runtime?.Capabilities?.Scope == Admin.AdminScope.Manage;
    private DateTimeOffset? _eventTime;
    private DateTimeOffset? _capturedAt => ShowEvents ? _eventTime : Runtime?.CapturedAt;
    private string? _error, _selectedNode;
    private PanelNodeDetails? _details;
    private Task? _loop;
    private IEnumerable<PanelNode> NodeRows => Runtime?.Nodes.Where(n => n.Plan is not null || n.Fleet is not null) ?? [];
    private static string RoleText(Admin.NodeRole? role) => role switch
    {
        Admin.NodeRole.WorldAuthority => "World Authority",
        Admin.NodeRole.Regular => "Game node",
        _ => "-",
    };
    protected override async Task OnInitializedAsync() { await RefreshAsync(); _loop = LoopAsync(); }
    private async Task RefreshAsync()
    {
        if (!ShowEvents)
        {
            if (_selectedNode is { } node) await LoadDetailsAsync(node);
            return;
        }
        try
        {
            var page = await Sdk.ReadClusterAsync<Admin.AdminEventPage>("cluster.panel.events", Cluster.UniqueName, _shutdown.Token, _cursor);
            _eventTime = DateTimeOffset.UtcNow;
            if (page.NextCursor < _cursor) { _events = []; _gap = true; }
            if (_cursor > 0 && page.EarliestRetained > _cursor + 1) _gap = true;
            _events = _events.Concat(page.Events).DistinctBy(e => e.Seq).OrderBy(e => e.Seq).TakeLast(200).ToArray();
            _cursor = page.NextCursor; _error = null;
        }
        catch (JSException error) { _error = error.Message; }
    }
    private async Task LoadDetailsAsync(string node)
    {
        _selectedNode = node;
        try
        {
            var next = await Sdk.ReadClusterAsync<PanelNodeDetails>("cluster.node.details", Cluster.UniqueName, _shutdown.Token, node);
            if (_selectedNode == node) { _details = next; _error = null; }
        }
        catch (JSException error) { if (_selectedNode == node) { _error = error.Message; _details = null; } }
    }
    private async Task LoopAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(_shutdown.Token))
                await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }
    private async Task CloseAsync(Admin.NodeStatus node)
    {
        if (node.Role != Admin.NodeRole.Regular || node.State != Admin.NodeState.Active || string.IsNullOrWhiteSpace(node.SlotKey)) return;
        if (await Dialogs.ShowMessageBoxAsync("Drain node?",
                $"Drain slot {node.SlotKey} (node {node.Node}, epoch {node.Epoch})? Gateway selects an active replacement node at execution time.",
                yesText: "Drain", cancelText: "Cancel") == true)
            await Command.InvokeAsync(PanelCommand.Create("node-close", target: node.SlotKey));
    }
    public async ValueTask DisposeAsync()
    {
        await _shutdown.CancelAsync();
        if (_loop is not null) await _loop;
        _shutdown.Dispose();
    }
}
