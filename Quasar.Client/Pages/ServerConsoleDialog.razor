    {
        public bool Shifted { get; set; }

        public bool CanLoadOlder { get; set; }

        public bool CanLoadNewer { get; set; }

        public double ScrollRatio { get; set; }
    }

    private sealed class ServerLogRolloverOptions
    {
        public int Threshold { get; set; }

        public bool CanLoadOlder { get; set; }

        public bool CanLoadNewer { get; set; }
    }
