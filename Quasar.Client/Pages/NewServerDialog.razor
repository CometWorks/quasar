<MudDialog>
    <TitleContent>
        <h2 class="quasar-text quasar-type-h6">New server</h2>
    </TitleContent>
    <DialogContent>
        <div class="quasar-layout quasar-gap-3">
            <h3 class="quasar-text quasar-type-subtitle1">What kind of server do you want to create?</h3>
            <MudGrid>
                @if (CanCreate) {
                    <MudItem xs="12" md="6">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Storage"
                                   Style="width: 100%; min-height: 88px;"
                                   OnClick="@(() => Choose(ServerKind.SingleMagnetar))">
                            Single Magnetar
                        </MudButton>
                        <p class="quasar-text quasar-type-body2 mt-2">One dedicated server with Magnetar plugins, managed by Quasar.</p>
                    </MudItem>
                }
                @if (CanManageCluster) {
                    <MudItem xs="12" md="6">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.AccountTree"
                                   Disabled="@(!WorkerLinux)"
                                   Style="width: 100%; min-height: 88px;"
                                   OnClick="@(() => Choose(ServerKind.Cluster))">
                            Cluster
                        </MudButton>
                        <p class="quasar-text quasar-type-body2 mt-2">@(WorkerLinux
                            ? "One shared world across multiple nodes. Continue to guided cluster setup."
                            : "Cluster setup requires Quasar running on Linux. Use Single Magnetar on Windows.")</p>
                    </MudItem>
                }
            </MudGrid>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public bool CanCreate { get; set; }
    [Parameter] public bool CanManageCluster { get; set; }
    [Parameter] public bool WorkerLinux { get; set; } = OperatingSystem.IsLinux();

    public enum ServerKind { SingleMagnetar, Cluster }

    private void Choose(ServerKind kind)
    {
        if (kind == ServerKind.Cluster && !WorkerLinux) return;
        MudDialog.Close(DialogResult.Ok(kind));
    }
    private void Cancel() => MudDialog.Cancel();
}
