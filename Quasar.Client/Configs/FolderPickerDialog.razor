@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-1">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="Cancel" title="Cancel" />
            <h2 class="quasar-text quasar-type-h6">@DialogTitle</h2>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="quasar-layout quasar-gap-2" style="min-width: 480px;">
            <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-1">
                <MudTextField @bind-Value="_currentPath"
                              Variant="Variant.Outlined"
                              Immediate="false"
                              Label="Path"
                              Class="mono flex-grow-1"
                              OnKeyDown="HandlePathKeyDownAsync"
                              OnAdornmentClick="Navigate"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Refresh" />
                <MudButton Variant="Variant.Outlined" OnClick="Navigate">Go</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" title="Up" OnClick="GoUp" />
            </div>

            <MudCheckBox T="bool" Value="_showHidden" ValueChanged="HandleShowHiddenChanged" Label="Show hidden folders" Dense="true" />

            <MudTextField @bind-Value="_entrySearch"
                          Label="Filter current folder"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />

            @if (_shortcuts.Count > 0)
            {
                <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-gap-1">
                    @foreach (var shortcut in _shortcuts)
                    {
                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => NavigateTo(shortcut.FullPath))">
                            @shortcut.Label
                        </MudChip>
                    }
                </div>
            }

            <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-align-center quasar-gap-0 folder-picker-breadcrumbs">
                @foreach (var crumb in _breadcrumbs)
                {
                    var isCurrent = string.Equals(crumb.FullPath, _currentPath, StringComparison.OrdinalIgnoreCase);
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Disabled="@isCurrent"
                               Class="folder-picker-breadcrumb"
                               OnClick="@(() => NavigateTo(crumb.FullPath))">
                        @crumb.Label
                    </MudButton>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@_error</MudAlert>
            }
            else if (RequireWorldFolder && _directory?.IsWorld == true)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                    Sandbox.sbc found. Click "Use this folder" to select it.
                </MudAlert>
            }

            <MudList T="FileBrowserEntry" Dense="true" Style="max-height: 320px; overflow-y: auto;">
                @foreach (var entry in FilteredEntries)
                {
                    <MudListItem T="FileBrowserEntry" OnClick="@(() => NavigateTo(entry.FullPath))">
                        <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-1">
                            <QuasarIcon Icon="@(entry.IsWorldFolder ? Icons.Material.Filled.Public : Icons.Material.Filled.Folder)" TrustedMarkup="true" Class="@("quasar-tone-" + (entry.IsWorldFolder ? Color.Success : Color.Default).ToString().ToLowerInvariant())" />
                            <p class="quasar-text quasar-type-body2">@entry.Name</p>
                            @if (entry.IsWorldFolder)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">world</MudChip>
                            }
                        </div>
                    </MudListItem>
                }
            </MudList>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!CanUseCurrentFolder)"
                   OnClick="UseCurrent">
            Use this folder
        </MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? InitialPath { get; set; }

    [Parameter]
    public string DialogTitle { get; set; } = "Pick world folder";

    [Parameter]
    public bool RequireWorldFolder { get; set; } = true;

    [Parameter]
    public IReadOnlyList<FileBrowserShortcut> AdditionalShortcuts { get; set; } = Array.Empty<FileBrowserShortcut>();

    private string _currentPath = string.Empty;
    private string _error = string.Empty;
    private string _entrySearch = string.Empty;
    private IReadOnlyList<FileBrowserEntry> _entries = Array.Empty<FileBrowserEntry>();
    private IReadOnlyList<FileBrowserBreadcrumb> _breadcrumbs = Array.Empty<FileBrowserBreadcrumb>();
    private IReadOnlyList<FileBrowserShortcut> _shortcuts = Array.Empty<FileBrowserShortcut>();
    private bool _showHidden;
    private bool CanUseCurrentFolder =>
        string.IsNullOrWhiteSpace(_error) &&
        _directory?.Path == _currentPath &&
        (!RequireWorldFolder || _directory?.IsWorld == true);

    private List<FileBrowserEntry> FilteredEntries
    {
        get
        {
            var search = _entrySearch.Trim();
            return _entries
                .Where(entry => string.IsNullOrEmpty(search) ||
                    entry.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    [Parameter] public Func<string, bool, Task<ConfigDirectory>>? BrowseDirectory { get; set; }
    private ConfigDirectory? _directory;
    private int _request;
    protected override Task OnInitializedAsync() => NavigateTo(InitialPath ?? string.Empty);

    private async Task NavigateTo(string path)
    {
        var request = ++_request;
        try
        {
            var directory = BrowseDirectory is not null ? await BrowseDirectory(path, _showHidden) : await new ConfigDashboard(JS).ReadAsync<ConfigDirectory>("directory", new { path, showHidden = _showHidden, xml = false });
            if (request != _request) return;
            _directory = directory;
            _entries = directory.Directories;
            _breadcrumbs = directory.Breadcrumbs;
            _shortcuts = directory.Shortcuts.Concat(AdditionalShortcuts).DistinctBy(s => s.FullPath, StringComparer.OrdinalIgnoreCase).ToArray();
            if (_currentPath != directory.Path) _entrySearch = string.Empty;
            _currentPath = directory.Path;
            _error = string.Empty;
        }
        catch (JSException error)
        {
            if (request != _request) return;
            _directory = null;
            _entries = [];
            _error = error.Message;
        }
    }

    private Task Navigate() => NavigateTo(_currentPath);
    private Task HandlePathKeyDownAsync(KeyboardEventArgs args) => args.Key == "Enter" ? Navigate() : Task.CompletedTask;
    private Task HandleShowHiddenChanged(bool value) { _showHidden = value; return Navigate(); }
    private Task GoUp() => _breadcrumbs.Count > 1 ? NavigateTo(_breadcrumbs[^2].FullPath) : Task.CompletedTask;

    private void Cancel() => MudDialog.Cancel();

    private void UseCurrent() => MudDialog.Close(DialogResult.Ok(_currentPath));
}
