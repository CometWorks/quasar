    private async Task UseDefaultBackupDirectoryAsync()
    {
        _backupDirectoryDraft = string.Empty;
        await SaveBackupDirectoryAsync();
    }

    private async Task SaveBackupDirectoryAsync()
    {
        _savingBackupDirectory = true;
        try
        {
            await Sdk.RequestAsync<bool>("backup.directory.save", new { path = _backupDirectoryDraft });
            await ReloadAsync(resetDirectory: true);
            Snackbar.Add("Backup folder saved.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to save backup folder: {exception.Message}", Severity.Error);
        }
        finally
        {
            _savingBackupDirectory = false;
        }
    }

    private async Task MakeServerBackupNowAsync(string uniqueName)
    {
        if (string.IsNullOrWhiteSpace(uniqueName))
            return;

        try
        {
            await Sdk.RequestAsync<object>("backups.server.create", new { uniqueName });
            Snackbar.Add("Server backup queued.", Severity.Info);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to queue server backup: {exception.Message}", Severity.Error);
        }
    }

    private async Task MakeWorldBackupNowAsync(string uniqueName)
    {
        if (_busy || string.IsNullOrWhiteSpace(uniqueName))
            return;

        _busy = true;
        try
        {
            var action = WorldBackupAction.LatestSave;
            if (IsServerRunning(uniqueName))
            {
                if (!_servers.Any(server => server.Running && string.Equals(server.UniqueName, uniqueName, StringComparison.OrdinalIgnoreCase)))
                    throw new InvalidOperationException("Wait for the server to finish starting, stopping, or restarting before backing up its world.");
                var choice = await DialogService.ShowMessageBoxAsync(
                    "Back up world now?",
                    "Save and back up waits for a fresh world save and keeps the server running. " +
                    "Stop and back up saves the world, stops the server, and then backs it up. The server stays stopped.",
                    yesText: "Save and back up",
                    noText: "Stop and back up",
                    cancelText: "Cancel");
                if (choice is null)
                    return;
                action = choice.Value ? WorldBackupAction.SaveAndBackUp : WorldBackupAction.StopAndBackUp;
            }
            if (action == WorldBackupAction.StopAndBackUp)
                await Sdk.RequestAsync<Guid>("backup.world.stop", new { uniqueName });
            else
                await Sdk.RequestAsync<object>("backups.world.create", new
                {
                    uniqueName,
                    action = action == WorldBackupAction.SaveAndBackUp ? "save" : "latest",
                });
            Snackbar.Add("World backup queued.", Severity.Info);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to queue world backup: {exception.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task RestoreLatestServerBackupAsync(string uniqueName) =>
        RestoreLatestBackupAsync(uniqueName, QuasarBackupKind.Server);

    private Task RestoreLatestWorldBackupAsync(string uniqueName) =>
        RestoreLatestBackupAsync(uniqueName, QuasarBackupKind.World);

    private async Task RestoreLatestBackupAsync(string uniqueName, QuasarBackupKind kind)
    {
        var backup = FindLatestBackup(uniqueName, kind);
        if (backup is null)
        {
            Snackbar.Add($"No {FormatBackupKind(kind).ToLowerInvariant()} backup exists for that server.", Severity.Info);
            return;
        }

        await RestoreFromStoredAsync(backup);
    }

    private async Task RestoreFromUploadAsync(InputFileChangeEventArgs selection)
    {
        if (_busy || _uploadInput?.Element is not { } input) return;
        var file = selection.File;
        _busy = true;
        try
        {
            if (file.Size > MaxUploadBytes)
            {
                Snackbar.Add("The backup exceeds the 10 GiB upload limit.", Severity.Error);
                return;
            }
            if (!await ConfirmRestoreAsync()) return;
            _lastReport = await JS.InvokeAsync<QuasarRestoreReport>("quasarSdk.uploadFile", CancellationToken.None,
                "quasar.core", "backup.restore.upload", input, file.Name, file.Size);
            await ReportRestoreAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add($"The restore outcome could not be confirmed. Check the server state before trying again. {exception.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
            _uploadKey++;
        }
    }

    private async Task RestoreFromStoredAsync(QuasarBackupFileInfo backup)
    {
        if (IsBackupRestoreBlocked(backup))
        {
            Snackbar.Add(
                $"'{backup.ServerDisplayName ?? backup.ServerUniqueName}' is running. Stop it before restoring.",
                Severity.Warning);
            return;
        }

        if (!await ConfirmRestoreAsync(backup))
            return;

        _busy = true;
        try
        {
            _lastReport = await Sdk.RequestAsync<QuasarRestoreReport>("backup.stored.restore", new { backup.Name });
            await ReportRestoreAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Restore failed: {exception.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(string name)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete backup?",
            $"Permanently delete '{name}'?",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            if (!await Sdk.RequestAsync<bool>("backup.stored.delete", new { name })) throw new InvalidOperationException("The backup no longer exists.");
            await ReloadAsync();
            Snackbar.Add("Backup deleted.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to delete backup: {exception.Message}", Severity.Error);
        }
    }

    private async Task<bool> ConfirmRestoreAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Restore backup?",
            "This restores the selected ZIP according to its backup type. Configuration backups merge by ID; server backups restore server definition plus non-cache app data; world backups restore save files. Restored server definitions come back stopped. Continue?",
            yesText: "Restore",
            cancelText: "Cancel");
        return confirmed == true;
    }

    private async Task<bool> ConfirmRestoreAsync(QuasarBackupFileInfo backup)
    {
        var message = backup.Kind switch
        {
            QuasarBackupKind.Server =>
                $"This restores the server definition plus non-cache Dedicated Server and Magnetar app data for '{backup.ServerDisplayName ?? backup.ServerUniqueName ?? backup.Name}'. The server will be restored stopped. Continue?",
            QuasarBackupKind.World =>
                $"This overwrites world save files for '{backup.ServerDisplayName ?? backup.ServerUniqueName ?? backup.Name}' but keeps existing server and world config. Continue?",
            _ =>
                "This overwrites Quasar settings that share an ID with the backup. Items with different IDs are kept (merge). Restored server definitions come back stopped. Continue?",
        };

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Restore backup?",
            message,
            yesText: "Restore",
            cancelText: "Cancel");
        return confirmed == true;
    }

    private async Task ReportRestoreAsync()
    {
        await ReloadAsync();
        if (_lastReport is null)
            return;

        Snackbar.Add(_lastReport.Message, _lastReport.Success ? Severity.Success : Severity.Error);
    }

    private static string FormatSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.#} {units[unit]}";
    }

    private static string FormatBackupType(QuasarBackupFileInfo backup)
    {
        var kind = FormatBackupKind(backup.Kind);
        return backup.Automatic ? $"{kind} (auto)" : kind;
    }

    private static string FormatBackupKind(QuasarBackupKind kind) =>
        kind switch
        {
            QuasarBackupKind.Server => "Server",
            QuasarBackupKind.World => "World",
            _ => "Quasar config",
        };

    private QuasarBackupFileInfo? FindLatestBackup(string uniqueName, QuasarBackupKind kind) =>
        _backups
            .Where(backup => backup.Kind == kind &&
                             string.Equals(backup.ServerUniqueName, uniqueName, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(backup => backup.CreatedAtUtc)
            .ThenBy(backup => backup.Name, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();
}
