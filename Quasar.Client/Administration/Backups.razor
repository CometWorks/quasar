@implements IDisposable
@inject DashboardSdk Sdk
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ViewerTimeZone ViewerTime

<PageTitle>Backups</PageTitle>

<div class="quasar-page-heading"><div><div class="quasar-eyebrow">Tools &amp; settings</div><h1>Backups</h1>
<p>Save and restore all of Quasar's configuration as a ZIP file stamped with the Quasar version (currently <strong>@_snapshot?.Version</strong>).</p></div></div>
@if (_loadError is not null) { <MudAlert Severity="Severity.Error">@_loadError</MudAlert> }
@if (_snapshot is null) { <MudProgressCircular Indeterminate="true" /> }
else
{

<MudGrid>
    <MudItem xs="12" md="6">
        <section class="quasar-panel pa-4" style="height:100%">
            <div class="quasar-layout quasar-gap-3">
                <h2 class="quasar-text quasar-type-h6">Create &amp; restore</h2>
                <p class="quasar-text quasar-type-body2">
                    A backup contains all Quasar configurations (server configs, Config profiles, world
                    templates, Discord, branding, players, security/RBAC and more). <b>No world state is
                        backed up. Please use the world backup below for save files, and the server backup for
                        non-cache Dedicated Server and Magnetar app data.</b>
                </p>

                <MudButton OnClick="@(() => DownloadBackupAsync())"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download">
                    Back up Quasar configuration to file
                </MudButton>

                <hr class="quasar-divider" />

                <h3 class="quasar-text quasar-type-subtitle2">Restore</h3>
                <p class="quasar-text quasar-type-body2">
                    Restoring <strong>merges</strong> the configuration backup into the current configuration:
                    items are matched by ID, so configs, templates and servers with new IDs are added while
                    matching IDs are overwritten. For a clean restore, delete Quasar's configs first, then restore.
                    Restoring the configuration does not change game data. You can restore the servers one by one.
                </p>
                <label class="quasar-field">
                    <span>Restore backup from ZIP file…</span>
                    <InputFile @key="_uploadKey" @ref="_uploadInput" accept=".zip" disabled="@_busy" OnChange="RestoreFromUploadAsync" />
                </label>

                @if (_lastReport is not null)
                {
                    <MudAlert Severity="@(_lastReport.Success ? Severity.Success : Severity.Error)" Dense="true">
                        @_lastReport.Message
                        @if (_lastReport.Success && _lastReport.RestartRecommended)
                        {
                            <text> Restart Quasar to be sure every component reloads.</text>
                        }
                    </MudAlert>
                }
            </div>
        </section>
    </MudItem>

    <MudItem xs="12" md="6">
        <section class="quasar-panel pa-4" style="height:100%">
            <div class="quasar-layout quasar-gap-2">
                <h2 class="quasar-text quasar-type-h6">Version compatibility</h2>
                <p class="quasar-text quasar-type-body2">
                    Backups follow semantic versioning:
                </p>
                <MudList T="string" Dense="true" Class="pl-2">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Same major.minor version restores in full; patch versions are compatible both ways.
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Block" IconColor="Color.Error">
                        Restoring a backup from an older major.minor version is not supported.
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Block" IconColor="Color.Error">
                        Restoring a backup from a newer major.minor version is not supported (no downgrade).
                    </MudListItem>
                </MudList>
                <span class="quasar-text quasar-type-caption">
                    Note: data-protection keys are not included, so a restored Steam Workshop API key must be
                    re-entered when moving the backup to a different machine.
                </span>
            </div>
        </section>
    </MudItem>

    <MudItem xs="12">
        <section class="quasar-panel pa-4">
            <div class="quasar-layout quasar-gap-3">
                <h2 class="quasar-text quasar-type-h6">Server &amp; world backups</h2>
                <p class="quasar-text quasar-type-body2">
                    Server backups include Quasar's server definition plus non-cache Dedicated Server and Magnetar app
                    data. World backups restore only world files and keep the current server/world config intact. World
                    backups of active servers ask whether to save first or stop and back up. Stop and back up leaves
                    the server stopped. Automatic world backups use the latest valid Space Engineers snapshot when available.
                </p>

                @if (_servers.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No servers configured yet.</MudAlert>
                }
                else
                {
                    <MudTable Items="_servers" Hover="true" Dense="true">
                        <HeaderContent>
                            <MudTh><MudTableSortLabel SortBy="new Func<BackupServer, object>(x => x.UniqueName)">Unique name</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<BackupServer, object>(x => x.DisplayName)">Server</MudTableSortLabel></MudTh>
                            <MudTh Class="quasar-actions-column"><span class="quasar-visually-hidden">Actions</span></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @{
                                var latestServerBackup = FindLatestBackup(context.UniqueName, QuasarBackupKind.Server);
                                var latestWorldBackup = FindLatestBackup(context.UniqueName, QuasarBackupKind.World);
                                var serverRunning = IsServerRunning(context.UniqueName);
                                var restoreBlockedReason = serverRunning ? "Stop the server before restoring." : null;
                            }
                            <MudTd DataLabel="Unique name"><code>@context.UniqueName</code></MudTd>
                            <MudTd DataLabel="Server">@context.DisplayName</MudTd>
                            <MudTd DataLabel="" Class="quasar-actions-column">
                                <div class="quasar-layout quasar-layout-row quasar-align-center quasar-gap-0">
                                    <MudTooltip Text="Back up server">
                                        <MudIconButton Icon="@Icons.Material.Filled.Inventory2"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => MakeServerBackupNowAsync(context.UniqueName))"
                                                       Disabled="_busy" />
                                    </MudTooltip>
                                    <MudTooltip Text="@(serverRunning ? restoreBlockedReason : latestServerBackup is null ? "No server backup available." : "Restore latest server backup")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RestoreLatestServerBackupAsync(context.UniqueName))"
                                                       Disabled="@(_busy || serverRunning || latestServerBackup is null)" />
                                    </MudTooltip>
                                    <MudTooltip Text="Back up world">
                                        <MudIconButton aria-label="Back up world" Icon="@Icons.Material.Filled.Public"
                                                       Color="Color.Secondary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => MakeWorldBackupNowAsync(context.UniqueName))"
                                                       Disabled="_busy" />
                                    </MudTooltip>
                                    <MudTooltip Text="@(serverRunning ? restoreBlockedReason : latestWorldBackup is null ? "No world backup available." : "Restore latest world backup")">
                                        <MudIconButton Icon="@Icons.Material.Filled.RestorePage"
                                                       Color="Color.Secondary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RestoreLatestWorldBackupAsync(context.UniqueName))"
                                                       Disabled="@(_busy || serverRunning || latestWorldBackup is null)" />
                                    </MudTooltip>
                                </div>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                <hr class="quasar-divider" />

                <h2 class="quasar-text quasar-type-h6">Automatic backups</h2>
                <p class="quasar-text quasar-type-body2">
                    Configure independent automatic backup rules. Server and world rules run for every configured
                    server and prune retained backups per server.
                </p>

                <MudExpansionPanels MultiExpansion="true">
                    <MudExpansionPanel Text="Quasar config" Expanded="@_settings.Configuration.Enabled">
                        <div class="quasar-layout quasar-gap-3">
                            <p class="quasar-text quasar-type-body2">
                                Backs up Quasar configuration only: server definitions, config profiles, world templates,
                                Discord, branding, players, security/RBAC and other Quasar catalogs. It does not include
                                Dedicated Server app data, Magnetar app data or world save files.
                            </p>
                            <MudSwitch @bind-Value="_settings.Configuration.Enabled" Color="Color.Primary" Label="Enable Quasar config backups" />
                            <MudGrid>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudSelect T="BackupFrequency" @bind-Value="_settings.Configuration.Frequency" Label="Frequency"
                                               Variant="Variant.Outlined" Disabled="!_settings.Configuration.Enabled">
                                        <MudSelectItem T="BackupFrequency" Value="BackupFrequency.Hourly">Hourly</MudSelectItem>
                                        <MudSelectItem T="BackupFrequency" Value="BackupFrequency.Daily">Daily</MudSelectItem>
                                        <MudSelectItem T="BackupFrequency" Value="BackupFrequency.Weekly">Weekly</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                @if (_settings.Configuration.Frequency != BackupFrequency.Hourly)
                                {
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudTimePicker Label="Time of day" @bind-Time="_configurationTimeOfDay"
                                                       Variant="Variant.Outlined" Disabled="!_settings.Configuration.Enabled" />
                                    </MudItem>
                                }
                                @if (_settings.Configuration.Frequency == BackupFrequency.Weekly)
                                {
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudSelect T="DayOfWeek" @bind-Value="_settings.Configuration.DayOfWeek" Label="Day of week"
                                                   Variant="Variant.Outlined" Disabled="!_settings.Configuration.Enabled">
                                            @foreach (var day in Enum.GetValues<DayOfWeek>())
                                            {
                                                <MudSelectItem T="DayOfWeek" Value="day">@day</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }
                                <MudItem xs="12" sm="6" md="3">
                                    <MudNumericField T="int" @bind-Value="_settings.Configuration.RetentionCount" Label="Keep last N backups"
                                                     Min="QuasarBackupSettings.MinRetentionCount"
                                                     Max="QuasarBackupSettings.MaxRetentionCount"
                                                     Variant="Variant.Outlined" Disabled="!_settings.Configuration.Enabled" />
                                </MudItem>
                            </MudGrid>
                        </div>
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Servers" Expanded="@_settings.Server.Enabled">
                        <div class="quasar-layout quasar-gap-3">
                            <p class="quasar-text quasar-type-body2">
                                Backs up each server's Quasar server definition plus non-cache Dedicated Server and
                                Magnetar app data. It does not include world save files; use world backups for saves.
                            </p>
                            <MudSwitch @bind-Value="_settings.Server.Enabled" Color="Color.Primary" Label="Enable server backups" />
                            <MudGrid>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudSelect T="BackupFrequency" @bind-Value="_settings.Server.Frequency" Label="Frequency"
                                               Variant="Variant.Outlined" Disabled="!_settings.Server.Enabled">
                                        <MudSelectItem T="BackupFrequency" Value="BackupFrequency.Hourly">Hourly</MudSelectItem>
                                        <MudSelectItem T="BackupFrequency" Value="BackupFrequency.Daily">Daily</MudSelectItem>
                                        <MudSelectItem T="BackupFrequency" Value="BackupFrequency.Weekly">Weekly</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                @if (_settings.Server.Frequency != BackupFrequency.Hourly)
                                {
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudTimePicker Label="Time of day" @bind-Time="_serverTimeOfDay"
                                                       Variant="Variant.Outlined" Disabled="!_settings.Server.Enabled" />
                                    </MudItem>
                                }
                                @if (_settings.Server.Frequency == BackupFrequency.Weekly)
                                {
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudSelect T="DayOfWeek" @bind-Value="_settings.Server.DayOfWeek" Label="Day of week"
                                                   Variant="Variant.Outlined" Disabled="!_settings.Server.Enabled">
                                            @foreach (var day in Enum.GetValues<DayOfWeek>())
                                            {
                                                <MudSelectItem T="DayOfWeek" Value="day">@day</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }
                                <MudItem xs="12" sm="6" md="3">
                                    <MudNumericField T="int" @bind-Value="_settings.Server.RetentionCount" Label="Keep last N per server"
                                                     Min="QuasarBackupSettings.MinRetentionCount"
                                                     Max="QuasarBackupSettings.MaxRetentionCount"
                                                     Variant="Variant.Outlined" Disabled="!_settings.Server.Enabled" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudNumericField T="int" @bind-Value="_settings.OnlineClusterMiBPerSecond" Label="Running cluster copy rate (MiB/s)"
                                                     Min="QuasarBackupSettings.MinOnlineClusterMiBPerSecond"
                                                     Max="QuasarBackupSettings.MaxOnlineClusterMiBPerSecond"
                                                     Variant="Variant.Outlined" Disabled="!_settings.Server.Enabled" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudNumericField T="int" @bind-Value="_settings.DeletedClusterRetentionDays" Label="Keep deleted clusters (days)"
                                                     Min="QuasarBackupSettings.MinDeletedClusterRetentionDays"
                                                     Max="QuasarBackupSettings.MaxDeletedClusterRetentionDays"
                                                     Variant="Variant.Outlined" />
                                </MudItem>
                            </MudGrid>
                            <p class="quasar-text quasar-type-caption">
                                Managed clusters follow the same schedule. A stopped cluster gets a clean backup. A running one is
                                copied without downtime, at most at the copy rate, and restores to the state of a crash at the
                                start of the copy. The newest clean backup is kept beyond the retention count. After the days
                                set above, Quasar removes all backups, the world and the Host data of a deleted cluster,
                                manual backups included. 0 keeps them forever.
                            </p>
                        </div>
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Worlds" Expanded="@_settings.World.Enabled">
                        <div class="quasar-layout quasar-gap-3">
                            <p class="quasar-text quasar-type-body2">
                                Backs up each server's world save files only. When a Space Engineers <code>Backup</code>
                                snapshot exists, Quasar uses the latest valid snapshot so running servers can be backed up
                                without copying the live save folder.
                            </p>
                            <MudSwitch @bind-Value="_settings.World.Enabled" Color="Color.Primary" Label="Enable world backups" />
                            <MudGrid>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudSelect T="BackupFrequency" @bind-Value="_settings.World.Frequency" Label="Frequency"
                                               Variant="Variant.Outlined" Disabled="!_settings.World.Enabled">
                                        <MudSelectItem T="BackupFrequency" Value="BackupFrequency.Hourly">Hourly</MudSelectItem>
                                        <MudSelectItem T="BackupFrequency" Value="BackupFrequency.Daily">Daily</MudSelectItem>
                                        <MudSelectItem T="BackupFrequency" Value="BackupFrequency.Weekly">Weekly</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                @if (_settings.World.Frequency != BackupFrequency.Hourly)
                                {
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudTimePicker Label="Time of day" @bind-Time="_worldTimeOfDay"
                                                       Variant="Variant.Outlined" Disabled="!_settings.World.Enabled" />
                                    </MudItem>
                                }
                                @if (_settings.World.Frequency == BackupFrequency.Weekly)
                                {
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudSelect T="DayOfWeek" @bind-Value="_settings.World.DayOfWeek" Label="Day of week"
                                                   Variant="Variant.Outlined" Disabled="!_settings.World.Enabled">
                                            @foreach (var day in Enum.GetValues<DayOfWeek>())
                                            {
                                                <MudSelectItem T="DayOfWeek" Value="day">@day</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }
                                <MudItem xs="12" sm="6" md="3">
                                    <MudNumericField T="int" @bind-Value="_settings.World.RetentionCount" Label="Keep last N per server"
                                                     Min="QuasarBackupSettings.MinRetentionCount"
                                                     Max="QuasarBackupSettings.MaxRetentionCount"
                                                     Variant="Variant.Outlined" Disabled="!_settings.World.Enabled" />
                                </MudItem>
                            </MudGrid>
                        </div>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                <div class="quasar-layout quasar-layout-row quasar-gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync" Disabled="_busy">
                        Save rules
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.BackupTable" OnClick="MakeBackupNowAsync" Disabled="_busy">
                        Run enabled rules now
                    </MudButton>
                </div>
            </div>
        </section>
    </MudItem>

    <MudItem xs="12">
        <section class="quasar-panel pa-4">
            <div class="quasar-layout quasar-gap-2">
                <h2 class="quasar-text quasar-type-h6">Stored backups</h2>
                <p class="quasar-text quasar-type-body2">
                    Folder: <code>@_snapshot.Directory.ResolvedDirectory</code> <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ContentCopy" title="Copy folder" OnClick="@(() => CopyAsync(_snapshot.Directory.ResolvedDirectory))" />
                </p>
                <MudGrid>
                    <MudItem xs="12" md="7">
                        <MudTextField @bind-Value="_backupDirectoryDraft"
                                      Label="Backup folder"
                                      Variant="Variant.Outlined"
                                      Disabled="@BackupDirectoryEditorDisabled"
                                      HelperText="Leave empty for the default install-root Backups folder. Relative paths resolve under the Quasar install directory." />
                    </MudItem>
                    <MudItem xs="12" md="5" Class="d-flex align-center justify-end">
                        <div class="quasar-layout quasar-layout-row quasar-wrap-wrap quasar-justify-flexend quasar-gap-1">
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.FolderOpen"
                                       Disabled="@BackupDirectoryEditorDisabled"
                                       OnClick="BrowseBackupDirectoryAsync">
                                Browse
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.RestartAlt"
                                       Disabled="@BackupDirectoryEditorDisabled"
                                       OnClick="UseDefaultBackupDirectoryAsync">
                                Use default
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@BackupDirectoryEditorDisabled"
                                       OnClick="SaveBackupDirectoryAsync">
                                Save folder
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
                <span class="quasar-text quasar-type-caption">
                    Setting stored in <code>@_backupDirectorySettingsPath</code> <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ContentCopy" title="Copy settings path" OnClick="@(() => CopyAsync(_backupDirectorySettingsPath))" />
                </span>
                @if (_backupDirectoryEnvironmentOverride)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        QUASAR_BACKUP_DIR is set to <code>@_backupDirectoryEnvironmentValue</code>, so this page cannot override it. Remove the environment variable and restart Quasar to edit the folder here.
                    </MudAlert>
                }
                @if (_backups.Count == 0)
                {
                    <p class="quasar-text quasar-type-body2">No backups in the configured backup folder yet.</p>
                }
                else
                {
                    <MudTable Items="_backups" Hover="true" Dense="true">
                        <HeaderContent>
                            <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<QuasarBackupFileInfo, object>(x => x.CreatedAtUtc)">Created</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<QuasarBackupFileInfo, object>(x => FormatBackupType(x))">Type</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<QuasarBackupFileInfo, object>(x => x.ServerDisplayName ?? x.ServerUniqueName ?? string.Empty)">Server</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<QuasarBackupFileInfo, object>(x => x.SizeBytes)">Size</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<QuasarBackupFileInfo, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
                            <MudTh Class="quasar-actions-column"><span class="quasar-visually-hidden">Actions</span></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Created"><time class="quasar-stacked-timestamp" datetime="@context.CreatedAtUtc.ToString("O")">@ViewerTime.FormatStacked(context.CreatedAtUtc)</time></MudTd>
                            <MudTd DataLabel="Type">@FormatBackupType(context)</MudTd>
                            <MudTd DataLabel="Server">@(context.ServerDisplayName ?? context.ServerUniqueName ?? "-")</MudTd>
                            <MudTd DataLabel="Size">@FormatSize(context.SizeBytes)</MudTd>
                            <MudTd DataLabel="Name">@context.Name</MudTd>
                            <MudTd DataLabel="" Class="quasar-actions-column">
                                <MudTooltip Text="Download">
                                    <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                   OnClick="@(() => DownloadBackupAsync(context.Name))"
                                                   Size="Size.Small" />
                                </MudTooltip>
                                <MudTooltip Text="@(IsBackupRestoreBlocked(context) ? "Stop the server before restoring." : "Restore")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                                   OnClick="@(() => RestoreFromStoredAsync(context))"
                                                   Disabled="@(_busy || IsBackupRestoreBlocked(context))" Size="Size.Small" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   OnClick="@(() => DeleteAsync(context.Name))"
                                                   Disabled="_busy" Size="Size.Small" Color="Color.Error" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </div>
        </section>
    </MudItem>
</MudGrid>
}

@code {
    private async Task DownloadBackupAsync(string? name = null)
    {
        try { await Sdk.DownloadAsync("backup.read", new { name }); }
        catch (JSException) { Snackbar.Add("The backup download could not complete. Reconnect and try again.", Severity.Error); }
    }

    private InputFile? _uploadInput;
    private int _uploadKey;
    private const long MaxUploadBytes = 10L * 1024 * 1024 * 1024;

    private QuasarBackupSettings _settings = new();
    private TimeSpan? _configurationTimeOfDay;
    private TimeSpan? _serverTimeOfDay;
    private TimeSpan? _worldTimeOfDay;
    private IReadOnlyList<QuasarBackupFileInfo> _backups = [];
    private IReadOnlyList<BackupServer> _servers = [];
    private BackupDashboard? _snapshot;
    private HashSet<Guid> _recentJobs = [];
    private readonly CancellationTokenSource _lifetime = new();
    private string? _loadError;
    private int _loadGeneration;
    private string _backupDirectoryDraft = string.Empty;
    private string _backupDirectorySettingsPath = string.Empty;
    private bool _backupDirectoryEnvironmentOverride;
    private string _backupDirectoryEnvironmentValue = string.Empty;
    private QuasarRestoreReport? _lastReport;
    private bool _busy;
    private bool _savingBackupDirectory;

    private bool BackupDirectoryEditorDisabled =>
        _busy || _savingBackupDirectory || _backupDirectoryEnvironmentOverride;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _ = PollAsync(_lifetime.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
                await InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }

    private async Task ReloadAsync(bool resetDirectory = false)
    {
        var generation = ++_loadGeneration;
        try
        {
            var next = await Sdk.RequestAsync<BackupDashboard>("backup.dashboard", token: _lifetime.Token);
            if (generation != _loadGeneration || _lifetime.IsCancellationRequested) return;
            if (_snapshot is null)
            {
                _settings = next.Settings;
                _configurationTimeOfDay = _settings.Configuration.TimeOfDay.ToTimeSpan();
                _serverTimeOfDay = _settings.Server.TimeOfDay.ToTimeSpan();
                _worldTimeOfDay = _settings.World.TimeOfDay.ToTimeSpan();
            }
            else foreach (var job in next.Jobs.Where(job => !_recentJobs.Contains(job.Id)))
                Snackbar.Add(job.Message, job.Success ? Severity.Success : Severity.Error);
            _recentJobs = next.Jobs.Select(job => job.Id).ToHashSet();
            if (resetDirectory || _snapshot is null || _backupDirectoryDraft == _snapshot.Directory.ConfiguredDirectory)
                _backupDirectoryDraft = next.Directory.ConfiguredDirectory;
            _snapshot = next;
            _servers = next.Servers;
            _backups = next.Backups.OrderByDescending(item => item.CreatedAtUtc).ThenBy(item => item.Name, StringComparer.OrdinalIgnoreCase).ToList();
            _backupDirectoryEnvironmentOverride = next.Directory.EnvironmentOverride;
            _backupDirectoryEnvironmentValue = next.Directory.EnvironmentDirectory;
            _backupDirectorySettingsPath = next.Directory.AppSettingsPath;
            _loadError = null;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (JSException error) { if (generation == _loadGeneration) _loadError = error.Message; }
    }

    private async Task CopyAsync(string path)
    {
        var ok = await JS.InvokeAsync<bool>("quasarConfigs.copyText", path);
        Snackbar.Add(ok ? "Path copied to clipboard." : "Copy failed. Select and copy the path manually.", ok ? Severity.Info : Severity.Warning);
    }

    private bool IsServerRunning(string? uniqueName) =>
        !string.IsNullOrWhiteSpace(uniqueName) && _servers.Any(server => server.Active && string.Equals(server.UniqueName, uniqueName, StringComparison.OrdinalIgnoreCase));

    // Only server/world backups target a specific server; configuration backups
    // are global and never blocked by a running server.
    private bool IsBackupRestoreBlocked(QuasarBackupFileInfo backup) =>
        backup.Kind is QuasarBackupKind.Server or QuasarBackupKind.World
        && IsServerRunning(backup.ServerUniqueName);

    private async Task SaveSettingsAsync()
    {
        _settings.Configuration.TimeOfDay = _configurationTimeOfDay is { } configurationTime
            ? TimeOnly.FromTimeSpan(configurationTime)
            : new TimeOnly(3, 0);
        _settings.Server.TimeOfDay = _serverTimeOfDay is { } serverTime
            ? TimeOnly.FromTimeSpan(serverTime)
            : new TimeOnly(3, 0);
        _settings.World.TimeOfDay = _worldTimeOfDay is { } worldTime
            ? TimeOnly.FromTimeSpan(worldTime)
            : new TimeOnly(3, 0);

        _busy = true;
        try
        {
            await Sdk.RequestAsync<bool>("backup.schedule.save", _settings);
            Snackbar.Add("Backup rules saved.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to save schedule: {exception.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MakeBackupNowAsync()
    {
        try
        {
            await Sdk.RequestAsync<Guid>("backup.schedule.run");
            Snackbar.Add("Enabled backup rules queued.", Severity.Info);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Failed to queue automatic backup: {exception.Message}", Severity.Error);
        }
    }

    private async Task BrowseBackupDirectoryAsync()
    {
        var dialog = await DialogService.ShowAsync<BackupFolderPicker>("Pick backup folder",
            new DialogParameters { [nameof(BackupFolderPicker.InitialPath)] = _backupDirectoryDraft },
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string path })
            _backupDirectoryDraft = path;
