@inject DashboardSdk Sdk
@inject ISnackbar Snackbar

<section class="quasar-panel pa-4">
    <div class="quasar-layout quasar-gap-3">
        <h2 class="quasar-text quasar-type-h6">Discord Admin Mappings</h2>
        <p>
            A mapped Discord user can use the admin commands UI plugins add to Discord, such as the assistant plugin's
            <code>/assistant</code>, as the mapped Steam account: with its roles, never more than that admin could do in Quasar.
            Discord's own Administrator permission doesn't count here.
        </p>
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="_discordUserId" Label="Discord user ID" Variant="Variant.Outlined" Disabled="@_saving"
                              HelperText="Right-click the user in Discord with developer mode on, then Copy User ID." />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_steamId" Label="Steam account" Variant="Variant.Outlined" Disabled="@_saving"
                              HelperText="SteamID64 or profile URL of the account whose Quasar roles the Discord user acts with." />
            </MudItem>
            <MudItem xs="12" md="1" Class="d-flex align-center">
                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" aria-label="Add Discord admin mapping"
                               Disabled="@(_saving || string.IsNullOrWhiteSpace(_discordUserId) || string.IsNullOrWhiteSpace(_steamId))"
                               OnClick="AddAsync" />
            </MudItem>
        </MudGrid>
        @if (Mappings.Length == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No Discord users are mapped.</MudAlert>
        }
        else
        {
            <MudTable T="DiscordMapping" Items="Mappings" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Discord user ID</MudTh>
                    <MudTh>Steam subject</MudTh>
                    <MudTh>Roles</MudTh>
                    <MudTh Class="quasar-actions-column"><span class="quasar-visually-hidden">Actions</span></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Discord user ID" Class="mono">@context.DiscordUserId</MudTd>
                    <MudTd DataLabel="Steam subject" Class="mono">@context.Subject</MudTd>
                    <MudTd DataLabel="Roles">@string.Join(", ", context.Roles)</MudTd>
                    <MudTd DataLabel="" Class="quasar-actions-column">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Remove Discord admin mapping"
                                       Disabled="@_saving" OnClick="@(() => RemoveAsync(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public DiscordMapping[] Mappings { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }
    private string _discordUserId = "", _steamId = "";
    private bool _saving;
    private async Task AddAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            await Sdk.RequestAsync<bool>("security.discord.add", new { discordUserId = _discordUserId.Trim(), subject = _steamId.Trim() });
            _discordUserId = _steamId = ""; await Changed.InvokeAsync();
            Snackbar.Add("Added Discord admin mapping.", Severity.Success);
        }
        catch (JSException error) { Snackbar.Add(error.Message, Severity.Error); }
        finally { _saving = false; }
    }
    private async Task RemoveAsync(DiscordMapping mapping)
    {
        if (_saving) return;
        _saving = true;
        try
        {
            await Sdk.RequestAsync<bool>("security.discord.remove", new { mapping.DiscordUserId });
            await Changed.InvokeAsync();
            Snackbar.Add("Removed Discord admin mapping.", Severity.Success);
        }
        catch (JSException error) { Snackbar.Add(error.Message, Severity.Error); }
        finally { _saving = false; }
    }
}
