@namespace Quasar.Ui.Components

<td class="@Class" data-label="@Label" @attributes="AdditionalAttributes">@ChildContent</td>

@code {
    /// <summary>
    /// The column title. A table with a stacked narrow layout shows it beside the
    /// value.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Additional class applied to the cell.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Cell content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional attributes forwarded to the cell.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
