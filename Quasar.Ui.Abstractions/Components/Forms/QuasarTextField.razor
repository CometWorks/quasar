@namespace Quasar.Ui.Components
@inherits QuasarFieldBase<string>

<div class="@FieldClass" aria-busy="@(IsValidating ? "true" : null)">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="quasar-input-label" for="@FieldId">
            @Label
            @if (Required)
            {
                <span class="quasar-input-required" aria-hidden="true">*</span>
            }
        </label>
    }

    @if (Multiline)
    {
        <textarea id="@FieldId"
                  rows="@Lines"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  readonly="@ReadOnly"
                  maxlength="@MaxLength"
                  aria-invalid="@(Errors.Count > 0 ? "true" : null)"
                  aria-describedby="@DescribedBy"
                  value="@CurrentValue"
                  @oninput="InputHandler"
                  @onchange="OnChangeAsync"
                  @onblur="OnBlurAsync"
                  @attributes="AdditionalAttributes"></textarea>
    }
    else
    {
        <input id="@FieldId"
               type="@TypeAttribute"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               maxlength="@MaxLength"
               autocomplete="@Autocomplete"
               aria-invalid="@(Errors.Count > 0 ? "true" : null)"
               aria-describedby="@DescribedBy"
               value="@CurrentValue"
               @oninput="InputHandler"
               @onchange="OnChangeAsync"
               @onblur="OnBlurAsync"
               @attributes="AdditionalAttributes" />
    }

    <QuasarFieldMessages Hint="@Hint" HintId="@HintId" MessagesId="@MessagesId" Errors="@Errors" />
</div>

@code {
    /// <summary>Renders a textarea instead of a single-line input.</summary>
    [Parameter] public bool Multiline { get; set; }

    /// <summary>Visible rows when <see cref="Multiline"/> is set.</summary>
    [Parameter] public int Lines { get; set; } = 3;

    /// <summary>The native input type.</summary>
    [Parameter] public QuasarTextInputType InputType { get; set; }

    /// <summary>Optional native autocomplete hint.</summary>
    [Parameter] public string? Autocomplete { get; set; }

    /// <summary>Optional native maximum length.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>
    /// Commits the value while the user types, after a short pause in typing,
    /// instead of only when the field loses focus or Enter is pressed. Use it for
    /// search and filter boxes.
    /// </summary>
    [Parameter] public bool Immediate { get; set; }

    // An empty callback registers no event, so a field that is not Immediate sends
    // nothing to the server while the user types.
    private EventCallback<ChangeEventArgs> InputHandler => Immediate
        ? EventCallback.Factory.Create<ChangeEventArgs>(this, OnInputAsync)
        : default;

    private string TypeAttribute => InputType switch
    {
        QuasarTextInputType.Password => "password",
        QuasarTextInputType.Email => "email",
        QuasarTextInputType.Search => "search",
        QuasarTextInputType.Url => "url",
        QuasarTextInputType.Tel => "tel",
        _ => "text",
    };

    private Task OnInputAsync(ChangeEventArgs args)
    {
        EditValue(args.Value?.ToString() ?? string.Empty);
        return Task.CompletedTask;
    }

    private Task OnChangeAsync(ChangeEventArgs args) =>
        SetValueAsync(args.Value?.ToString() ?? string.Empty);
}
