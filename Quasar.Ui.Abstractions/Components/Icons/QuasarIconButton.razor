@namespace Quasar.Ui.Components
@if (Href is not null && QuasarUrlSafety.IsSafeHref(Href))
{
    <a class="quasar-icon-button @Class" href="@Href" title="@Label" aria-label="@Label"><QuasarIcon Icon="@Icon" TrustedMarkup="@TrustedMarkup" />@if (ShowLabel) { <span>@(Text ?? Label)</span> }</a>
}
else if (Href is null)
{
    <button type="button" class="quasar-icon-button @Class" title="@Label" aria-label="@Label"
            aria-expanded="@(Expanded?.ToString().ToLowerInvariant())" popovertarget="@ClosePopover" popovertargetaction="hide" disabled="@Disabled" @onclick="OnClick"><QuasarIcon Icon="@Icon" TrustedMarkup="@TrustedMarkup" />@if (ShowLabel) { <span>@(Text ?? Label)</span> }</button>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    /// <summary>
    /// Optional link target. Relative links and http(s), mailto and tel URLs
    /// are rendered; other schemes are ignored.
    /// </summary>
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public bool ShowLabel { get; set; }
    [Parameter] public string? ClosePopover { get; set; }
    [Parameter] public bool? Expanded { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool TrustedMarkup { get; set; }
}
